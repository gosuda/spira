package main

import (
	"context"

	"github.com/gosuda/spira/admin"
	"github.com/gosuda/spira/asset"
	"github.com/gosuda/spira/config"
	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/job"
	"github.com/gosuda/spira/view"
	"github.com/gosuda/spira/web"
)

func AssembleForTest(ctx context.Context, settings Settings, service *admin.Server?) (*Application?, error) {
	return assemble(ctx, settings, service)
}

func BuildRouterForTest(pool *db.Pool, assets *asset.Manifest, tags view.Node, dev bool) (*web.Router, *job.Scheduler, error) {
	return buildRouter(context.Background(), shopParts{pool: pool, assets: assets, tags: tags, dev: dev})
}

func LoadShopSettingsForTest(source config.Source) (Settings, error) {
	return loadShopSettings(source)
}
