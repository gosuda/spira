type cancelRace struct {
	router  *web.Router
	request *http.Request
	reply   *httptest.ResponseRecorder
	loaded  chan struct{}
	release chan struct{}
	done    chan struct{}
}

func (box *cancelRace) probe(call context.Context) error {
	close(box.loaded)
	select {
	case <-box.release:
		return nil
	case <-call.Done():
		return call.Err()
	}
}

func serveFirst(box *cancelRace) error {
	defer close(box.done)
	box.router.ServeHTTP(box.reply, box.request)
	return nil
}

func afterSnapshot(ctx context.Context, box *cancelRace, compete func(context.Context) error) error {
	defer close(box.release)
	select {
	case <-box.loaded:
	case <-box.done:
		return errors.New("orders_test: first cancel finished without loading")
	case <-ctx.Done():
		return ctx.Err()
	}
	return compete(ctx)
}

func runCancelRace(ctx context.Context, r *web.Router, req *http.Request, compete func(context.Context) error) (*httptest.ResponseRecorder, error) {
	box := &cancelRace{
		router:  r,
		request: req,
		reply:   httptest.NewRecorder(),
		loaded:  make(chan struct{}),
		release: make(chan struct{}),
		done:    make(chan struct{}),
	}
	box.request = req.WithContext(orders.ContextWithProbe(ctx, box.probe))
	go group (ctx) {
		go { serveFirst(box) }
		go { afterSnapshot(ctx, box, compete)? }
	}
	return box.reply, nil
}

func TestConcurrentCancelsAnswer200And409(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	user := seedUser(t, pool, "ada")
	if user == 0 {
		return
	}
	id := seedOrder(t, pool, user)
	if id == 0 {
		return
	}
	r, sessions := testRouter(pool)
	cookie := sessionCookie(t, sessions, user)
	winner := httptest.NewRecorder()
	loser, err := runCancelRace(bounded(t), r, cancelRequest($"{id}", cookie), func(ctx context.Context) error {
		req := cancelRequest($"{id}", cookie)
		r.ServeHTTP(winner, req.WithContext(ctx))
		return nil
	})
	if err != nil {
		t.Fatalf("cancel race: %v", err)
		return
	}
	if winner.Code != http.StatusOK {
		t.Fatalf("second status %d want 200, body %s", winner.Code, winner.Body.String())
	}
	checkCancelProblem(t, loser, http.StatusConflict, "orders.stale_order")
	got := fetchedOrder(t, pool, id)
	if got == nil {
		t.Fatal("order is missing after concurrent cancels")
		return
	}
	if got.status != "cancelled" || got.version != 2 {
		t.Errorf("concurrent cancels persisted %+v, want cancelled at version 2", got)
	}
}

func TestCancelConcealsOrderLostAfterSnapshot(t *testing.T) {
	t.Run("deleted", func(t *testing.T) { checkOrderLostAfterSnapshot(t, "deleted") })
	t.Run("replaced", func(t *testing.T) { checkOrderLostAfterSnapshot(t, "replaced") })
}

func checkOrderLostAfterSnapshot(t *testing.T, change string) {
	t.Helper()
	pool := openPool(t)
	if pool == nil {
		return
	}
	owner := seedUser(t, pool, "owner")
	other := seedUser(t, pool, "replacement owner")
	id := seedOrder(t, pool, owner)
	r, sessions := testRouter(pool)
	cookie := sessionCookie(t, sessions, owner)
	req := cancelRequest($"{id}", cookie)
	rec, err := runCancelRace(bounded(t), r, req, func(ctx context.Context) error {
		return replaceOrderDuringCancel(ctx, pool, orderReplacement{id: id, owner: other, change: change})
	})
	if err != nil {
		t.Fatalf("cancel race: %v", err)
		return
	}
	checkCancelProblem(t, rec, http.StatusNotFound, "orders.unknown_order")
	missing := httptest.NewRecorder()
	r.ServeHTTP(missing, cancelRequest("999", cookie))
	if rec.Body.String() != missing.Body.String() {
		t.Errorf("lost order response %q discloses state; missing order response %q", rec.Body.String(), missing.Body.String())
	}
	got, err := store.GetOrder(bounded(t), pool, store.OrderID(id))
	if err != nil {
		t.Fatalf("read final order: %v", err)
		return
	}
	if change == "deleted" {
		if got != nil {
			t.Errorf("cancel recreated the deleted order: %+v", got)
		}
		return
	}
	if got == nil {
		t.Fatal("replacement order is missing")
		return
	}
	if got.UserID != store.UserID(other) || got.Status != "open" || got.Version != 1 || got.Total != 200 {
		t.Errorf("cancel changed the replacement order: %+v", got)
	}
}

type orderReplacement struct {
	id     int64
	owner  int64
	change string
}

func replaceOrderDuringCancel(ctx context.Context, pool *db.Pool, replacement orderReplacement) error {
	_, err := pool.ExecContext(ctx, "DELETE FROM orders WHERE id = ?", replacement.id)
	if err != nil || replacement.change == "deleted" {
		return err
	}
	res := pool.ExecContext(ctx, `INSERT INTO orders (user_id, status, total, created_at)
		VALUES (?, 'open', 200, '2026-01-02 10:00:00')`, replacement.owner)?
	got := res.LastInsertId()?
	if got != replacement.id {
		return fmt.Errorf("SQLite allocated replacement ID %d, want reused ID %d", got, replacement.id)
	}
	return nil
}

func TestCancelDeadlineWhileWriterReserved(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	user := seedUser(t, pool, "ada")
	id := seedOrder(t, pool, user)
	before := fetchedOrder(t, pool, id)
	if before == nil {
		return
	}
	r, sessions := testRouter(pool)
	req := cancelRequest($"{id}", sessionCookie(t, sessions, user))
	reply := httptest.NewRecorder()
	ctx := bounded(t)
	_, err := db.InSQLiteImmediateTx(ctx, pool, func(_ *db.Tx) (struct{}, error) {
		wait, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
		defer cancel()
		r.ServeHTTP(reply, req.WithContext(wait))
		return struct{}{}, nil
	})
	if err != nil {
		t.Fatalf("hold SQLite writer reservation: %v", err)
		return
	}
	checkCancelProblem(t, reply, http.StatusInternalServerError, "internal")
	checkUnchangedOrder(t, pool, id, before)
}
