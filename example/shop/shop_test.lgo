package main_test

import (
	"net/http"
	"net/http/httptest"
	"testing"
	"testing/fstest"

	shopmain "github.com/gosuda/spira/example/shop"
)

func TestIslandsServeWasmWithContentType(t *testing.T) {
	sys := fstest.MapFS{
		"islands/ticker.wasm": {Data: []byte{0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00}},
	}
	handler := shopmain.IslandFiles(http.FileServerFS(sys))
	req := httptest.NewRequest(http.MethodGet, "/islands/ticker.wasm", nil)
	rec := httptest.NewRecorder()
	handler.ServeHTTP(rec, req)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	if ct := rec.Header().Get("Content-Type"); ct != "application/wasm" {
		t.Fatalf("content type = %q, want application/wasm", ct)
	}
	if cc := rec.Header().Get("Cache-Control"); cc != "no-cache" {
		t.Fatalf("cache control = %q, want no-cache", cc)
	}
}
