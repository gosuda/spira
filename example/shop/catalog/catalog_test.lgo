	_ "modernc.org/sqlite"
)

func openPool(t *testing.T) *db.Pool? {
	t.Helper()
	key := strings.NewReplacer("/", "_").Replace(t.Name())
	pool, err := db.Open("sqlite", fmt.Sprintf("file:spira_catalog_%s?mode=memory&cache=shared", key))
	if err != nil {
		t.Fatalf("open: %v", err)
		return nil
	}
	if pool == nil {
		t.Fatalf("open: no pool")
		return nil
	}
	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
	defer cancel()
	if err := pool.Start(ctx); err != nil {
		t.Fatalf("start: %v", err)
		return nil
	}
	steps, err := migrate.Load(shopdb.FS())
	if err != nil {
		t.Fatalf("load migrations: %v", err)
		return nil
	}
	if err := migrate.Apply(ctx, pool, steps); err != nil {
		t.Fatalf("apply migrations: %v", err)
		return nil
	}
	seedProducts(t, pool)
	t.Cleanup(func() {
		if err := pool.Stop(context.Background()); err != nil {
			t.Errorf("stop: %v", err)
		}
	})
	return pool
}

func seedProducts(t *testing.T, pool *db.Pool) {
	t.Helper()
	rows := []string{
		"INSERT INTO products (id, name, price, stock, created_at) VALUES (1, 'Widget', 1299, 10, '2026-01-02 10:00:00')",
		"INSERT INTO products (id, name, price, stock, created_at) VALUES (2, '<script>alert(1)</script>', 500, 5, '2026-01-03 10:00:00')",
		"INSERT INTO products (id, name, price, stock, created_at) VALUES (3, 'Gadget', 2500, 0, '2026-01-01 10:00:00')",
	}
	for _, q := range rows {
		if _, err := pool.ExecContext(t.Context(), q); err != nil {
			t.Fatalf("seed: %v", err)
			return
		}
	}
}

func testRouter(pool *db.Pool) *web.Router {
	r := web.NewRouter()
	r.Layout = layoutPage()
	feature := &catalog.Feature{DB: pool, Assets: asset.Dev("http://localhost:5173")}
	feature.Register(r)
	return r
}

func layoutPage() func(ctx *web.Context, p web.Page) view.Node {
	return func(ctx *web.Context, p web.Page) view.Node {
		return view.Html(view.Head(view.Title(view.T(p.Title))), view.Body(p.Body))
	}
}

func get(t *testing.T, r *web.Router, target string, headers http.Header) *httptest.ResponseRecorder {
	t.Helper()
	req := httptest.NewRequest(http.MethodGet, target, nil)
	for k, vs := range headers {
		for _, v := range vs {
			req.Header.Add(k, v)
		}
	}
	rec := httptest.NewRecorder()
	r.ServeHTTP(rec, req)
	return rec
}

func htmxHeaders() http.Header {
	return http.Header{"HX-Request": []string{"true"}}
}

func TestCatalogPageStartsWithDoctype(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog", nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	body := rec.Body.String()
	if !strings.HasPrefix(body, "<!doctype html>") {
		t.Fatalf("body starts %q, want the doctype", body[:min(64, len(body))])
	}
	if vary := rec.Header().Get("Vary"); !strings.Contains(vary, "HX-Request") {
		t.Fatalf("Vary = %q, want the htmx cache keys", vary)
	}
	if !strings.Contains(body, "&lt;script&gt;") {
		t.Fatalf("body lacks the escaped product name")
	}
	if strings.Contains(body, "<script>alert(1)</script>") {
		t.Fatalf("body holds the raw injected script")
	}
	if !strings.Contains(body, `entry="example/shop/catalog/islands/gallery.react.tsx"`) {
		t.Fatalf("body lacks the gallery island")
	}
	if !strings.Contains(body, `entry="example/shop/catalog/islands/filter.solid.tsx"`) {
		t.Fatalf("body lacks the filter island")
	}
	if !strings.Contains(body, `hx-get="/catalog/search"`) {
		t.Fatalf("body lacks the htmx search box")
	}
}

func TestCatalogFragmentForHtmx(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog", htmxHeaders())
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	body := rec.Body.String()
	if strings.Contains(body, "<html") {
		t.Fatalf("fragment carries the document shell")
	}
	if !strings.Contains(body, "Widget") {
		t.Fatalf("fragment lacks the product list")
	}
	if vary := rec.Header().Get("Vary"); !strings.Contains(vary, "HX-Request") {
		t.Fatalf("Vary = %q, want the htmx cache key", vary)
	}
}

func TestCatalogBoostedReturnsFullPage(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	headers := htmxHeaders()
	headers.Set("HX-Boosted", "true")
	rec := get(t, testRouter(pool), "/catalog", headers)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	if !strings.Contains(rec.Body.String(), "<html") {
		t.Fatalf("boosted response lacks the document shell")
	}
}

func TestProductDetail(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	router := testRouter(pool)
	rec := get(t, router, "/catalog/1", nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("detail status = %d, want 200", rec.Code)
		return
	}
	if !strings.Contains(rec.Body.String(), "Widget") {
		t.Fatalf("detail lacks the product name")
	}
	missing := get(t, router, "/catalog/999", nil)
	if missing.Code != http.StatusNotFound {
		t.Fatalf("missing status = %d, want 404", missing.Code)
	}
	if ct := missing.Header().Get("Content-Type"); ct != "application/problem+json" {
		t.Fatalf("missing content type = %q, want application/problem+json", ct)
	}
	var problem map[string]string
	if err := json.Unmarshal(missing.Body.Bytes(), &problem); err != nil {
		t.Fatalf("decode missing product fault: %v", err)
		return
	}
	want := map[string]string{
		"code":    "catalog.unknown_product",
		"message": "The product was not found.",
	}
	if !maps.Equal(problem, want) {
		t.Fatalf("missing product fault = %v, want only %v", problem, want)
	}
}

func TestSearchFragmentFilters(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog/search?q=Wid", htmxHeaders())
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	body := rec.Body.String()
	if !strings.Contains(body, "Widget") {
		t.Fatalf("search lacks the matching product")
	}
	if strings.Contains(body, "Gadget") {
		t.Fatalf("search holds a product outside the query")
	}
}

func TestPlainSearchRedirectsToList(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog/search?q=Widget", nil)
	if rec.Code != http.StatusSeeOther {
		t.Fatalf("status = %d, want 303", rec.Code)
		return
	}
	if loc := rec.Header().Get("Location"); !strings.Contains(loc, "q=Widget") {
		t.Fatalf("Location = %q, want the query carried over", loc)
	}
}

