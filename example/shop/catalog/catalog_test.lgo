func TestRecommendationsResolveWithoutReload(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog/1", nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	if !rec.Flushed {
		t.Fatal("detail response was not flushed")
	}
	body := rec.Body.String()
	_, slot, found := strings.Cut(body, `<spira-slot id="`)
	if !found {
		t.Fatal("detail lacks the recommendations fallback slot")
		return
	}
	slotID, afterID, found := strings.Cut(slot, `">`)
	if !found || slotID == "" {
		t.Fatal("recommendations fallback slot lacks an ID")
		return
	}
	fallback, afterFallback, found := strings.Cut(afterID, "</spira-slot>")
	if !found || !strings.Contains(fallback, "Loading recommendations.") {
		t.Fatal("recommendations slot lacks its loading fallback")
		return
	}
	_, resolved, found := strings.Cut(afterFallback, `<template data-spira-slot="`+slotID+`">`)
	if !found {
		t.Fatal("detail lacks the matching resolved template after the fallback")
		return
	}
	recommendations, _, found := strings.Cut(resolved, "</template>")
	if !found || !strings.Contains(recommendations, "&lt;script&gt;alert(1)&lt;/script&gt;") {
		t.Fatal("resolved recommendations lack the escaped name of the other in-stock product")
	}
	if strings.Contains(recommendations, "Widget") || strings.Contains(recommendations, "Gadget") {
		t.Fatal("resolved recommendations include the current or out-of-stock product")
	}
	if strings.Contains(body, "<script>alert(1)</script>") {
		t.Fatal("detail rendered the raw script payload")
	}
}

func TestSortOrdersByPrice(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog?sort=price_desc", htmxHeaders())
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	body := rec.Body.String()
	gadget := strings.Index(body, "Gadget")
	widget := strings.Index(body, "Widget")
	if gadget < 0 || widget < 0 || gadget > widget {
		t.Fatalf("price_desc order wrong: Gadget at %d, Widget at %d", gadget, widget)
	}
}

func parsePage(t *testing.T, body string) *html.Node? {
	t.Helper()
	doc, err := html.Parse(strings.NewReader(body))
	if err != nil {
		t.Fatalf("parse page as HTML: %v", err)
		return nil
	}
	return doc
}

func pageAttr(n *html.Node, key string) string {
	for _, a := range n.Attr {
		if a.Key == key {
			return a.Val
		}
	}
	return ""
}

func pageHasAttr(n *html.Node, key string) bool {
	for _, a := range n.Attr {
		if a.Key == key {
			return true
		}
	}
	return false
}

func pageAll(root *html.Node, match func(n *html.Node) bool) []*html.Node {
	var found []*html.Node
	for n := range root.Descendants() {
		if match(n) {
			found = append(found, n)
		}
	}
	return found
}

func pageFirst(root *html.Node, match func(n *html.Node) bool) *html.Node? {
	for n := range root.Descendants() {
		if match(n) {
			return n
		}
	}
	return nil
}

func pageWithin(outer *html.Node, inner *html.Node) bool {
	if outer == inner {
		return true
	}
	for n := range outer.Descendants() {
		if n == inner {
			return true
		}
	}
	return false
}

func stockRegion(t *testing.T, doc *html.Node) *html.Node? {
	t.Helper()
	regions := pageAll(doc, func(n *html.Node) bool { return pageAttr(n, "data-live-region") == "stock" })
	if len(regions) != 1 {
		t.Fatalf("stock regions = %d, want one stable region", len(regions))
		return nil
	}
	return regions[0]
}

func requireRegionOwnsSinkAndToggle(t *testing.T, doc *html.Node, region *html.Node) *html.Node? {
	t.Helper()
	sink := pageFirst(doc, func(n *html.Node) bool { return pageAttr(n, "sse-swap") == "stock" })
	if sink == nil {
		t.Fatal("page lacks the stock SSE sink")
		return nil
	}
	if !pageWithin(region, sink) {
		t.Fatal("the stock SSE sink is outside the region")
	}
	toggle := pageFirst(doc, func(n *html.Node) bool {
		return n.Data == "button" && pageHasAttr(n, "data-live-toggle")
	})
	if toggle == nil {
		t.Fatal("page lacks the pause toggle")
		return nil
	}
	if !pageWithin(region, toggle) {
		t.Fatal("the pause toggle is outside the region")
	}
	return sink
}

func listDocument(t *testing.T, pool *db.Pool) *html.Node? {
	t.Helper()
	rec := get(t, testRouter(pool), "/catalog", nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return nil
	}
	return parsePage(t, rec.Body.String())
}

func searchForm(doc *html.Node) *html.Node? {
	return pageFirst(doc, func(n *html.Node) bool {
		if n.Data != "form" {
			return false
		}
		return pageFirst(n, func(c *html.Node) bool { return c.Data == "input" && pageAttr(c, "name") == "q" }) != nil
	})
}

func resultsList(t *testing.T, doc *html.Node) *html.Node? {
	t.Helper()
	results := pageAll(doc, func(n *html.Node) bool { return pageAttr(n, "id") == "results" })
	if len(results) != 1 {
		t.Fatalf("results lists = %d, want one", len(results))
		return nil
	}
	return results[0]
}

func TestListStockRegionOwnsTargets(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	doc := listDocument(t, pool)
	if doc == nil {
		return
	}
	region := stockRegion(t, doc)
	if region == nil {
		return
	}
	if pageFirst(region, func(n *html.Node) bool { return n != region && pageAttr(n, "data-live-region") == "stock" }) != nil {
		t.Fatal("the stock region nests another live region")
	}
	results := resultsList(t, doc)
	if results == nil {
		return
	}
	if !pageWithin(region, results) {
		t.Fatal("the results list is outside the stock region")
	}
	targets := pageAll(doc, func(n *html.Node) bool { return strings.HasPrefix(pageAttr(n, "id"), "stock-") })
	if len(targets) == 0 {
		t.Fatal("page lacks stock update targets")
		return
	}
	for _, target := range targets {
		if !pageWithin(region, target) {
			t.Fatalf("stock target %q is outside the region", pageAttr(target, "id"))
		}
	}
}

func TestListStockRegionOwnsSinkAndToggle(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	doc := listDocument(t, pool)
	if doc == nil {
		return
	}
	region := stockRegion(t, doc)
	if region == nil {
		return
	}
	sink := requireRegionOwnsSinkAndToggle(t, doc, region)
	if sink == nil {
		return
	}
	results := resultsList(t, doc)
	if results == nil {
		return
	}
	if pageWithin(results, sink) {
		t.Fatal("the SSE sink sits inside the results list and cannot survive a search swap")
	}
}

func TestListSearchFormReplacesList(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	doc := listDocument(t, pool)
	if doc == nil {
		return
	}
	form := searchForm(doc)
	if form == nil {
		t.Fatal("page lacks the search form")
		return
	}
	if got := pageAttr(form, "hx-target"); got != "#results" {
		t.Fatalf("search hx-target = %q, want #results", got)
	}
	if got := pageAttr(form, "hx-swap"); got != "outerHTML" {
		t.Fatalf("search hx-swap = %q, want outerHTML so the returned list replaces the old one", got)
	}
}

func TestListPageCarriesNoOutOfBandMarkup(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	doc := listDocument(t, pool)
	if doc == nil {
		return
	}
	if stray := pageFirst(doc, func(n *html.Node) bool { return pageAttr(n, "hx-swap-oob") != "" }); stray != nil {
		t.Fatalf("page markup carries hx-swap-oob on %q; only SSE row payloads may swap oob", pageAttr(stray, "id"))
	}
}

func TestDetailStockRegionOwnsItsTarget(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog/1", nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	doc := parsePage(t, rec.Body.String())
	if doc == nil {
		return
	}
	region := stockRegion(t, doc)
	if region == nil {
		return
	}
	target := pageFirst(doc, func(n *html.Node) bool { return pageAttr(n, "id") == "stock-1" })
	if target == nil {
		t.Fatal("detail lacks the product stock target")
		return
	}
	if stray := pageFirst(doc, func(n *html.Node) bool { return pageAttr(n, "hx-swap-oob") != "" }); stray != nil {
		t.Fatalf("detail page carries hx-swap-oob on %q; htmx would strip it and the row with it", pageAttr(stray, "id"))
	}
	if !pageWithin(region, target) {
		t.Fatal("the product stock target is outside the region")
	}
	requireRegionOwnsSinkAndToggle(t, doc, region)
}

func TestSearchFragmentReplacesTheWholeList(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	rec := get(t, testRouter(pool), "/catalog/search?q=Gad", htmxHeaders())
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
		return
	}
	body := rec.Body.String()
	trimmed := strings.TrimSpace(body)
	if !strings.HasPrefix(trimmed, `<ul id="results">`) {
		t.Fatalf("fragment starts %q, want the whole results list as its root", trimmed[:min(64, len(trimmed))])
	}
	if n := strings.Count(body, `id="results"`); n != 1 {
		t.Fatalf("fragment holds %d results ids, want exactly one, not a nested duplicate", n)
	}
	if strings.Contains(body, "hx-swap-oob") {
		t.Fatal("search response carries hx-swap-oob; htmx strips nested oob targets and would erase every stock row from its own result")
	}
	if !strings.Contains(body, `id="stock-3"`) {
		t.Fatal("fragment lacks the matching product stock target")
	}
	if n := strings.Count(body, `id="stock-`); n != 1 {
		t.Fatalf("fragment holds %d stock target ids, want exactly the matched one", n)
	}
	if strings.Contains(body, `id="stock-1"`) {
		t.Fatal("fragment carries a stock target the query filtered out")
	}
	if strings.Contains(body, "sse-swap") {
		t.Fatal("fragment duplicates the SSE sink")
	}
	if strings.Contains(body, "data-live-toggle") {
		t.Fatal("fragment duplicates the pause toggle")
	}
}
