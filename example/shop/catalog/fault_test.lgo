package catalog_test

import (
	"errors"
	"strings"
	"testing"

	"github.com/gosuda/spira/example/shop/catalog"
	"github.com/gosuda/spira/fault/faulttest"
)

func TestCatalogUnknownProductStaysClientSafe(t *testing.T) {
	const secret = "SECRET-CATALOG-73019"
	raw := faulttest.PublicJSON(t, catalog.ErrUnknownProduct.Wrap(errors.New(secret)))
	faulttest.RefuseLeak(t, raw, secret)
	if !strings.Contains(string(raw), `"catalog.unknown_product"`) {
		t.Fatalf("public view %s lacks the fault code", raw)
	}
	if !strings.Contains(string(raw), "The product was not found.") {
		t.Fatalf("public view %s lacks the constant message", raw)
	}
}
