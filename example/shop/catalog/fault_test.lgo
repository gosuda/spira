package catalog_test

import (
	"encoding/json"
	"errors"
	"maps"
	"net/http"
	"strings"
	"testing"

	"github.com/gosuda/spira/example/shop/catalog"
	"github.com/gosuda/spira/fault/faulttest"
	"github.com/gosuda/spira/web"
)

const catalogProbeCause = "SECRET-CATALOG-73019\n<catalog-probe data-value=\"untrusted\">"

func TestCatalogUnknownProductStaysClientSafe(t *testing.T) {
	wrapped := catalog.ErrUnknownProduct.Wrap(errors.New(catalogProbeCause))
	if !strings.Contains(wrapped.Error(), catalogProbeCause) {
		t.Fatalf("operator diagnostic %q lost its cause", wrapped.Error())
		return
	}
	assertCatalogPublic(t, faulttest.PublicJSON(t, wrapped))
}

func TestCatalogWrappedFaultHTTPHidesCause(t *testing.T) {
	router := web.NewRouter()
	router.Handle(http.MethodGet, "/catalog-fault", func(_ *web.Context) (web.Reply, error) {
		return nil, catalog.ErrUnknownProduct.Wrap(errors.New(catalogProbeCause))
	})
	response := get(t, router, "/catalog-fault", nil)
	if response.Code != http.StatusNotFound {
		t.Fatalf("wrapped fault status = %d, want 404", response.Code)
		return
	}
	assertCatalogPublic(t, response.Body.Bytes())
}

func TestCatalogMissingProductReturnsSafeNotFound(t *testing.T) {
	pool := openPool(t)
	if pool == nil {
		return
	}
	router := testRouter(pool)
	missing := get(t, router, "/catalog/999", nil)
	if missing.Code != http.StatusNotFound {
		t.Fatalf("missing status = %d, want 404", missing.Code)
		return
	}
	assertCatalogPublic(t, missing.Body.Bytes())
}

func assertCatalogPublic(t *testing.T, raw []byte) {
	t.Helper()
	faulttest.RefuseLeak(t, raw, "SECRET-CATALOG-73019", "catalog-probe", "untrusted")
	var problem map[string]string
	if err := json.Unmarshal(raw, &problem); err != nil {
		t.Fatalf("decode missing product fault: %v", err)
		return
	}
	want := map[string]string{
		"code":    "catalog.unknown_product",
		"message": "The product was not found.",
	}
	if !maps.Equal(problem, want) {
		t.Fatalf("missing product fault = %v, want only %v", problem, want)
		return
	}
}
