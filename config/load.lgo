package config

import (
	"comptime"
	"errors"
	"fmt"
	"strconv"
	"strings"
	"time"
)

type Loader struct {
	sources []Source
	missing []string
	errs    []error
}

func NewLoader(sources []Source) *Loader {
	return &Loader{sources: sources}
}

func (l *Loader) Key(prefix string, name string, tag string) string {
	return joinKey(prefix, name, tag)
}

func (l *Loader) Set(dst any, key string, required bool) {
	set := setterOf(dst)
	if set == nil {
		l.errs = append(l.errs, fmt.Errorf("config: %s: unsupported type", key))
		return
	}
	l.ReadField(key, required, set)
}

func (l *Loader) ReadField(key string, required bool, set func(raw string) error) {
	raw, found := l.lookup(key)
	if !found {
		if required {
			l.missing = append(l.missing, key)
		}
		return
	}
	if err := set(raw); err != nil {
		l.errs = append(l.errs, fmt.Errorf("config: %s: %w", key, err))
	}
}

func (l *Loader) Err() error {
	if len(l.errs) > 0 {
		return errors.Join(l.errs...)
	}
	if len(l.missing) > 0 {
		return fmt.Errorf("config: missing keys: %s", strings.Join(l.missing, ", "))
	}
	return nil
}

func (l *Loader) lookup(key string) (string, bool) {
	for _, src := range l.sources {
		if v := src.Lookup(key); v != nil {
			return v ?? "", true
		}
	}
	return "", false
}

func Load[T any](sources ...Source) (T, error) {
	var out T
	const if comptime.IsStruct[T]() {
		ld := NewLoader(sources)
		Fill[T](ld, &out, "")
		if err := ld.Err(); err != nil {
			var zero T
			return zero, err
		}
	} else {
		return out, errors.New("config: Load needs a struct")
	}
	return out, nil
}

func Fill[S any](ld *Loader, dst *S, prefix string) {
	const for _, f := range comptime.Fields[S]() {
		key := ld.Key(prefix, f.Name, f.Tag.Get("env"))
		FillField[f.Type](ld, &dst.[f], key, f.Tag.Get("required") == "true")
	}
}

func FillField[F any](ld *Loader, dst *F, key string, required bool) {
	const if comptime.IsStruct[F]() {
		Fill[F](ld, dst, key)
	} else {
		const switch F {
		case time.Duration:
			ld.ReadField(key, required, func(raw string) error {
				v := time.ParseDuration(raw)?
				*dst = v
				return nil
			})
		case string:
			ld.ReadField(key, required, func(raw string) error {
				*dst = raw
				return nil
			})
		case bool:
			ld.ReadField(key, required, func(raw string) error {
				v := strconv.ParseBool(raw)?
				*dst = v
				return nil
			})
		case ~float64:
			ld.ReadField(key, required, func(raw string) error {
				return SetFloat64(dst, raw)
			})
		case []string:
			ld.ReadField(key, required, func(raw string) error {
				*dst = SplitList(raw)
				return nil
			})
		case any:
			ld.ReadField(key, required, func(raw string) error {
				return ParseIntegerField[F](dst, raw)
			})
		}
	}
}

func ParseIntegerField[F any](dst *F, raw string) error {
	const switch F {
	case ~int:
		return SetSigned(dst, raw, strconv.IntSize)
	case ~int8:
		return SetSigned(dst, raw, 8)
	case ~int16:
		return SetSigned(dst, raw, 16)
	case ~int32:
		return SetSigned(dst, raw, 32)
	case ~int64:
		return SetSigned(dst, raw, 64)
	case ~uint:
		return SetUnsigned(dst, raw, strconv.IntSize)
	case ~uint8:
		return SetUnsigned(dst, raw, 8)
	case ~uint16:
		return SetUnsigned(dst, raw, 16)
	case ~uint32:
		return SetUnsigned(dst, raw, 32)
	case ~uint64:
		return SetUnsigned(dst, raw, 64)
	case any:
		comptime.Error("config: unsupported field type")
	}
	return nil
}

type setter func(raw string) error

func setterOf(dst any) setter {
	switch d := dst.(type) {
	case *string:
		return func(raw string) error {
			*d = raw
			return nil
		}
	case *[]string:
		return func(raw string) error {
			*d = SplitList(raw)
			return nil
		}
	case *bool:
		return parsed(d, strconv.ParseBool)
	case *time.Duration:
		return parsed(d, time.ParseDuration)
	case *float64:
		return func(raw string) error {
			return SetFloat64(d, raw)
		}
	}
	return integerSetter(dst)
}

func integerSetter(dst any) setter {
	switch d := dst.(type) {
	case *int:
		return signedSetter(d, strconv.IntSize)
	case *int8:
		return signedSetter(d, 8)
	case *int16:
		return signedSetter(d, 16)
	case *int32:
		return signedSetter(d, 32)
	case *int64:
		return signedSetter(d, 64)
	case *uint:
		return unsignedSetter(d, strconv.IntSize)
	case *uint8:
		return unsignedSetter(d, 8)
	case *uint16:
		return unsignedSetter(d, 16)
	case *uint32:
		return unsignedSetter(d, 32)
	case *uint64:
		return unsignedSetter(d, 64)
	}
	return nil
}

func parsed[V any](dst *V, parse func(raw string) (V, error)) setter {
	return func(raw string) error {
		v, err := parse(raw)
		if err != nil {
			return err
		}
		*dst = v
		return nil
	}
}

type signed interface {
	~int | ~int8 | ~int16 | ~int32 | ~int64
}

type unsigned interface {
	~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64
}

func signedSetter[E signed](dst *E, bits int) setter {
	return func(raw string) error {
		return SetSigned(dst, raw, bits)
	}
}

func unsignedSetter[E unsigned](dst *E, bits int) setter {
	return func(raw string) error {
		return SetUnsigned(dst, raw, bits)
	}
}

func SetSigned[E signed](dst *E, raw string, bits int) error {
	v := strconv.ParseInt(raw, 10, bits)?
	*dst = E(v)
	return nil
}

func SetUnsigned[E unsigned](dst *E, raw string, bits int) error {
	v := strconv.ParseUint(raw, 10, bits)?
	*dst = E(v)
	return nil
}

func SetFloat64[F ~float64](dst *F, raw string) error {
	v := strconv.ParseFloat(raw, 64)?
	*dst = F(v)
	return nil
}

func SplitList(raw string) []string {
	var parts []string
	for _, p := range strings.Split(raw, ",") {
		if trimmed := strings.TrimSpace(p); trimmed != "" {
			parts = append(parts, trimmed)
		}
	}
	return parts
}
