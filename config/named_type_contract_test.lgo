package config_test

import (
	"errors"
	"strconv"
	"strings"
	"testing"

	"github.com/gosuda/spira/config"
)

type numericOffset int

type numericRatio float64

type namedNumericConfig struct {
	Offset numericOffset
	Ratio  numericRatio
}

type builtinNumericConfig struct {
	Offset int
	Ratio  float64
}

func TestLoadNamedNumericTypes(t *testing.T) {
	t.Parallel()
	src := config.Map(map[string]string{"OFFSET": "-17", "RATIO": "2.75"})
	control, err := config.Load[builtinNumericConfig](src)
	if err != nil {
		t.Fatalf("Load with builtin numeric fields: %v", err)
		return
	}
	if control.Offset != -17 || control.Ratio != 2.75 {
		t.Fatalf("Load with builtin numeric fields = %+v, want Offset=-17 Ratio=2.75", control)
	}

	got, err := config.Load[namedNumericConfig](src)
	if err != nil {
		t.Fatalf("Load with named numeric fields: %v", err)
		return
	}
	if got.Offset != numericOffset(-17) || got.Ratio != numericRatio(2.75) {
		t.Fatalf("Load with named numeric fields = %+v, want Offset=-17 Ratio=2.75", got)
	}
}

func TestLoadNamedNumericTypesReportParseErrors(t *testing.T) {
	t.Parallel()
	cases := []struct {
		key   string
		value string
	}{
		{"OFFSET", "3.5"},
		{"RATIO", "2.75x"},
	}
	for _, c := range cases {
		values := map[string]string{"OFFSET": "-17", "RATIO": "2.75"}
		values[c.key] = c.value
		_, err := config.Load[namedNumericConfig](config.Map(values))
		if err == nil || !errors.Is(err, strconv.ErrSyntax) || !strings.HasPrefix(err.Error(), "config: "+c.key+": ") {
			t.Errorf("Load with %s=%q error = %v, want syntax error wrapped for %s", c.key, c.value, err, c.key)
		}
	}
}
