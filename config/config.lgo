package config

import (
	"context"
	"encoding/json/jsontext"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"net/http"
	"os"
	"strings"
	"time"
)

type Source interface {
	Lookup(key string) string?
}

type envSource struct{}

func (s envSource) Lookup(key string) string? {
	v, ok := os.LookupEnv(key)
	if !ok {
		var none string?
		return none
	}
	return v
}

type mapSource struct {
	values map[string]string
}

func (s mapSource) Lookup(key string) string? {
	return s.values[key]
}

func Env() Source {
	return envSource{}
}

func Map(values const map[string]string) Source {
	copied := make(map[string]string, len(values))
	for k, v := range values {
		copied[k] = v
	}
	return mapSource{values: copied}
}

func File(path string) (Source, error) {
	body, err := os.ReadFile(path)
	if err != nil {
		return mapSource{}, fmt.Errorf("config: file %q: %w", path, err)
	}
	values, err := decodeObject(body)
	if err != nil {
		return mapSource{}, fmt.Errorf("config: file %q: %w", path, err)
	}
	return mapSource{values: values}, nil
}

const remoteTimeout = 10 * time.Second
const remoteLimit = 1 << 20

func Remote(ctx context.Context, url string) (Source, error) {
	ctx, cancel := context.WithTimeout(ctx, remoteTimeout)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
	if err != nil {
		return mapSource{}, fmt.Errorf("config: remote %q: %w", url, err)
	}
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return mapSource{}, fmt.Errorf("config: remote %q: %w", url, err)
	}
	defer resp.Body.Close()?
	if resp.StatusCode != http.StatusOK {
		return mapSource{}, fmt.Errorf("config: remote %q: status %d", url, resp.StatusCode)
	}
	body, err := io.ReadAll(io.LimitReader(resp.Body, remoteLimit+1))
	if len(body) > remoteLimit {
		return mapSource{}, fmt.Errorf("config: remote %q: body exceeds %d bytes", url, remoteLimit)
	}
	if err != nil {
		return mapSource{}, fmt.Errorf("config: remote %q: %w", url, err)
	}
	values, err := decodeObject(body)
	if err != nil {
		return mapSource{}, fmt.Errorf("config: remote %q: %w", url, err)
	}
	return mapSource{values: values}, nil
}

const profileEnv = "SPIRA_PROFILE"

func Profile() string {
	if v := os.Getenv(profileEnv); v != "" {
		return v
	}
	return "dev"
}

func decodeObject(body []byte) (map[string]string, error) {
	var parsed map[string]jsontext.Value
	if err := json.Unmarshal(body, &parsed); err != nil {
		return nil, fmt.Errorf("parse: %w", err)
	}
	if parsed == nil {
		return nil, errors.New("document is not a JSON object")
	}
	values := make(map[string]string, len(parsed))
	if err := flattenMembers("", parsed, values); err != nil {
		return nil, err
	}
	return values, nil
}

func flattenMembers(prefix string, m map[string]jsontext.Value, out map[string]string) error {
	for k, v := range m {
		key := k
		if prefix != "" {
			key = prefix + "_" + k
		}
		if err := flattenValue(key, v, out); err != nil {
			return err
		}
	}
	return nil
}

func flattenValue(key string, v jsontext.Value, out map[string]string) error {
	upper := strings.ToUpper(key)
	switch v.Kind() {
	case jsontext.KindBeginObject:
		var child map[string]jsontext.Value
		if err := json.Unmarshal(v, &child); err != nil {
			return fmt.Errorf("%s: %w", upper, err)
		}
		return flattenMembers(key, child, out)
	case jsontext.KindNull:
		return nil
	case jsontext.KindString:
		var s string
		if err := json.Unmarshal(v, &s); err != nil {
			return fmt.Errorf("%s: %w", upper, err)
		}
		return setOnce(out, upper, s)
	case jsontext.KindBeginArray:
		return fmt.Errorf("%s: array value", upper)
	}
	return setOnce(out, upper, string(v))
}

func setOnce(out map[string]string, key string, value string) error {
	if _, held := out[key]; held {
		return fmt.Errorf("%s: duplicate key", key)
	}
	out[key] = value
	return nil
}
