package migrate_test

import (
	"errors"
	"os"
	"testing"
	"testing/fstest"

	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/fault/faulttest"
	"github.com/gosuda/spira/migrate"
)

func TestFaultUnavailable(t *testing.T) {
	_, err := migrate.Load(os.DirFS("/nonexistent-fault-dir"))
	if !errors.Is(err, migrate.ErrUnavailable) {
		t.Fatalf("Load error = %v, want migrate.ErrUnavailable", err)
		return
	}
	pool, oerr := db.Open("sqlite", dsnFor(t))
	if oerr != nil {
		t.Fatalf("Open: %v", oerr)
		return
	}
	if pool == nil {
		t.Fatal("Open returned no pool")
		return
	}
	if serr := pool.Start(t.Context()); serr != nil {
		t.Fatalf("Start: %v", serr)
		return
	}
	if serr := pool.Stop(t.Context()); serr != nil {
		t.Fatalf("Stop: %v", serr)
		return
	}
	steps := loadSteps(t, "good")
	err = migrate.Apply(t.Context(), pool, steps)
	if !errors.Is(err, migrate.ErrUnavailable) {
		t.Fatalf("Apply error = %v, want migrate.ErrUnavailable", err)
		return
	}
}

func TestFaultsMatchSpecTable(t *testing.T) {
	faulttest.CheckTable(t, "../docs/specs/migrate.md", migrate.Faults())
}

func TestFaultPublicHidesSecretsAndHostile(t *testing.T) {
	hostile := "<script>alert(1)</script>"
	secret := "sk-live-secret-value"
	fsys := fstest.MapFS{
		hostile + ".up.sql": &fstest.MapFile{Data: []byte("CREATE TABLE h (id integer)")},
	}
	_, lerr := migrate.Load(fsys)
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, lerr), hostile)
	pool := openPool(t)
	steps := loadSteps(t, "good")
	if aerr := migrate.Apply(t.Context(), pool, steps); aerr != nil {
		t.Fatalf("Apply: %v", aerr)
		return
	}
	renamed := []migrate.Step{{Name: hostile, Up: steps[0].Up, Down: steps[0].Down}, steps[1]}
	oerr := migrate.Apply(t.Context(), pool, renamed)
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, oerr), hostile)
	bad := []migrate.Step{steps[0], steps[1], {Name: "0003_bad", Up: "SELECT * FROM " + secret, Down: "SELECT 1"}}
	uerr := migrate.Apply(t.Context(), pool, bad)
	if !errors.Is(uerr, db.ErrStatementFailed) {
		t.Fatalf("Apply error = %v, want db.ErrStatementFailed", uerr)
		return
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, uerr), secret)
}
