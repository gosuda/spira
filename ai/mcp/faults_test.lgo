func TestMCPFaultParseError(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":`, nil)
	if status != http.StatusBadRequest {
		t.Fatalf("status %d, body %s", status, raw)
		return
	}
	e := wireError(t, raw)
	if e == nil {
		return
	}
	if e.Code != -32700 {
		t.Errorf("code %d, want -32700", e.Code)
	}
	if string(e.Data) != `{"code":"mcp.parse_error"}` {
		t.Errorf("data %s, want the mcp.parse_error fault code", e.Data)
	}
}

