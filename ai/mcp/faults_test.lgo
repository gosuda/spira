func TestMCPFaultUnknownTool(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	hostile := "<script>alert(1)</script>"
	_, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"`+hostile+`","arguments":{}}}`, nil)
	e := wireError(t, raw)
	if e == nil {
		return
	}
	if e.Code != -32602 {
		t.Errorf("code %d, want -32602", e.Code)
	}
	if e.Message != "Unknown tool" {
		t.Errorf("message %q, want the constant text with no tool name", e.Message)
	}
	if string(e.Data) != `{"code":"mcp.unknown_tool"}` {
		t.Errorf("data %s, want the mcp.unknown_tool fault code", e.Data)
	}
	faulttest.RefuseLeak(t, raw, hostile)
}

func TestMCPFaultToolFailed(t *testing.T) {
	secret := "sk-live-9f2secret"
	tools := []ai.Tool{
		{
			Name:   "broken",
			Schema: `{"type":"object"}`,
			Call: func(_ context.Context, _ string) (string, error) {
				return "", errors.New("provider said no: " + secret)
			},
		},
	}
	ts := mountServer(t, tools, (&countingGuard{}).stage())
	_, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"broken","arguments":{}}}`, nil)
	env := decodeEnvelope(t, raw)
	if env.Error != nil {
		t.Fatalf("protocol error %+v, want result", env.Error)
		return
	}
	var result struct {
		Content []struct {
			Text string `json:"text"`
		} `json:"content"`
		IsError bool `json:"isError"`
	}
	if err := json.Unmarshal(env.Result, &result); err != nil {
		t.Fatalf("decode result: %v", err)
		return
	}
	if !result.IsError {
		t.Error("isError false, want true")
	}
	if len(result.Content) != 1 || result.Content[0].Text != "The tool call failed." {
		t.Errorf("content %+v, want the constant mcp.tool_failed text", result.Content)
	}
	faulttest.RefuseLeak(t, raw, secret)
}

func TestMCPFaultProtocolError(t *testing.T) {
	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		if _, err := w.Write([]byte(`{"jsonrpc":"2.0","id":1,"error":{"code":-32602,"message":"Unknown tool: x"}}`)); err != nil {
			return
		}
	}))
	defer ts.Close()
	c := mcp.NewClient(mcp.NewHTTP(ts.URL, ts.Client()))
	defer func() {
		if err := c.Close(); err != nil {
			t.Errorf("close client: %v", err)
		}
	}()
	_, err := c.Call(context.Background(), "x", "{}")
	if !errors.Is(err, mcp.ErrProtocolError) {
		t.Fatalf("error = %v, want the mcp.protocol_error fault", err)
		return
	}
	rpcErr := &mcp.RPCError{}
	if !errors.As(err, &rpcErr) || rpcErr.Code != -32602 {
		t.Fatalf("error = %v, want the wire code behind errors.As", err)
	}
}

func TestMCPFaultUpstreamFailed(t *testing.T) {
	secret := "sk-live-7q1secret"
	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		http.Error(w, "provider said no: "+secret, http.StatusBadGateway)
	}))
	defer ts.Close()
	c := mcp.NewClient(mcp.NewHTTP(ts.URL, ts.Client()))
	defer func() {
		if err := c.Close(); err != nil {
			t.Errorf("close client: %v", err)
		}
	}()
	_, err := c.Call(context.Background(), "get_weather", "{}")
	if !errors.Is(err, mcp.ErrUpstreamFailed) {
		t.Fatalf("error = %v, want the mcp.upstream_failed fault", err)
		return
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, err), secret)
	if strings.Contains(err.Error(), secret) {
		t.Fatalf("the operator chain carries the upstream body: %v", err)
	}
}

func TestMCPFaultTransportFailed(t *testing.T) {
	r, w := io.Pipe()
	s := mcp.NewStdio(r, io.Discard)
	defer func() {
		if err := s.Close(); err != nil {
			t.Errorf("close stdio: %v", err)
		}
	}()
	defer func() {
		if err := w.Close(); err != nil {
			t.Errorf("close pipe write: %v", err)
		}
	}()
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	_, err := s.Request(ctx, mcp.Envelope{JSONRPC: "2.0", Method: "tools/list"})
	if !errors.Is(err, mcp.ErrTransportFailed) {
		t.Fatalf("error = %v, want the mcp.transport_failed fault", err)
		return
	}
	if !errors.Is(err, context.Canceled) {
		t.Fatalf("error = %v, want the context cause behind errors.Is", err)
	}
}
