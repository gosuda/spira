package mcp_test

import (
	"context"
	"encoding/json"
	"errors"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gosuda/spira/ai"
	"github.com/gosuda/spira/ai/mcp"
	"github.com/gosuda/spira/fault/faulttest"
)

func TestMCPFaultsMatchSpecTable(t *testing.T) {
	faulttest.CheckTable(t, "../../docs/specs/ai-mcp.md", mcp.Faults())
}

func wireError(t *testing.T, raw []byte) *mcp.RPCError? {
	t.Helper()
	env := decodeEnvelope(t, raw)
	if env.Error == nil {
		t.Fatalf("no protocol error in %s", raw)
		return nil
	}
	return env.Error
}

func TestMCPFaultForbiddenOrigin(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	_, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":1,"method":"tools/list"}`, map[string]string{"Origin": "https://evil.example"})
	e := wireError(t, raw)
	if e == nil {
		return
	}
	if e.Code != -32000 {
		t.Errorf("code %d, want -32000", e.Code)
	}
	if string(e.Data) != `{"code":"mcp.forbidden_origin"}` {
		t.Errorf("data %s, want the mcp.forbidden_origin fault code", e.Data)
	}
	if calls != 0 {
		t.Errorf("tool ran %d times, want none", calls)
	}
}

