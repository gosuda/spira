package mcp_test

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"encoding/json/jsontext"

	"github.com/gosuda/spira/ai"
	"github.com/gosuda/spira/ai/mcp"
	"github.com/gosuda/spira/web"
)

type countingGuard struct {
	deny bool
	seen int
}

func (g *countingGuard) stage() web.Stage {
	return func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			g.seen++
			if g.deny {
				return web.Data{Value: map[string]string{"error": "denied"}, Status: http.StatusUnauthorized}, nil
			}
			return next(ctx)
		}
	}
}

func mountServer(t *testing.T, tools []ai.Tool, guard web.Stage) *httptest.Server {
	t.Helper()
	r := web.NewRouter()
	mcp.Mount(r, "/mcp", tools, guard)
	ts := httptest.NewServer(r)
	t.Cleanup(ts.Close)
	return ts
}

func postRaw(t *testing.T, ts *httptest.Server, body string, headers map[string]string) (int, []byte) {
	t.Helper()
	req, err := http.NewRequest("POST", ts.URL+"/mcp", bytes.NewReader([]byte(body)))
	if err !=nil {
		t.Fatalf("new request: %v", err)
		return 0, nil
	}
	req.Header.Set("Content-Type", "application/json")
	for k, v := range headers {
		req.Header.Set(k, v)
	}
	resp, err := ts.Client().Do(req)
	if err != nil {
		t.Fatalf("post: %v", err)
		return 0, nil
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			t.Errorf("close body: %v", cerr)
		}
	}()
	raw, err := io.ReadAll(resp.Body)
	if err != nil {
		t.Fatalf("read body: %v", err)
		return 0, nil
	}
	return resp.StatusCode, raw
}

func postFixture(t *testing.T, ts *httptest.Server, name string) (int, []byte) {
	t.Helper()
	return postRaw(t, ts, string(fixture(t, name)), nil)
}

type serverEnvelope struct {
	JSONRPC string          `json:"jsonrpc"`
	ID      jsontext.Value  `json:"id"`
	Result  json.RawMessage `json:"result"`
	Error   *mcp.RPCError?  `json:"error"`
}

func decodeEnvelope(t *testing.T, raw []byte) serverEnvelope {
	t.Helper()
	var env serverEnvelope
	if err := json.Unmarshal(raw, &env); err != nil {
		t.Fatalf("decode envelope %s: %v", raw, err)
		return serverEnvelope{}
	}
	return env
}

func testTools(t *testing.T, calls *int) []ai.Tool {
	t.Helper()
	return []ai.Tool{
		{
			Name:        "get_weather",
			Description: "Get current weather information for a location",
			Schema:      `{"type":"object","properties":{"location":{"type":"string"}},"required":["location"]}`,
			Call: func(_ context.Context, _ string) (string, error) {
				*calls++
				return weatherText, nil
			},
		},
	}
}

func TestMountInitialize(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postFixture(t, ts, "lifecycle/initialize-request.json")
	if status != http.StatusOK {
		t.Fatalf("status %d, body %s", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	if env.JSONRPC != "2.0" {
		t.Errorf("jsonrpc %q", env.JSONRPC)
	}
	if string(env.ID) != "1" {
		t.Errorf("id %s, want 1", env.ID)
	}
	var result struct {
		ProtocolVersion string `json:"protocolVersion"`
		Capabilities    struct {
			Tools struct {
				ListChanged bool `json:"listChanged"`
			} `json:"tools"`
		} `json:"capabilities"`
		ServerInfo struct {
			Name    string `json:"name"`
			Version string `json:"version"`
		} `json:"serverInfo"`
	}
	if err := json.Unmarshal(env.Result, &result); err != nil {
		t.Fatalf("decode result: %v", err)
		return
	}
	if result.ProtocolVersion != "2025-11-25" {
		t.Errorf("protocolVersion %q", result.ProtocolVersion)
	}
	if result.Capabilities.Tools.ListChanged {
		t.Error("capabilities.tools.listChanged is true, want false")
	}
	if result.ServerInfo.Name == "" || result.ServerInfo.Version == "" {
		t.Errorf("serverInfo %+v", result.ServerInfo)
	}
}

func TestMountToolsList(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":2,"method":"tools/list"}`, nil)
	if status != http.StatusOK {
		t.Fatalf("status %d, body %s", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	var result struct {
		Tools []struct {
			Name        string         `json:"name"`
			Description string         `json:"description"`
			InputSchema jsontext.Value `json:"inputSchema"`
		} `json:"tools"`
		NextCursor string `json:"nextCursor"`
	}
	if err := json.Unmarshal(env.Result, &result); err != nil {
		t.Fatalf("decode result: %v", err)
		return
	}
	if len(result.Tools) != 1 {
		t.Fatalf("tools %d, want 1", len(result.Tools))
		return
	}
	tool := result.Tools[0]
	if tool.Name != "get_weather" {
		t.Errorf("name %q", tool.Name)
	}
	if tool.Description != "Get current weather information for a location" {
		t.Errorf("description %q", tool.Description)
	}
	if !strings.Contains(string(tool.InputSchema), `"location"`) {
		t.Errorf("inputSchema %s", tool.InputSchema)
	}
	if result.NextCursor != "" {
		t.Errorf("nextCursor %q, want absent", result.NextCursor)
	}
}

func TestMountCall(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postFixture(t, ts, "tools/tools-call-request.json")
	if status != http.StatusOK {
		t.Fatalf("status %d, body %s", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	var result struct {
		Content []struct {
			Type string `json:"type"`
			Text string `json:"text"`
		} `json:"content"`
		IsError bool `json:"isError"`
	}
	if err := json.Unmarshal(env.Result, &result); err != nil {
		t.Fatalf("decode result: %v", err)
		return
	}
	if calls != 1 {
		t.Errorf("tool calls %d, want 1", calls)
	}
	if len(result.Content) != 1 || result.Content[0].Type != "text" {
		t.Fatalf("content %+v", result.Content)
		return
	}
	if result.Content[0].Text != weatherText {
		t.Errorf("text %q, want %q", result.Content[0].Text, weatherText)
	}
	if result.IsError {
		t.Error("isError true")
	}
}

func TestMountCallToolError(t *testing.T) {
	tools := []ai.Tool{
		{
			Name:   "broken",
			Schema: `{"type":"object"}`,
			Call: func(_ context.Context, _ string) (string, error) {
				return "", errors.New("upstream exploded")
			},
		},
	}
	ts := mountServer(t, tools, (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"broken","arguments":{}}}`, nil)
	if status != http.StatusOK {
		t.Fatalf("status %d, body %s", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	var result struct {
		Content []struct {
			Text string `json:"text"`
		} `json:"content"`
		IsError bool `json:"isError"`
	}
	if err := json.Unmarshal(env.Result, &result); err != nil {
		t.Fatalf("decode result: %v", err)
		return
	}
	if !result.IsError {
		t.Error("isError false, want true")
	}
	if len(result.Content) != 1 || result.Content[0].Text != "The tool call failed." {
		t.Errorf("content %+v, want the constant mcp.tool_failed text", result.Content)
	}
	if env.Error != nil {
		t.Errorf("protocol error %+v, want result", env.Error)
	}
}

func TestMountUnknownTool(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"invalid_tool_name","arguments":{}}}`, nil)
	if status != http.StatusOK {
		t.Fatalf("status %d, body %s", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	e := env.Error
	if e == nil {
		t.Fatalf("no error in %s", raw)
		return
	}
	if e.Code != -32602 {
		t.Errorf("code %d, want -32602", e.Code)
	}
	if e.Message != "Unknown tool" {
		t.Errorf("message %q, want the constant text with no tool name", e.Message)
	}
	if string(e.Data) != `{"code":"mcp.unknown_tool"}` {
		t.Errorf("data %s, want the mcp.unknown_tool fault code", e.Data)
	}
	if string(env.ID) != "9" {
		t.Errorf("id %s, want 9", env.ID)
	}
}

func TestMountOrigin(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	host := strings.TrimPrefix(ts.URL, "http://")
	for _, tc := range []struct {
		origin string
		want   int
	}{
		{"https://evil.example", http.StatusForbidden},
		{"null", http.StatusForbidden},
		{"http://" + host, http.StatusOK},
		{"", http.StatusOK},
	} {
		headers := map[string]string{}
		if tc.origin != "" {
			headers["Origin"] = tc.origin
		}
		status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":1,"method":"tools/list"}`, headers)
		if status != tc.want {
			t.Errorf("origin %q: status %d, want %d (body %s)", tc.origin, status, tc.want, raw)
		}
	}
}

func TestMountProtocolVersion(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	body := `{"jsonrpc":"2.0","id":1,"method":"tools/list"}`
	for _, tc := range []struct {
		version string
		want    int
	}{
		{"2024-11-05", http.StatusBadRequest},
		{"2025-03-26", http.StatusBadRequest},
		{"2025-11-25", http.StatusOK},
		{"", http.StatusOK},
	} {
		headers := map[string]string{}
		if tc.version != "" {
			headers["MCP-Protocol-Version"] = tc.version
		}
		status, raw := postRaw(t, ts, body, headers)
		if status != tc.want {
			t.Errorf("version %q: status %d, want %d (body %s)", tc.version, status, tc.want, raw)
		}
	}
}

func TestMountGuard(t *testing.T) {
	toolCalls := 0
	tools := []ai.Tool{
		{
			Name:   "get_weather",
			Schema: `{"type":"object"}`,
			Call: func(_ context.Context, _ string) (string, error) {
				toolCalls++
				return weatherText, nil
			},
		},
	}
	guard := &countingGuard{deny: true}
	ts := mountServer(t, tools, guard.stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"get_weather","arguments":{}}}`, nil)
	if status != http.StatusUnauthorized {
		t.Fatalf("status %d, want 401 (body %s)", status, raw)
		return
	}
	if guard.seen != 1 {
		t.Errorf("guard seen %d, want 1", guard.seen)
	}
	if toolCalls != 0 {
		t.Errorf("tool called %d times, want 0", toolCalls)
	}
}

func TestMountNotification(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postFixture(t, ts, "lifecycle/initialized-notification.json")
	if status != http.StatusAccepted {
		t.Fatalf("status %d, want 202 (body %s)", status, raw)
		return
	}
	if len(raw) != 0 {
		t.Errorf("body %q, want empty", raw)
	}
}

func TestMountMalformed(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{`, nil)
	if status != http.StatusBadRequest {
		t.Fatalf("status %d, want 400 (body %s)", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	e := env.Error
	if e == nil {
		t.Errorf("no error in %s, want -32700", raw)
		return
	}
	if e.Code != -32700 {
		t.Errorf("code %d, want -32700", e.Code)
	}
}

func TestMountUnknownMethod(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":5,"method":"bogus/method"}`, nil)
	if status != http.StatusOK {
		t.Fatalf("status %d, want 200 (body %s)", status, raw)
		return
	}
	env := decodeEnvelope(t, raw)
	e := env.Error
	if e == nil {
		t.Errorf("no error in %s, want -32601", raw)
		return
	}
	if e.Code != -32601 {
		t.Errorf("code %d, want -32601", e.Code)
	}
	if string(env.ID) != "5" {
		t.Errorf("id %s, want 5", env.ID)
	}
}

func TestMountClientServer(t *testing.T) {
	var calls int
	ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
	c := mcp.NewClient(mcp.NewHTTP(ts.URL+"/mcp", ts.Client()))
	defer func() {
		if cerr := c.Close(); cerr != nil {
			t.Errorf("close client: %v", cerr)
		}
	}()
	ctx := context.Background()
	if err := c.Initialize(ctx); err != nil {
		t.Fatalf("initialize: %v", err)
		return
	}
	tools, err := c.Tools(ctx)
	if err != nil {
		t.Fatalf("tools: %v", err)
		return
	}
	if len(tools) != 1 || tools[0].Name != "get_weather" {
		t.Fatalf("tools %+v", tools)
		return
	}
	text, err := c.Call(ctx, "get_weather", `{"location":"New York"}`)
	if err != nil {
		t.Fatalf("call: %v", err)
		return
	}
	if text != weatherText {
		t.Errorf("text %q, want %q", text, weatherText)
	}
	if calls != 1 {
		t.Errorf("tool calls %d, want 1", calls)
	}
}

func TestMountCallNonObjectArguments(t *testing.T) {
	for _, args := range []string{"null", "[1,2]", "5", `"x"`} {
		var calls int
		ts := mountServer(t, testTools(t, &calls), (&countingGuard{}).stage())
		status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":11,"method":"tools/call","params":{"name":"get_weather","arguments":`+args+`}}`, nil)
		if status != http.StatusOK {
			t.Fatalf("arguments %s: status %d, body %s", args, status, raw)
		}
		env := decodeEnvelope(t, raw)
		rpcErr := env.Error
		if rpcErr == nil {
			t.Errorf("arguments %s: no error, want invalid params", args)
			continue
		}
		if rpcErr.Code != -32602 {
			t.Errorf("arguments %s: error code %d, want -32602", args, rpcErr.Code)
			continue
		}
		if rpcErr.Message != "Invalid params" {
			t.Errorf("arguments %s: message %q, want Invalid params", args, rpcErr.Message)
		}
		if calls != 0 {
			t.Errorf("arguments %s: tool ran %d times, want none", args, calls)
		}
	}
}

func TestClientCallNonObjectArguments(t *testing.T) {
	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		t.Error("client sent a request with non-object arguments")
	}))
	defer ts.Close()
	c := mcp.NewClient(mcp.NewHTTP(ts.URL, ts.Client()))
	defer func() {
		if err := c.Close(); err != nil {
			t.Errorf("close client: %v", err)
		}
	}()
	for _, args := range []string{"null", "[1,2]", "5", `"x"`} {
		_, err := c.Call(context.Background(), "get_weather", args)
		if err == nil {
			t.Errorf("arguments %s accepted", args)
			continue
		}
		prefix := "mcp: tools/call get_weather arguments:"
		if !strings.Contains(err.Error(), prefix) {
			t.Errorf("arguments %s: error %q does not carry %q", args, err, prefix)
			continue
		}
		if args == "null" && !strings.Contains(err.Error(), "not a JSON object") {
			t.Errorf("arguments null: error %q does not name the shape", err)
		}
	}
}

func TestMountCallEmptyText(t *testing.T) {
	tools := []ai.Tool{
		{
			Name:   "empty",
			Schema: "",
			Call: func(_ context.Context, _ string) (string, error) {
				return "", nil
			},
		},
	}
	ts := mountServer(t, tools, (&countingGuard{}).stage())
	status, raw := postRaw(t, ts, `{"jsonrpc":"2.0","id":12,"method":"tools/call","params":{"name":"empty","arguments":{}}}`, nil)
	if status != http.StatusOK {
		t.Fatalf("status %d, body %s", status, raw)
	}
	if !strings.Contains(string(raw), `"text":""`) {
		t.Errorf("reply %s omits the text member for an empty result", raw)
	}
	env := decodeEnvelope(t, raw)
	var result struct {
		Content []struct {
			Type string `json:"type"`
			Text string `json:"text"`
		} `json:"content"`
	}
	if err := json.Unmarshal(env.Result, &result); err != nil {
		t.Fatalf("decode result: %v", err)
		return
	}
	if len(result.Content) != 1 || result.Content[0].Type != "text" || result.Content[0].Text != "" {
		t.Errorf("content %+v, want one text item with an empty text", result.Content)
	}
}
