package mcp

import (
	"bufio"
	"context"
	"errors"
	"fmt"
	"io"
	"strings"
)

type Stdio struct {
	source io.Reader
	sink   io.Writer
	reader *bufio.Reader
}

func NewStdio(r io.Reader, w io.Writer) *Stdio {
	return &Stdio{source: r, sink: w, reader: bufio.NewReader(r)}
}

func (s *Stdio) Notify(ctx context.Context, msg Envelope) error {
	return s.send(ctx, msg)
}

func (s *Stdio) Request(ctx context.Context, msg Envelope) (Envelope, error) {
	if err := s.send(ctx, msg); err != nil {
		return Envelope{}, err
	}
	want := idKey(msg.ID)
	for {
		if err := ctx.Err(); err != nil {
			return Envelope{}, fmt.Errorf("mcp: stdio: %w", err)
		}
		reply, err := s.nextMessage()
		if err != nil {
			return Envelope{}, err
		}
		if isResponse(reply) && idKey(reply.ID) == want {
			return reply, nil
		}
	}
}

func (s *Stdio) send(ctx context.Context, msg Envelope) error {
	if err := ctx.Err(); err != nil {
		return fmt.Errorf("mcp: stdio: %w", err)
	}
	line, err := encodeEnvelope(msg)
	if err != nil {
		return err
	}
	if _, err := s.sink.Write(append(line, '\n')); err != nil {
		return fmt.Errorf("mcp: stdio write: %w", err)
	}
	return nil
}

func (s *Stdio) nextMessage() (Envelope, error) {
	for {
		line, err := s.reader.ReadString('\n')
		if err != nil {
			return Envelope{}, fmt.Errorf("mcp: stdio read: %w", err)
		}
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		return decodeEnvelope([]byte(line))
	}
}

func (s *Stdio) Close() error {
	var errs []error
	if closer, ok := s.sink.(io.Closer); ok {
		if err := closer.Close(); err != nil {
			errs = append(errs, fmt.Errorf("mcp: stdio close write: %w", err))
		}
	}
	if closer, ok := s.source.(io.Closer); ok {
		if err := closer.Close(); err != nil {
			errs = append(errs, fmt.Errorf("mcp: stdio close read: %w", err))
		}
	}
	return errors.Join(errs...)
}
