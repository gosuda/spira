const ndjsonToolStream = `{"model":"llama3.2","created_at":"2026-01-01T00:00:00Z","message":{"role":"assistant","content":"","thinking":"Need the tool."},"done":false}
{"model":"llama3.2","created_at":"2026-01-01T00:00:00Z","message":{"role":"assistant","content":"","tool_calls":[{"id":"call_1","function":{"name":"getWeather","arguments":{"city":"Seoul"}}}]},"done":false}
{"model":"llama3.2","created_at":"2026-01-01T00:00:00Z","message":{"role":"assistant","content":""},"done_reason":"tool_calls","done":true,"prompt_eval_count":12,"eval_count":34}
`

const ndjsonCutStream = `{"model":"mistral","created_at":"2026-01-01T00:00:00Z","message":{"role":"assistant","content":"Hel"},"done":false}
{"model":"mistral","created_at":"2026-01-01T00:00:00Z","message":{"role":"assistant","content":"lo"},"done":false}
`

const ndjsonOneLine = `{"model":"llama3.2","created_at":"2026-01-01T00:00:00Z","message":{"role":"assistant","content":"Hel"},"done":false}
`

const testMarkerName = "X-Spira-Ollama-Test"

const testMarkerValue = "ollama-test-client"

type markerTripper struct {
	base http.RoundTripper
}

func (m *markerTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	clone := req.Clone(req.Context())
	clone.Header.Set(testMarkerName, testMarkerValue)
	return m.base.RoundTrip(clone)
}

func admitted(r *http.Request) bool {
	return r.Header.Get(testMarkerName) == testMarkerValue
}

func testClient(srv *httptest.Server) *ollama.Client {
	httpClient := srv.Client()
	base := httpClient.Transport
	if base == nil {
		base = http.DefaultTransport
	}
	httpClient.Transport = &markerTripper{base: base}
	return &ollama.Client{
		BaseURL: srv.URL,
		Model:   "llama3.2",
		HTTP:    httpClient,
		Policy:  resilience.Policy{Timeout: 2 * time.Second, Retry: resilience.Retry{Attempts: 3, Base: time.Millisecond, Max: 2 * time.Millisecond}},
	}
}

func serveBody(t *testing.T, status int, contentType string, body string) http.HandlerFunc {
	t.Helper()
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		w.Header().Set("Content-Type", contentType)
		if status != http.StatusOK {
			w.WriteHeader(status)
		}
		if _, err := io.WriteString(w, body); err != nil {
			t.Errorf("server write: %v", err)
		}
	})
}

type request struct {
	body string
	path string
}

type requests struct {
	seen []request
}

func (s *requests) at(i int) request {
	return s.seen[i]
}

type recorder struct {
	state sync.Locked[requests]
}

func (r *recorder) add(req *http.Request, body string) {
	r.state.WithLock(func(s *requests) {
		s.seen = append(s.seen, request{body: body, path: req.URL.Path})
	})
}

func (r *recorder) count() int {
	n := 0
	r.state.WithLock(func(s *requests) { n = len(s.seen) })
	return n
}

func (r *recorder) body(i int) string {
	var got request
	r.state.WithLock(func(s *requests) { got = s.at(i) })
	return got.body
}

func (r *recorder) path(i int) string {
	var got request
	r.state.WithLock(func(s *requests) { got = s.at(i) })
	return got.path
}

func (rec *recorder) serve(t *testing.T, status int, contentType string, body string) *httptest.Server {
	t.Helper()
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		serveBody(t, status, contentType, body)(w, r)
	}))
	t.Cleanup(srv.Close)
	return srv
}

func canonical(t *testing.T, raw []byte) string {
	t.Helper()
	var v any
	if err := json.Unmarshal(raw, &v); err != nil {
		t.Fatalf("canonical: %v", err)
	}
	out, err := json.Marshal(v, json.Deterministic(true))
	if err != nil {
		t.Fatalf("canonical marshal: %v", err)
	}
	return string(out)
}

func sampleRequest() ai.Request {
	return ai.Request{
		Model: "llama3.2",
		Messages: []ai.Message{
			{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Weather in Seoul?"}}},
		},
		Tools: []ai.Tool{{
			Name:        "getWeather",
			Description: "Get the weather for a city",
			Schema:      `{"type":"object","properties":{"city":{"type":"string"}},"required":["city"]}`,
			Call: func(ctx context.Context, arguments string) (string, error) {
				return "{}", nil
			},
		}},
		Temperature: f64(0.7),
		TopK:        i32(40),
	}
}

func wantChatBody(t *testing.T) string {
	t.Helper()
	return canonical(t, []byte(`{"model":"llama3.2","stream":false,"messages":[{"role":"user","content":"Weather in Seoul?"}],"tools":[{"type":"function","function":{"name":"getWeather","description":"Get the weather for a city","parameters":{"type":"object","properties":{"city":{"type":"string"}},"required":["city"]}}}],"options":{"temperature":0.7,"top_k":40}}`))
}

func TestChatRequestBodyMatchesReferenceShape(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", `{"model":"llama3.2","message":{"role":"assistant","content":"hi"},"done":true,"done_reason":"stop"}`)
	c := testClient(srv)
	if _, err := c.Chat(context.Background(), sampleRequest()); err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	if path := rec.path(0); path != "/api/chat" {
		t.Fatalf("path = %q, want /api/chat", path)
	}
	gotJSON, wantJSON := canonical(t, []byte(rec.body(0))), wantChatBody(t)
	if gotJSON != wantJSON {
		t.Fatalf("request body = %s\nwant           = %s", gotJSON, wantJSON)
	}
}

func TestStreamCollectsCompleteToolCall(t *testing.T) {
	srv := httptest.NewServer(serveBody(t, http.StatusOK, "application/x-ndjson", ndjsonToolStream))
	defer srv.Close()
	c := testClient(srv)
	chunks := collectAll(c.Stream(context.Background(), ai.Request{Model: "llama3.2", Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Weather?"}}}}}))
	for i, ch := range chunks {
		t.Logf("chunk %d: %+v err=%v", i, ch.chunk, ch.err)
	}
	reply := collectReply(t, c.Stream(context.Background(), ai.Request{Model: "llama3.2", Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Weather?"}}}}}))
	parts := reply.Message.Parts
	if len(parts) != 2 {
		t.Fatalf("parts = %+v, want reasoning and one tool call", parts)
	}
	reasoning, ok := parts[0].(ai.Reasoning)
	if !ok || reasoning.Text != "Need the tool." {
		t.Fatalf("part 0 = %+v, want Reasoning{Need the tool.}", parts[0])
	}
	call, ok := parts[1].(ai.ToolCall)
	if !ok {
		t.Fatalf("part 1 = %+v, want ToolCall", parts[1])
	}
	if call.ID != "call_1" || call.Name != "getWeather" {
		t.Fatalf("tool call = %+v, want call_1 getWeather", call)
	}
	var args struct {
		City string `json:"city"`
	}
	if err := json.Unmarshal([]byte(call.Arguments), &args); err != nil {
		t.Fatalf("arguments %q is not a JSON object: %v", call.Arguments, err)
	}
	if args.City != "Seoul" {
		t.Fatalf("arguments city = %q, want Seoul", args.City)
	}
	if reply.Finish != ai.FinishToolCall {
		t.Fatalf("finish = %q, want tool_call", reply.Finish)
	}
	if reply.Usage.Input != 12 || reply.Usage.Output != 34 || reply.Usage.Total != 46 {
		t.Fatalf("usage = %+v, want 12/34/46", reply.Usage)
	}
	if reply.Model != "llama3.2" {
		t.Fatalf("model = %q, want llama3.2", reply.Model)
	}
}

func TestStreamCutBeforeDoneYieldsErrorAndNoReply(t *testing.T) {
	srv := httptest.NewServer(serveBody(t, http.StatusOK, "application/x-ndjson", ndjsonCutStream))
	defer srv.Close()
	c := testClient(srv)
	chunks := collectAll(c.Stream(context.Background(), ai.Request{Model: "mistral"}))
	if len(chunks) == 0 {
		t.Fatal("no chunks")
	}
	last := chunks[len(chunks)-1]
	if last.err == nil || !errors.Is(last.err, ollama.ErrProviderStreamCut) {
		t.Fatalf("last error = %v, want stream ended before done", last.err)
	}
	if _, err := ai.Collect(c.Stream(context.Background(), ai.Request{Model: "mistral"})); err == nil {
		t.Fatal("Collect err=nil, want the cut-stream error")
	}
}

func TestStreamCallerCancelYieldsPrefixedCancelError(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		serveBody(t, http.StatusOK, "application/x-ndjson", ndjsonOneLine)(w, r)
		if f, ok := w.(http.Flusher); ok {
			f.Flush()
		}
		<-r.Context().Done()
	}))
	defer srv.Close()
	ctx, cancel := context.WithCancel(context.Background())
	next, stop := iter.Pull2(testClient(srv).Stream(ctx, ai.Request{Model: "llama3.2"}))
	defer stop()
	if _, err, ok := next(); !ok || err != nil {
		t.Fatalf("first chunk err = %v, want the data chunk", err)
		return
	}
	cancel()
	_, err, ok := next()
	if !ok {
		t.Fatal("expected the cancel chunk after cancel")
	}
	if err == nil {
		t.Fatal("expected the cancel error after cancel")
	}
	if !errors.Is(err, ollama.ErrProviderStreamCut) {
		t.Fatalf("cancel error = %v, want the stream cut fault", err)
	}
	if !errors.Is(err, context.Canceled) {
		t.Fatalf("cancel error = %v, want context.Canceled", err)
	}
	if _, err, ok := next(); ok {
		t.Fatalf("pull after the cancel error = %v, want the end of the stream", err)
	}
}

func TestStreamCanceledBeforeHeadersYieldsStreamCut(t *testing.T) {
	srv := httptest.NewServer(serveBody(t, http.StatusOK, "application/x-ndjson", ndjsonOneLine))
	defer srv.Close()
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	chunks := collectAll(testClient(srv).Stream(ctx, ai.Request{Model: "llama3.2"}))
	if len(chunks) == 0 {
		t.Fatal("no chunks")
	}
	last := chunks[len(chunks)-1]
	if last.err == nil || !errors.Is(last.err, ollama.ErrProviderStreamCut) {
		t.Fatalf("last error = %v, want the stream cut fault", last.err)
	}
	if !errors.Is(last.err, context.Canceled) {
		t.Fatalf("last error = %v, want context.Canceled", last.err)
	}
}

func TestStreamEndsAtTheDoneRecordWhileTheBodyStaysOpen(t *testing.T) {
	var held atomic.Int64
	handlerDone := make(chan struct{})
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer close(handlerDone)
		serveBody(t, http.StatusOK, "application/x-ndjson", ndjsonToolStream)(w, r)
		if f, ok := w.(http.Flusher); ok {
			f.Flush()
		}
		idle := time.Now()
		<-r.Context().Done()
		held.Store(int64(time.Since(idle)))
	}))
	defer srv.Close()
	c := testClient(srv)
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	reply := collectReply(t, c.Stream(ctx, ai.Request{Model: "llama3.2"}))
	if reply.Finish != ai.FinishToolCall {
		t.Fatalf("finish = %q, want tool_call", reply.Finish)
		return
	}
	<-handlerDone
	if h := time.Duration(held.Load()); h > time.Second {
		t.Fatalf("the server waited %v for the body to close after the flush: the stream waited for the body to close", h)
	}
}

func TestFormatGoesOutAsJSONModeOrAsASchemaObject(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", `{"model":"llama3.2","message":{"role":"assistant","content":"hi"},"done":true,"done_reason":"stop"}`)
	c := testClient(srv)
	var got struct {
		Format jsontext.Value `json:"format"`
	}
	formatOf := func(t *testing.T, i int) jsontext.Value {
		t.Helper()
		got.Format = nil
		if err := json.Unmarshal([]byte(rec.body(i)), &got); err != nil {
			t.Fatalf("request body %s: %v", rec.body(i), err)
			return nil
		}
		return got.Format
	}
	mode := "json"
	chatReply(t, c, ai.Request{Model: "llama3.2", Format: mode})
	if format := formatOf(t, 0); string(format) != `"json"` {
		t.Fatalf("format = %s, want the JSON string json", format)
	}
	schema := `{"type":"object","required":["city"]}`
	chatReply(t, c, ai.Request{Model: "llama3.2", Format: schema})
	if format := formatOf(t, 1); canonical(t, format) != canonical(t, []byte(schema)) {
		t.Fatalf("format = %s, want the schema as a JSON object", format)
	}
	chatReply(t, c, ai.Request{Model: "llama3.2", Format: "{}"})
	if format := formatOf(t, 2); string(format) != "{}" {
		t.Fatalf("format = %s, want the explicit empty object", format)
	}
	chatReply(t, c, ai.Request{Model: "llama3.2"})
	if body := rec.body(3); strings.Contains(body, `"format"`) {
		t.Fatalf("request body %s contains a format member, want it absent", body)
	}
	sent := rec.count()
	for _, bad := range []string{`"type"`, `{"type":`, `[1]`} {
		if _, err := c.Chat(context.Background(), ai.Request{Model: "llama3.2", Format: bad}); err == nil || !errors.Is(err, ollama.ErrInvalidRequest) {
			t.Fatalf("Chat with format %s: err = %v, want the format error", bad, err)
		}
	}
	if n := rec.count(); n != sent {
		t.Fatalf("a bad format reached the server %d times", n-sent)
	}
}

func TestClientErrorIsFinal(t *testing.T) {
	var calls atomic.Int64
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		calls.Add(1)
		serveBody(t, http.StatusBadRequest, "application/json", `{"error":"bad request"}`)(w, r)
	}))
	defer srv.Close()
	c := testClient(srv)
	_, err := c.Chat(context.Background(), ai.Request{Model: "llama3.2"})
	if err == nil {
		t.Fatal("err=nil, want the 400 answer")
	}
	if !errors.Is(err, ollama.ErrProviderRejected) {
		t.Fatalf("err = %v, want the provider rejection for a 400 answer", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("server saw %d calls, want 1: a 400 is final", calls.Load())
	}
}

func TestClientErrorAddsNoResultToTheBreaker(t *testing.T) {
	statuses := []int{http.StatusInternalServerError, http.StatusInternalServerError, http.StatusBadRequest}
	var calls atomic.Int64
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		n := int(calls.Add(1))
		if n <= len(statuses) {
			serveBody(t, statuses[n-1], "application/json", `{"error":"refused"}`)(w, r)
			return
		}
		serveBody(t, http.StatusOK, "application/json", `{"model":"llama3.2","message":{"role":"assistant","content":"hi"},"done":true,"done_reason":"stop"}`)(w, r)
	}))
	defer srv.Close()
	c := testClient(srv)
	c.Policy = resilience.Policy{Timeout: 2 * time.Second, Breaker: &resilience.Breaker{Window: 3, FailureRate: 0.5, OpenFor: time.Hour}}
	for range statuses {
		if _, err := c.Chat(context.Background(), ai.Request{Model: "llama3.2"}); err == nil {
			t.Fatal("err=nil, want the failing answer")
		}
	}
	if _, err := c.Chat(context.Background(), ai.Request{Model: "llama3.2"}); err != nil {
		t.Fatalf("err = %v, want a reply: two 500 answers and a 400 must not fill a window of three", err)
	}
	if calls.Load() != 4 {
		t.Fatalf("server saw %d calls, want 4", calls.Load())
	}
}

func TestServerErrorIsRetried(t *testing.T) {
	var calls atomic.Int64
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		if calls.Add(1) == 1 {
			serveBody(t, http.StatusInternalServerError, "application/json", `{"error":"boom"}`)(w, r)
			return
		}
		serveBody(t, http.StatusOK, "application/json", `{"model":"llama3.2","message":{"role":"assistant","content":"ok"},"done":true,"done_reason":"stop"}`)(w, r)
	}))
	defer srv.Close()
	c := testClient(srv)
	reply := chatReply(t, c, ai.Request{Model: "llama3.2"})
	if calls.Load() != 2 {
		t.Fatalf("server saw %d calls, want 2: a 500 is retried", calls.Load())
	}
	if len(reply.Message.Parts) != 1 {
		t.Fatalf("parts = %+v, want one text part", reply.Message.Parts)
	}
	text, ok := reply.Message.Parts[0].(ai.Text)
	if !ok || text.Text != "ok" {
		t.Fatalf("part = %+v, want Text{ok}", reply.Message.Parts[0])
	}
}

func TestEmbedReturnsEmbeddingsInInputOrder(t *testing.T) {
	type embedRequest struct {
		Model    string   `json:"model"`
		Input    []string `json:"input"`
		Truncate bool     `json:"truncate"`
	}
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", `{"model":"llama3.2","embeddings":[[1,2,3],[4,5,6]]}`)
	c := testClient(srv)
	embeddings := embedAll(t, c, []string{"first", "second"})
	if path := rec.path(0); path != "/api/embed" {
		t.Fatalf("path = %q, want /api/embed", path)
	}
	var got embedRequest
	if err := json.Unmarshal([]byte(rec.body(0)), &got); err != nil {
		t.Fatalf("embed request body: %v", err)
		return
	}
	if len(got.Input) != 2 || got.Input[0] != "first" || got.Input[1] != "second" {
		t.Fatalf("input = %v, want [first second]", got.Input)
	}
	if len(embeddings) != 2 || len(embeddings[0]) != 3 || embeddings[0][0] != 1 || embeddings[1][2] != 6 {
		t.Fatalf("embeddings = %v, want [[1 2 3] [4 5 6]]", embeddings)
	}
}

type collected struct {
	chunk ai.Chunk
	err   error
}

func collectAll(stream iter.Seq2[ai.Chunk, error]) []collected {
	var out []collected
	for chunk, err := range stream {
		out = append(out, collected{chunk: chunk, err: err})
	}
	return out
}

func collectReply(t *testing.T, stream iter.Seq2[ai.Chunk, error]) ai.Reply {
	t.Helper()
	reply, err := ai.Collect(stream)
	if err != nil {
		t.Fatalf("Collect: %v", err)
		return ai.Reply{}
	}
	return reply
}

func chatReply(t *testing.T, c *ollama.Client, req ai.Request) ai.Reply {
	t.Helper()
	reply, err := c.Chat(context.Background(), req)
	if err != nil {
		t.Fatalf("Chat: %v", err)
		return ai.Reply{}
	}
	return reply
}

func embedBody(vectors int, dims int) string {
	row := "[" + strings.Repeat("0.12345678,", dims-1) + "0.12345678]"
	return `{"model":"llama3.2","embeddings":[` + strings.Repeat(row+",", vectors-1) + row + `]}`
}

func TestEmbedAcceptsABatchLargerThanOneMebibyte(t *testing.T) {
	body := embedBody(128, 1024)
	if len(body) <= 1<<20 {
		t.Fatalf("test body holds %d bytes, want more than 1 MiB", len(body))
	}
	srv := httptest.NewServer(serveBody(t, http.StatusOK, "application/json", body))
	defer srv.Close()
	embeddings := embedAll(t, testClient(srv), make([]string, 128))
	if len(embeddings) != 128 || len(embeddings[127]) != 1024 || embeddings[127][1023] != float32(0.12345678) {
		t.Fatalf("got %d vectors, want 128 vectors of 1024 values that end in 0.12345678", len(embeddings))
	}
}

func TestEmbedBodyOverItsLimitIsFinal(t *testing.T) {
	var calls atomic.Int64
	body := embedBody(1, 200000)
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		calls.Add(1)
		w.Header().Set("Content-Type", "application/json")
		if _, werr := io.WriteString(w, body); werr != nil {
			t.Logf("server write ended when the client stopped at its limit: %v", werr)
		}
	}))
	defer srv.Close()
	_, err := testClient(srv).Embed(context.Background(), []string{"one"})
	if err == nil || !errors.Is(err, ollama.ErrProviderTooLarge) {
		t.Fatalf("err = %v, want the size limit of 1 MiB plus 128 KiB", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("server saw %d calls, want 1: the same body would come again", calls.Load())
	}
}

type failingAnswer struct {
	status      int
	contentType string
	payload     string
	cutConn     bool
}

func failingStatusServer(t *testing.T, rec *recorder, answer failingAnswer) *httptest.Server {
	t.Helper()
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !admitted(r) {
			w.WriteHeader(http.StatusNotFound)
			return
		}
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		w.Header().Set("Content-Type", answer.contentType)
		w.WriteHeader(answer.status)
		if _, werr := io.WriteString(w, answer.payload); werr != nil {
			t.Logf("server write ended: %v", werr)
			return
		}
		if f, ok := w.(http.Flusher); ok {
			f.Flush()
		}
		if answer.cutConn {
			cutBody(w, r, t)
			return
		}
		<-r.Context().Done()
	}))
	t.Cleanup(srv.Close)
	return srv
}

func cutBody(w http.ResponseWriter, r *http.Request, t *testing.T) {
	hj, ok := w.(http.Hijacker)
	if !ok {
		<-r.Context().Done()
		return
	}
	conn, _, herr := hj.Hijack()
	if herr != nil {
		t.Logf("hijack: %v", herr)
		<-r.Context().Done()
		return
	}
	if cerr := conn.Close(); cerr != nil {
		t.Errorf("close the cut connection: %v", cerr)
	}
}

func TestEmbedRejectsAStalledErrorBodyAfterOneRequest(t *testing.T) {
	rec := &recorder{}
	srv := failingStatusServer(t, rec, failingAnswer{status: http.StatusBadRequest, contentType: "application/json", payload: strings.Repeat("x", 1<<20)})
	c := testClient(srv)
	c.Policy.Timeout = 10 * time.Second
	_, err := c.Embed(context.Background(), []string{"one"})
	if err == nil || !errors.Is(err, ollama.ErrProviderRejected) {
		t.Fatalf("err = %v, want the 400 rejection", err)
		return
	}
	if n := rec.count(); n != 1 {
		t.Fatalf("server saw %d calls, want 1: a rejection is final", n)
	}
}

func TestEmbedKeepsTheStatusOfAFailingAnswerWhoseBodyIsCut(t *testing.T) {
	rec := &recorder{}
	srv := failingStatusServer(t, rec, failingAnswer{status: http.StatusBadRequest, contentType: "application/json", payload: strings.Repeat("x", 100), cutConn: true})
	c := testClient(srv)
	c.Policy.Timeout = 10 * time.Second
	start := time.Now()
	_, err := c.Embed(context.Background(), []string{"one"})
	if err == nil || !errors.Is(err, ollama.ErrProviderRejected) {
		t.Fatalf("err = %v, want the 400 rejection", err)
		return
	}
	if !strings.Contains(err.Error(), "body read ended early") {
		t.Fatalf("err = %v, want the status with the read cause", err)
		return
	}
	if n := rec.count(); n != 1 {
		t.Fatalf("server saw %d calls, want 1: a rejection is final", n)
	}
	if waited := time.Since(start); waited > 5*time.Second {
		t.Fatalf("Embed returned after %v: a cut error body waited out the retry schedule", waited)
	}
}

func TestStreamKeepsTheStatusOfAFailingAnswerWhoseBodyIsCut(t *testing.T) {
	rec := &recorder{}
	srv := failingStatusServer(t, rec, failingAnswer{status: http.StatusBadRequest, contentType: "application/x-ndjson", payload: strings.Repeat("x", 100), cutConn: true})
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	chunks := collectAll(testClient(srv).Stream(ctx, ai.Request{Model: "llama3.2"}))
	if len(chunks) == 0 {
		t.Fatal("no chunks")
	}
	last := chunks[len(chunks)-1]
	if last.err == nil || !errors.Is(last.err, ollama.ErrProviderRejected) {
		t.Fatalf("last error = %v, want the 400 rejection", last.err)
		return
	}
	if !strings.Contains(last.err.Error(), "body read ended early") {
		t.Fatalf("last error = %v, want the status with the read cause", last.err)
		return
	}
	if n := rec.count(); n != 1 {
		t.Fatalf("server saw %d calls, want 1", n)
	}
}

func embedAll(t *testing.T, c *ollama.Client, texts []string) [][]float32 {
	t.Helper()
	embeddings, err := c.Embed(context.Background(), texts)
	if err != nil {
		t.Fatalf("Embed: %v", err)
		return nil
	}
	return embeddings
}

func f64(v float64) float64? {
	return v
}

func i32(v int) int? {
	return v
}

type cutReader struct {
	left int
	cut  error
}

func (b *cutReader) Read(p []byte) (int, error) {
	if b.left <= 0 {
		return 0, b.cut
	}
	n := min(len(p), b.left)
	for i := range n {
		p[i] = 'x'
	}
	b.left -= n
	if b.left == 0 {
		return n, b.cut
	}
	return n, nil
}

func (b *cutReader) Close() error {
	return nil
}

type cutTransport struct {
	calls *atomic.Int64
	total int
	cut   error
}

func (t *cutTransport) RoundTrip(req *http.Request) (*http.Response, error) {
	t.calls.Add(1)
	return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: &cutReader{left: t.total, cut: t.cut}}, nil
}

func TestChatBodyOverLimitWithCutConnectionIsFinal(t *testing.T) {
	var calls atomic.Int64
	transport := &cutTransport{calls: &calls, total: (1 << 20) + 1, cut: io.ErrUnexpectedEOF}
	c := &ollama.Client{BaseURL: "http://ollama.invalid", Model: "llama3.2", HTTP: &http.Client{Transport: transport}, Policy: resilience.Policy{Timeout: 2 * time.Second, Retry: resilience.Retry{Attempts: 3, Base: time.Millisecond, Max: 2 * time.Millisecond}}}
	_, err := c.Chat(context.Background(), ai.Request{Model: "llama3.2"})
	if err == nil || !errors.Is(err, ollama.ErrProviderTooLarge) {
		t.Fatalf("err = %v, want the size limit of 1 MiB", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("transport saw %d calls, want 1: the same body would come again", calls.Load())
	}
}
