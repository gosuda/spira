//go:build engines

package session_test

import (
	"os"
	"testing"

	"github.com/gosuda/spira/ai/session"
	"github.com/gosuda/spira/db"
)

func sqlDSN(t *testing.T, name string) string {
	t.Helper()
	dsn := os.Getenv(name)
	if dsn == "" {
		t.Fatalf("%s is empty; run `just engines`", name)
		return ""
	}
	return dsn
}

func sqlEnginePool(t *testing.T, driver string, dsnVar string) *db.Pool {
	t.Helper()
	pool := sqlOpen(t, driver, sqlDSN(t, dsnVar))
	sqlPrepare(t, pool)
	sqlStop(t, pool)
	return pool
}

func sqlEnginePair(t *testing.T, driver string, dsnVar string) (*db.Pool, *db.Pool) {
	t.Helper()
	dsn := sqlDSN(t, dsnVar)
	first := sqlPrepareOn(t, driver, sqlOpen(t, driver, dsn))
	second := sqlPrepareOn(t, driver, sqlOpen(t, driver, dsn))
	sqlStop(t, first)
	sqlStop(t, second)
	return first, second
}

func sqlPrepareOn(t *testing.T, driver string, pool *db.Pool) *db.Pool {
	t.Helper()
	if err := sqlFixedStore(pool).Prepare(t.Context()); err != nil {
		t.Fatalf("prepare %s: %v", driver, err)
		return pool
	}
	return pool
}

func TestEngineSessionContractPostgres(t *testing.T) {
	pool := sqlEnginePool(t, "pgx", "SPIRA_TEST_POSTGRES_DSN")
	runSessionContract(t, func(t *testing.T) session.Store {
		t.Helper()
		return sqlFixedStore(pool)
	})
}

func TestEngineSessionContractMySQL(t *testing.T) {
	pool := sqlEnginePool(t, "mysql", "SPIRA_TEST_MYSQL_DSN")
	runSessionContract(t, func(t *testing.T) session.Store {
		t.Helper()
		return sqlFixedStore(pool)
	})
}

func TestEngineSessionContractMSSQL(t *testing.T) {
	pool := sqlEnginePool(t, "sqlserver", "SPIRA_TEST_MSSQL_DSN")
	runSessionContract(t, func(t *testing.T) session.Store {
		t.Helper()
		return sqlFixedStore(pool)
	})
}

func TestEngineSessionClaimAdmitsOneWinner(t *testing.T) {
	t.Run("postgres", func(t *testing.T) { sessionClaimAdmitsOneWinner(t, sqlEnginePool(t, "pgx", "SPIRA_TEST_POSTGRES_DSN")) })
	t.Run("mysql", func(t *testing.T) { sessionClaimAdmitsOneWinner(t, sqlEnginePool(t, "mysql", "SPIRA_TEST_MYSQL_DSN")) })
	t.Run("mssql", func(t *testing.T) { sessionClaimAdmitsOneWinner(t, sqlEnginePool(t, "sqlserver", "SPIRA_TEST_MSSQL_DSN")) })
}

func TestEngineDeleteClearsAConcurrentAppend(t *testing.T) {
	t.Run("postgres", func(t *testing.T) {
		first, second := sqlEnginePair(t, "pgx", "SPIRA_TEST_POSTGRES_DSN")
		sessionDeleteBesideAppend(t, first, second)
	})
	t.Run("mysql", func(t *testing.T) {
		first, second := sqlEnginePair(t, "mysql", "SPIRA_TEST_MYSQL_DSN")
		sessionDeleteBesideAppend(t, first, second)
	})
	t.Run("mssql", func(t *testing.T) {
		first, second := sqlEnginePair(t, "sqlserver", "SPIRA_TEST_MSSQL_DSN")
		sessionDeleteBesideAppend(t, first, second)
	})
}
