}

func TestSessionFaultSystemMessage(t *testing.T) {
	s := &session.Service{}
	sqlEnsure(t, s, "a")
	system := session.Event{ID: "a/e1", Session: "a", At: sqlBaseTime(), Type: session.EventMessage, Message: ai.Message{Role: ai.RoleSystem, Parts: []ai.Part{ai.Text{Text: "s"}}}}
	if _, err := s.Append(t.Context(), "a", sqlVersion(t, s, "a"), system); !errors.Is(err, session.ErrSystemMessage) {
		t.Fatalf("Append system message error = %v, want the system message fault", err)
