package session_test

import (
	"errors"
	"fmt"
	"path/filepath"
	"strings"
	"testing"

	"github.com/gosuda/spira/ai"
	"github.com/gosuda/spira/ai/session"
	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/fault/faulttest"
)

func TestSessionFaultsMatchSpecTable(t *testing.T) {
	faulttest.CheckTable(t, "../../docs/specs/ai-session.md", session.Faults())
}

func faultNoLeak(t *testing.T, err error, planted ...string) {
	t.Helper()
	if err == nil {
		t.Fatalf("expected a fault, got nil")
		return
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, err), planted...)
}

func TestSessionFaultBlankID(t *testing.T) {
	s := &session.Service{}
	if _, err := s.Ensure(""); !errors.Is(err, session.ErrBlankID) {
		t.Fatalf("Ensure blank id error = %v, want the blank id fault", err)
		return
	}
	if _, err := s.Ensure("   "); !errors.Is(err, session.ErrBlankID) {
		t.Fatalf("Ensure whitespace id error = %v, want the blank id fault", err)
	}
}

func TestSessionFaultIDTooLarge(t *testing.T) {
	s := &session.Service{}
	long := strings.Repeat("k", 256)
	if _, err := s.Ensure(long); !errors.Is(err, session.ErrIDTooLarge) {
		t.Fatalf("Ensure overlong id error = %v, want the id limit fault", err)
		return
	}
	sqlEnsure(t, s, "a")
	overlong := session.Event{ID: long + "/e1", Session: "a", At: sqlBaseTime(), Type: session.EventMessage, Message: sqlUser("lost")}
	if _, err := s.Append(t.Context(), "a", sqlVersion(t, s, "a"), overlong); !errors.Is(err, session.ErrIDTooLarge) {
		t.Fatalf("Append overlong event id error = %v, want the id limit fault", err)
	}
}

func TestSessionFaultEmptyBatch(t *testing.T) {
	s := &session.Service{}
	sqlEnsure(t, s, "a")
	if _, err := s.Append(t.Context(), "a", sqlVersion(t, s, "a")); !errors.Is(err, session.ErrEmptyBatch) {
		t.Fatalf("Append empty batch error = %v, want the empty batch fault", err)
