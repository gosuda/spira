}

func TestSessionFaultForeignEvent(t *testing.T) {
	s := &session.Service{}
	sqlEnsure(t, s, "a")
	sqlEnsure(t, s, "b")
	foreign := session.Event{ID: "b/e1", Session: "b", At: sqlBaseTime(), Type: session.EventMessage, Message: sqlUser("x")}
	if _, err := s.Append(t.Context(), "a", sqlVersion(t, s, "a"), foreign); !errors.Is(err, session.ErrForeignEvent) {
		t.Fatalf("Append foreign event error = %v, want the foreign event fault", err)
	}
}

