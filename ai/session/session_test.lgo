func TestHistoryKeepsOnlyTheResultThatAnswersAStoredCall(t *testing.T) {
	stored := []ai.Message{
		text("Weather in Lisbon?"),
		toolCall("c1"),
		{Role: ai.RoleTool, Parts: []ai.Part{ai.ToolResult{ID: "c1", Name: "weather", Content: "sunny"}, ai.ToolResult{ID: "c9", Name: "weather", Content: "orphan"}}},
	}
	request := []ai.Message{text("And Porto?")}
	got := session.History(stored, request)
	want := []string{"Weather in Lisbon?", "call:c1", "result:c1", "And Porto?"}
	if !slices.Equal(describe(got), want) {
		t.Fatalf("got %v want %v", describe(got), want)
	}
	if n := len(got[2].Parts); n != 1 {
		t.Fatalf("the kept tool message holds %d parts, want the one result that answers the call", n)
	}
}

func TestHistoryKeepsAnsweredToolCall(t *testing.T) {
