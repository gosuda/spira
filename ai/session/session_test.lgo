func text(s string) ai.Message {
	return ai.Message{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: s}}}
}

func assistant(s string) ai.Message {
	return ai.Message{Role: ai.RoleAssistant, Parts: []ai.Part{ai.Text{Text: s}}}
}

func system(s string) ai.Message {
	return ai.Message{Role: ai.RoleSystem, Parts: []ai.Part{ai.Text{Text: s}}}
}

func toolCall(id string) ai.Message {
	return ai.Message{Role: ai.RoleAssistant, Parts: []ai.Part{ai.ToolCall{ID: id, Name: "weather", Arguments: "{}"}}}
}

func toolResult(id string) ai.Message {
	return ai.Message{Role: ai.RoleTool, Parts: []ai.Part{ai.ToolResult{ID: id, Name: "weather", Content: "sunny"}}}
}

func msgText(m ai.Message) string {
	for _, p := range m.Parts {
		if t, ok := p.(ai.Text); ok {
			return t.Text
		}
	}
	return ""
}

func describe(messages []ai.Message) []string {
	var out []string
	for _, m := range messages {
		if m.Role == ai.RoleAssistant && len(m.Parts) > 0 {
			if tc, ok := m.Parts[0].(ai.ToolCall); ok {
				out = append(out, "call:"+tc.ID)
				continue
			}
		}
		if m.Role == ai.RoleTool && len(m.Parts) > 0 {
			if tr, ok := m.Parts[0].(ai.ToolResult); ok {
				out = append(out, "result:"+tr.ID)
				continue
			}
		}
		out = append(out, msgText(m))
	}
	return out
}

func appendMsg(t *testing.T, s *session.Service, id string, m ai.Message) {
	t.Helper()
	v, err := s.Version(t.Context(), id)
	if err != nil {
		t.Fatalf("Version: %v", err)
		return
	}
	e := session.Event{ID: fmt.Sprintf("e%d", v), Session: id, Type: session.EventMessage, Message: m}
	ok, err := s.Append(t.Context(), id, v, e)
	if err != nil {
		t.Fatalf("Append: %v", err)
		return
	}
	if !ok {
		t.Fatalf("Append returned false")
	}
}

func ensureSession(t *testing.T, s *session.Service, id string) {
	t.Helper()
	_, err := s.Ensure(id)
	if err != nil {
		t.Fatalf("Ensure: %v", err)
	}
}

func eventsOf(t *testing.T, s *session.Service, id string) []session.Event {
	t.Helper()
	events, err := s.Events(t.Context(), id)
	if err != nil {
		t.Fatalf("Events: %v", err)
		return nil
	}
	return events
}

func versionOf(t *testing.T, s *session.Service, id string) int64 {
	t.Helper()
	v, err := s.Version(t.Context(), id)
	if err != nil {
		t.Fatalf("Version: %v", err)
		return 0
	}
	return v
}

func TestEnsureCreatesSessionWithTTL(t *testing.T) {
	s := &session.Service{TTL: time.Hour}
	sess, err := s.Ensure("s1")
	if err != nil {
		t.Fatalf("Ensure: %v", err)
		return
	}
	if sess == nil {
		t.Fatalf("Ensure returned nil")
		return
	}
	if sess.ID != "s1" || sess.ExpiresAt.IsZero() || !sess.ExpiresAt.After(sess.CreatedAt) {
		t.Fatalf("bad session: %+v", sess)
	}
	found := s.Find("s1")
	if found == nil {
		t.Fatalf("Find returned nil")
		return
	}
	if found.ID != "s1" {
		t.Fatalf("Find wrong id")
	}
}

func TestEnsureReturnsSameSession(t *testing.T) {
	s := &session.Service{}
	a, err1 := s.Ensure("x")
	b, err2 := s.Ensure("x")
	if err1 != nil || err2 != nil {
		t.Fatalf("Ensure errors: %v %v", err1, err2)
		return
	}
	if a == nil {
		t.Fatalf("Ensure returned nil for a")
		return
	}
	if b == nil {
		t.Fatalf("Ensure returned nil for b")
		return
	}
	if a.ID != b.ID {
		t.Fatalf("different sessions")
	}
}

func TestFindReturnsNilForMissing(t *testing.T) {
	s := &session.Service{}
	if s.Find("nope") != nil {
		t.Fatalf("expected nil")
	}
}

func TestAppendAndEventsInOrder(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("What is Spring AI?"))
	appendMsg(t, s, "s1", assistant("Spring AI is a framework."))
	appendMsg(t, s, "s1", text("Tell me more."))

	events := eventsOf(t, s, "s1")
	if len(events) != 3 {
		t.Fatalf("got %d events", len(events))
	}
	msgs := []ai.Message{}
	for _, e := range events {
		m := e.Message ?? ai.Message{}
		msgs = append(msgs, m)
	}
	want := []string{"What is Spring AI?", "Spring AI is a framework.", "Tell me more."}
	if got := describe(msgs); !slices.Equal(got, want) {
		t.Fatalf("messages: %v", got)
	}
}

func TestAppendStaleVersionReturnsFalse(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	v := versionOf(t, s, "s1")
	ok, err := s.Append(t.Context(), "s1", v, session.Event{ID: "e1", Session: "s1", Type: session.EventMessage, Message: text("hi")})
	if err != nil {
		t.Fatalf("Append: %v", err)
		return
	}
	if !ok {
		t.Fatalf("first append failed")
	}
	ok, err = s.Append(t.Context(), "s1", v, session.Event{ID: "e2", Session: "s1", Type: session.EventMessage, Message: text("bye")})
	if err != nil {
		t.Fatalf("stale Append err: %v", err)
		return
	}
	if ok {
		t.Fatalf("stale append returned true")
	}
}

func TestAppendSystemMessageRejectedBeforeVersion(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	v := versionOf(t, s, "s1")
	ok, err := s.Append(t.Context(), "s1", v, session.Event{ID: "e1", Session: "s1", Type: session.EventMessage, Message: system("sys")})
	if err == nil {
		t.Fatalf("expected error for system message")
		return
	}
	_ = ok
	ok, err = s.Append(t.Context(), "s1", v+999, session.Event{ID: "e2", Session: "s1", Type: session.EventMessage, Message: system("sys2")})
	if err == nil {
		t.Fatalf("expected error on stale version")
		return
	}
	_ = ok
}

type appendResult struct {
	ok   atomic.Bool
	err  atomic.Value
	done chan<- struct{}
}

type appendParams struct {
	s   *session.Service
	ctx context.Context
	id  string
	v   int64
}

func appendForTest(p appendParams, res *appendResult) {
	ok, err := p.s.Append(p.ctx, "s1", p.v, session.Event{ID: p.id, Session: "s1", Type: session.EventMessage, Message: text("one")})
	if err != nil {
		res.ok.Store(false)
		res.err.Store(err)
	} else {
		res.ok.Store(ok)
	}
	select {
	case res.done <- struct{}{}:
	case <-p.ctx.Done():
	}
}

func TestConcurrentAppendsExactlyOneSucceeds(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	v := versionOf(t, s, "s1")
	ctx := t.Context()
	done := make(chan struct{}, 2)
	res1 := &appendResult{done: done}
	res2 := &appendResult{done: done}
	run := func() error {
		go group (ctx) {
			go { appendForTest(appendParams{s: s, ctx: ctx, id: "a1", v: v}, res1) }
			go { appendForTest(appendParams{s: s, ctx: ctx, id: "a2", v: v}, res2) }
		}
		return nil
	}
	if err := run(); err != nil {
		t.Fatalf("go group: %v", err)
	}
	select {
	case <-done:
	case <-ctx.Done():
	}
	select {
	case <-done:
	case <-ctx.Done():
	}
	if res1.ok.Load() == res2.ok.Load() {
		t.Fatalf("both appends same result: %v %v", res1.ok.Load(), res2.ok.Load())
	}
	e1 := res1.err.Load()
	e2 := res2.err.Load()
	if e1 != nil || e2 != nil {
		t.Fatalf("errors: %v %v", e1, e2)
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 1 {
		t.Fatalf("expected 1 event, got %d", len(events))
	}
}

func TestExpiryWithFakeClock(t *testing.T) {
	now := time.Now()
	s := &session.Service{TTL: time.Hour, Now: func() time.Time { return now }}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("hi"))
	if s.Find("s1") == nil {
		t.Fatalf("session should exist")
	}
	now = now.Add(2 * time.Hour)
	if s.Find("s1") != nil {
		t.Fatalf("session should be expired")
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 0 {
		t.Fatalf("expired session should have no events")
	}
	if v := versionOf(t, s, "s1"); v != 0 {
		t.Fatalf("expired session version: %d", v)
	}
}

func TestCompactFromAnExpiredSessionCannotHideTheNewTurn(t *testing.T) {
	now := time.Now()
	s := &session.Service{TTL: time.Hour, Now: func() time.Time { return now }}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("before the expiry"))
	stale := versionOf(t, s, "s1")
	now = now.Add(2 * time.Hour)
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("after the expiry"))

	ok, err := s.Compact(t.Context(), "s1", stale, session.Boundary{Summary: []ai.Message{assistant("stale summary")}})
	if err != nil {
		t.Fatalf("Compact: %v", err)
		return
	}
	if ok {
		t.Fatalf("a compaction of the expired session was accepted")
	}
	msgs, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	want := []string{"after the expiry"}
	if got := describe(msgs); !slices.Equal(got, want) {
		t.Fatalf("active = %v, want the replacement turn %v", got, want)
	}
}

func TestAppendKeepsThePartsOfTheStoredMessage(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	m := text("original")
	appendMsg(t, s, "s1", m)
	if m.Parts[0].(ai.Text).Text != "original" {
		t.Fatalf("the caller's message changed")
	}
	m.Parts[0] = ai.Text{Text: "edited by the caller"}

	msgs, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	if got := msgText(msgs[0]); got != "original" {
		t.Fatalf("stored text = %q, want the text at append time", got)
	}
}

func TestActiveKeepsThePartsOfTheReturnedMessage(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("original"))

	msgs, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	msgs[0].Parts[0] = ai.Text{Text: "edited by the caller"}

	again, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	if got := msgText(again[0]); got != "original" {
		t.Fatalf("stored text = %q, want the text at append time", got)
	}
}

func TestLastNExtendsToTurnStart(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	for i := 1; i <= 6; i++ {
		appendMsg(t, s, "s1", text(fmt.Sprintf("message %d", i)))
	}
	events, err := s.LastN(t.Context(), "s1", 3)
	if err != nil {
		t.Fatalf("LastN: %v", err)
		return
	}
	if len(events) != 3 {
		t.Fatalf("got %d events", len(events))
	}
	m0 := events[0].Message ?? ai.Message{}
	m2 := events[2].Message ?? ai.Message{}
	if msgText(m0) != "message 4" {
		t.Fatalf("first event: %+v", events[0])
	}
	if msgText(m2) != "message 6" {
		t.Fatalf("last event: %+v", events[2])
	}
}

func TestLastNExtendsBackToTurnBoundary(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("hello"))
	appendMsg(t, s, "s1", assistant("hi"))
	appendMsg(t, s, "s1", text("and now?"))
	appendMsg(t, s, "s1", assistant("still here"))

	events, err := s.LastN(t.Context(), "s1", 1)
	if err != nil {
		t.Fatalf("LastN: %v", err)
		return
	}
	if len(events) != 2 {
		t.Fatalf("expected 2 events, got %d", len(events))
	}
	m0 := events[0].Message ?? ai.Message{}
	m1 := events[1].Message ?? ai.Message{}
	if msgText(m0) != "and now?" || msgText(m1) != "still here" {
		t.Fatalf("wrong window")
	}

	events, err = s.LastN(t.Context(), "s1", 3)
	if err != nil {
		t.Fatalf("LastN: %v", err)
		return
	}
	if len(events) != 4 {
		t.Fatalf("expected 4 events, got %d", len(events))
	}
}

func TestLastNCountsNonMessageEvents(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("hello"))
	appendMsg(t, s, "s1", assistant("hi"))
	v := versionOf(t, s, "s1")
	_, err := s.Append(t.Context(), "s1", v, session.Event{ID: "marker", Session: "s1", Type: session.EventCompaction})
	if err != nil {
		t.Fatalf("Append: %v", err)
		return
	}
	appendMsg(t, s, "s1", text("and now?"))
	appendMsg(t, s, "s1", assistant("still here"))

	events, err := s.LastN(t.Context(), "s1", 1)
	if err != nil {
		t.Fatalf("LastN: %v", err)
		return
	}
	if len(events) != 2 {
		t.Fatalf("expected 2 events (user2+assistant2), got %d", len(events))
	}
}

func TestLastNWithoutTurnStartIsPlainWindow(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", assistant("Be brief."))
	appendMsg(t, s, "s1", assistant("And polite."))

	events, err := s.LastN(t.Context(), "s1", 1)
	if err != nil {
		t.Fatalf("LastN: %v", err)
		return
	}
	if len(events) != 1 {
		t.Fatalf("expected 1 event, got %d", len(events))
	}
	m := events[0].Message ?? ai.Message{}
	if msgText(m) != "And polite." {
		t.Fatalf("wrong event: %+v", events[0])
	}
}

