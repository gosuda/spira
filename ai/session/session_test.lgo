func TestCompactRecordsBoundary(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	for i := 1; i <= 5; i++ {
		appendMsg(t, s, "s1", text(fmt.Sprintf("user turn %d", i)))
		appendMsg(t, s, "s1", assistant(fmt.Sprintf("assistant reply %d", i)))
	}
	v := versionOf(t, s, "s1")
	ok, err := s.Compact(t.Context(), "s1", v, session.Boundary{
		Summary: []ai.Message{assistant("summary")},
	})
	if err != nil {
		t.Fatalf("Compact: %v", err)
		return
	}
	if !ok {
		t.Fatalf("Compact returned false")
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 12 {
		t.Fatalf("expected 12 events (10 msgs + boundary + summary), got %d", len(events))
	}
	msgs, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	if len(msgs) != 1 {
		t.Fatalf("expected 1 active message (summary), got %d", len(msgs))
	}
}

func TestCompactStaleVersionReturnsFalse(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("hi"))
	v := versionOf(t, s, "s1")
	ok, err := s.Compact(t.Context(), "s1", v+1, session.Boundary{})
	if err != nil {
		t.Fatalf("Compact err: %v", err)
		return
	}
	if ok {
		t.Fatalf("expected false")
	}
}

func TestHistoryPutsSystemFirst(t *testing.T) {
	stored := []ai.Message{system("Be brief."), text("hello"), assistant("hi")}
	request := []ai.Message{text("and now?")}
	got := session.History(stored, request)
	want := []string{"Be brief.", "hello", "hi", "and now?"}
	if !slices.Equal(describe(got), want) {
		t.Fatalf("got %v want %v", describe(got), want)
	}
}

func TestHistoryDeduplicatesSystem(t *testing.T) {
	stored := []ai.Message{system("Be brief."), text("hello"), system("Be brief."), assistant("hi")}
	request := []ai.Message{text("and now?")}
	got := session.History(stored, request)
	want := []string{"Be brief.", "hello", "hi", "and now?"}
	if !slices.Equal(describe(got), want) {
		t.Fatalf("got %v want %v", describe(got), want)
	}
}

func TestHistoryDropsBlankSystem(t *testing.T) {
	stored := []ai.Message{system(""), text("hello"), assistant("hi")}
	request := []ai.Message{system("Be brief."), text("and now?")}
	got := session.History(stored, request)
	want := []string{"Be brief.", "hello", "hi", "and now?"}
