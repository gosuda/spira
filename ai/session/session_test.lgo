func TestRunRefusesAModelTheSessionAlreadyWrapped(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	client := serveModel(t, &scripted{chat: chatAnswer("Hi")})
	wrapped := session.Remember(s, "s1")(client)

	_, err := s.Run(t.Context(), "s1", session.Turn{
		Model:   wrapped,
		Request: ai.Request{Messages: []ai.Message{text("Hi")}},
		Limits:  ai.Limits{},
	})
	if err == nil {
		t.Fatalf("Run took an already wrapped model")
		return
	}
	if !errors.Is(err, session.ErrAlreadyWrapped) {
		t.Fatalf("Run error = %v, want the double-wrap refusal", err)
	}
}

func TestRunRecordsADirectAnswerAfterAConfirmResume(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{answer: func(req wireReq) string {
		for _, m := range req.Messages {
			if m.Role == "tool" && m.ToolCallID == "c1" {
				return chatAnswer("Booked.")
			}
		}
		return chatCallsAnswer("c1:book_flight")
	}}
	client := serveModel(t, model)

	tools := []ai.Tool{{
		Name:        "book_flight",
		Description: "book a flight",
		Schema:      `{"type":"object","properties":{}}`,
		Call: func(ctx context.Context, arguments string) (string, error) {
			return "booked", nil
		},
		Direct:  true,
		Confirm: true,
	}}
	req := ai.Request{Messages: []ai.Message{text("Book me a flight.")}, Tools: tools}
	_, err := s.Run(t.Context(), "s1", session.Turn{Model: client, Request: req, Limits: ai.Limits{}})
	paused := &ai.ConfirmError{}
	if !errors.As(err, &paused) {
		t.Fatalf("Run error = %v, want a ConfirmError", err)
		return
	}

	resume := req
	resume.Messages = paused.Messages
	resume.Decisions = []ai.Decision{{Call: "c1"}}
	resume.Resume = &paused.Reply
	reply, err := s.Run(t.Context(), "s1", session.Turn{Model: client, Request: resume, Limits: ai.Limits{}})
	if err != nil {
		t.Fatalf("resumed Run: %v", err)
		return
	}
	if reply.Message.Role != ai.RoleTool {
		t.Fatalf("the resumed direct reply has role %q, want tool", reply.Message.Role)
	}

	wrapped := session.Remember(s, "s1")(client)
	_, err = wrapped.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("what happened?")}})
	if err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	reqs := model.requests(t)
	if len(reqs) == 0 {
		t.Fatalf("the provider saw no request")
		return
	}
	requireCallBeforeResult(t, reqs[len(reqs)-1].Messages, "c1")
}

func TestRunRecordsOnceWhenRememberHidesInsideSearch(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{chat: chatAnswer("Hello!")}
	client := serveModel(t, model)
	_, searchLayer := ai.SearchTools([]ai.Tool{})
	hidden := searchLayer(session.Remember(s, "s1")(client))
	_, err := s.Run(t.Context(), "s1", session.Turn{
		Model:   hidden,
		Request: ai.Request{Messages: []ai.Message{text("Hi")}},
		Limits:  ai.Limits{},
	})
	if err != nil {
		t.Fatalf("Run: %v", err)
		return
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 2 {
		t.Fatalf("expected 2 events (user+reply), got %d", len(events))
	}

}

func TestRememberNestedSameSessionRecordsOnce(t *testing.T) {
	s := &session.Service{}
	model := &scripted{chat: chatAnswer("Hello!")}
	client := serveModel(t, model)
	stacked := session.Remember(s, "a")(session.Remember(s, "b")(session.Remember(s, "a")(client)))
	if _, err := stacked.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}); err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	if events := eventsOf(t, s, "a"); len(events) != 2 {
		t.Fatalf("session a holds %d events, want the turn once", len(events))
	}
	if events := eventsOf(t, s, "b"); len(events) != 2 {
		t.Fatalf("session b holds %d events, want the turn once", len(events))
	}
}

func TestRememberStreamLateFailureAppendsNothing(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	partial := "data: {\"id\":\"chatcmpl-1\",\"model\":\"gpt-6-astra\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}\n\n"
	model := &scripted{stream: partial}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))
	var okChunks int
	var failures []error
	for _, err := range wrapped.Stream(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}) {
		if err != nil {
			failures = append(failures, err)
		} else {
			okChunks++
		}
	}
	if okChunks == 0 {
		t.Fatalf("the cut stream gave no chunks before failing")
	}
	if len(failures) != 1 {
		t.Fatalf("the cut stream gave %d errors, want one", len(failures))
	}
	if events := eventsOf(t, s, "s1"); len(events) != 0 {
		t.Fatalf("a stream that failed after chunks left %d events, want 0", len(events))
	}
}
