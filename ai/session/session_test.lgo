	request := []ai.Message{text("And Porto?")}
	got := session.History(stored, request)
	want := []string{"Weather in Lisbon?", "call:c1", "result:c1", "And Porto?"}
	if !slices.Equal(describe(got), want) {
		t.Fatalf("got %v want %v", describe(got), want)
	}
}

func TestHistoryDoesNotDoubleOverlap(t *testing.T) {
	stored := []ai.Message{text("And Porto?"), toolCall("c1")}
	request := []ai.Message{text("And Porto?"), toolCall("c1"), toolResult("c1")}
	got := session.History(stored, request)
	want := []string{"And Porto?", "call:c1", "result:c1"}
	if !slices.Equal(describe(got), want) {
		t.Fatalf("got %v want %v", describe(got), want)
	}
}

func TestHistoryLaterRoundPrependsOnlyWhatLoopDoesNotCarry(t *testing.T) {
	u1 := text("Weather in Lisbon?")
	a1 := assistant("Sunny.")
	u2 := text("And Porto?")
	call := toolCall("c1")
	stored := []ai.Message{u1, a1, u2, call}
	request := []ai.Message{u2, call, toolResult("c1")}
	got := session.History(stored, request)
	want := []string{"Weather in Lisbon?", "Sunny.", "And Porto?", "call:c1", "result:c1"}
	if !slices.Equal(describe(got), want) {
		t.Fatalf("got %v want %v", describe(got), want)
	}
}

