func TestLastUserOrTool(t *testing.T) {
	msgs := []ai.Message{system("sys"), text("hello"), assistant("hi")}
	got := session.LastUserOrTool(msgs)
	if got == nil {
		t.Fatalf("expected user message")
		return
	}
	g := got ?? ai.Message{}
	if msgText(g) != "hello" {
		t.Fatalf("expected user message, got %+v", got)
	}
	msgs = []ai.Message{system("sys"), text("hello"), toolResult("c1")}
	got = session.LastUserOrTool(msgs)
	if got == nil {
		t.Fatalf("expected tool message")
		return
	}
	g = got ?? ai.Message{}
	if g.Role != ai.RoleTool {
		t.Fatalf("expected the tool message, got %+v", got)
	}
	msgs = []ai.Message{system("sys")}
	got = session.LastUserOrTool(msgs)
	if got != nil {
		t.Fatalf("expected nil, got %+v", got)
	}
}

type wireCall struct {
	ID       string `json:"id"`
	Type     string `json:"type"`
	Function struct {
		Name      string `json:"name"`
		Arguments string `json:"arguments"`
	} `json:"function"`
}

type wireMsg struct {
	Role       string     `json:"role"`
	Content    string     `json:"content"`
	ToolCallID string     `json:"tool_call_id"`
	ToolCalls  []wireCall `json:"tool_calls"`
}

type wireReq struct {
	Stream   bool      `json:"stream"`
	Messages []wireMsg `json:"messages"`
}

type scripted struct {
	bodies sync.Locked[[]string]
	chat string
	stream string
	fail error
	during func()
	answer func(req wireReq) string
}

func (s *scripted) requests(t *testing.T) []wireReq {
	t.Helper()
	var bodies []string
	s.bodies.WithLock(func(b *[]string) {
		bodies = slices.Clone(*b)
	})
	out := make([]wireReq, 0, len(bodies))
	for _, raw := range bodies {
		var req wireReq
		if err := json.Unmarshal([]byte(raw), &req); err != nil {
			t.Fatalf("request body is not JSON: %v", err)
			return nil
		}
		out = append(out, req)
	}
	return out
}
func serveModel(t *testing.T, s *scripted) *openai.Client {
	t.Helper()
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
			return
		}
		var req wireReq
		if err := json.Unmarshal(raw, &req); err != nil {
			t.Errorf("server decode: %v", err)
			return
		}
		s.bodies.WithLock(func(b *[]string) {
			*b = append(*b, string(raw))
		})
		if s.during != nil {
			s.during()
		}
		if s.fail != nil {
			http.Error(w, s.fail.Error(), http.StatusInternalServerError)
			return
		}
		if req.Stream {
			w.Header().Set("Content-Type", "text/event-stream")
			if _, err := io.WriteString(w, s.stream); err != nil {
				t.Errorf("server write: %v", err)
			}
			return
		}
		body := s.chat
		if s.answer != nil {
			body = s.answer(req)
		}
		w.Header().Set("Content-Type", "application/json")
		if _, err := io.WriteString(w, body); err != nil {
			t.Errorf("server write: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	return &openai.Client{
		BaseURL: srv.URL,
		Model:   "gpt-6-astra",
		HTTP:    srv.Client(),
		Policy:  resilience.Policy{Timeout: 2 * time.Second},
	}
}

func chatAnswer(content string) string {
	return fmt.Sprintf(`{"id":"chatcmpl-1","model":"gpt-6-astra","choices":[{"index":0,"message":{"role":"assistant","content":%q},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`, content)
}

func chatCallsAnswer(calls ...string) string {
	var b strings.Builder
	b.WriteString(`{"id":"chatcmpl-1","model":"gpt-6-astra","choices":[{"index":0,"message":{"role":"assistant","content":null,"tool_calls":[`)
	for i, call := range calls {
		if i > 0 {
			b.WriteByte(',')
		}
		parts := strings.SplitN(call, ":", 2)
		fmt.Fprintf(&b, `{"id":%q,"type":"function","function":{"name":%q,"arguments":"{}"}}`, parts[0], parts[1])
	}
	b.WriteString(`]},"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`)
	return b.String()
}

func sseAnswer(texts ...string) string {
	var b strings.Builder
	for _, s := range texts {
		fmt.Fprintf(&b, "data: {\"id\":\"chatcmpl-1\",\"model\":\"gpt-6-astra\",\"choices\":[{\"index\":0,\"delta\":{\"content\":%q},\"finish_reason\":null}]}\n\n", s)
	}
	b.WriteString("data: {\"id\":\"chatcmpl-1\",\"model\":\"gpt-6-astra\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}\n\n")
	b.WriteString("data: [DONE]\n\n")
	return b.String()
}

func TestRememberChatAppendsUserAndReply(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{chat: chatAnswer("Hello!")}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	reply, err := wrapped.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}})
	if err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	if reply.Message.Role != ai.RoleAssistant {
		t.Fatalf("bad reply")
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 2 {
		t.Fatalf("expected 2 events, got %d", len(events))
	}
	m0 := events[0].Message ?? ai.Message{}
	m1 := events[1].Message ?? ai.Message{}
	if msgText(m0) != "Hi" || msgText(m1) != "Hello!" {
		t.Fatalf("wrong events")
	}
}

func TestRememberChatLoadsHistory(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("What is Spring?"))
	appendMsg(t, s, "s1", assistant("Spring is a framework."))

	model := &scripted{chat: chatAnswer("More info.")}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	_, err := wrapped.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("Tell me more.")}})
	if err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	reqs := model.requests(t)
	if len(reqs) != 1 {
		t.Fatalf("the provider saw %d requests, want 1", len(reqs))
		return
	}
	got := describeWire(reqs[0].Messages)
	want := []string{"What is Spring?", "Spring is a framework.", "Tell me more."}
	if !slices.Equal(got, want) {
		t.Fatalf("got %v want %v", got, want)
	}
}

func describeWire(messages []wireMsg) []string {
	var out []string
	for _, m := range messages {
		if len(m.ToolCalls) > 0 {
			out = append(out, "call:"+m.ToolCalls[0].ID)
			continue
		}
		if m.Role == "tool" {
			out = append(out, "result:"+m.ToolCallID)
			continue
		}
		out = append(out, m.Content)
	}
	return out
}

func TestRememberChatFailedCallAppendsNothing(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{fail: errors.New("model down")}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	_, err := wrapped.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}})
	if err == nil {
		t.Fatalf("expected error")
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 0 {
		t.Fatalf("expected no events, got %d", len(events))
	}
}

func TestRememberStreamAppendsOnce(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{stream: sseAnswer("Hello", " world")}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	var chunks []ai.Chunk
	for c, err := range wrapped.Stream(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}) {
		if err != nil {
			t.Fatalf("Stream: %v", err)
		}
		chunks = append(chunks, c)
	}
	if len(chunks) != 3 {
		t.Fatalf("expected 3 chunks (2 text + 1 finish), got %d", len(chunks))
	}
	events := eventsOf(t, s, "s1")
	if len(events) != 2 {
		t.Fatalf("expected 2 events (user+reply), got %d", len(events))
	}
	m1 := events[1].Message ?? ai.Message{}
	if msgText(m1) != "Hello world" {
		t.Fatalf("wrong reply: %v", msgText(m1))
	}
}

func TestRememberStreamFailedCallAppendsNothing(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{fail: errors.New("stream cut")}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	var failures []error
	for _, err := range wrapped.Stream(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}) {
		if err != nil {
			failures = append(failures, err)
		}
	}
	if len(failures) != 1 {
		t.Fatalf("the stream gave the errors %v, want one error", failures)
	}
	if !errors.Is(failures[0], openai.ErrProviderError) {
		t.Fatalf("the stream error is not the provider fault: %v", failures[0])
	}
	if events := eventsOf(t, s, "s1"); len(events) != 0 {
		t.Fatalf("a stream that failed left %d events, want 0", len(events))
	}
}

func TestRememberRecordsATurnBesideAConcurrentTurn(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{chat: chatAnswer("Hello!")}
	model.during = func() { appendMsg(t, s, "s1", text("from another request")) }
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	if _, err := wrapped.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}); err != nil {
		t.Fatalf("Chat: %v", err)
	}
	stored, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	want := []string{"from another request", "Hi", "Hello!"}
	if got := describe(stored); !slices.Equal(got, want) {
		t.Fatalf("stored = %v, want %v", got, want)
	}
}

func TestRememberRecordsATurnWhenTheSessionExpiresDuringTheCall(t *testing.T) {
	var now sync.Locked[time.Time]
	now.WithLock(func(v *time.Time) {
		*v = time.Now()
	})
	at := func() time.Time {
		var out time.Time
		now.WithLock(func(v *time.Time) {
			out = *v
		})
		return out
	}
	s := &session.Service{TTL: time.Hour, Now: at}
	ensureSession(t, s, "s1")
	appendMsg(t, s, "s1", text("before the expiry"))
	model := &scripted{chat: chatAnswer("Hello!")}
	model.during = func() {
		now.WithLock(func(v *time.Time) {
			*v = v.Add(2 * time.Hour)
		})
	}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))
	if _, err := wrapped.Chat(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}); err != nil {
		t.Fatalf("Chat: %v", err)
	}
	stored, err := s.Active(t.Context(), "s1")
	if err != nil {
		t.Fatalf("Active: %v", err)
		return
	}
	want := []string{"Hi", "Hello!"}
	if got := describe(stored); !slices.Equal(got, want) {
		t.Fatalf("stored = %v, want the turn alone in a new session %v", got, want)
	}
}

func TestRememberStreamStoppedEarlyAppendsNothing(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{stream: sseAnswer("Hello", " world")}
	wrapped := session.Remember(s, "s1")(serveModel(t, model))

	for _, err := range wrapped.Stream(t.Context(), ai.Request{Messages: []ai.Message{text("Hi")}}) {
		if err != nil {
			t.Fatalf("Stream: %v", err)
		}
		break
	}
	if events := eventsOf(t, s, "s1"); len(events) != 0 {
		t.Fatalf("a stream that the caller stopped left %d events, want 0", len(events))
	}
}

func TestRememberRecordsADirectToolAnswer(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{answer: func(req wireReq) string {
		for _, m := range req.Messages {
			if len(m.ToolCalls) > 0 {
				return chatAnswer("It is a window seat.")
			}
		}
		return chatCallsAnswer("c1:weather")
	}}
	client := serveModel(t, model)

	reply, err := s.Run(t.Context(), "s1", session.Turn{
		Model: client,
		Request: ai.Request{
			Messages: []ai.Message{text("Is my seat a window seat?")},
			Tools: []ai.Tool{{
				Name:        "weather",
				Description: "look up a booking",
				Schema:      `{"type":"object","properties":{}}`,
				Call: func(ctx context.Context, arguments string) (string, error) {
					return "14C, a window seat", nil
				},
				Direct: true,
			}},
		},
		Limits: ai.Limits{},
	})
	if err != nil {
		t.Fatalf("Run: %v", err)
		return
	}
	if reply.Message.Role != ai.RoleTool {
		t.Fatalf("the direct reply has role %q, want tool", reply.Message.Role)
	}

	wrapped := session.Remember(s, "s1")(client)
	_, err = wrapped.Chat(t.Context(), ai.Request{
		Messages: []ai.Message{text("thanks")},
	})
	if err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	reqs := model.requests(t)
	if len(reqs) < 2 {
		t.Fatalf("the provider saw %d requests, want at least 2", len(reqs))
		return
	}
	requireCallBeforeResult(t, reqs[len(reqs)-1].Messages, "c1")
}

func requireCallBeforeResult(t *testing.T, messages []wireMsg, id string) {
	t.Helper()
	callAt, resultAt := -1, -1
	for i, m := range messages {
		if callsID(m, id) {
			callAt = i
		}
		if m.Role == "tool" && m.ToolCallID == id {
			resultAt = i
		}
	}
	if callAt < 0 || resultAt < 0 || resultAt < callAt {
		t.Fatalf("the prompt does not hold the call before its result: %v", describeWire(messages))
	}
}

func callsID(m wireMsg, id string) bool {
	if m.Role != "assistant" {
		return false
	}
	for _, c := range m.ToolCalls {
		if c.ID == id {
			return true
		}
	}
	return false
}

func confirmBooked(req wireReq) string {
	for _, m := range req.Messages {
		if m.Role == "tool" && m.ToolCallID == "c1" {
			return chatAnswer("Booked.")
		}
	}
	return chatCallsAnswer("c1:book_flight")
}

func TestRememberKeepsAResumedToolExchangeTogether(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	model := &scripted{answer: confirmBooked}
	client := serveModel(t, model)

	tools := []ai.Tool{{
		Name:        "book_flight",
		Description: "book a flight",
		Schema:      `{"type":"object","properties":{}}`,
		Call: func(ctx context.Context, arguments string) (string, error) {
			return "booked", nil
		},
		Confirm: true,
	}}
	wrapped := session.Remember(s, "s1")(client)

	_, err := ai.Run(t.Context(), wrapped, ai.Request{
		Messages: []ai.Message{text("Book me a flight.")},
		Tools:    tools,
	}, ai.Limits{})
	paused := &ai.ConfirmError{}
	if !errors.As(err, &paused) {
		t.Fatalf("Run error = %v, want a ConfirmError", err)
		return
	}

	appendMsg(t, s, "s1", text("unrelated question"))
	appendMsg(t, s, "s1", assistant("unrelated answer"))

	_, err = ai.Run(t.Context(), wrapped, ai.Request{
		Messages:  paused.Messages,
		Tools:     tools,
		Decisions: []ai.Decision{{Call: "c1"}},
		Resume:    &paused.Reply,
	}, ai.Limits{})
	if err != nil {
		t.Fatalf("resumed Run: %v", err)
	}

	_, err = ai.Run(t.Context(), wrapped, ai.Request{
		Messages: []ai.Message{text("what happened?")},
	}, ai.Limits{})
	if err != nil {
		t.Fatalf("Run: %v", err)
	}

	reqs := model.requests(t)
	if len(reqs) == 0 {
		t.Fatalf("the provider saw no request")
		return
	}
	requireCallBeforeResult(t, reqs[len(reqs)-1].Messages, "c1")
}

func TestRememberRestoresAResumedCallAfterExpiry(t *testing.T) {
	now := time.Now()
	s := &session.Service{TTL: time.Hour, Now: func() time.Time { return now }}
	ensureSession(t, s, "s1")
	model := &scripted{answer: confirmBooked}
	client := serveModel(t, model)
	tools := []ai.Tool{{
		Name:        "book_flight",
		Description: "book a flight",
		Schema:      `{"type":"object","properties":{}}`,
		Call: func(ctx context.Context, arguments string) (string, error) {
			return "booked", nil
		},
		Confirm: true,
	}}
	wrapped := session.Remember(s, "s1")(client)
	_, err := ai.Run(t.Context(), wrapped, ai.Request{
		Messages: []ai.Message{text("Book me a flight.")},
		Tools:    tools,
	}, ai.Limits{})
	paused := &ai.ConfirmError{}
	if !errors.As(err, &paused) {
		t.Fatalf("Run error = %v, want a ConfirmError", err)
		return
	}
	now = now.Add(2 * time.Hour)
	_, err = ai.Run(t.Context(), wrapped, ai.Request{
		Messages:  paused.Messages,
		Tools:     tools,
		Decisions: []ai.Decision{{Call: "c1"}},
		Resume:    &paused.Reply,
	}, ai.Limits{})
	if err != nil {
		t.Fatalf("resumed Run: %v", err)
	}
	_, err = wrapped.Chat(t.Context(), ai.Request{
		Messages: []ai.Message{text("what happened?")},
	})
	if err != nil {
		t.Fatalf("Chat: %v", err)
		return
	}
	reqs := model.requests(t)
	if len(reqs) == 0 {
		t.Fatalf("the provider saw no request")
		return
	}
	requireCallBeforeResult(t, reqs[len(reqs)-1].Messages, "c1")
}

func TestAppendRejectsAnEventOfAnotherSession(t *testing.T) {
	s := &session.Service{}
	ensureSession(t, s, "s1")
	foreign := session.Event{ID: "e0", Session: "s2", Type: session.EventMessage, Message: text("hi")}

	ok, err := s.Append(t.Context(), "s1", 0, foreign)

	if err == nil {
		t.Fatalf("Append took an event of session s2 into s1 (ok = %v)", ok)
	}
	if events := eventsOf(t, s, "s1"); len(events) != 0 {
		t.Fatalf("the refused append left %d events", len(events))
	}
}

