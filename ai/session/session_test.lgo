func TestHistoryDropsOrphanToolCall(t *testing.T) {
	stored := []ai.Message{text("Weather in Lisbon?"), toolCall("c1")}
	request := []ai.Message{text("And Porto?")}
	got := session.History(stored, request)
	want := []string{"Weather in Lisbon?", "And Porto?"}
	if !slices.Equal(describe(got), want) {
