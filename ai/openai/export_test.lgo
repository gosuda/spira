package openai

import (
	"errors"
	"time"
)
func IsStall(err error) bool {
	return isStall(err)
}

type IdleProbe struct {
	Resets int
	Fired  bool
	limit  time.Duration
	fire   func()
}

func (p *IdleProbe) Reset(d time.Duration) bool {
	p.Resets++
	p.limit = d
	return true
}

func (p *IdleProbe) Stop() bool {
	return true
}

func (p *IdleProbe) Fire() {
	p.Fired = true
	p.fire()
}

func (p *IdleProbe) Limit() time.Duration {
	return p.limit
}

func ArmIdleProbe(c *Client) (*IdleProbe, func()) {
	probe := &IdleProbe{}
	prev := c.idleTimer
	c.idleTimer = func(limit time.Duration, onIdle func()) (func(time.Duration) bool, func() bool) {
		probe.limit = limit
		probe.fire = onIdle
		return probe.Reset, probe.Stop
	}
	return probe, func() { c.idleTimer = prev }
}

func FaultDetail(err error) (status int, errType string, length int, ok bool) {
	detail := &statusDetail{}
	if !errors.As(err, &detail) {
		return 0, "", 0, false
	}
	if detail == nil {
		return 0, "", 0, false
	}
	return detail.status, detail.errType, detail.length, true
}
