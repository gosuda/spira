// Reference chat completion response, from the OpenAI chat completions reference.
const completionBody = `{
  "id": "chatcmpl-123",
  "object": "chat.completion",
  "created": 1694268190,
  "model": "gpt-6-astra",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": "Hello!"
      },
      "logprobs": null,
      "finish_reason": "stop"
    }
  ],
  "usage": {
    "prompt_tokens": 9,
    "completion_tokens": 12,
    "total_tokens": 21
  }
}`

// Reference event stream, from the OpenAI chat completions reference response example.
const ssePlain = `data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","system_fingerprint":"fp_44709d6fcb","choices":[{"index":0,"delta":{"role":"assistant","content":""},"logprobs":null,"finish_reason":null}]}

data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","system_fingerprint":"fp_44709d6fcb","choices":[{"index":0,"delta":{"content":"Hello"},"logprobs":null,"finish_reason":null}]}

data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","system_fingerprint":"fp_44709d6fcb","choices":[{"index":0,"delta":{},"logprobs":null,"finish_reason":"stop"}]}

data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","system_fingerprint":"fp_44709d6fcb","choices":[],"usage":{"prompt_tokens":9,"completion_tokens":12,"total_tokens":21}}

data: [DONE]

`

// One tool call assembled from fragments across three chunks, per the
// delta.tool_calls shape of the OpenAI chat completions reference.
const sseToolFragments = `data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call_abc","type":"function","function":{"name":"get_weather","arguments":""}}]},"finish_reason":null}]}

data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"function":{"arguments":"{\"ci"}}]},"finish_reason":null}]}

data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"function":{"arguments":"ty\":\"Seoul\"}"}}]},"finish_reason":"tool_calls"}]}

data: [DONE]

`

// A stream cut before [DONE].
const sseCut = `data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","choices":[{"index":0,"delta":{"content":"Hel"},"finish_reason":null}]}

data: {"id":"chatcmpl-123","object":"chat.completion.chunk","created":1694268190,"model":"gpt-6-astra","choices":[{"index":0,"delta":{"content":"lo"},"finish_reason":null}]}

`

// DeepSeek answers carry reasoning_content, per the DeepSeek create-chat-completion reference.
const deepseekBody = `{
  "id": "e15a4e32",
  "object": "chat.completion",
  "created": 1694268190,
  "model": "deepseek-chat",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": "Paris.",
        "reasoning_content": "The capital of France is Paris."
      },
      "finish_reason": "stop"
    }
  ],
  "usage": {
    "prompt_tokens": 8,
    "completion_tokens": 30,
    "total_tokens": 38
  }
}`

// Mistral answers can carry content as a chunk array, per the Mistral chat reference.
const mistralBody = `{
  "id": "0b6d7b",
  "object": "chat.completion",
  "created": 1694268190,
  "model": "mistral-large-latest",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": [
          {"type": "text", "text": "Hello"},
          {"type": "thinking", "thinking": [{"type": "text", "text": "ponder"}], "closed": true, "signature": "sig"}
        ]
      },
      "finish_reason": "stop"
    }
  ],
  "usage": {
    "prompt_tokens": 5,
    "completion_tokens": 6,
    "total_tokens": 11
  }
}`

// Reference embedding response, per the OpenAI embeddings reference (testdata/SOURCES).
// The data rows arrive out of index order to prove the vectors return in input order.
const embeddingBody = `{
  "object": "list",
  "data": [
    {"object": "embedding", "embedding": [4.0, 5.0, 6.0], "index": 1},
    {"object": "embedding", "embedding": [1.0, 2.0, 3.0], "index": 0}
  ],
  "model": "text-embedding-3-small",
  "usage": {"prompt_tokens": 6, "total_tokens": 6}
}`

func testClient(srv *httptest.Server) *openai.Client {
	return &openai.Client{
		BaseURL: srv.URL,
		Model:   "gpt-6-astra",
		HTTP:    srv.Client(),
		Policy:  resilience.Policy{Timeout: 2 * time.Second, Retry: resilience.Retry{Attempts: 3, Base: time.Millisecond, Max: 2 * time.Millisecond}},
	}
}

type recorder struct {
	mu     sync.Mutex
	bodies []string
	auths  []string
	paths  []string
}

func (r *recorder) add(req *http.Request, body string) {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.bodies = append(r.bodies, body)
	r.auths = append(r.auths, req.Header.Get("Authorization"))
	r.paths = append(r.paths, req.URL.Path)
}

func (r *recorder) count() int {
	r.mu.Lock()
	defer r.mu.Unlock()
	return len(r.bodies)
}

func (r *recorder) body(i int) string {
	r.mu.Lock()
	defer r.mu.Unlock()
	return r.bodies[i]
}

func (rec *recorder) serve(t *testing.T, status int, contentType string, body string) *httptest.Server {
	t.Helper()
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		w.Header().Set("Content-Type", contentType)
		if status != http.StatusOK {
			w.WriteHeader(status)
		}
		if _, err := io.WriteString(w, body); err != nil {
			t.Errorf("server write: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	return srv
}

func canonical(t *testing.T, raw string) string {
	t.Helper()
	var v any
	if err := json.Unmarshal([]byte(raw), &v); err != nil {
		t.Fatalf("decode %q: %v", raw, err)
	}
	out, err := json.Marshal(v, json.Deterministic(true))
	if err != nil {
		t.Fatalf("encode: %v", err)
	}
	return string(out)
}

func gather(seq iter.Seq2[ai.Chunk, error]) ([]ai.Chunk, error) {
	var out []ai.Chunk
	var first error
	for chunk, err := range seq {
		if err != nil && first == nil {
			first = err
		}
		out = append(out, chunk)
	}
	return out, first
}

func TestChatReplies(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", completionBody)
	c := testClient(srv)
	reply, err := c.Chat(context.Background(), ai.Request{
		Model:    "gpt-6-astra",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Say hello"}}}},
	})
	if err != nil {
		t.Fatalf("chat: %v", err)
		return
	}
	if reply.ID != "chatcmpl-123" || reply.Model != "gpt-6-astra" {
		t.Fatalf("reply identity: %+v", reply)
	}
	if reply.Finish != ai.FinishCompleted {
		t.Fatalf("finish: %+v", reply.Finish)
	}
	if reply.Usage != (ai.Usage{Input: 9, Output: 12, Total: 21}) {
		t.Fatalf("usage: %+v", reply.Usage)
	}
	if len(reply.Message.Parts) != 1 {
		t.Fatalf("parts: %+v", reply.Message.Parts)
	}
	if text, ok := reply.Message.Parts[0].(ai.Text); !ok || text.Text != "Hello!" {
		t.Fatalf("text part: %+v", reply.Message.Parts[0])
	}
	if rec.paths[0] != "/chat/completions" {
		t.Fatalf("path: %s", rec.paths[0])
	}
	if rec.auths[0] != "" {
		t.Fatalf("unexpected auth header: %s", rec.auths[0])
	}
}

func TestChatRequestWithToolIsTheReferenceOracle(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", completionBody)
	c := testClient(srv)
	tool := ai.Tool{
		Name:        "get_weather",
		Description: "Get the weather of a city",
		Schema:      `{"type":"object","properties":{"city":{"type":"string"}},"required":["city"]}`,
	}
	_, err := c.Chat(context.Background(), ai.Request{
		Model:    "gpt-6-astra",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "What is the weather in Seoul?"}}}},
		Tools:    []ai.Tool{tool},
	})
	if err != nil {
		t.Fatalf("chat: %v", err)
	}
	want := canonical(t, `{
	  "model": "gpt-6-astra",
	  "messages": [{"role":"user","content":"What is the weather in Seoul?"}],
	  "stream": false,
	  "tools": [{"type":"function","function":{"name":"get_weather","description":"Get the weather of a city","parameters":{"type":"object","properties":{"city":{"type":"string"}},"required":["city"]}}}]
	}`)
	if got := canonical(t, rec.body(0)); got != want {
		t.Fatalf("request body:\n got %s\nwant %s", got, want)
	}
}

func TestStreamCollectsTheReferenceReply(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "text/event-stream", ssePlain)
	c := testClient(srv)
	reply, err := ai.Collect(c.Stream(context.Background(), ai.Request{
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Say hello"}}}},
	}))
	if err != nil {
		t.Fatalf("collect: %v", err)
		return
	}
	var text strings.Builder
	for _, p := range reply.Message.Parts {
		if t, ok := p.(ai.Text); ok {
			text.WriteString(t.Text)
		}
	}
	if text.String() != "Hello" {
		t.Fatalf("stream text: %q", text.String())
	}
	if reply.Finish != ai.FinishCompleted {
		t.Fatalf("finish: %+v", reply.Finish)
	}
	if reply.Usage != (ai.Usage{Input: 9, Output: 12, Total: 21}) {
		t.Fatalf("usage: %+v", reply.Usage)
	}
	if reply.ID != "chatcmpl-123" || reply.Model != "gpt-6-astra" {
		t.Fatalf("reply identity: %+v", reply)
	}
	if rec.paths[0] != "/chat/completions" {
		t.Fatalf("path: %s", rec.paths[0])
	}
}

func TestStreamToolCallAssemblesFragments(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "text/event-stream", sseToolFragments)
	c := testClient(srv)
	reply, err := ai.Collect(c.Stream(context.Background(), ai.Request{
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Weather in Seoul?"}}}},
	}))
	if err != nil {
		t.Fatalf("collect: %v", err)
		return
	}
	if reply.Finish != ai.FinishToolCall {
		t.Fatalf("finish: %+v", reply.Finish)
	}
	var calls []ai.ToolCall
	for _, p := range reply.Message.Parts {
		if call, ok := p.(ai.ToolCall); ok {
			calls = append(calls, call)
		}
	}
	if len(calls) != 1 {
		t.Fatalf("tool calls: %+v", reply.Message.Parts)
	}
	call := calls[0]
	if call.ID != "call_abc" || call.Name != "get_weather" || call.Arguments != `{"city":"Seoul"}` {
		t.Fatalf("assembled call: %+v", call)
	}
}

func TestStreamEndsAtDoneWhileTheBodyStaysOpen(t *testing.T) {
	rec := &recorder{}
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		w.Header().Set("Content-Type", "text/event-stream")
		if _, err := io.WriteString(w, ssePlain); err != nil {
			t.Errorf("server write: %v", err)
		}
		if f, ok := w.(http.Flusher); ok {
			f.Flush()
		}
		<-r.Context().Done()
	}))
	t.Cleanup(srv.Close)
	c := testClient(srv)
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	start := time.Now()
	reply, err := ai.Collect(c.Stream(ctx, ai.Request{
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Say hello"}}}},
	}))
	if err != nil {
		t.Fatalf("collect: %v", err)
		return
	}
	if reply.Finish != ai.FinishCompleted {
		t.Fatalf("finish: %+v", reply.Finish)
	}
	if waited := time.Since(start); waited > 2*time.Second {
		t.Fatalf("Collect returned after %v: the stream waited for the body to close", waited)
	}
}

func TestCutStreamYieldsErrorChunkAndNoReply(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "text/event-stream", sseCut)
	c := testClient(srv)
	_, err := gather(c.Stream(context.Background(), ai.Request{
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Say hello"}}}},
	}))
	if err == nil {
		t.Fatal("expected an error chunk")
	}
	if !strings.Contains(err.Error(), "[DONE]") {
		t.Fatalf("error: %v", err)
	}
	if _, cerr := ai.Collect(c.Stream(context.Background(), ai.Request{
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Say hello"}}}},
	})); cerr == nil {
		t.Fatal("collect over a cut stream returned no error")
	}
}

func TestEmbeddingsReturnVectorsInInputOrder(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", embeddingBody)
	c := testClient(srv)
	c.Model = "text-embedding-3-small"
	vectors, err := c.Embed(context.Background(), []string{"first", "second"})
	if err != nil {
		t.Fatalf("embed: %v", err)
		return
	}
	if len(vectors) != 2 {
		t.Fatalf("vectors: %v", vectors)
	}
	if len(vectors[0]) != 3 || vectors[0][0] != 1 || vectors[0][2] != 3 {
		t.Fatalf("first vector: %v", vectors[0])
	}
	if len(vectors[1]) != 3 || vectors[1][0] != 4 || vectors[1][2] != 6 {
		t.Fatalf("second vector: %v", vectors[1])
	}
	want := canonical(t, `{"model":"text-embedding-3-small","input":["first","second"],"encoding_format":"float"}`)
	if got := canonical(t, rec.body(0)); got != want {
		t.Fatalf("request body:\n got %s\nwant %s", got, want)
	}
	if rec.paths[0] != "/embeddings" {
		t.Fatalf("path: %s", rec.paths[0])
	}
}

func TestEmbeddingIndexOutsideTheAnswerIsAnError(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", `{"object":"list","data":[{"object":"embedding","index":2,"embedding":[1,2,3]},{"object":"embedding","index":0,"embedding":[4,5,6]}]}`)
	_, err := testClient(srv).Embed(context.Background(), []string{"first", "second"})
	if err == nil || err.Error() != "ai/openai: embedding index 2 is outside the 2 vectors of the answer" {
		t.Fatalf("err = %v, want the error that names index 2 and the 2 vectors", err)
	}
}

func embedOversizeBody() string {
	row := "[" + strings.Repeat("0.12345678,", 160000-1) + "0.12345678]"
	return `{"object":"list","model":"text-embedding-3-small","data":[{"object":"embedding","index":0,"embedding":` + row + `}]}`
}

func TestEmbedBodyOverItsLimitIsFinal(t *testing.T) {
	body := embedOversizeBody()
	if len(body) <= (1<<20)+128<<10 {
		t.Fatalf("test body holds %d bytes, want more than the embedding limit", len(body))
	}
	rec := &recorder{}
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		w.Header().Set("Content-Type", "application/json")
		if _, err := io.WriteString(w, body); err != nil {
			t.Logf("server write ended when the client stopped at its limit: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	c := testClient(srv)
	c.Model = "text-embedding-3-small"
	_, err := c.Embed(context.Background(), []string{"one"})
	if err == nil {
		t.Fatal("expected the size limit error")
	}
	if !strings.Contains(err.Error(), "ai/openai: response exceeds the size limit of 1179648 bytes") {
		t.Fatalf("error: %v", err)
	}
	if rec.count() != 1 {
		t.Fatalf("oversize body was retried: %d requests", rec.count())
	}
}

func TestDeepSeekReasoningPart(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", deepseekBody)
	c := testClient(srv)
	c.Model = "deepseek-chat"
	reply, err := c.Chat(context.Background(), ai.Request{
		Model:    "deepseek-chat",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Capital of France?"}}}},
	})
	if err != nil {
		t.Fatalf("chat: %v", err)
		return
	}
	if len(reply.Message.Parts) != 2 {
		t.Fatalf("parts: %+v", reply.Message.Parts)
	}
	text, ok := reply.Message.Parts[0].(ai.Text)
	if !ok || text.Text != "Paris." {
		t.Fatalf("text part: %+v", reply.Message.Parts[0])
	}
	reasoning, ok := reply.Message.Parts[1].(ai.Reasoning)
	if !ok || reasoning.Text != "The capital of France is Paris." {
		t.Fatalf("reasoning part: %+v", reply.Message.Parts[1])
	}
}

func TestMistralChunkArrayContentAndOptions(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", mistralBody)
	c := testClient(srv)
	c.Model = "mistral-large-latest"
	c.SafePrompt = true
	c.RandomSeed = 42
	reply, err := c.Chat(context.Background(), ai.Request{
		Model:       "mistral-large-latest",
		Temperature: ptr(0.5),
		Messages:    []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "Hello"}}}},
	})
	if err != nil {
		t.Fatalf("chat: %v", err)
		return
	}
	if len(reply.Message.Parts) != 2 {
		t.Fatalf("parts: %+v", reply.Message.Parts)
	}
	if text, ok := reply.Message.Parts[0].(ai.Text); !ok || text.Text != "Hello" {
		t.Fatalf("text part: %+v", reply.Message.Parts[0])
	}
	reasoning, ok := reply.Message.Parts[1].(ai.Reasoning)
	if !ok || reasoning.Text != "ponder" {
		t.Fatalf("reasoning part: %+v", reply.Message.Parts[1])
	}
	want := canonical(t, `{"model":"mistral-large-latest","messages":[{"role":"user","content":"Hello"}],"stream":false,"temperature":0.5,"safe_prompt":true,"random_seed":42}`)
	if got := canonical(t, rec.body(0)); got != want {
		t.Fatalf("request body:\n got %s\nwant %s", got, want)
	}
}

func TestFormatGoesOutAsJSONObjectOrSchema(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusOK, "application/json", completionBody)
	c := testClient(srv)
	chat := func(format string) {
		t.Helper()
		if _, err := c.Chat(context.Background(), ai.Request{
			Model:    "gpt-6-astra",
			Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
			Format:   format,
		}); err != nil {
			t.Fatalf("chat with format %q: %v", format, err)
		}
	}
	formatOf := func(i int) map[string]any {
		t.Helper()
		var body struct {
			Format map[string]any `json:"response_format"`
		}
		if err := json.Unmarshal([]byte(rec.body(i)), &body); err != nil {
			t.Fatalf("request body %d: %v", i, err)
		}
		return body.Format
	}
	chat("json")
	if got := canonical(t, mustJSON(t, formatOf(0))); got != `{"type":"json_object"}` {
		t.Fatalf("response_format = %s, want json_object", got)
	}
	schema := `{"type":"object","required":["city"]}`
	chat(schema)
	want := canonical(t, `{"type":"json_schema","json_schema":{"name":"response","schema":{"type":"object","required":["city"]},"strict":true}}`)
	if got := canonical(t, mustJSON(t, formatOf(1))); got != want {
		t.Fatalf("response_format = %s, want %s", got, want)
	}
	sent := rec.count()
	for _, bad := range []string{`"type"`, `{"type":`, `[1]`, `null`} {
		if _, err := c.Chat(context.Background(), ai.Request{
			Model:    "gpt-6-astra",
			Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
			Format:   bad,
		}); err == nil || !strings.Contains(err.Error(), "ai/openai: format is not json") {
			t.Fatalf("chat with format %s: err = %v, want the format error", bad, err)
		}
	}
	if rec.count() != sent {
		t.Fatalf("a bad format reached the server %d times", rec.count()-sent)
	}
}

func mustJSON(t *testing.T, v any) string {
	t.Helper()
	out, err := json.Marshal(v)
	if err != nil {
		t.Fatalf("marshal: %v", err)
	}
	return string(out)
}

func ptr(v float64) float64? {
	return v
}

func TestUnauthorizedIsFinal(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusUnauthorized, "application/json", `{"error":{"message":"Incorrect API key provided","type":"invalid_request_error"}}`)
	c := testClient(srv)
	_, err := c.Chat(context.Background(), ai.Request{
		Model:    "gpt-6-astra",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
	})
	if err == nil {
		t.Fatal("expected an error")
	}
	if got, want := err.Error(), `ai/openai: 401: {"error":{"message":"Incorrect API key provided","type":"invalid_request_error"}}`; got != want {
		t.Fatalf("error:\n got %s\nwant %s", got, want)
	}
	if rec.count() != 1 {
		t.Fatalf("401 was retried: %d requests", rec.count())
	}
}

func TestRateLimitedIsRetried(t *testing.T) {
	rec := &recorder{}
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		if rec.count() == 1 {
			w.Header().Set("Content-Type", "application/json")
			w.WriteHeader(http.StatusTooManyRequests)
			if _, err := io.WriteString(w, `{"error":{"message":"Rate limit reached"}}`); err != nil {
				t.Errorf("server write: %v", err)
			}
			return
		}
		w.Header().Set("Content-Type", "application/json")
		if _, err := io.WriteString(w, completionBody); err != nil {
			t.Errorf("server write: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	c := testClient(srv)
	reply, err := c.Chat(context.Background(), ai.Request{
		Model:    "gpt-6-astra",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
	})
	if err != nil {
		t.Fatalf("chat after retry: %v", err)
		return
	}
	if reply.ID != "chatcmpl-123" {
		t.Fatalf("reply: %+v", reply)
	}
	if rec.count() != 2 {
		t.Fatalf("requests: %d", rec.count())
	}
}

func TestServerErrorIsRetried(t *testing.T) {
	rec := &recorder{}
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		if rec.count() == 1 {
			w.Header().Set("Content-Type", "application/json")
			w.WriteHeader(http.StatusInternalServerError)
			if _, err := io.WriteString(w, `{"error":{"message":"The server had an error"}}`); err != nil {
				t.Errorf("server write: %v", err)
			}
			return
		}
		w.Header().Set("Content-Type", "application/json")
		if _, err := io.WriteString(w, completionBody); err != nil {
			t.Errorf("server write: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	c := testClient(srv)
	_, err := c.Chat(context.Background(), ai.Request{
		Model:    "gpt-6-astra",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
	})
	if err != nil {
		t.Fatalf("chat after retry: %v", err)
	}
	if rec.count() != 2 {
		t.Fatalf("requests: %d", rec.count())
	}
}

func TestClientErrorAddsNoResultToTheBreaker(t *testing.T) {
	statuses := []int{http.StatusInternalServerError, http.StatusInternalServerError, http.StatusBadRequest}
	rec := &recorder{}
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		n := rec.count()
		w.Header().Set("Content-Type", "application/json")
		if n <= len(statuses) {
			w.WriteHeader(statuses[n-1])
			if _, err := io.WriteString(w, `{"error":{"message":"refused"}}`); err != nil {
				t.Errorf("server write: %v", err)
			}
			return
		}
		if _, err := io.WriteString(w, completionBody); err != nil {
			t.Errorf("server write: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	c := testClient(srv)
	c.Policy = resilience.Policy{Timeout: 2 * time.Second, Breaker: &resilience.Breaker{Window: 3, FailureRate: 0.5, OpenFor: time.Hour}}
	for range statuses {
		if _, err := c.Chat(context.Background(), ai.Request{Model: "gpt-6-astra"}); err == nil {
			t.Fatal("err=nil, want the failing answer")
		}
	}
	reply, err := c.Chat(context.Background(), ai.Request{Model: "gpt-6-astra"})
	if err != nil {
		t.Fatalf("err = %v, want a reply: two 500 answers and a 400 must not fill a window of three", err)
		return
	}
	if reply.ID != "chatcmpl-123" {
		t.Fatalf("reply: %+v", reply)
	}
	if rec.count() != 4 {
		t.Fatalf("server saw %d calls, want 4", rec.count())
	}
}

func TestFailingStatusBodyIsCutAtOneMiB(t *testing.T) {
	body := strings.Repeat("x", (1<<20)+(512<<10))
	rec := &recorder{}
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, err := io.ReadAll(r.Body)
		if err != nil {
			t.Errorf("server read: %v", err)
		}
		rec.add(r, string(raw))
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusInternalServerError)
		if _, err := io.WriteString(w, body); err != nil {
			t.Errorf("server write: %v", err)
		}
	}))
	t.Cleanup(srv.Close)
	c := testClient(srv)
	c.Policy = resilience.Policy{Timeout: 30 * time.Second, Retry: resilience.Retry{Attempts: 2}}
	_, err := c.Embed(context.Background(), make([]string, 8))
	if err == nil {
		t.Fatal("err=nil, want a failing status")
	}
	if !strings.HasPrefix(err.Error(), "ai/openai: 500: ") {
		t.Fatalf("error does not classify the status: %q", err.Error()[:64])
	}
	if len(err.Error()) > (1<<20)+64 {
		t.Fatalf("error holds %d bytes, want at most one mebibyte of body: the limit of this call is two mebibytes", len(err.Error()))
	}
	if rec.count() != 2 {
		t.Fatalf("server saw %d calls, want 2: the 500 is retried, not a caller fault", rec.count())
	}
}

func TestBadRequestIsFinal(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusBadRequest, "application/json", `{"error":{"message":"'model' is a required property"}}`)
	c := testClient(srv)
	_, err := c.Chat(context.Background(), ai.Request{
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
	})
	if err == nil {
		t.Fatal("expected an error")
	}
	if !strings.HasPrefix(err.Error(), "ai/openai: 400: ") {
		t.Fatalf("error: %v", err)
	}
	if rec.count() != 1 {
		t.Fatalf("400 was retried: %d requests", rec.count())
	}
}

func TestKeyNeverAppearsInError(t *testing.T) {
	rec := &recorder{}
	srv := rec.serve(t, http.StatusUnauthorized, "application/json", `{"error":{"message":"Incorrect API key provided"}}`)
	c := testClient(srv)
	c.Key = "sk-super-secret-value"
	c.Policy = resilience.Policy{Timeout: 2 * time.Second}
	_, err := c.Chat(context.Background(), ai.Request{
		Model:    "gpt-6-astra",
		Messages: []ai.Message{{Role: ai.RoleUser, Parts: []ai.Part{ai.Text{Text: "hi"}}}},
	})
	if err == nil {
		t.Fatal("expected an error")
	}
	if strings.Contains(err.Error(), "sk-super-secret-value") {
		t.Fatalf("error leaks the key: %v", err)
	}
	if rec.auths[0] != "Bearer sk-super-secret-value" {
		t.Fatalf("bearer header: %s", rec.auths[0])
	}
}
