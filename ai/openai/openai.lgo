package openai

import (
	"bufio"
	"bytes"
	"context"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"iter"
	"net/http"
	"strings"
	"time"

	"github.com/gosuda/spira/ai"
	"github.com/gosuda/spira/resilience"
)

type Client struct {
	BaseURL    string
	Model      string
	Key        string
	SafePrompt bool?
	RandomSeed int?
	HTTP       *http.Client
	Policy     resilience.Policy
	idleTimer  func(limit time.Duration, onIdle func()) (func(time.Duration) bool, func() bool)
}

func (c *Client) http() *http.Client {
	if h := c.HTTP; h != nil {
		return h
	}
	return http.DefaultClient
}

func (c *Client) Chat(ctx context.Context, req ai.Request) (ai.Reply, error) {
	payload, err := requestJSON(req, false, c)
	if err != nil {
		return ai.Reply{}, ErrInvalidRequest.Wrap(err)
	}
	out, err := send[chatResponse](ctx, c, exchange{path: "/chat/completions", payload: payload, limit: replyLimit})
	if err != nil {
		return ai.Reply{}, err
	}
	return replyOf(&out), nil
}

func (c *Client) newTimer(limit time.Duration, onIdle func()) (func(time.Duration) bool, func() bool) {
	if c.idleTimer != nil {
		return c.idleTimer(limit, onIdle)
	}
	return realIdleTimer(limit, onIdle)
}

func realIdleTimer(limit time.Duration, onIdle func()) (func(time.Duration) bool, func() bool) {
	timer := time.AfterFunc(limit, onIdle)
	return timer.Reset, timer.Stop
}
func (c *Client) Stream(ctx context.Context, req ai.Request) iter.Seq2[ai.Chunk, error] {
	payload, err := requestJSON(req, true, c)
	if err != nil {
		yield ai.Chunk{}, ErrInvalidRequest.Wrap(err)
		return
	}
	limit := c.Policy.Timeout
	if limit <= 0 {
		limit = 10 * time.Second
	}
	bounded, cancel := context.WithCancelCause(ctx)
	defer cancel(nil)
	reset, stop := c.newTimer(limit, func() {
		cancel(&stallError{limit: limit})
	})
	defer stop()
	status, body, err := c.do(bounded, "/chat/completions", payload)
	if err != nil {
		yield ai.Chunk{}, streamDoError(bounded, err)
		return
	}
	defer closeBody(body)
	if status < 200 || status > 299 {
		yield ai.Chunk{}, failure(bounded, status, body)
		return
	}
	alive := &touchReader{source: body, touch: func() { reset(limit) }}
	for chunk, err := range streamEvents(bounded, alive, func() { reset(limit) }) {
		stop()
		if err != nil {
			yield chunk, streamDoError(bounded, err)
			return
		}
		if cause := context.Cause(bounded); cause != nil {
			yield ai.Chunk{}, streamDoError(bounded, cause)
			return
		}
		yield chunk, nil
		if cause := context.Cause(bounded); cause != nil {
			yield ai.Chunk{}, streamDoError(bounded, cause)
			return
		}
		reset(limit)
	}
	if cause := context.Cause(bounded); cause != nil {
		yield ai.Chunk{}, streamDoError(bounded, cause)
		return
	}
}

func streamDoError(ctx context.Context, err error) error {
	if cause := context.Cause(ctx); cause != nil {
		return ErrProviderStreamCut.Wrap(cause)
	}
	if errors.Is(err, ErrProviderStreamCut) {
		return err
	}
	return ErrProviderError.Wrap(err)
}

func isStall(err error) bool {
	stall := &stallError{}
	return errors.As(err, &stall)
}

type stallError struct {
	limit time.Duration
}

func (e *stallError) Error() string {
	return fmt.Sprintf("ai/openai: no stream event for %s", e.limit)
}

func failure(ctx context.Context, status int, body io.Reader) error {
	data, err := io.ReadAll(io.LimitReader(body, replyLimit))
	detail := statusDetailOf(status, data)
	if err == nil {
		return classifyStatus(status, detail)
	}
	cause := context.Cause(ctx)
	if cause == nil {
		cause = err
	}
	return classifyStatus(status, fmt.Errorf("%w: body read ended early: %w", detail, cause))
}

func (c *Client) Embed(ctx context.Context, texts const []string) ([][]float32, error) {
	input := make([]string, len(texts))
	copy(input, texts)
	payload, err := json.Marshal(embedRequest{Model: c.Model, Input: input, EncodingFormat: "float"})
	if err != nil {
		return nil, ErrInvalidRequest.Wrap(fmt.Errorf("encode request: %w", err))
	}
	limit := replyLimit + int64(len(texts))*embedVectorLimit
	out, err := send[embedResponse](ctx, c, exchange{path: "/embeddings", payload: payload, limit: limit})
	if err != nil {
		return nil, err
	}
	vectors, verr := out.vectors()
	if verr != nil {
		return nil, ErrProviderError.Wrap(verr)
	}
	return vectors, nil
}

func closeBody(body io.Closer) {
	if err := body.Close(); err != nil {
		return
	}
}

const replyLimit = 1 << 20

const embedVectorLimit = 128 << 10

type exchange struct {
	path    string
	payload []byte
	limit   int64
}

func send[T any](ctx context.Context, c *Client, x exchange) (T, error) {
	var zero T
	return resilience.Do[T](ctx, c.Policy, func(actx context.Context) (T, error) {
		value, err := post[T](actx, c, x)
		if err == nil {
			return value, nil
		}
		if callerFault(err) || errors.Is(err, ErrProviderTooLarge) || errors.Is(err, ErrInvalidRequest) {
			return zero, resilience.Ignored(err)
		}
		return zero, err
	})
}

func callerFault(err error) bool {
	return errors.Is(err, ErrProviderRejected)
}
func post[T any](ctx context.Context, c *Client, x exchange) (T, error) {
	var zero T
	status, body, err := c.do(ctx, x.path, x.payload)
	if err != nil {
		return zero, ErrProviderError.Wrap(err)
	}
	defer body.Close()?
	if status < 200 || status > 299 {
		return zero, failure(ctx, status, body)
	}
	data, err := io.ReadAll(io.LimitReader(body, x.limit+1))
	if int64(len(data)) > x.limit {
		return zero, ErrProviderTooLarge.Wrap(fmt.Errorf("response size %d exceeds the limit %d", len(data), x.limit))
	}
	if err != nil {
		return zero, ErrProviderError.Wrap(fmt.Errorf("read response: %w", err))
	}
	var out T
	if err := json.Unmarshal(data, &out); err != nil {
		return zero, ErrProviderError.Wrap(fmt.Errorf("decode response: %w", err))
	}
	return out, nil
}

func (c *Client) do(ctx context.Context, path string, payload []byte) (int, io.ReadCloser, error) {
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.BaseURL+path, bytes.NewReader(payload))
	if err != nil {
		return 0, nil, fmt.Errorf("ai/openai: build request: %w", err)
	}
	req.Header.Set("Content-Type", "application/json")
	if c.Key != "" {
		req.Header.Set("Authorization", "Bearer "+c.Key)
	}
	resp, err := c.http().Do(req)
	if err != nil {
		return 0, nil, fmt.Errorf("ai/openai: %s: %w", path, err)
	}
	return resp.StatusCode, resp.Body, nil
}

func replyOf(resp *chatResponse) ai.Reply {
	finish := ai.FinishOther
	if f := resp.finish(); f != "" {
		finish = ai.FinishOf(f)
	}
	return ai.Reply{
		Message: ai.Message{Role: ai.RoleAssistant, Parts: resp.parts()},
		Finish:  finish,
		Usage:   resp.usageOf(),
		ID:      resp.ID,
		Model:   resp.Model,
	}
}

func requestJSON(req ai.Request, stream bool, c *Client) ([]byte, error) {
	body, err := requestOf(req, stream, c)
	if err != nil {
		return nil, err
	}
	payload, err := json.Marshal(body)
	if err != nil {
		return nil, fmt.Errorf("ai/openai: encode request: %w", err)
	}
	return payload, nil
}

func requestOf(req ai.Request, stream bool, c *Client) (map[string]any, error) {
	out := map[string]any{
		"model":    req.Model ?? c.Model,
		"stream":   stream,
	}
	if stream {
		out["stream_options"] = map[string]any{"include_usage": true}
	}
	messages, err := messagesOf(req.Messages)
	if err != nil {
		return nil, err
	}
	out["messages"] = messages
	if v := req.Temperature; v != nil {
		out["temperature"] = v ?? 0
	}
	if v := req.TopP; v != nil {
		out["top_p"] = v ?? 0
	}
	if v := req.TopK; v != nil {
		out["top_k"] = v ?? 0
	}
	if v := req.MaxTokens; v != nil {
		out["max_tokens"] = v ?? 0
	}
	if len(req.Stop) > 0 {
		out["stop"] = req.Stop
	}
	tools, err := toolsOf(req.Tools)
	if err != nil {
		return nil, err
	}
	if len(tools) > 0 {
		out["tools"] = tools
	}
	format, err := formatOf(req.Format ?? "")
	if err != nil {
		return nil, err
	}
	if format != nil {
		out["response_format"] = format
	}
	if v := c.SafePrompt; v != nil {
		out["safe_prompt"] = v ?? false
	}
	if v := c.RandomSeed; v != nil {
		out["random_seed"] = v ?? 0
	}
	return out, nil
}

func formatOf(format string) (map[string]any, error) {
	switch format {
	case "":
		return nil, nil
	case "json":
		return map[string]any{"type": "json_object"}, nil
	}
	var schema map[string]any
	if err := json.Unmarshal([]byte(format), &schema); err != nil || schema == nil {
		return nil, fmt.Errorf("ai/openai: format is not json and not a JSON schema")
	}
	return map[string]any{
		"type": "json_schema",
		"json_schema": map[string]any{
			"name":   "response",
			"schema": schema,
			"strict": true,
		},
	}, nil
}

func messagesOf(messages []ai.Message) ([]wireMessage, error) {
	var out []wireMessage
	for _, m := range messages {
		w, err := wireMessages(m)
		if err != nil {
			return nil, err
		}
		out = append(out, w...)
	}
	return out, nil
}

func wireMessages(m ai.Message) ([]wireMessage, error) {
	switch m.Role {
	case ai.RoleSystem:
		return []wireMessage{{Role: "system", Content: strPtr(textOf(m.Parts))}}, nil
	case ai.RoleUser:
		return []wireMessage{{Role: "user", Content: strPtr(textOf(m.Parts))}}, nil
	case ai.RoleAssistant:
		return []wireMessage{assistantOf(m)}, nil
	case ai.RoleTool:
		return toolMessages(m), nil
	}
	return nil, nil
}

func toolMessages(m ai.Message) []wireMessage {
	var out []wireMessage
	for _, p := range m.Parts {
		if tr, ok := p.(ai.ToolResult); ok {
			out = append(out, wireMessage{Role: "tool", Content: strPtr(tr.Content), ToolCallID: tr.ID})
		}
	}
	return out
}

func strPtr(s string) *string {
	return &s
}

func assistantOf(m ai.Message) wireMessage {
	w := wireMessage{Role: "assistant"}
	var text strings.Builder
	var reasoning strings.Builder
	for _, p := range m.Parts {
		switch v := p.(type) {
		case ai.Text:
			text.WriteString(v.Text)
		case ai.Reasoning:
			reasoning.WriteString(v.Text)
		case ai.ToolCall:
			w.ToolCalls = append(w.ToolCalls, wireReqCall{
				ID:       v.ID,
				Type:     "function",
				Function: wireReqCallFunc{Name: v.Name, Arguments: v.Arguments},
			})
		}
	}
	if text.Len() > 0 || len(w.ToolCalls) == 0 {
		content := text.String()
		w.Content = &content
	}
	if reasoning.Len() > 0 {
		w.ReasoningContent = reasoning.String()
	}
	return w
}

func textOf(parts []ai.Part) string {
	var b strings.Builder
	for _, p := range parts {
		if t, ok := p.(ai.Text); ok {
			b.WriteString(t.Text)
		}
	}
	return b.String()
}

func toolsOf(tools []ai.Tool) ([]wireTool, error) {
	if len(tools) == 0 {
		return nil, nil
	}
	var out []wireTool
	for _, t := range tools {
		var params map[string]any
		if t.Schema != "" {
			if err := json.Unmarshal([]byte(t.Schema), &params); err != nil {
				return nil, fmt.Errorf("ai/openai: tool %q schema: %w", t.Name, err)
			}
		}
		out = append(out, wireTool{Type: "function", Function: wireFunction{Name: t.Name, Description: t.Description, Parameters: params}})
	}
	return out, nil
}

type pendingCall struct {
	id        string
	name      string
	arguments strings.Builder
}

type streamState struct {
	calls   []*pendingCall
	byIndex map[int]*pendingCall
	finish  string
	usage   ai.Usage
	hasMeta bool
	done    bool
}

func (s *streamState) note(chunk *wireChunk) {
	if chunk.Usage != nil {
		s.usage = chunk.usageOf()
		s.hasMeta = true
	}
	for _, choice := range chunk.Choices {
		if choice.FinishReason != "" {
			s.finish = choice.FinishReason
			s.hasMeta = true
		}
		for _, call := range choice.Delta.ToolCalls {
			s.noteCall(call)
		}
	}
}

func (s *streamState) noteCall(call wireDeltaCall) {
	index := int(call.Index)
	fresh := &pendingCall{}
	pending := s.byIndex[index] ?? fresh
	if pending == fresh {
		s.byIndex[index] = fresh
		s.calls = append(s.calls, fresh)
	}
	if call.ID != "" {
		pending.id = call.ID
	}
	if call.Function.Name != "" {
		pending.name = call.Function.Name
	}
	pending.arguments.WriteString(call.Function.Arguments)
}

func (s *streamState) metaChunk(chunk *wireChunk) ai.Chunk {
	out := ai.Chunk{ID: chunk.ID, Model: chunk.Model}
	if s.finish != "" {
		out.Finish = ai.FinishOf(s.finish)
	}
	if s.hasMeta {
		out.Usage = s.usage
	}
	return out
}

func (s *streamState) flushCalls() iter.Seq2[ai.Chunk, error] {
	for _, pending := range s.calls {
		call := ai.ToolCall{ID: pending.id, Name: pending.name, Arguments: pending.arguments.String()}
		yield ai.Chunk{Part: ai.Part(call)}, nil
	}
}

func streamEvents(ctx context.Context, body io.Reader, touch func()) iter.Seq2[ai.Chunk, error] {
	lines := &lineReader{reader: bufio.NewReader(body)}
	state := &streamState{byIndex: map[int]*pendingCall{}}
	for {
		line, err := lines.next(touch)
		if err != nil {
			for chunk, cerr := range streamEnd(ctx, err, state) {
				yield chunk, cerr
			}
			return
		}
		if text := strings.TrimSpace(line); text != "" {
			for chunk, cerr := range eventLine(text, state) {
				yield chunk, cerr
			}
		}
		if state.done {
			return
		}
	}
}

type touchReader struct {
	source io.Reader
	touch  func()
}

func (r *touchReader) Read(p []byte) (int, error) {
	n, err := r.source.Read(p)
	if n > 0 {
		r.touch()
	}
	return n, err
}

type lineReader struct {
	reader  *bufio.Reader
	waiting bool
	lateErr error
}

func (l *lineReader) next(touch func()) (string, error) {
	if l.waiting {
		l.waiting = false
		return "", l.lateErr
	}
	line, err := l.reader.ReadString('\n')
	if len(line) > 0 {
		touch()
	}
	if err != nil && line != "" {
		l.lateErr = err
		l.waiting = true
		return line, nil
	}
	return line, err
}

func streamEnd(ctx context.Context, err error, state *streamState) iter.Seq2[ai.Chunk, error] {
	if state.done {
		return
	}
	if cause := context.Cause(ctx); cause != nil {
		yield ai.Chunk{}, ErrProviderStreamCut.Wrap(cause)
		return
	}
	for chunk, cerr := range endOfStream(state) {
		yield chunk, cerr
	}
}

func endOfStream(state *streamState) iter.Seq2[ai.Chunk, error] {
	for chunk, cerr := range state.flushCalls() {
		yield chunk, cerr
	}
	yield ai.Chunk{}, ErrProviderStreamCut.Err()
}

func eventLine(text string, state *streamState) iter.Seq2[ai.Chunk, error] {
	if !strings.HasPrefix(text, "data:") {
		return
	}
	data := strings.TrimSpace(strings.TrimPrefix(text, "data:"))
	if data == "[DONE]" {
		state.done = true
		for chunk, err := range state.flushCalls() {
			yield chunk, err
		}
		return
	}
	var chunk wireChunk
	if err := json.Unmarshal([]byte(data), &chunk); err != nil {
		yield ai.Chunk{}, ErrProviderStreamCut.Wrap(fmt.Errorf("decode stream event: %w", err))
		return
	}
	if chunk.Error != nil && len(chunk.Choices) == 0 {
		state.done = true
		var empty wireStreamError
		wireErr := *(chunk.Error ?? &empty)
		yield ai.Chunk{}, ErrProviderStreamCut.Wrap(&statusDetail{status: 200, errType: wireErr.Type, length: len(wireErr.Message)})
		return
	}
	for part, err := range deltaParts(&chunk) {
		yield part, err
		if err != nil {
			return
		}
	}
	state.note(&chunk)
	if state.hasMeta {
		yield state.metaChunk(&chunk), nil
		state.hasMeta = false
	}
}

func deltaParts(chunk *wireChunk) iter.Seq2[ai.Chunk, error] {
	for _, choice := range chunk.Choices {
		d := choice.Delta
		if d.Content.text != "" {
			yield ai.Chunk{Part: ai.Part(ai.Text{Text: d.Content.text}), Partial: true}, nil
		}
		for _, part := range chunkParts(d.Content.chunks) {
			yield ai.Chunk{Part: part, Partial: true}, nil
		}
		if d.ReasoningContent != "" {
			yield ai.Chunk{Part: ai.Part(ai.Reasoning{Text: d.ReasoningContent}), Partial: true}, nil
		}
		if d.Reasoning != "" {
			yield ai.Chunk{Part: ai.Part(ai.Reasoning{Text: d.Reasoning}), Partial: true}, nil
		}
	}
}
