package ai

import (
	"encoding/json/v2"
	"errors"
	"fmt"
	"strings"
)

var ErrEmpty = errors.New("ai: structured: empty answer")

var ErrTooLarge = errors.New("ai: structured: answer exceeds the size limit of 1048576 bytes")

var ErrUnterminatedFence = errors.New("ai: structured: unterminated code fence")

const structuredLimit = 1 << 20

func FormatInstruction() string {
	return "Your response should be in JSON format.\n" +
		"Do not include any explanations, only provide a RFC8259 compliant JSON response following this format without deviation.\n" +
		"Do not include markdown code blocks in your response.\n" +
		"Remove the ```json markdown from the output."
}

func Structured[T any](text string) (T, error) {
	var zero T
	if len(text) > structuredLimit {
		return zero, ErrTooLarge
	}
	doc, err := structuredDocument(text)
	if err != nil {
		return zero, err
	}
	var out T
	if uerr := json.Unmarshal([]byte(doc), &out); uerr != nil {
		return zero, fmt.Errorf("ai: structured: decode: %w", uerr)
	}
	return out, nil
}

func structuredDocument(text string) (string, error) {
	trimmed := strings.TrimSpace(text)
	if trimmed == "" {
		return "", ErrEmpty
	}
	if idx := strings.Index(trimmed, "```"); idx >= 0 {
		return fencedDocument(trimmed[idx:])
	}
	return trimmed, nil
}

func fencedDocument(from string) (string, error) {
	rest := from[3:]
	if nl := strings.Index(rest, "\n"); nl >= 0 {
		rest = rest[nl+1:]
	}
	end := strings.Index(rest, "```")
	if end < 0 {
		return "", ErrUnterminatedFence
	}
	inner := strings.TrimSpace(rest[:end])
	if inner == "" {
		return "", ErrEmpty
	}
	return inner, nil
}
