package rag_test

import (
	"context"
	"errors"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gosuda/spira/ai/openai"
	"github.com/gosuda/spira/ai/rag"
	"github.com/gosuda/spira/fault/faulttest"
	"github.com/gosuda/spira/resilience"
)

func TestRAGFaultsMatchSpecTable(t *testing.T) {
	faulttest.CheckTable(t, "../../docs/specs/ai-rag.md", rag.Faults())
}

func TestRAGFaultInvalidFilter(t *testing.T) {
	_, err := rag.ParseFilter("country === 'BG'")
	if !errors.Is(err, rag.ErrInvalidFilter) {
		t.Fatalf("error = %v, want the rag.invalid_filter fault", err)
	}
}

func TestRAGFaultInvalidRequest(t *testing.T) {
	_, err := rag.Split("hello world", rag.SplitOptions{ChunkSize: 0})
	if !errors.Is(err, rag.ErrInvalidRequest) {
		t.Fatalf("error = %v, want the rag.invalid_request fault", err)
	}
}

func TestRAGFaultTooLarge(t *testing.T) {
	_, err := rag.ReadText(strings.NewReader(strings.Repeat("x", (1<<20)+1)), "big.txt")
	if !errors.Is(err, rag.ErrTooLarge) {
		t.Fatalf("error = %v, want the rag.too_large fault", err)
	}
}

type refusingEmbed struct {
	message string
}

func (f refusingEmbed) Embed(ctx context.Context, texts const []string) ([][]float32, error) {
	return nil, errors.New(f.message)
}

func TestRAGFaultStoreFailed(t *testing.T) {
	secret := "sk-live-3k8secret"
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		http.Error(w, "embed refused: "+secret, http.StatusBadRequest)
	}))
	t.Cleanup(srv.Close)
	store := &rag.Memory{Embed: &openai.Client{BaseURL: srv.URL, Model: "text-embedding-3-small", HTTP: srv.Client(), Policy: resilience.Policy{}}}
	_, err := store.Search(context.Background(), rag.Search{Query: "q"})
	if !errors.Is(err, rag.ErrStoreFailed) {
		t.Fatalf("error = %v, want the rag.store_failed fault", err)
		return
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, err), secret)
}

func TestRAGFaultsHideSecretsAndHostileText(t *testing.T) {
	secret := "sk-live-6t4secret"
	hostile := "<script>alert(1)</script>'; DROP TABLE x; --"
	_, perr := rag.ParseFilter("country == '" + hostile)
	if perr == nil {
		t.Fatal("a hostile filter must fail to parse")
		return
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, perr), hostile, secret)
	store := &rag.Memory{Embed: refusingEmbed{message: secret}}
	_, serr := store.Search(context.Background(), rag.Search{Query: hostile, TopK: -1})
	if serr == nil {
		t.Fatal("a negative TopK must fail")
		return
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, serr), hostile, secret)
	parsed, ferr := rag.ParseFilter("country == 'BG'")
	if ferr != nil {
		t.Fatalf("ParseFilter: %v", ferr)
		return
	}
	fragment, _, ferr := rag.ProbeFilterSQL(parsed, 4)
	if ferr != nil {
		t.Fatalf("ProbeFilterSQL: %v", ferr)
		return
	}
	if fragment == "" {
		t.Fatal("ProbeFilterSQL returned no fragment")
	}
}
