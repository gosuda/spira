package rag

import "testing"

func TestDropReleasesTheTextAndMetadataOfTheRemovedDocument(t *testing.T) {
	s := &memory{dims: 2}
	for _, id := range []string{"a", "b", "c"} {
		s.put(Document{ID: id, Text: "text of " + id, Metadata: map[string]Value{"k": Text{Text: id}}}, []float32{1, 0}, 1)
	}

	for _, id := range []string{"a", "c", "b"} {
		s.drop(id)
	}

	if len(s.entries) != 0 {
		t.Fatalf("the store holds %d documents after each one was deleted", len(s.entries))
		return
	}
	for at, held := range s.entries[:3] {
		if held.id != "" || held.text != "" || held.meta != nil {
			t.Errorf("slot %d still holds document %q with text %q and metadata %v", at, held.id, held.text, held.meta)
		}
	}
}
