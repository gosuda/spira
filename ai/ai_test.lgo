package ai_test

import (
	"testing"

	"github.com/gosuda/spira/ai"
)

func TestFinishOfMapsEveryRawProviderString(t *testing.T) {
	cases := map[ai.Finish][]string{
		ai.FinishCompleted: {"stop", "end_turn", "STOP", "stop_sequence"},
		ai.FinishTruncated: {"length", "max_tokens", "MAX_TOKENS", "context_window_exceeded"},
		ai.FinishToolCall:  {"tool_calls", "tool_call", "tool_use", "TOOL_CALLS"},
		ai.FinishFiltered:  {"content_filter", "SAFETY", "RECITATION", "refusal", "PROHIBITED_CONTENT", "SPII", "BLOCKLIST"},
	}
	for want, raws := range cases {
		for _, raw := range raws {
			if got := ai.FinishOf(raw); got != want {
				t.Errorf("FinishOf(%q) = %q, want %q", raw, got, want)
			}
		}
	}
}

func TestFinishOfNeverCallsAnUnknownStringCompleted(t *testing.T) {
	for _, raw := range []string{"", "Stop", "done", "eos", "end", "error", "tool"} {
		if got := ai.FinishOf(raw); got != ai.FinishOther {
			t.Errorf("FinishOf(%q) = %q, want %q", raw, got, ai.FinishOther)
		}
	}
}
