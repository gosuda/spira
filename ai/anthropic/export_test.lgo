package anthropic

import "errors"

func FaultDetail(err error) (status int, errType string, length int, ok bool) {
	detail := &statusDetail{}
	if !errors.As(err, &detail) {
		return 0, "", 0, false
	}
	if detail == nil {
		return 0, "", 0, false
	}
	return detail.status, detail.errType, detail.length, true
}
