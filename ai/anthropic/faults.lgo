package anthropic

import (
	"encoding/json/v2"
	"errors"
	"fmt"
	"net/http"

	"github.com/gosuda/spira/fault"
)

var ErrProviderRejected = fault.New("anthropic.provider_rejected", fault.Invalid, "The model provider rejected the request.")

var ErrProviderRateLimited = fault.New("anthropic.provider_rate_limited", fault.RateLimited, "The model provider rate limited the request.")

var ErrProviderError = fault.New("anthropic.provider_error", fault.Unavailable, "The model provider returned an error.")

var ErrProviderTooLarge = fault.New("anthropic.provider_too_large", fault.TooLarge, "The provider response is too large.")

var ErrProviderStreamCut = fault.New("anthropic.provider_stream_cut", fault.Unavailable, "The model provider stream was cut.")

var ErrInvalidRequest = fault.New("anthropic.invalid_request", fault.Invalid, "The model request is invalid.")

var ErrTooManyRedirects = fault.New("anthropic.too_many_redirects", fault.Unavailable, "The provider request failed.")

func Faults() []*fault.Error {
	return []*fault.Error{ErrProviderRejected, ErrProviderRateLimited, ErrProviderError, ErrProviderTooLarge, ErrProviderStreamCut, ErrInvalidRequest, ErrTooManyRedirects}
}

type statusDetail struct {
	status  int
	errType string
	length  int
}

func (d *statusDetail) Error() string {
	if d.errType == "" {
		return fmt.Sprintf("provider status %d, body length %d", d.status, d.length)
	}
	return fmt.Sprintf("provider status %d, error type %q, body length %d", d.status, d.errType, d.length)
}

func statusDetailOf(status int, body []byte) *statusDetail {
	return &statusDetail{status: status, errType: errorTypeOf(body), length: len(body)}
}

func errorTypeOf(body []byte) string {
	var parsed struct {
		Error struct {
			Type string `json:"type"`
		} `json:"error"`
	}
	if err := json.Unmarshal(body, &parsed); err != nil {
		return ""
	}
	return parsed.Error.Type
}

func classifyStatus(status int, detail error) error {
	if status == http.StatusTooManyRequests {
		return ErrProviderRateLimited.Wrap(detail)
	}
	if status >= 400 && status < 500 && status != http.StatusRequestTimeout {
		return ErrProviderRejected.Wrap(detail)
	}
	return ErrProviderError.Wrap(detail)
}

func transportFault(err error) error {
	if errors.Is(err, errRedirects) {
		return ErrTooManyRedirects.Wrap(err)
	}
	return ErrProviderError.Wrap(err)
}
