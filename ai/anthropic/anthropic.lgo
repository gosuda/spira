package anthropic

import (
	"bufio"
	"bytes"
	"context"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"iter"
	"net/http"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/gosuda/spira/ai"
	"github.com/gosuda/spira/resilience"
)

const (
	apiPath          = "/v1/messages"
	apiVersion       = "2026-10-21"
	replyLimit       = 1 << 20
	defaultMaxTokens = 4096
)

type Client struct {
	BaseURL   string
	Key       string
	HTTP      *http.Client
	Policy    resilience.Policy
	MaxTokens int
}

func (c *Client) http() *http.Client {
	if h := c.HTTP; h != nil {
		return h
	}
	return http.DefaultClient
}

func (c *Client) payload(req ai.Request, stream bool) ([]byte, error) {
	fallback := defaultMaxTokens
	if c.MaxTokens > 0 {
		fallback = c.MaxTokens
	}
	wire, err := encodeChat(req, fallback, stream)
	if err != nil {
		return nil, err
	}
	payload, err := json.Marshal(wire)
	if err != nil {
		return nil, fmt.Errorf("ai/anthropic: encode request: %w", err)
	}
	return payload, nil
}
func (c *Client) Chat(ctx context.Context, req ai.Request) (ai.Reply, error) {
	payload, err := c.payload(req, false)
	if err != nil {
		return ai.Reply{}, ErrInvalidRequest.Wrap(err)
	}
	var hold time.Time
	budget := time.Duration(0)
	if retry := c.Policy.Retry; retry != nil {
		budget = retry.Max
	}
	out, err := resilience.Do[chatResponse](ctx, c.Policy, func(actx context.Context) (chatResponse, error) {
		if err := holdUntil(ctx, hold); err != nil {
			return chatResponse{}, ErrProviderError.Wrap(err)
		}
		value, err := c.post(actx, payload, budget)
		if err == nil {
			return value, nil
		}
		if wait := deferredWait(err); wait > 0 {
			when := time.Now().Add(wait)
			if when.After(hold) {
				hold = when
			}
		}
		if callerFault(err) || errors.Is(err, ErrProviderTooLarge) || errors.Is(err, ErrInvalidRequest) {
			return chatResponse{}, resilience.Ignored(err)
		}
		return chatResponse{}, err
	})
	if err != nil {
		return ai.Reply{}, err
	}
	return replyOf(&out), nil
}

func (c *Client) Stream(ctx context.Context, req ai.Request) iter.Seq2[ai.Chunk, error] {
	payload, err := c.payload(req, true)
	if err != nil {
		yield ai.Chunk{}, ErrInvalidRequest.Wrap(err)
		return
	}
	budget := time.Duration(0)
	if retry := c.Policy.Retry; retry != nil {
		budget = retry.Max
	}
	var hold time.Time
	head, err := resilience.Do[streamHead](ctx, c.Policy, func(actx context.Context) (streamHead, error) {
		if err := holdUntil(ctx, hold); err != nil {
			return streamHead{}, ErrProviderError.Wrap(err)
		}
		status, header, body, derr := c.do(actx, payload)
		if derr != nil {
			return streamHead{}, transportFault(derr)
		}
		if status >= 200 && status <= 299 {
			return streamHead{body: body}, nil
		}
		data, rerr := io.ReadAll(io.LimitReader(body, replyLimit))
		failure := classifyStatus(status, statusDetailOf(status, data))
		closeBody(body)
		if rerr != nil {
			failure = classifyStatus(status, fmt.Errorf("%w: body read ended early: %w", statusDetailOf(status, data), rerr))
		}
		if wait := retryWait(header, budget); wait > 0 {
			failure = &deferred{cause: failure, wait: wait}
		}
		if wait := deferredWait(failure); wait > 0 {
			when := time.Now().Add(wait)
			if when.After(hold) {
				hold = when
			}
		}
		if callerFault(failure) {
			return streamHead{}, resilience.Ignored(failure)
		}
		return streamHead{}, failure
	})
	if err != nil {
		yield ai.Chunk{}, err
		return
	}
	defer closeBody(head.body)
	for chunk, cerr := range streamEvents(ctx, head.body) {
		yield chunk, cerr
	}
}

type streamHead struct {
	body io.ReadCloser
}

func closeBody(body io.Closer) {
	if err := body.Close(); err != nil {
		return
	}
}

func callerFault(err error) bool {
	return errors.Is(err, ErrProviderRejected)
}

func (c *Client) post(ctx context.Context, payload []byte, budget time.Duration) (chatResponse, error) {
	status, header, body, err := c.do(ctx, payload)
	if err != nil {
		return chatResponse{}, transportFault(err)
	}
	defer body.Close()?
	data, rerr := io.ReadAll(io.LimitReader(body, replyLimit+1))
	if status < 200 || status > 299 {
		if len(data) > replyLimit {
			data = data[:replyLimit]
		}
		failure := classifyStatus(status, statusDetailOf(status, data))
		if rerr != nil {
			failure = classifyStatus(status, fmt.Errorf("%w: body read ended early: %w", statusDetailOf(status, data), rerr))
		}
		if wait := retryWait(header, budget); wait > 0 {
			return chatResponse{}, &deferred{cause: failure, wait: wait}
		}
		return chatResponse{}, failure
	}
	if len(data) > replyLimit {
		return chatResponse{}, ErrProviderTooLarge.Wrap(fmt.Errorf("response size %d exceeds the limit %d", len(data), replyLimit))
	}
	if rerr != nil {
		return chatResponse{}, ErrProviderError.Wrap(fmt.Errorf("read response: %w", rerr))
	}
	var out chatResponse
	if err := json.Unmarshal(data, &out); err != nil {
		return chatResponse{}, ErrProviderError.Wrap(fmt.Errorf("decode response: %w", err))
	}
	return out, nil
}

func (c *Client) do(ctx context.Context, payload []byte) (int, http.Header, io.ReadCloser, error) {
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.BaseURL+apiPath, bytes.NewReader(payload))
	if err != nil {
		return 0, nil, nil, fmt.Errorf("ai/anthropic: build request: %w", err)
	}
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("anthropic-version", apiVersion)
	if c.Key != "" {
		req.Header.Set("x-api-key", c.Key)
	}
	resp, err := c.guarded().Do(req)
	if err != nil {
		return 0, nil, nil, fmt.Errorf("ai/anthropic: %s: %w", apiPath, err)
	}
	return resp.StatusCode, resp.Header, resp.Body, nil
}

func (c *Client) guarded() *http.Client {
	base := c.http()
	if c.Key == "" {
		return base
	}
	next := base.CheckRedirect
	clone := *base
	clone.CheckRedirect = func(req *http.Request, via []*http.Request) error {
		if len(via) > 0 && !sameOrigin(req.URL, via[0].URL) {
			req.Header.Del("x-api-key")
		}
		if next != nil {
			return next(req, via)
		}
		if len(via) >= 10 {
			return errRedirects
		}
		return nil
	}
	return &clone
}

func sameOrigin(a *url.URL, b *url.URL) bool {
	return a.Scheme == b.Scheme && a.Host == b.Host
}

var errRedirects = errors.New("ai/anthropic: stopped after 10 redirects")

func holdUntil(ctx context.Context, at time.Time) error {
	wait := time.Until(at)
	if wait <= 0 {
		return nil
	}
	timer := time.NewTimer(wait)
	defer timer.Stop()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-timer.C:
		return nil
	}
}

func retryWait(header http.Header, budget time.Duration) time.Duration {
	raw := strings.TrimSpace(header.Get("Retry-After"))
	if raw == "" {
		return 0
	}
	wait := time.Duration(0)
	if secs, err := strconv.ParseInt(raw, 10, 64); err == nil && secs >= 0 {
		if secs > int64(maxWait)/int64(time.Second) {
			wait = maxWait
		} else {
			wait = time.Duration(secs) * time.Second
		}
	} else if at, err := http.ParseTime(raw); err == nil {
		wait = max(time.Until(at), 0)
	}
	if budget > 0 && wait > budget {
		return budget
	}
	return wait
}

const maxWait = 24 * time.Hour

type deferred struct {
	cause error
	wait  time.Duration
}

func (d *deferred) Error() string {
	return d.cause.Error()
}

func (d *deferred) Unwrap() error {
	return d.cause
}
func deferredWait(err error) time.Duration {
	noted := &deferred{}
	if errors.As(err, &noted) {
		return noted.wait
	}
	return 0
}

func streamEvents(ctx context.Context, body io.Reader) iter.Seq2[ai.Chunk, error] {
	reader := bufio.NewReader(body)
	state := &streamState{tools: map[int32]*toolBlock{}}
	for {
		line, rerr := reader.ReadString('\n')
		for chunk, err := range state.line(strings.TrimRight(line, "\r\n"), rerr != nil) {
			yield chunk, err
		}
		if state.ended {
			return
		}
		if rerr != nil {
			if err := ctx.Err(); err != nil {
				yield ai.Chunk{}, ErrProviderStreamCut.Wrap(err)
				return
			}
			yield ai.Chunk{}, ErrProviderStreamCut.Err()
			return
		}
		if err := ctx.Err(); err != nil {
			yield ai.Chunk{}, ErrProviderStreamCut.Wrap(err)
			return
		}
	}
}

type toolBlock struct {
	id        string
	name      string
	seed      string
	arguments strings.Builder
}

type streamState struct {
	ended    bool
	data     strings.Builder
	id       string
	model    string
	uncached int32
	output   int32
	read     int32
	created  int32
	finish   string
	tools    map[int32]*toolBlock
}

func (s *streamState) line(line string, last bool) iter.Seq2[ai.Chunk, error] {
	if name, isEvent := strings.CutPrefix(line, "event:"); isEvent && strings.TrimSpace(name) == "message_stop" {
		s.ended = true
		yield s.final(), nil
		return
	}
	if value, isData := strings.CutPrefix(line, "data:"); isData {
		s.data.WriteString(value)
		s.data.WriteByte('\n')
	}
	if line != "" && !last {
		return
	}
	data := s.data.String()
	s.data.Reset()
	if strings.TrimSpace(data) == "" {
		return
	}
	var ev wireEvent
	if err := json.Unmarshal([]byte(data), &ev); err != nil {
		s.ended = true
		yield ai.Chunk{}, ErrProviderStreamCut.Wrap(fmt.Errorf("decode stream event: %w", err))
		return
	}
	for chunk, err := range s.event(ev) {
		yield chunk, err
	}
}

func (s *streamState) event(ev wireEvent) iter.Seq2[ai.Chunk, error] {
	switch ev.Type {
	case "message_start":
		s.id = ev.Message.ID
		s.model = ev.Message.Model
		s.uncached = ev.Message.Usage.InputTokens
		s.output = ev.Message.Usage.OutputTokens
		s.read = ev.Message.Usage.CacheReadInputTokens
		s.created = ev.Message.Usage.CacheCreationInputTokens
		yield ai.Chunk{ID: s.id, Model: s.model, Usage: s.usage()}, nil
	case "content_block_start":
		if ev.ContentBlock.Type == "tool_use" {
			s.tools[ev.Index] = &toolBlock{id: ev.ContentBlock.ID, name: ev.ContentBlock.Name, seed: string(ev.ContentBlock.Input)}
		}
	case "content_block_delta":
		for chunk, err := range s.delta(ev) {
			yield chunk, err
		}
	case "content_block_stop":
		for chunk, err := range s.blockStop(ev.Index) {
			yield chunk, err
		}
	case "message_delta":
		s.messageDelta(ev)
	case "message_stop":
		s.ended = true
		yield s.final(), nil
	case "error":
		s.ended = true
		yield ai.Chunk{}, ErrProviderStreamCut.Wrap(&statusDetail{status: 200, errType: ev.Error.Type, length: len(ev.Error.Message)})
	}
}

func (s *streamState) delta(ev wireEvent) iter.Seq2[ai.Chunk, error] {
	switch ev.Delta.Type {
	case "text_delta":
		yield ai.Chunk{Part: ai.Part(ai.Text{Text: ev.Delta.Text}), Index: int(ev.Index), Partial: true}, nil
	case "thinking_delta":
		yield ai.Chunk{Part: ai.Part(ai.Reasoning{Text: ev.Delta.Thinking}), Index: int(ev.Index), Partial: true}, nil
	case "input_json_delta":
		if tool := s.tools[ev.Index]; tool != nil {
			tool.arguments.WriteString(ev.Delta.PartialJSON)
		}
	}
}

func (s *streamState) blockStop(index int32) iter.Seq2[ai.Chunk, error] {
	tool := s.tools[index]
	if tool == nil {
		return
	}
	delete(s.tools, index)
	args := tool.arguments.String()
	if strings.TrimSpace(args) == "" {
		args = "{}"
		if checked, cerr := rawJSON(tool.seed, "{}"); cerr == nil {
			args = string(checked)
		}
	}
	yield ai.Chunk{Part: ai.Part(ai.ToolCall{ID: tool.id, Name: tool.name, Arguments: args}), Index: int(index)}, nil
}

func (s *streamState) messageDelta(ev wireEvent) {
	if ev.Delta.StopReason != "" {
		s.finish = ev.Delta.StopReason
	}
	if ev.Usage.seenIn {
		s.uncached = ev.Usage.input
	}
	if ev.Usage.seenOut {
		s.output = ev.Usage.output
	}
	if ev.Usage.seenRd {
		s.read = ev.Usage.read
	}
	if ev.Usage.seenMk {
		s.created = ev.Usage.created
	}
}

func (s *streamState) usage() ai.Usage {
	input := int(s.uncached + s.read + s.created)
	output := int(s.output)
	return ai.Usage{Input: input, Output: output, Total: input + output}
}
func (s *streamState) final() ai.Chunk {
	finish := ai.FinishOther
	if s.finish != "" {
		finish = ai.FinishOf(s.finish)
	}
	return ai.Chunk{ID: s.id, Model: s.model, Usage: s.usage(), Finish: finish}
}

func inputTokens(u wireUsage) int32 {
	return u.InputTokens + u.CacheReadInputTokens + u.CacheCreationInputTokens
}
