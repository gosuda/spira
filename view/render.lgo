package view

import (
	"bytes"
	"context"
	"crypto/rand"
	"encoding/hex"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"net/http"
	"strings"

	"logos/sync"
)

var escaper = strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", `"`, "&#34;", "'", "&#39;")

func escapeHTML(s string) string {
	return escaper.Replace(s)
}

func safeURL(v string) string {
	stripped := stripControlAndSpace(v)
	i := strings.IndexAny(stripped, ":/?#")
	if i < 0 || stripped[i] != ':' {
		return v
	}
	switch strings.ToLower(stripped[:i]) {
	case "http", "https", "mailto", "tel":
		return v
	}
	return "about:invalid"
}

func stripControlAndSpace(v string) string {
	var b []byte
	for _, c := range []byte(v) {
		if c <= 0x20 || c == 0x7f {
			continue
		}
		b = append(b, c)
	}
	return string(b)
}

func validWhen(when string) bool {
	switch when {
	case "load", "visible", "idle":
		return true
	}
	return false
}

func isVoid(tag string) bool {
	switch tag {
	case "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr":
		return true
	}
	return false
}

func writeRaw(w io.Writer, s string) error {
	if _, err := io.WriteString(w, s); err != nil {
		return fmt.Errorf("view: write: %w", err)
	}
	return nil
}

func writeEscaped(w io.Writer, s string) error {
	return writeRaw(w, escapeHTML(s))
}

type slotTask struct {
	id    string
	later *Later
}

type slotRun struct {
	nonce string
	next  sync.Locked[int]
	tasks sync.Locked[[]slotTask]
	errs  sync.Locked[[]error]
}

type slotQueue struct {
	run   *slotRun
	found []slotTask
}

func slotNonce() (string, error) {
	var b [8]byte
	if _, err := rand.Read(b[:]); err != nil {
		return "", fmt.Errorf("view: slot nonce: %w", err)
	}
	return hex.EncodeToString(b[:]), nil
}

func (q *slotQueue) add(l *Later) string {
	var seq int
	q.run.next.WithLock(func(n *int) {
		seq = *n
		*n++
	})
	id := fmt.Sprintf("s%s-%d", q.run.nonce, seq)
	q.found = append(q.found, slotTask{id: id, later: l})
	return id
}

func (q *slotQueue) publish() {
	q.run.tasks.WithLock(func(ts *[]slotTask) {
		*ts = append(*ts, q.found...)
	})
}

func (r *slotRun) drain() []slotTask {
	var out []slotTask
	r.tasks.WithLock(func(ts *[]slotTask) {
		out = append(out, *ts...)
		*ts = nil
	})
	return out
}

func (r *slotRun) fail(id string, err error) {
	r.errs.WithLock(func(es *[]error) {
		*es = append(*es, fmt.Errorf("view: slot %s: %w", id, err))
	})
}

func (r *slotRun) joined() error {
	var errs []error
	r.errs.WithLock(func(es *[]error) {
		errs = append(errs, *es...)
	})
	return errors.Join(errs...)
}

type lockedWriter struct {
	inner sync.Locked[io.Writer]
}

func newLockedWriter(w io.Writer) *lockedWriter {
	lw := &lockedWriter{}
	lw.inner.WithLock(func(p *io.Writer) { *p = w })
	return lw
}

func (lw *lockedWriter) write(b []byte) error {
	var err error
	lw.inner.WithLock(func(p *io.Writer) {
		_, err = (*p).Write(b)
	})
	return err
}

func (lw *lockedWriter) flush() {
	lw.inner.WithLock(func(p *io.Writer) {
		if f, ok := (*p).(http.Flusher); ok {
			f.Flush()
		}
	})
}

func Render(ctx context.Context, w io.Writer, n Node) error {
	nonce, err := slotNonce()
	if err != nil {
		return err
	}
	run := &slotRun{nonce: nonce}
	q := &slotQueue{run: run}
	if e, ok := n.(Element); ok && e.tag == "html" {
		writeRaw(w, "<!doctype html>")?
	}
	if err := writeNode(w, n, q, ""); err != nil {
		return err
	}
	q.publish()
	if f, ok := w.(http.Flusher); ok {
		f.Flush()
	}
	return resolveSlots(ctx, run, w)
}

func resolveSlots(ctx context.Context, r *slotRun, w io.Writer) error {
	lw := newLockedWriter(w)
	for {
		tasks := r.drain()
		if len(tasks) == 0 {
			return r.joined()
		}
		r.runTasks(ctx, lw, tasks)?
	}
}

func (r *slotRun) runTasks(ctx context.Context, lw *lockedWriter, tasks []slotTask) error {
	go group (ctx, limit = 8) {
		for _, task := range tasks {
			go {
				r.resolve(ctx, lw, task)
			}
		}
	}
	return nil
}

func (r *slotRun) resolve(ctx context.Context, lw *lockedWriter, task slotTask) {
	node, err := resolveNode(ctx, task.later)
	if err != nil {
		r.failSlot(lw, task.id, err)
		return
	}
	nested := &slotQueue{run: r}
	var buf bytes.Buffer
	if err := writeNode(&buf, node, nested, ""); err != nil {
		r.failSlot(lw, task.id, err)
		return
	}
	out := append([]byte(`<template data-spira-slot="`+task.id+`">`), buf.Bytes()...)
	out = append(out, "</template>"...)
	if err := lw.write(out); err != nil {
		r.fail(task.id, err)
		return
	}
	lw.flush()
	nested.publish()
}

func resolveNode(ctx context.Context, l *Later) (node Node, err error) {
	defer func() {
		if r := recover(); r != nil {
			err = fmt.Errorf("resolver panicked: %v", r)
		}
	}()
	return l.Resolve(ctx)
}

func (r *slotRun) failSlot(lw *lockedWriter, id string, err error) {
	bad := []byte(`<template data-spira-slot="` + id + `"><spira-error></spira-error></template>`)
	if writeErr := lw.write(bad); writeErr != nil {
		err = errors.Join(err, writeErr)
	}
	lw.flush()
	r.fail(id, err)
}

func writeNode(w io.Writer, p Part, q *slotQueue, parent string) error {
	switch v := p.(type) {
	case Element:
		return writeElement(w, v, q)
	case Text:
		return writeEscaped(w, v.S)
	case Trusted:
		return writeRaw(w, v.HTML)
	case Group:
		return writeGroup(w, v, q, parent)
	case *Island:
		return writeIsland(w, v, q)
	case *Later:
		return writeSlot(w, v, q, parent)
	case Attribute:
		return nil
	case nil:
		return nil
	}
	return nil
}

func writeElement(w io.Writer, e Element, q *slotQueue) error {
	if isVoid(e.tag) {
		return writeOpen(w, e)
	}
	if err := writeOpen(w, e); err != nil {
		return err
	}
	if err := writeChildren(w, e.parts, q, e.tag); err != nil {
		return err
	}
	return writeRaw(w, "</"+e.tag+">")
}

func writeOpen(w io.Writer, e Element) error {
	if err := writeRaw(w, "<"+e.tag); err != nil {
		return err
	}
	if err := writeAttrs(w, e.parts); err != nil {
		return err
	}
	return writeRaw(w, ">")
}

func writeAttrs(w io.Writer, parts []Part) error {
	for _, p := range parts {
		if a, ok := p.(Attribute); ok {
			if err := writeAttr(w, a); err != nil {
				return err
			}
		}
	}
	return nil
}

func writeAttr(w io.Writer, a Attribute) error {
	if a.flag {
		return writeRaw(w, " "+a.name)
	}
	return writeValuedAttr(w, a)
}

func writeValuedAttr(w io.Writer, a Attribute) error {
	value := a.value
	switch strings.ToLower(a.name) {
	case "href", "src", "action", "formaction", "xlink:href", "data":
		value = safeURL(value)
	}
	if err := writeRaw(w, " "+a.name+`="`); err != nil {
		return err
	}
	if err := writeEscaped(w, value); err != nil {
		return err
	}
	return writeRaw(w, `"`)
}

func writeChildren(w io.Writer, parts []Part, q *slotQueue, parent string) error {
	for _, p := range parts {
		if err := writeNode(w, p, q, parent); err != nil {
			return err
		}
	}
	return nil
}

func writeGroup(w io.Writer, g Group, q *slotQueue, parent string) error {
	for _, n := range g.Nodes {
		if err := writeNode(w, n, q, parent); err != nil {
			return err
		}
	}
	return nil
}

func writeIsland(w io.Writer, i *Island, q *slotQueue) error {
	if !validWhen(i.When) {
		return fmt.Errorf("view: island %q: when %q is not load, visible or idle", i.Entry, i.When)
	}
	props, err := islandProps(i)
	if err != nil {
		return err
	}
	if err := writeIslandOpen(w, i, props); err != nil {
		return err
	}
	if fb := i.Fallback; fb != nil {
		if err := writeNode(w, fb, q, "spira-island"); err != nil {
			return err
		}
	}
	return writeRaw(w, "</spira-island>")
}

func islandProps(i *Island) ([]byte, error) {
	if i.Props == nil {
		return []byte("{}"), nil
	}
	props, err := json.Marshal(i.Props)
	if err != nil {
		return nil, fmt.Errorf("view: island %s props: %w", i.Entry, err)
	}
	if len(props) == 0 || props[0] != '{' {
		return nil, fmt.Errorf("view: island %s props must encode to a JSON object", i.Entry)
	}
	return props, nil
}

func writeIslandOpen(w io.Writer, i *Island, props []byte) error {
	if err := writeRaw(w, `<spira-island entry="`); err != nil {
		return err
	}
	if err := writeEscaped(w, i.Entry); err != nil {
		return err
	}
	if err := writeRaw(w, `" when="`); err != nil {
		return err
	}
	if err := writeEscaped(w, i.When); err != nil {
		return err
	}
	if err := writeRaw(w, `" props="`); err != nil {
		return err
	}
	if err := writeEscaped(w, string(props)); err != nil {
		return err
	}
	return writeRaw(w, `">`)
}

func parentForbidsSlot(parent string) bool {
	switch strings.ToLower(parent) {
	case "table", "thead", "tbody", "tfoot", "tr", "colgroup", "select":
		return true
	}
	return false
}

func writeSlot(w io.Writer, l *Later, q *slotQueue, parent string) error {
	if parentForbidsSlot(parent) {
		return laterInside(parent)
	}
	id := q.add(l)
	if err := writeRaw(w, `<spira-slot id="`+id+`">`); err != nil {
		return err
	}
	if err := writeNode(w, l.Fallback, q, parent); err != nil {
		return err
	}
	return writeRaw(w, "</spira-slot>")
}

func laterInside(parent string) error {
	return fmt.Errorf("view: Later inside <%s>: a browser moves a slot element out of this parent; defer the whole <%s>", parent, parent)
}

func CheckSlots(n Node) error {
	return slotPlacement(n, "")
}

func slotPlacement(p Part, parent string) error {
	switch v := p.(type) {
	case Element:
		return elementSlots(v)
	case Group:
		return groupSlots(v, parent)
	case *Island:
		if fb := v.Fallback; fb != nil {
			return slotPlacement(fb, "spira-island")
		}
	case *Later:
		if parentForbidsSlot(parent) {
			return laterInside(parent)
		}
		return slotPlacement(v.Fallback, parent)
	case Text:
	case Trusted:
	case Attribute:
	case nil:
	}
	return nil
}

func elementSlots(e Element) error {
	if isVoid(e.tag) {
		return nil
	}
	for _, p := range e.parts {
		slotPlacement(p, e.tag)?
	}
	return nil
}

func groupSlots(g Group, parent string) error {
	for _, n := range g.Nodes {
		slotPlacement(n, parent)?
	}
	return nil
}
