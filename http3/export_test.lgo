package http3

import (
	"github.com/quic-go/quic-go/http3"
)

func (s *Server) BoundTCPAddrForTest() string {
	var held *serverRun?
	s.state.WithLock(func(st *serverState) {
		held = st.run
	})
	run := held
	if run == nil {
		return ""
	}
	return run.tcpAddr
}

func (s *Server) BoundUDPAddrForTest() string {
	var held *serverRun?
	s.state.WithLock(func(st *serverState) {
		held = st.run
	})
	run := held
	if run == nil {
		return ""
	}
	return run.udpAddr
}

func (s *Server) H3ForTest() *http3.Server? {
	var held *serverRun?
	s.state.WithLock(func(st *serverState) {
		held = st.run
	})
	run := held
	if run == nil {
		return nil
	}
	return run.h3
}
