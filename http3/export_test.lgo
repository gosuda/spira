package http3

import (
	"context"
	"errors"
)

func (s *Server) BoundTCPAddrForTest() string {
	var held *serverRun?
	s.state.WithLock(func(st *serverState) {
		held = st.run
	})
	run := held
	if run == nil {
		return ""
	}
	return run.tcpAddr
}

func (s *Server) BoundUDPAddrForTest() string {
	var held *serverRun?
	s.state.WithLock(func(st *serverState) {
		held = st.run
	})
	run := held
	if run == nil {
		return ""
	}
	return run.udpAddr
}

func (s *Server) WaitH3ServeForTest(ctx context.Context) error {
	var held *serverRun?
	s.state.WithLock(func(st *serverState) { held = st.run })
	run := held
	if run == nil {
		return errors.New("http3: no active run")
	}
	select {
	case <-run.join.done:
		var err error
		run.join.err.WithLock(func(value *error) { err = *value })
		return err
	case <-ctx.Done():
		return ctx.Err()
	}
}
