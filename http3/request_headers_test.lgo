package http3_test

import (
	"bufio"
	"bytes"
	"errors"
	"io"
	"net/http"
	"slices"
	"strings"
	"testing"

	"github.com/gosuda/spira/http3"
	"github.com/quic-go/qpack"
)

func encodeH3TestFields(t *testing.T, fields []qpack.HeaderField) []byte {
	t.Helper()
	var block bytes.Buffer
	encoder := qpack.NewEncoder(&block)
	for _, field := range fields {
		if err := encoder.WriteField(field); err != nil {
			t.Fatal(err)
		}
	}
	if err := encoder.Close(); err != nil {
		t.Fatal(err)
	}
	return block.Bytes()
}

func h3TestRequestFields() []qpack.HeaderField {
	return []qpack.HeaderField{
		{Name: ":method", Value: "GET"},
		{Name: ":scheme", Value: "https"},
		{Name: ":authority", Value: "example.com"},
		{Name: ":path", Value: "/"},
	}
}

func TestDecodeH3RequestMatchesNetHTTP(t *testing.T) {
	const target = "/items/a%2Fb?view=full&tag=%23"
	fields := []qpack.HeaderField{
		{Name: ":method", Value: "POST"},
		{Name: ":scheme", Value: "https"},
		{Name: ":authority", Value: "example.com"},
		{Name: ":path", Value: target},
		{Name: "host", Value: "example.com"},
		{Name: "content-length", Value: "4"},
		{Name: "content-length", Value: "4, 04"},
		{Name: "cookie", Value: "a=1"},
		{Name: "cookie", Value: "b=2"},
		{Name: "x-multi", Value: "first"},
		{Name: "x-multi", Value: "second"},
	}
	got, err := http3.DecodeH3RequestForTest(encodeH3TestFields(t, fields), 1024)
	if err != nil {
		t.Fatalf("decode request: %v", err)
		return
	}
	if got == nil {
		t.Fatal("decode returned no request")
		return
	}
	const wire = "POST " + target + " HTTP/1.1\r\nHost: example.com\r\nContent-Length: 4\r\nCookie: a=1; b=2\r\nX-Multi: first\r\nX-Multi: second\r\n\r\nbody"
	want, err := http.ReadRequest(bufio.NewReader(strings.NewReader(wire)))
	if err != nil {
		t.Fatalf("read HTTP/1 oracle: %v", err)
		return
	}
	if got.Method != want.Method || got.Host != want.Host || got.RequestURI != want.RequestURI || got.ContentLength != want.ContentLength {
		t.Errorf("got %s %s %s length %d; want %s %s %s length %d", got.Method, got.Host, got.RequestURI, got.ContentLength, want.Method, want.Host, want.RequestURI, want.ContentLength)
	}
	gotURL, wantURL := got.URL, want.URL
	if gotURL == nil {
		t.Fatal("decode returned no request URL")
		return
	}
	if wantURL == nil {
		t.Fatal("HTTP/1 oracle returned no request URL")
		return
	}
	if gotURL.Path != wantURL.Path || gotURL.RawPath != wantURL.RawPath || gotURL.RawQuery != wantURL.RawQuery || gotURL.Host != wantURL.Host || gotURL.Scheme != wantURL.Scheme {
		t.Errorf("got URL %#v; want %#v", gotURL, wantURL)
	}
	for _, key := range []string{"Cookie", "Content-Length", "X-Multi", "Host"} {
		if !slices.Equal(got.Header.Values(key), want.Header.Values(key)) {
			t.Errorf("%s = %q; want %q", key, got.Header.Values(key), want.Header.Values(key))
		}
	}
	if got.Proto != "HTTP/3.0" || got.ProtoMajor != 3 || got.ProtoMinor != 0 {
		t.Errorf("unexpected protocol %s (%d.%d)", got.Proto, got.ProtoMajor, got.ProtoMinor)
	}
	if got.Body != nil || got.TLS != nil || got.RemoteAddr != "" {
		t.Error("header-only decoding set transport state")
	}
}

type h3TargetCase struct {
	name     string
	fields   []qpack.HeaderField
	host     string
	uri      string
	path     string
	urlHost  string
	protocol string
}

func TestDecodeH3RequestTargetForms(t *testing.T) {
	cases := []h3TargetCase{
		{name: "OPTIONS asterisk with Host fallback", host: "example.com", uri: "*", path: "*", fields: []qpack.HeaderField{
			{Name: ":method", Value: "OPTIONS"}, {Name: ":scheme", Value: "HTTPS"}, {Name: ":path", Value: "*"},
			{Name: "host", Value: "example.com"}, {Name: "te", Value: "Trailers, trailers"},
		}},
		{name: "CONNECT authority form", host: "[2001:db8::1]:443", uri: "[2001:db8::1]:443", urlHost: "[2001:db8::1]:443", fields: []qpack.HeaderField{
			{Name: ":method", Value: "CONNECT"}, {Name: ":authority", Value: "[2001:db8::1]:443"},
		}},
		{name: "extended CONNECT origin form", host: "example.com", uri: "/socket?room=blue", path: "/socket", protocol: "websocket", fields: []qpack.HeaderField{
			{Name: ":method", Value: "CONNECT"}, {Name: ":protocol", Value: "websocket"}, {Name: ":scheme", Value: "https"},
			{Name: ":authority", Value: "example.com"}, {Name: ":path", Value: "/socket?room=blue"},
		}},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			req, err := http3.DecodeH3RequestForTest(encodeH3TestFields(t, tc.fields), 1024)
			if err != nil {
				t.Fatalf("decode request: %v", err)
				return
			}
			if req == nil {
				t.Fatal("decode returned no request")
				return
			}
			u := req.URL
			if u == nil || u.Path != tc.path || u.Host != tc.urlHost || req.Host != tc.host || req.RequestURI != tc.uri {
				t.Errorf("target = %#v, Host %q, URI %q", u, req.Host, req.RequestURI)
			}
			if req.Proto != "HTTP/3.0" || req.ProtoMajor != 3 || req.ContentLength != -1 {
				t.Errorf("got %s (%d), ContentLength %d", req.Proto, req.ProtoMajor, req.ContentLength)
			}
			protocols := req.Header.Values(":protocol")
			if (tc.protocol == "" && len(protocols) != 0) || (tc.protocol != "" && !slices.Equal(protocols, []string{tc.protocol})) {
				t.Errorf(":protocol = %q; want %q", protocols, tc.protocol)
			}
		})
	}
}

func expectMalformedH3Request(t *testing.T, fields []qpack.HeaderField, detail string) {
	t.Helper()
	_, err := http3.DecodeH3RequestForTest(encodeH3TestFields(t, fields), 1024)
	if !errors.Is(err, http3.ErrH3MalformedMessageForTest()) || !strings.Contains(err.Error(), detail) {
		t.Fatalf("want malformed message containing %q; got %v", detail, err)
	}
}

func TestDecodeH3RejectsMalformedFields(t *testing.T) {
	cases := []struct {
		name   string
		field  string
		value  string
		detail string
	}{
		{"uppercase name", "X-Foo", "a", "invalid field name"},
		{"empty name", "", "a", "invalid field name"},
		{"invalid token", "x foo", "a", "invalid field name"},
		{"carriage return", "x-foo", "a\rb", "invalid field value"},
		{"line feed", "x-foo", "a\nb", "invalid field value"},
		{"NUL", "x-foo", "a\x00b", "invalid field value"},
		{"leading space", "x-foo", " a", "invalid field value"},
		{"trailing tab", "x-foo", "a\t", "invalid field value"},
		{"response pseudo-header", ":status", "200", "unknown request pseudo-header"},
		{"duplicate pseudo-header", ":path", "/", "duplicate request pseudo-header"},
		{"empty protocol on GET", ":protocol", "", "invalid :protocol"},
		{"protocol on GET", ":protocol", "websocket", "invalid :protocol"},
		{"conflicting host", "host", "other.example", "mismatch with :authority"},
		{"empty host", "host", "", "invalid Host"},
		{"connection", "connection", "close", "connection-specific"},
		{"keep-alive", "keep-alive", "timeout=1", "connection-specific"},
		{"proxy-connection", "proxy-connection", "close", "connection-specific"},
		{"transfer-encoding", "transfer-encoding", "chunked", "connection-specific"},
		{"upgrade", "upgrade", "websocket", "connection-specific"},
		{"TE with transfer coding", "te", "trailers, gzip", "TE must contain only trailers"},
		{"empty TE", "te", "", "TE must contain only trailers"},
		{"empty length", "content-length", "", "invalid Content-Length"},
		{"signed length", "content-length", "+1", "invalid Content-Length"},
		{"negative length", "content-length", "-1", "invalid Content-Length"},
		{"overflowing length", "content-length", "9223372036854775808", "invalid Content-Length"},
		{"empty length list member", "content-length", "2,", "invalid Content-Length"},
		{"conflicting length list", "content-length", "2, 3", "conflicting Content-Length"},
		{"prohibited announced trailer", "trailer", "X-Foo, Content-Length", "prohibited trailer field"},
		{"invalid announced trailer", "trailer", "X Foo", "invalid trailer name"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			fields := append(h3TestRequestFields(), qpack.HeaderField{Name: tc.field, Value: tc.value})
			expectMalformedH3Request(t, fields, tc.detail)
		})
	}
}

func TestDecodeH3RejectsInvalidFieldSequences(t *testing.T) {
	cases := []struct {
		name   string
		extra  []qpack.HeaderField
		detail string
	}{
		{"pseudo after regular field", []qpack.HeaderField{{Name: "x", Value: "y"}, {Name: ":path", Value: "/"}}, "pseudo-header after regular field"},
		{"multiple host fields", []qpack.HeaderField{{Name: "host", Value: "example.com"}, {Name: "host", Value: "example.com"}}, "multiple Host fields"},
		{"conflicting length fields", []qpack.HeaderField{{Name: "content-length", Value: "2"}, {Name: "content-length", Value: "3"}}, "conflicting Content-Length"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			expectMalformedH3Request(t, append(h3TestRequestFields(), tc.extra...), tc.detail)
		})
	}
}

func TestDecodeH3RejectsInvalidTargetFields(t *testing.T) {
	expectMalformedH3Request(t, []qpack.HeaderField{
		{Name: ":method", Value: "GET"},
		{Name: ":scheme", Value: "example"},
		{Name: ":path", Value: "/"},
	}, "missing authority")

	cases := []struct {
		name   string
		index  int
		value  string
		detail string
	}{
		{"empty method", 0, "", "invalid :method"},
		{"invalid method", 0, "GET/POST", "invalid :method"},
		{"empty scheme", 1, "", "invalid :scheme"},
		{"invalid scheme", 1, "https://", "invalid :scheme"},
		{"empty authority", 2, "", "missing authority"},
		{"userinfo", 2, "user@example.com", "invalid authority host"},
		{"authority with path", 2, "example.com/api", "invalid authority host"},
		{"authority with nonnumeric port", 2, "example.com:http", "invalid authority port"},
		{"authority with overflowing port", 2, "example.com:65536", "invalid authority port"},
		{"invalid IP literal", 2, "[example.com]", "invalid authority IP literal"},
		{"unbracketed IPv6", 2, "2001:db8::1", "invalid authority port"},
		{"empty path", 3, "", "invalid :path"},
		{"absolute URI path", 3, "https://example.com/", "invalid :path"},
		{"relative path", 3, "items/1", "invalid :path"},
		{"asterisk GET", 3, "*", "invalid :path"},
		{"fragment", 3, "/items#one", "invalid :path"},
		{"unescaped space", 3, "/a b", "invalid :path"},
		{"bad path escape", 3, "/a%ZZ", "invalid :path"},
		{"bad query escape", 3, "/?a=%Z", "invalid :path"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			fields := h3TestRequestFields()
			fields[tc.index].Value = tc.value
			expectMalformedH3Request(t, fields, tc.detail)
		})
	}
}

func TestDecodeH3RejectsMalformedConnect(t *testing.T) {
	cases := []struct {
		name   string
		fields []qpack.HeaderField
		detail string
	}{
		{"Host cannot replace CONNECT authority", []qpack.HeaderField{{Name: "host", Value: "example.com:443"}}, "missing authority"},
		{"classic CONNECT requires port", []qpack.HeaderField{{Name: ":authority", Value: "example.com"}}, "lacks port"},
		{"classic CONNECT omits scheme even if empty", []qpack.HeaderField{{Name: ":authority", Value: "example.com:443"}, {Name: ":scheme", Value: ""}}, "must omit :scheme and :path"},
		{"classic CONNECT omits path even if empty", []qpack.HeaderField{{Name: ":authority", Value: "example.com:443"}, {Name: ":path", Value: ""}}, "must omit :scheme and :path"},
		{"empty protocol is not absent", []qpack.HeaderField{{Name: ":authority", Value: "example.com:443"}, {Name: ":protocol", Value: ""}}, "invalid :protocol"},
		{"protocol must be token", []qpack.HeaderField{{Name: ":authority", Value: "example.com"}, {Name: ":protocol", Value: "websocket/13"}, {Name: ":scheme", Value: "https"}, {Name: ":path", Value: "/"}}, "invalid :protocol"},
		{"extended CONNECT requires authority", []qpack.HeaderField{{Name: ":protocol", Value: "websocket"}, {Name: ":scheme", Value: "https"}, {Name: ":path", Value: "/"}, {Name: "host", Value: "example.com"}}, "missing authority"},
		{"extended CONNECT requires scheme", []qpack.HeaderField{{Name: ":protocol", Value: "websocket"}, {Name: ":authority", Value: "example.com"}, {Name: ":path", Value: "/"}}, "invalid :scheme"},
		{"extended CONNECT requires path", []qpack.HeaderField{{Name: ":protocol", Value: "websocket"}, {Name: ":authority", Value: "example.com"}, {Name: ":scheme", Value: "https"}}, "invalid :path"},
		{"extended CONNECT rejects asterisk", []qpack.HeaderField{{Name: ":protocol", Value: "websocket"}, {Name: ":authority", Value: "example.com"}, {Name: ":scheme", Value: "https"}, {Name: ":path", Value: "*"}}, "invalid :path"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			fields := []qpack.HeaderField{{Name: ":method", Value: "CONNECT"}}
			expectMalformedH3Request(t, append(fields, tc.fields...), tc.detail)
		})
	}
}

func TestDecodeH3AnnouncedTrailers(t *testing.T) {
	fields := append(h3TestRequestFields(),
		qpack.HeaderField{Name: "trailer", Value: "X-Checksum, X-Warning"},
		qpack.HeaderField{Name: "trailer", Value: "x-checksum,x-extra"},
	)
	req, err := http3.DecodeH3RequestForTest(encodeH3TestFields(t, fields), 1024)
	if err != nil {
		t.Fatalf("decode request: %v", err)
		return
	}
	if req == nil {
		t.Fatal("decode returned no request")
		return
	}
	if _, present := req.Header["Trailer"]; present || len(req.Trailer) != 3 {
		t.Fatalf("unexpected trailer announcement: Header %v, Trailer %v", req.Header, req.Trailer)
	}
	for _, key := range []string{"X-Checksum", "X-Warning", "X-Extra"} {
		if values, present := req.Trailer[key]; !present || values != nil {
			t.Errorf("trailer %s = %q (present %v); want announced without a value", key, values, present)
		}
	}
}

func TestDecodeH3Trailers(t *testing.T) {
	fields := []qpack.HeaderField{{Name: "x-proof", Value: "first"}, {Name: "x-proof", Value: "second"}}
	got, err := http3.DecodeH3TrailersForTest(encodeH3TestFields(t, fields), 1024)
	if err != nil {
		t.Fatal(err)
		return
	}
	if len(got) != 1 || !slices.Equal(got.Values("X-Proof"), []string{"first", "second"}) {
		t.Errorf("trailers = %v; want both X-Proof values in order", got)
	}
}

func TestDecodeH3RejectsInvalidTrailers(t *testing.T) {
	cases := []struct {
		name   string
		value  string
		detail string
	}{
		{":path", "/", "invalid trailer name"},
		{"X-Foo", "value", "invalid field name"},
		{"x-foo", "a\r\nb", "invalid field value"},
		{"content-length", "0", "prohibited trailer field"},
		{"host", "example.com", "prohibited trailer field"},
		{"trailer", "x-foo", "prohibited trailer field"},
		{"te", "trailers", "prohibited trailer field"},
		{"upgrade", "websocket", "prohibited trailer field"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			block := encodeH3TestFields(t, []qpack.HeaderField{{Name: tc.name, Value: tc.value}})
			_, err := http3.DecodeH3TrailersForTest(block, 1024)
			if !errors.Is(err, http3.ErrH3MalformedMessageForTest()) || !strings.Contains(err.Error(), tc.detail) {
				t.Fatalf("want malformed message containing %q; got %v", tc.detail, err)
			}
		})
	}
}

func TestDecodeH3ClassifiesQPACKFailures(t *testing.T) {
	cases := []struct {
		name  string
		block []byte
	}{
		{"missing prefix", []byte{}},
		{"missing delta base", []byte{0}},
		{"nonzero insert count", []byte{1, 0}},
		{"nonzero delta base", []byte{0, 1}},
		{"negative base", []byte{0, 0x80}},
		{"unknown field representation", []byte{0, 0, 0}},
		{"dynamic table index", []byte{0, 0, 0x80}},
		{"out of range static index", []byte{0, 0, 0xff, 0x25}},
		{"missing literal value", []byte{0, 0, 0x50}},
		{"truncated static index", []byte{0, 0, 0xff}},
		{"bad Huffman value", []byte{0, 0, 0x50, 0x81, 0xff}},
		{"bad field after malformed HTTP field", append(encodeH3TestFields(t, []qpack.HeaderField{{Name: "X-Upper", Value: "bad"}}), 0)},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			_, reqErr := http3.DecodeH3RequestForTest(tc.block, 1024)
			_, trailerErr := http3.DecodeH3TrailersForTest(tc.block, 1024)
			if !errors.Is(reqErr, http3.ErrH3QPACKForTest()) || !errors.Is(trailerErr, http3.ErrH3QPACKForTest()) {
				t.Errorf("request error %v, trailer error %v; want QPACK errors", reqErr, trailerErr)
			}
		})
	}
	_, err := http3.DecodeH3RequestForTest([]byte{0, 0, 0x50}, 1024)
	if !errors.Is(err, io.ErrUnexpectedEOF) {
		t.Errorf("QPACK error did not preserve unexpected EOF: %v", err)
	}
}

func TestDecodeH3FieldSectionSize(t *testing.T) {
	fields := append(h3TestRequestFields(), qpack.HeaderField{Name: "x", Value: "a"}, qpack.HeaderField{Name: "x", Value: "a"})
	request := encodeH3TestFields(t, fields)
	trailer := encodeH3TestFields(t, []qpack.HeaderField{{Name: "x-proof", Value: "\xc3\xa9"}})
	const requestSize = 42 + 44 + 53 + 38 + 34 + 34
	const trailerSize = 32 + 7 + 2
	for _, limit := range []uint64{requestSize, requestSize + 1, ^uint64(0)} {
		if _, err := http3.DecodeH3RequestForTest(request, limit); err != nil {
			t.Errorf("request under limit %d: %v", limit, err)
		}
	}
	if _, err := http3.DecodeH3RequestForTest(request, requestSize-1); !errors.Is(err, http3.ErrH3FieldSectionTooLargeForTest()) {
		t.Errorf("request exceeds size by one: %v", err)
	}
	if _, err := http3.DecodeH3TrailersForTest(trailer, trailerSize); err != nil {
		t.Errorf("trailer at exact limit: %v", err)
	}
	if _, err := http3.DecodeH3TrailersForTest(trailer, trailerSize-1); !errors.Is(err, http3.ErrH3FieldSectionTooLargeForTest()) {
		t.Errorf("trailer exceeds size by one: %v", err)
	}
	if _, err := http3.DecodeH3TrailersForTest(trailer, 0); !errors.Is(err, http3.ErrH3FieldSectionTooLargeForTest()) {
		t.Errorf("nonempty trailer with zero budget: %v", err)
	}
	got, err := http3.DecodeH3TrailersForTest([]byte{0, 0}, 0)
	if err != nil {
		t.Fatalf("decode empty QPACK trailer section: %v", err)
		return
	}
	if len(got) != 0 {
		t.Errorf("empty QPACK trailer section decoded as %v", got)
	}
	if _, err := http3.DecodeH3RequestForTest([]byte{0, 0}, 0); !errors.Is(err, http3.ErrH3MalformedMessageForTest()) {
		t.Errorf("empty QPACK request section should fail HTTP validation: %v", err)
	}
}
