package http3

import (
	"bytes"
	"errors"
	"io"
	"testing"
)

func encV(v uint64) []byte {
	switch {
	case v < 64:
		return []byte{byte(v)}
	case v < 16384:
		return []byte{0x40 | byte(v>>8), byte(v)}
	case v < 1073741824:
		return []byte{0x80 | byte(v>>24), byte(v >> 16), byte(v >> 8), byte(v)}
	default:
		return []byte{0xC0 | byte(v>>56), byte(v >> 48), byte(v >> 40), byte(v >> 32), byte(v >> 24), byte(v >> 16), byte(v >> 8), byte(v)}
	}
}

func encSetting(id, value uint64) []byte {
	out := encV(id)
	return append(out, encV(value)...)
}

func TestReadH3FrameHeaderWidthBoundaries(t *testing.T) {
	cases := []struct {
		name   string
		kind   []byte
		length []byte
		kindV  uint64
		lenV   uint64
	}{
		{"1-byte pair", []byte{0x00}, []byte{0x3F}, 0, 63},
		{"2-byte pair", []byte{0x40, 0x3F}, []byte{0x7F, 0xFF}, 63, 16383},
		{"4-byte pair", []byte{0x80, 0x00, 0x00, 0x00}, []byte{0xBF, 0xFF, 0xFF, 0xFF}, 0, 1073741823},
		{"8-byte pair", []byte{0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, []byte{0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}, 0, 4611686018427387903},
	}
	for _, c := range cases {
		t.Run(c.name, func(t *testing.T) {
			payload := []byte("payload-bytes")
			wire := append(append(append([]byte{}, c.kind...), c.length...), payload...)
			r := bytes.NewReader(wire)
			h, err := readH3FrameHeader(r)
			if err != nil {
				t.Fatalf("readH3FrameHeader: %v", err)
				return
			}
			if h.kind != c.kindV || h.length != c.lenV {
				t.Fatalf("header = {kind %d, length %d}, want {kind %d, length %d}", h.kind, h.length, c.kindV, c.lenV)
			}
			rest, err := io.ReadAll(r)
			if err != nil {
				t.Fatalf("read rest: %v", err)
				return
			}
			if string(rest) != string(payload) {
				t.Fatalf("payload consumed: remaining %q, want %q", rest, payload)
			}
		})
	}
}

func TestReadH3FrameHeaderTruncated(t *testing.T) {
	kind, length := encV(1073741824), encV(16384)
	header := append(kind, length...)
	for cut := 0; cut < len(header); cut++ {
		r := bytes.NewReader(header[:cut])
		if _, err := readH3FrameHeader(r); err == nil {
			t.Fatalf("cut %d: expected error, got nil", cut)
		}
	}
}

func TestAppendH3FrameHeaderWireBytes(t *testing.T) {
	cases := []struct {
		name string
		kind uint64
		len  uint64
		want string
	}{
		{"headers", 0x01, 25, "\x01\x19"},
		{"settings", 0x04, 6, "\x04\x06"},
		{"goaway", 0x07, 8, "\a\b"},
		{"cancel push", 0x03, 1, "\x03\x01"},
		{"2-byte length", 0x00, 16383, "\x00\x7f\xff"},
		{"4-byte length", 0x01, 1073741823, "\x01\xbf\xff\xff\xff"},
		{"8-byte length", 0x01, 4611686018427387903, "\x01\xff\xff\xff\xff\xff\xff\xff\xff"},
		{"2-byte kind", 16383, 5, "\x7f\xff\x05"},
	}
	for _, c := range cases {
		t.Run(c.name, func(t *testing.T) {
			got := appendH3FrameHeader([]byte("pre-"), c.kind, c.len)
			if !bytes.HasPrefix(got, []byte("pre-")) {
				t.Fatalf("prefix lost: %q", got)
			}
			if string(got[4:]) != c.want {
				t.Fatalf("wire = % x, want % x", got[4:], c.want)
			}
			r := bytes.NewReader(got[4:])
			h, err := readH3FrameHeader(r)
			if err != nil {
				t.Fatalf("roundtrip: %v", err)
				return
			}
			if h.kind != c.kind || h.length != c.len {
				t.Fatalf("roundtrip = {%d, %d}, want {%d, %d}", h.kind, h.length, c.kind, c.len)
			}
			if r.Len() != 0 {
				t.Fatalf("roundtrip left %d bytes", r.Len())
			}
		})
	}
}

func TestDecodeH3SettingsAllFields(t *testing.T) {
	payload := append(append(append(append(append([]byte{},
		encSetting(0x06, 9000)...),
		encSetting(0x01, 4096)...),
		encSetting(0x07, 100)...),
		encSetting(0x08, 1)...),
		encSetting(0x33, 1)...)
	s, err := decodeH3Settings(payload)
	if err != nil {
		t.Fatalf("decodeH3Settings: %v", err)
		return
	}
	if s.maxFieldSectionSize != 9000 || s.qpackMaxTableCapacity != 4096 || s.qpackBlockedStreams != 100 {
		t.Fatalf("numeric settings = {%d %d %d}, want {9000 4096 100}", s.maxFieldSectionSize, s.qpackMaxTableCapacity, s.qpackBlockedStreams)
	}
	if !s.enableConnectProtocol || !s.enableDatagram {
		t.Fatalf("boolean settings = {connect %v, datagram %v}, want true true", s.enableConnectProtocol, s.enableDatagram)
	}
}

func TestDecodeH3SettingsDefaultsAndEmpty(t *testing.T) {
	s, err := decodeH3Settings(nil)
	if err != nil {
		t.Fatalf("empty payload: %v", err)
		return
	}
	if s.maxFieldSectionSize != h3UnlimitedFieldSectionSize || s.qpackMaxTableCapacity != 0 || s.qpackBlockedStreams != 0 || s.enableConnectProtocol || s.enableDatagram {
		t.Fatalf("empty payload settings = %+v, want all defaults", s)
	}
	s, err = decodeH3Settings(append(append([]byte{}, encSetting(0x33, 0)...), encSetting(0x08, 0)...))
	if err != nil {
		t.Fatalf("explicit zeros: %v", err)
		return
	}
	if s.enableConnectProtocol || s.enableDatagram {
		t.Fatalf("explicit zero booleans set true: %+v", s)
	}
}

func TestDecodeH3SettingsUnknownIDsIgnored(t *testing.T) {
	payload := append(append(append([]byte{},
		encSetting(0x21, 7)...),
		encSetting(0x46, 5)...),
		encSetting(0x27FF+64, 1)...)
	s, err := decodeH3Settings(payload)
	if err != nil {
		t.Fatalf("unknown ids: %v", err)
		return
	}
	if s.maxFieldSectionSize != h3UnlimitedFieldSectionSize || s.enableDatagram {
		t.Fatalf("unknown ids leaked into known fields: %+v", s)
	}
}

func TestDecodeH3SettingsFieldSectionSizeOmittedVersusZero(t *testing.T) {
	omitted, err := decodeH3Settings(encSetting(0x33, 1))
	if err != nil {
		t.Fatalf("omitted size: %v", err)
		return
	}
	if omitted.maxFieldSectionSize != h3UnlimitedFieldSectionSize {
		t.Fatalf("omitted size = %d, want h3UnlimitedFieldSectionSize (%d)", omitted.maxFieldSectionSize, uint64(h3UnlimitedFieldSectionSize))
	}
	explicitZero, err := decodeH3Settings(append(append([]byte{}, encSetting(0x06, 0)...), encSetting(0x33, 1)...))
	if err != nil {
		t.Fatalf("explicit zero size: %v", err)
		return
	}
	if explicitZero.maxFieldSectionSize != 0 {
		t.Fatalf("explicit zero size = %d, want 0", explicitZero.maxFieldSectionSize)
	}
	if explicitZero.maxFieldSectionSize == h3UnlimitedFieldSectionSize {
		t.Fatal("explicit zero size indistinguishable from omitted")
	}
}

func TestDecodeH3SettingsDuplicateRejected(t *testing.T) {
	known := append(append([]byte{}, encSetting(0x06, 1)...), encSetting(0x06, 2)...)
	_, err := decodeH3Settings(known)
	if !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("duplicate known id: err %v, want errH3SettingsMalformed", err)
	}
	unknown := append(append([]byte{}, encSetting(0x99, 1)...), encSetting(0x99, 2)...)
	_, err = decodeH3Settings(unknown)
	if !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("duplicate unknown id: err %v, want errH3SettingsMalformed", err)
	}
}

func TestDecodeH3SettingsForbiddenHTTP2IDs(t *testing.T) {
	for _, id := range []uint64{0x2, 0x3, 0x4, 0x5} {
		_, err := decodeH3Settings(encSetting(id, 1))
		if !errors.Is(err, errH3SettingsMalformed) {
			t.Fatalf("id %#x: err %v, want errH3SettingsMalformed", id, err)
		}
	}
}

func TestDecodeH3SettingsInvalidBooleans(t *testing.T) {
	if _, err := decodeH3Settings(encSetting(0x08, 2)); !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("connect protocol value 2: err %v", err)
	}
	if _, err := decodeH3Settings(encSetting(0x33, 2)); !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("datagram value 2: err %v", err)
	}
	if _, err := decodeH3Settings(encSetting(0x08, 7)); !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("connect protocol value 7: err %v", err)
	}
}

func TestDecodeH3SettingsTruncated(t *testing.T) {
	if _, err := decodeH3Settings([]byte{0xBF}); !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("lone 4-byte id prefix: err %v", err)
	}
	if _, err := decodeH3Settings([]byte{0x06}); !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("id without value: err %v", err)
	}
	if _, err := decodeH3Settings([]byte{0x06, 0xC7, 0xFF}); !errors.Is(err, errH3SettingsMalformed) {
		t.Fatalf("value cut mid-varint: err %v", err)
	}
}

func TestDecodeH3SettingsSizeBound(t *testing.T) {
	var payload []byte
	for i := 0; len(payload) < 8192; i++ {
		v := uint64(64 + i)
		payload = append(payload, encV(v)...)
		payload = append(payload, encV(v)...)
	}
	payload = payload[:8192]
	s, err := decodeH3Settings(payload)
	if err != nil {
		t.Fatalf("exactly 8192 bytes: %v", err)
		return
	}
	if s.maxFieldSectionSize != h3UnlimitedFieldSectionSize {
		t.Fatalf("8192-byte unknown settings leaked: %+v", s)
	}
	_, err = decodeH3Settings(append(payload, 0x00))
	if !errors.Is(err, errH3SettingsTooLarge) {
		t.Fatalf("8193 bytes: err %v, want errH3SettingsTooLarge", err)
	}
}

func TestDecodeH3SettingsErrorSentinelsDistinct(t *testing.T) {
	_, dupErr := decodeH3Settings(append(append([]byte{}, encSetting(0x06, 1)...), encSetting(0x06, 2)...))
	_, bigErr := decodeH3Settings(bytes.Repeat([]byte{0x00}, 8193))
	if errors.Is(dupErr, errH3SettingsTooLarge) {
		t.Fatal("malformed error matches too-large sentinel")
	}
	if errors.Is(bigErr, errH3SettingsMalformed) {
		t.Fatal("too-large error matches malformed sentinel")
	}
}
