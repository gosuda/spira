package http3

import (
	"errors"
	"fmt"
	"io"
	"net/http"
	"net/netip"
	"net/url"
	"strconv"
	"strings"

	"github.com/quic-go/qpack"
	"golang.org/x/net/http/httpguts"
)

var (
	errH3QPACK                = errors.New("http3: QPACK decoding failed")
	errH3MalformedMessage     = errors.New("http3: malformed message")
	errH3FieldSectionTooLarge = errors.New("http3: field section too large")
)

type h3MessageError string

func (e h3MessageError) Error() string {
	return errH3MalformedMessage.Error() + ": " + string(e)
}

func (e h3MessageError) Unwrap() error {
	return errH3MalformedMessage
}

const (
	h3Method = iota
	h3Scheme
	h3Authority
	h3Path
	h3Protocol
	h3PseudoCount
)

type h3RequestFields struct {
	pseudo [h3PseudoCount]string
	seen   uint8
	header http.Header
}

func decodeH3Request(block []byte, maxFieldSectionSize uint64) (*http.Request?, error) {
	fields := h3RequestFields{header: make(http.Header)}
	decodeH3Fields(block, maxFieldSectionSize, fields.add)?
	return fields.request()
}

func decodeH3Trailers(block []byte, maxFieldSectionSize uint64) (http.Header, error) {
	trailer := make(http.Header)
	decodeH3Fields(block, maxFieldSectionSize, func(field qpack.HeaderField) error {
		name := h3TrailerName(field.Name)?
		values, _ := trailer[name]
		trailer[name] = append(values, field.Value)
		return nil
	})?
	return trailer, nil
}

func decodeH3Fields(block []byte, remaining uint64, accept func(qpack.HeaderField) error) error {
	if len(block) < 2 {
		return fmt.Errorf("%w: %w", errH3QPACK, io.ErrUnexpectedEOF)
	}
	if block[0] == 0 && block[1]&0x80 != 0 {
		return fmt.Errorf("%w: negative base with zero insert count", errH3QPACK)
	}
	next := qpack.NewDecoder().Decode(block)
	var malformed error
	for {
		field, err := next()
		if err == io.EOF {
			return malformed
		}
		if err != nil {
			return fmt.Errorf("%w: %w", errH3QPACK, err)
		}
		nameSize, valueSize := uint64(len(field.Name)), uint64(len(field.Value))
		if remaining < 32 || nameSize > remaining-32 || valueSize > remaining-32-nameSize {
			return errH3FieldSectionTooLarge
		}
		remaining -= 32 + nameSize + valueSize
		if malformed != nil {
			continue
		}
		malformed = validateH3Field(field)
		if malformed == nil {
			malformed = accept(field)
		}
	}
}

func validateH3Field(field qpack.HeaderField) error {
	name := strings.TrimPrefix(field.Name, ":")
	if !httpguts.ValidHeaderFieldName(name) || strings.ContainsAny(name, "ABCDEFGHIJKLMNOPQRSTUVWXYZ") {
		return h3MessageError("invalid field name")
	}
	if !httpguts.ValidHeaderFieldValue(field.Value) || strings.Trim(field.Value, " \t") != field.Value {
		return h3MessageError("invalid field value")
	}
	return nil
}

func (f *h3RequestFields) has(index int) bool {
	return f.seen&(1<<index) != 0
}

func (f *h3RequestFields) addPseudo(field qpack.HeaderField) error {
	if len(f.header) != 0 {
		return h3MessageError("pseudo-header after regular field")
	}
	var index int
	switch field.Name {
	case ":method":
		index = h3Method
	case ":scheme":
		index = h3Scheme
	case ":authority":
		index = h3Authority
	case ":path":
		index = h3Path
	case ":protocol":
		index = h3Protocol
	default:
		return h3MessageError("unknown request pseudo-header")
	}
	if f.has(index) {
		return h3MessageError("duplicate request pseudo-header")
	}
	f.seen |= 1 << index
	f.pseudo[index] = field.Value
	return nil
}

func (f *h3RequestFields) add(field qpack.HeaderField) error {
	if strings.HasPrefix(field.Name, ":") {
		return f.addPseudo(field)
	}
	name := http.CanonicalHeaderKey(field.Name)
	if h3ConnectionSpecific(name) {
		return h3MessageError("connection-specific field")
	}
	if name == "Te" && !h3TETrailers(field.Value) {
		return h3MessageError("TE must contain only trailers")
	}
	values, _ := f.header[name]
	f.header[name] = append(values, field.Value)
	return nil
}

func h3TETrailers(value string) bool {
	found := false
	for part := range strings.SplitSeq(value, ",") {
		token := strings.Trim(part, " \t")
		if token == "" {
			continue
		}
		if len(token) != len("trailers") || !strings.EqualFold(token, "trailers") {
			return false
		}
		found = true
	}
	return found
}

func h3ConnectionSpecific(canonicalName string) bool {
	switch canonicalName {
	case "Connection", "Keep-Alive", "Proxy-Connection", "Transfer-Encoding", "Upgrade":
		return true
	}
	return false
}

func (f *h3RequestFields) request() (*http.Request?, error) {
	method := f.pseudo[h3Method]
	if !httpguts.ValidHeaderFieldName(method) {
		return nil, h3MessageError("invalid :method")
	}
	authority := f.authority()?
	target, requestURI := f.target(authority)?
	if target == nil {
		return nil, h3MessageError("missing request target")
	}
	length := h3ContentLength(f.header)?
	trailer := h3AnnouncedTrailers(f.header)?
	delete(f.header, "Host")
	cookies := f.header.Values("Cookie")
	if len(cookies) > 1 {
		cookies[0] = strings.Join(cookies, "; ")
		clear(cookies[1:])
		f.header["Cookie"] = cookies[:1:1]
	}
	if f.has(h3Protocol) {
		f.header[":protocol"] = []string{f.pseudo[h3Protocol]}
	}
	return &http.Request{
		Method:        method,
		URL:           target,
		Proto:         "HTTP/3.0",
		ProtoMajor:    3,
		Header:        f.header,
		ContentLength: length,
		Host:          authority,
		RequestURI:    requestURI,
		Trailer:       trailer,
	}, nil
}

func (f *h3RequestFields) authority() (string, error) {
	authority := f.pseudo[h3Authority]
	hosts := f.header.Values("Host")
	if len(hosts) > 1 {
		return "", h3MessageError("multiple Host fields")
	}
	connect := f.pseudo[h3Method] == http.MethodConnect
	if len(hosts) == 1 {
		host := hosts[0]
		if host == "" || (f.has(h3Authority) && host != authority) {
			return "", h3MessageError("invalid Host or mismatch with :authority")
		}
		if !f.has(h3Authority) && !connect {
			authority = host
		}
	}
	if authority == "" {
		return "", h3MessageError("missing authority")
	}
	port := h3AuthorityPort(authority)?
	if connect && !f.has(h3Protocol) && port == "" {
		return "", h3MessageError("CONNECT authority lacks port")
	}
	return authority, nil
}

func h3AuthorityPort(authority string) (string, error) {
	if !strings.HasPrefix(authority, "[") {
		host, port, _ := strings.Cut(authority, ":")
		if host == "" || !validH3URIChars(host, "") {
			return "", h3MessageError("invalid authority host")
		}
		if port != "" && !validH3Port(port) {
			return "", h3MessageError("invalid authority port")
		}
		return port, nil
	}
	literal, suffix, closed := strings.Cut(authority[1:], "]")
	if !closed || !validH3IPLiteral(literal) {
		return "", h3MessageError("invalid authority IP literal")
	}
	if suffix == "" {
		return "", nil
	}
	port, hasPort := strings.CutPrefix(suffix, ":")
	if !hasPort || (port != "" && !validH3Port(port)) {
		return "", h3MessageError("invalid authority port")
	}
	return port, nil
}

func validH3Port(port string) bool {
	_, err := strconv.ParseUint(port, 10, 16)
	return err == nil
}

func validH3IPLiteral(literal string) bool {
	if strings.IndexByte(literal, '%') >= 0 {
		return false
	}
	if len(literal) != 0 && literal[0]|0x20 == 'v' {
		version, addr, found := strings.Cut(literal[1:], ".")
		if !found || version == "" || addr == "" || !validH3URIChars(addr, ":") {
			return false
		}
		for i := range len(version) {
			if !h3HexDigit(version[i]) {
				return false
			}
		}
		return true
	}
	ip, err := netip.ParseAddr(literal)
	return err == nil && ip.Is6()
}

func (f *h3RequestFields) target(authority string) (*url.URL?, string, error) {
	method := f.pseudo[h3Method]
	if f.has(h3Protocol) {
		if method != http.MethodConnect || !httpguts.ValidHeaderFieldName(f.pseudo[h3Protocol]) {
			return nil, "", h3MessageError("invalid :protocol")
		}
	} else if method == http.MethodConnect {
		if f.has(h3Scheme) || f.has(h3Path) {
			return nil, "", h3MessageError("CONNECT must omit :scheme and :path")
		}
		return &url.URL{Host: authority}, authority, nil
	}
	if !validH3Scheme(f.pseudo[h3Scheme]) {
		return nil, "", h3MessageError("invalid :scheme")
	}
	path := f.pseudo[h3Path]
	if !(method == http.MethodOptions && path == "*") && (!strings.HasPrefix(path, "/") || !validH3URIChars(path, ":@/?")) {
		return nil, "", h3MessageError("invalid :path")
	}
	target, err := url.ParseRequestURI(path)
	if err != nil {
		return nil, "", h3MessageError("invalid :path")
	}
	return target, path, nil
}

func validH3Scheme(scheme string) bool {
	if scheme == "" || !h3ASCIIAlpha(scheme[0]) {
		return false
	}
	for i := 1; i < len(scheme); i++ {
		c := scheme[i]
		if !h3ASCIIAlpha(c) && !(c >= '0' && c <= '9') && c != '+' && c != '-' && c != '.' {
			return false
		}
	}
	return true
}

func validH3URIChars(value string, extra string) bool {
	for i := 0; i < len(value); i++ {
		c := value[i]
		if h3ASCIIAlpha(c) || c >= '0' && c <= '9' || strings.IndexByte("-._~!$&'()*+,;=", c) >= 0 || strings.IndexByte(extra, c) >= 0 {
			continue
		}
		if c != '%' || len(value)-i < 3 || !h3HexDigit(value[i+1]) || !h3HexDigit(value[i+2]) {
			return false
		}
		i += 2
	}
	return true
}

func h3ASCIIAlpha(c byte) bool {
	lower := c | 0x20
	return lower >= 'a' && lower <= 'z'
}

func h3HexDigit(c byte) bool {
	lower := c | 0x20
	return c >= '0' && c <= '9' || lower >= 'a' && lower <= 'f'
}

func h3ContentLength(header http.Header) (int64, error) {
	values := header.Values("Content-Length")
	if len(values) == 0 {
		return -1, nil
	}
	length := int64(-1)
	var first string
	for _, value := range values {
		for part := range strings.SplitSeq(value, ",") {
			digits := strings.Trim(part, " \t")
			n, err := strconv.ParseUint(digits, 10, 63)
			if err != nil {
				return 0, h3MessageError("invalid Content-Length")
			}
			if length >= 0 && uint64(length) != n {
				return 0, h3MessageError("conflicting Content-Length fields")
			}
			if length < 0 {
				first, length = digits, int64(n)
			}
		}
	}
	values[0] = first
	clear(values[1:])
	header["Content-Length"] = values[:1:1]
	return length, nil
}

func h3AnnouncedTrailers(header http.Header) (http.Header, error) {
	var trailer http.Header
	for _, value := range header.Values("Trailer") {
		for part := range strings.SplitSeq(value, ",") {
			name := strings.Trim(part, " \t")
			if name == "" {
				continue
			}
			canonical := h3TrailerName(name)?
			if trailer == nil {
				trailer = make(http.Header)
			}
			trailer[canonical] = nil
		}
	}
	delete(header, "Trailer")
	return trailer, nil
}

func h3TrailerName(name string) (string, error) {
	if !httpguts.ValidHeaderFieldName(name) {
		return "", h3MessageError("invalid trailer name")
	}
	canonical := http.CanonicalHeaderKey(name)
	if h3ConnectionSpecific(canonical) || !httpguts.ValidTrailerHeader(canonical) {
		return "", h3MessageError("prohibited trailer field")
	}
	return canonical, nil
}
