package orm_test

import (
	"context"
	"fmt"
	"slices"
	"testing"
	"time"

	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/orm"
)

func TestFlushOrder(t *testing.T) {
	pool := sqlitePool(t)
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	for _, ddl := range []string{
		"CREATE TABLE orm_items (id INTEGER PRIMARY KEY, name TEXT NOT NULL, version INTEGER NOT NULL)",
		"INSERT INTO orm_items (id, name, version) VALUES (1, 'old', 1), (2, 'old', 1), (3, 'old', 1), (4, 'old', 1)",
		"CREATE TABLE orm_audit (seq INTEGER PRIMARY KEY, event TEXT NOT NULL)",
		"CREATE TRIGGER orm_insert AFTER INSERT ON orm_items BEGIN INSERT INTO orm_audit(event) VALUES ('i' || NEW.id); END",
		"CREATE TRIGGER orm_update AFTER UPDATE ON orm_items BEGIN INSERT INTO orm_audit(event) VALUES ('u' || NEW.id); END",
		"CREATE TRIGGER orm_delete AFTER DELETE ON orm_items BEGIN INSERT INTO orm_audit(event) VALUES ('d' || OLD.id); END",
	} {
		if err := exec(ctx, pool, ddl); err != nil {
			t.Fatal(err)
		}
	}
	if err := queueWrites(ctx, pool); err != nil {
		t.Fatal(err)
	}
	got, err := db.Query[string](ctx, pool, "SELECT event FROM orm_audit ORDER BY seq")
	if err != nil {
		t.Fatal(err)
		return
	}
	want := []string{"i6", "i5", "u2", "u1", "d4", "d3"}
	if !slices.Equal(got, want) {
		t.Fatalf("flush events = %v, want %v", got, want)
	}
}

func queueWrites(ctx context.Context, pool *db.Pool) error {
	_, err := orm.InSession[int](ctx, pool, func(s *orm.Session) (int, error) {
		loaded := make(map[itemID]*item)
		for _, key := range []itemID{2, 1, 3, 4} {
			row := orm.Get[item, itemID](ctx, s, items, key)?
			if row == nil {
				return 0, fmt.Errorf("missing seed row %d", key)
			}
			loaded[key] = row
		}
		for _, key := range []itemID{6, 5} {
			orm.Add[item, itemID](s, items, &item{ID: key, Name: "added"})
		}
		for _, key := range []itemID{1, 2} {
			if row, ok := loaded[key]; ok {
				row.Name = "changed"
			}
		}
		for _, key := range []itemID{4, 3} {
			if row, ok := loaded[key]; ok {
				orm.Remove[item, itemID](s, items, row)
			}
		}
		return 0, nil
	})
	return err
}
