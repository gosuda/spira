//go:build engines

package orm_test

import (
	"context"
	"os"
	"testing"
	"time"

	_ "github.com/go-sql-driver/mysql"
	_ "github.com/jackc/pgx/v5/stdlib"
	_ "github.com/microsoft/go-mssqldb"
)

func TestOptimisticWriteEngines(t *testing.T) {
	for _, engine := range []engineCase{
		{driver: "pgx", dsn: "SPIRA_TEST_POSTGRES_DSN", idType: "BIGINT GENERATED BY DEFAULT AS IDENTITY"},
		{driver: "mysql", dsn: "SPIRA_TEST_MYSQL_DSN", idType: "BIGINT AUTO_INCREMENT"},
		{driver: "sqlserver", dsn: "SPIRA_TEST_MSSQL_DSN", idType: "BIGINT IDENTITY(1, 1)"},
	} {
		t.Run(engine.driver, func(t *testing.T) { checkEngine(t, engine) })
	}
}

type engineCase struct {
	driver string
	dsn    string
	idType string
}

func checkEngine(t *testing.T, engine engineCase) {
	t.Helper()
	dsn := os.Getenv(engine.dsn)
	if dsn == "" {
		t.Fatalf("%s is empty; run `just engines`", engine.dsn)
		return
	}
	pool := openPool(t, engine.driver, dsn)
	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Second)
	defer cancel()
	create := "CREATE TABLE orm_items (id " + engine.idType + " PRIMARY KEY, name VARCHAR(128) NOT NULL, version BIGINT NOT NULL)"
	if err := exec(ctx, pool, create); err != nil {
		t.Fatal(err)
		return
	}
	t.Cleanup(func() {
		cleanup, stop := context.WithTimeout(context.Background(), 5*time.Second)
		defer stop()
		if err := exec(cleanup, pool, "DROP TABLE orm_items"); err != nil {
			t.Errorf("drop table: %v", err)
		}
	})
	if err := optimisticWrite(ctx, pool); err != nil {
		t.Fatal(err)
	}
}
