package orm_test

import (
	"bytes"
	"context"
	"fmt"
	"testing"
	"time"

	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/orm"
)

type blobID int64

type blobDoc struct {
	ID      blobID  `col:"id"`
	Data    []byte? `col:"data"`
	Version int64   `col:"version"`
}

var blobDocs = orm.Table[blobDoc, blobID]{Name: "orm_blobs", Key: "id", Version: "version"}

func TestNullableBlobRoundTrip(t *testing.T) {
	pool := sqlitePool(t)
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	if err := exec(ctx, pool, "CREATE TABLE orm_blobs (id INTEGER PRIMARY KEY, data BLOB, version INTEGER NOT NULL)"); err != nil {
		t.Fatal(err)
	}
	nullDoc := &blobDoc{}
	fullDoc := &blobDoc{Data: []byte{'a', 'b'}}
	_, err := orm.InSession[int](ctx, pool, func(s *orm.Session) (int, error) {
		orm.Add[blobDoc, blobID](s, blobDocs, nullDoc)
		orm.Add[blobDoc, blobID](s, blobDocs, fullDoc)
		s.Flush(ctx)?
		return 0, nil
	})
	if err != nil {
		t.Fatalf("flush nullable blobs: %v", err)
	}
	if err := checkBlob(ctx, pool, nullDoc.ID, nil); err != nil {
		t.Fatal(err)
	}
	if err := checkBlob(ctx, pool, fullDoc.ID, []byte{'a', 'b'}); err != nil {
		t.Fatal(err)
	}
}

func checkBlob(ctx context.Context, q db.Querier, id blobID, want []byte) error {
	row := db.One[blobDoc](ctx, q, "SELECT id, data, version FROM orm_blobs WHERE id = ?", int64(id))?
	if row == nil {
		return fmt.Errorf("blob %d absent", int64(id))
	}
	got := blobValueOf(row)
	if want == nil {
		if got != nil {
			return fmt.Errorf("blob %d data = %v, want SQL NULL", int64(id), got)
		}
		return nil
	}
	if !bytes.Equal(got, want) {
		return fmt.Errorf("blob %d data = %v, want %v", int64(id), got, want)
	}
	return nil
}

func blobValueOf(doc blobDoc?) []byte {
	if doc == nil {
		return nil
	}
	var empty []byte
	value := doc.Data ?? empty
	if len(value) == 0 {
		return nil
	}
	return value
}

func TestNullableBlobChangeDetection(t *testing.T) {
	pool := sqlitePool(t)
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	if err := exec(ctx, pool, "CREATE TABLE orm_blobs (id INTEGER PRIMARY KEY, data BLOB, version INTEGER NOT NULL)"); err != nil {
		t.Fatal(err)
	}
	if err := exec(ctx, pool, "INSERT INTO orm_blobs (id, data, version) VALUES (1, X'61', 1), (2, NULL, 1)"); err != nil {
		t.Fatal(err)
	}
	_, err := orm.InSession[int](ctx, pool, func(s *orm.Session) (int, error) {
		loaded := db.Query[blobDoc](ctx, s.Tx(), "SELECT id, data, version FROM orm_blobs ORDER BY id")?
		if len(loaded) != 2 {
			return 0, fmt.Errorf("attached %d rows, want 2", len(loaded))
		}
		held := orm.Attach[blobDoc, blobID](s, blobDocs, loaded)
		if len(held) != 2 {
			return 0, fmt.Errorf("held %d rows, want 2", len(held))
		}
		s.Flush(ctx)?
		unchanged := db.One[blobDoc](ctx, s.Tx(), "SELECT id, data, version FROM orm_blobs WHERE id = 1")?
		if versionOf(unchanged) != 1 {
			return 0, fmt.Errorf("clean flush moved version to %d, want 1", versionOf(unchanged))
		}
		if data := blobValueOf(*held[0]); len(data) == 0 {
			return 0, fmt.Errorf("held row lost its payload")
		} else {
			data[0] = 'z'
		}
		s.Flush(ctx)?
		moved := db.One[blobDoc](ctx, s.Tx(), "SELECT id, data, version FROM orm_blobs WHERE id = 1")?
		if versionOf(moved) != 2 {
			return 0, fmt.Errorf("dirty flush left version at %d, want 2", versionOf(moved))
		}
		if got := blobValueOf(moved); !bytes.Equal(got, []byte{'z'}) {
			return 0, fmt.Errorf("dirty flush wrote %v, want [122]", got)
		}
		return 0, nil
	})
	if err != nil {
		t.Fatal(err)
	}
}

func versionOf(doc blobDoc?) int64 {
	if doc == nil {
		return -1
	}
	return doc.Version
}
type blobShape struct {
	ID    int64  `col:"id"`
	Shape string `col:"shape"`
	Size  int64? `col:"size"`
}

func TestNullableEmptyBlobCopyPreservesEmptiness(t *testing.T) {
	pool := sqlitePool(t)
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	if err := exec(ctx, pool, "CREATE TABLE orm_blobs (id INTEGER PRIMARY KEY, data BLOB, version INTEGER NOT NULL)"); err != nil {
		t.Fatal(err)
	}
	if err := exec(ctx, pool, "INSERT INTO orm_blobs (id, data, version) VALUES (21, X'', 1), (22, NULL, 1)"); err != nil {
		t.Fatal(err)
	}
	loaded, err := db.Query[blobDoc](ctx, pool, "SELECT id, data, version FROM orm_blobs WHERE id = 21")
	if err != nil {
		t.Fatalf("load empty blob: %v", err)
	}
	if len(loaded) != 1 {
		t.Fatalf("loaded %d empty-blob rows, want 1", len(loaded))
	}
	if loaded[0].Data == nil {
		t.Fatalf("empty blob reads as absent, want present")
	}
	_, err = orm.InSession[int](ctx, pool, func(s *orm.Session) (int, error) {
		clone := &blobDoc{Data: loaded[0].Data}
		orm.Add[blobDoc, blobID](s, blobDocs, clone)
		s.Flush(ctx)?
		return 0, nil
	})
	if err != nil {
		t.Fatalf("flush blob copy: %v", err)
	}
	shapes, err := db.Query[blobShape](ctx, pool, "SELECT id, typeof(data) AS shape, length(data) AS size FROM orm_blobs ORDER BY id")
	if err != nil {
		t.Fatalf("read blob shapes: %v", err)
	}
	if err := blobCopyShapes(shapes); err != nil {
		t.Fatal(err)
	}
}

func blobCopyShapes(shapes []blobShape) error {
	blobs := 0
	nulls := 0
	for _, shape := range shapes {
		if shape.ID == 22 {
			if shape.Shape != "null" {
				return fmt.Errorf("seed NULL row stores %q, want null", shape.Shape)
			}
			nulls++
			continue
		}
		if shape.Shape != "blob" {
			return fmt.Errorf("row %d stores %q, want blob", shape.ID, shape.Shape)
		}
		if size := shape.Size ?? -1; size != 0 {
			return fmt.Errorf("row %d stores length %d, want 0", shape.ID, size)
		}
		blobs++
	}
	if blobs != 2 || nulls != 1 {
		return fmt.Errorf("stored %d blobs and %d nulls, want 2 blobs and 1 null", blobs, nulls)
	}
	return nil
}
