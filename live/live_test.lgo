package live_test

import (
	"bytes"
	"context"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"sync/atomic"
	"testing"
	"testing/synctest"
	"time"

	"github.com/gosuda/spira/bus"
	"github.com/gosuda/spira/live"
	"github.com/gosuda/spira/view"
	"github.com/gosuda/spira/web"

	"logos/sync"
)

type streamTap struct {
	msgs  chan string
	ended chan error
}

func newStreamTap() *streamTap {
	return &streamTap{msgs: make(chan string, 32), ended: make(chan error, 1)}
}

func (s *streamTap) read(ctx context.Context, body io.Reader) error {
	var pending []byte
	buf := make([]byte, 4096)
	for {
		n, rerr := body.Read(buf)
		pending = append(pending, buf[:n]...)
		s.split(ctx, &pending)
		if rerr != nil {
			select {
			case s.ended <- rerr:
			case <-ctx.Done():
			}
			return nil
		}
	}
}

func (s *streamTap) split(ctx context.Context, pending *[]byte) {
	for {
		i := bytes.Index(*pending, []byte("\n\n"))
		if i < 0 {
			return
		}
		select {
		case s.msgs <- string((*pending)[:i+2]):
		case <-ctx.Done():
			return
		}
		*pending = (*pending)[i+2:]
	}
}

func serveEvents(t *testing.T, h web.Handler) (*httptest.Server, <-chan struct{}) {
	t.Helper()
	r := web.NewRouter()
	r.Handle("GET", "/events", h)
	serveDone := make(chan struct{}, 4)
	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		defer func() {
			select {
			case serveDone <- struct{}{}:
			case <-t.Context().Done():
			}
		}()
		r.ServeHTTP(w, req)
	}))
	t.Cleanup(ts.Close)
	return ts, serveDone
}

func topicHandler(topic *bus.Topic[live.Event], subscribed chan<- (<-chan live.Event)) web.Handler {
	return func(c *web.Context) (web.Reply, error) {
		ch := topic.Subscribe(c.Ctx())
		select {
		case subscribed <- ch:
		case <-c.Ctx().Done():
		}
		return live.Events(c, ch), nil
	}
}

func rawHandler(events <-chan live.Event) web.Handler {
	return func(c *web.Context) (web.Reply, error) {
		return live.Events(c, events), nil
	}
}

func mustEvent(t *testing.T, name string, body view.Node) live.Event {
	t.Helper()
	ev, err := live.NewEvent(name, body)
	if err != nil {
		t.Fatalf("NewEvent(%q): %v", name, err)
		return live.Event{}
	}
	return ev
}

func closeBody(t *testing.T, body io.ReadCloser) {
	t.Helper()
	if cerr := body.Close(); cerr != nil {
		t.Fatalf("close stream body: %v", cerr)
	}
}

func openStream(t *testing.T, ts *httptest.Server) (*http.Response?, error) {
	t.Helper()
	resp, err := ts.Client().Get(ts.URL + "/events")
	if err != nil {
		return nil, fmt.Errorf("open stream: %w", err)
	}
	if ct := resp.Header.Get("Content-Type"); ct != "text/event-stream" {
		return nil, fmt.Errorf("content type %q, want text/event-stream", ct)
	}
	return resp, nil
}

type streamDrive struct {
	body           io.ReadCloser
	tap            *streamTap
	topic          *bus.Topic[live.Event]?
	pub            *checkedPublisher?
	sub            <-chan live.Event
	serveDone      <-chan struct{}
	gate           chan struct{}
	resolveStarted chan struct{}
	events         chan live.Event
	messages       []string
}

func tapMessages(ctx context.Context, tap *streamTap, wait time.Duration) (string, error) {
	select {
	case m := <-tap.msgs:
		return m, nil
	case err := <-tap.ended:
		return "", fmt.Errorf("stream ended before the next message: %w", err)
	case <-time.After(wait):
		return "", fmt.Errorf("no message within %v", wait)
	case <-ctx.Done():
		return "", ctx.Err()
	}
}

func expectHeartbeatErr(ctx context.Context, tap *streamTap) error {
	got, err := tapMessages(ctx, tap, 3*time.Second)
	if err != nil {
		return err
	}
	if got != ": live\n\n" {
		return fmt.Errorf("first message %q, want the heartbeat comment", got)
	}
	return nil
}

func awaitEndErr(ctx context.Context, tap *streamTap, wait time.Duration) error {
	select {
	case <-tap.ended:
		return nil
	case <-time.After(wait):
		return fmt.Errorf("stream did not end within %v", wait)
	case <-ctx.Done():
		return ctx.Err()
	}
}

func awaitServeErr(ctx context.Context, serveDone <-chan struct{}) error {
	select {
	case <-serveDone:
		return nil
	case <-time.After(5 * time.Second):
		return fmt.Errorf("the server did not finish the stream within 5s")
	case <-ctx.Done():
		return ctx.Err()
	}
}

func subscribedChannel(ctx context.Context, subscribed <-chan (<-chan live.Event)) (<-chan live.Event, error) {
	select {
	case ch := <-subscribed:
		return ch, nil
	case <-time.After(3 * time.Second):
		return nil, fmt.Errorf("the handler did not subscribe")
	case <-ctx.Done():
		return nil, ctx.Err()
	}
}

func awaitSubscribe(t *testing.T, subscribed <-chan (<-chan live.Event)) {
	t.Helper()
	select {
	case <-subscribed:
	case <-time.After(3 * time.Second):
		t.Fatal("the handler did not subscribe")
	}
}

func (c *streamDrive) emit(ctx context.Context, ev live.Event) error {
	select {
	case c.events <- ev:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

func rejectBadNames() error {
	if err := checkBadName("bad\nname"); err != nil {
		return err
	}
	return checkBadName("bad\rname")
}

func checkBadName(name string) error {
	_, err := live.NewEvent(name, view.T("x"))
	if err == nil {
		return fmt.Errorf("newline name accepted, want a line break rejection")
	}
	if !errors.Is(err, live.ErrInvalidEventName) {
		return fmt.Errorf("newline name error = %w, want invalid_event_name", err)
	}
	return nil
}

func drainTap(tap *streamTap) error {
	for {
		select {
		case m := <-tap.msgs:
			if strings.Contains(m, "event:") {
				return fmt.Errorf("a malformed name produced a message %q", m)
			}
		default:
			return nil
		}
	}
}

func TestEventMessageWireForm(t *testing.T) {
	topic := bus.NewTopic[live.Event](2)
	subscribed := make(chan (<-chan live.Event), 1)
	ts, _ := serveEvents(t, topicHandler(topic, subscribed))
	resp, err := openStream(t, ts)
	if err != nil {
		t.Fatal(err)
		return
	}
	if resp == nil {
		t.Fatal("no response")
		return
	}
	defer closeBody(t, resp.Body)
	awaitSubscribe(t, subscribed)
	tap := newStreamTap()
	drive := &streamDrive{body: resp.Body, tap: tap, topic: topic}
	if err := drive.wireForm(t.Context()); err != nil {
		t.Fatalf("client group: %v", err)
	}
}

func (c *streamDrive) wireForm(ctx context.Context) error {
	go group (ctx) {
		go { c.tap.read(ctx, c.body)? }
		go c.wireFormSteps(ctx)
	}
	return nil
}

func (c *streamDrive) wireFormSteps(ctx context.Context) error {
	topic := c.topic
	if topic == nil {
		return fmt.Errorf("live_test: wire form needs a topic")
	}
	if err := expectHeartbeatErr(ctx, c.tap); err != nil {
		return err
	}
	price, err := live.NewEvent("price", view.T("first\nsecond"))
	if err != nil {
		return fmt.Errorf("NewEvent(price): %w", err)
	}
	topic.Publish(price)
	want := "event: price\ndata: first\ndata: second\n\n"
	got, err := tapMessages(ctx, c.tap, 3*time.Second)
	if err != nil {
		return err
	}
	if got != want {
		return fmt.Errorf("multi-line message %q, want %q", got, want)
	}
	plain, err := live.NewEvent("plain", view.T("single"))
	if err != nil {
		return fmt.Errorf("NewEvent(plain): %w", err)
	}
	topic.Publish(plain)
	got, err = tapMessages(ctx, c.tap, 3*time.Second)
	if err != nil {
		return err
	}
	if got != "event: plain\ndata: single\n\n" {
		return fmt.Errorf("single-line message %q", got)
	}
	returns, err := live.NewEvent("returns", view.T("one\r\ntwo\rthree"))
	if err != nil {
		return fmt.Errorf("NewEvent(returns): %w", err)
	}
	topic.Publish(returns)
	got, err = tapMessages(ctx, c.tap, 3*time.Second)
	if err != nil {
		return err
	}
	if got != "event: returns\ndata: one\ndata: two\ndata: three\n\n" {
		return fmt.Errorf("message with carriage returns %q", got)
	}
	if cerr := c.body.Close(); cerr != nil {
		return fmt.Errorf("close stream body: %w", cerr)
	}
	return nil
}

func TestClientDisconnectEndsStreamAndSubscription(t *testing.T) {
	topic := bus.NewTopic[live.Event](2)
	subscribed := make(chan (<-chan live.Event), 1)
	ts, serveDone := serveEvents(t, topicHandler(topic, subscribed))
	resp, err := openStream(t, ts)
	if err != nil {
		t.Fatal(err)
		return
	}
	if resp == nil {
		t.Fatal("no response")
		return
	}
	defer closeBody(t, resp.Body)
	sub, err := subscribedChannel(t.Context(), subscribed)
	if err != nil {
		t.Fatal(err)
		return
	}
	tap := newStreamTap()
	drive := &streamDrive{body: resp.Body, tap: tap, sub: sub, serveDone: serveDone}
	if err := drive.disconnect(t.Context()); err != nil {
		t.Fatalf("group join after the disconnect: %v", err)
	}
}

func (c *streamDrive) disconnect(ctx context.Context) error {
	go group (ctx) {
		go { c.tap.read(ctx, c.body)? }
		go c.disconnectSteps(ctx)
	}
	return nil
}

func (c *streamDrive) disconnectSteps(ctx context.Context) error {
	if err := expectHeartbeatErr(ctx, c.tap); err != nil {
		return err
	}
	if cerr := c.body.Close(); cerr != nil {
		return fmt.Errorf("close stream body: %w", cerr)
	}
	select {
	case <-c.serveDone:
	case <-time.After(5 * time.Second):
		return fmt.Errorf("the stream did not end within 5s of the client disconnect")
	case <-ctx.Done():
		return ctx.Err()
	}
	return checkSubClosed(ctx, c.sub)
}

func checkSubClosed(ctx context.Context, sub <-chan live.Event) error {
	select {
	case v, ok := <-sub:
		if ok {
			return fmt.Errorf("the subscription delivered %q after the client disconnected", v.Name)
		}
	case <-time.After(3 * time.Second):
		return fmt.Errorf("the subscription channel did not close after the client disconnected")
	case <-ctx.Done():
		return ctx.Err()
	}
	return nil
}

type checkedPublisher struct {
	topic *bus.Topic[live.Event]
	fast  <-chan live.Event
}

func (p *checkedPublisher) publish(name string, body view.Node) error {
	ev, err := live.NewEvent(name, body)
	if err != nil {
		return fmt.Errorf("NewEvent(%q): %w", name, err)
	}
	p.topic.Publish(ev)
	select {
	case got := <-p.fast:
		if got.Name != name {
			return fmt.Errorf("the fast subscriber got %q, want %q", got.Name, name)
		}
	case <-time.After(3 * time.Second):
		return fmt.Errorf("the fast subscriber did not receive %q", name)
	}
	return nil
}

func TestSlowStreamSubscriberLosesEventsFastKeepsAll(t *testing.T) {
	topic := bus.NewTopic[live.Event](1)
	subscribed := make(chan (<-chan live.Event), 1)
	resolveStarted := make(chan struct{})
	gate := make(chan struct{})
	ts, serveDone := serveEvents(t, topicHandler(topic, subscribed))
	fast := topic.Subscribe(t.Context())
	resp, err := openStream(t, ts)
	if err != nil {
		t.Fatal(err)
		return
	}
	if resp == nil {
		t.Fatal("no response")
		return
	}
	defer closeBody(t, resp.Body)
	awaitSubscribe(t, subscribed)
	tap := newStreamTap()
	drive := &streamDrive{
		body:           resp.Body,
		tap:            tap,
		pub:            &checkedPublisher{topic: topic, fast: fast},
		gate:           gate,
		resolveStarted: resolveStarted,
		serveDone:      serveDone,
	}
	if err := drive.slowStream(t.Context()); err != nil {
		t.Fatalf("client group: %v", err)
	}
}

func (c *streamDrive) slowStream(ctx context.Context) error {
	go group (ctx) {
		go { c.tap.read(ctx, c.body)? }
		go c.slowStreamSteps(ctx)
	}
	return nil
}

func blockedEvent(resolveStarted chan struct{}, gate chan struct{}) (live.Event, error) {
	return live.NewEvent("e1", &view.Later{
		Fallback: view.T("pending"),
		Resolve: func(ctx context.Context) (view.Node, error) {
			select {
			case resolveStarted <- struct{}{}:
			case <-ctx.Done():
				return nil, ctx.Err()
			}
			select {
			case <-gate:
				return view.T("resolved"), nil
			case <-ctx.Done():
				return nil, ctx.Err()
			}
		},
	})
}

func (c *streamDrive) slowStreamSteps(ctx context.Context) error {
	pub := c.pub
	if pub == nil {
		return fmt.Errorf("live_test: slow stream needs a publisher")
	}
	if err := c.publishBlocked(ctx, pub); err != nil {
		return err
	}
	if err := c.publishOverflow(ctx, pub); err != nil {
		return err
	}
	if err := c.checkSlowTap(ctx); err != nil {
		return err
	}
	if err := c.checkFastTap(ctx); err != nil {
		return err
	}
	if cerr := c.body.Close(); cerr != nil {
		return fmt.Errorf("close stream body: %w", cerr)
	}
	return awaitServeErr(ctx, c.serveDone)
}

func (c *streamDrive) publishBlocked(ctx context.Context, pub *checkedPublisher) error {
	if err := expectHeartbeatErr(ctx, c.tap); err != nil {
		return err
	}
	blocked, err := blockedEvent(c.resolveStarted, c.gate)
	if err != nil {
		return fmt.Errorf("NewEvent(%q): %w", "e1", err)
	}
	if err := pub.publish("e1", blocked.Body); err != nil {
		return err
	}
	select {
	case <-c.resolveStarted:
	case <-time.After(3 * time.Second):
		return fmt.Errorf("the stream never started rendering the first event")
	case <-ctx.Done():
		return ctx.Err()
	}
	return nil
}

func (c *streamDrive) publishOverflow(ctx context.Context, pub *checkedPublisher) error {
	if err := pub.publish("e2", view.T("second")); err != nil {
		return err
	}
	if err := pub.publish("e3", view.T("third")); err != nil {
		return err
	}
	if err := pub.publish("e4", view.T("fourth")); err != nil {
		return err
	}
	if err := pub.publish("e5", view.T("fifth")); err != nil {
		return err
	}
	if got := pub.topic.Dropped(); got != 3 {
		return fmt.Errorf("Dropped = %d, want 3 events dropped for the blocked stream subscriber", got)
	}
	close(c.gate)
	return nil
}

func (c *streamDrive) checkSlowTap(ctx context.Context) error {
	first, err := tapMessages(ctx, c.tap, 3*time.Second)
	if err != nil {
		return err
	}
	if !strings.HasPrefix(first, "event: e1\ndata: ") || !strings.Contains(first, ">resolved<") || !strings.HasSuffix(first, "\n\n") {
		return fmt.Errorf("first event message %q", first)
	}
	return nil
}

func (c *streamDrive) checkFastTap(ctx context.Context) error {
	second, err := tapMessages(ctx, c.tap, 3*time.Second)
	if err != nil {
		return err
	}
	if second != "event: e2\ndata: second\n\n" {
		return fmt.Errorf("second event message %q", second)
	}
	return nil
}

func TestEventTextEscapedAndNameRejected(t *testing.T) {
	events := make(chan live.Event, 2)
	ts, serveDone := serveEvents(t, rawHandler(events))
	resp, err := openStream(t, ts)
	if err != nil {
		t.Fatal(err)
		return
	}
	if resp == nil {
		t.Fatal("no response")
		return
	}
	defer closeBody(t, resp.Body)
	tap := newStreamTap()
	drive := &streamDrive{body: resp.Body, tap: tap, events: events, serveDone: serveDone}
	if err := drive.escaped(t.Context()); err != nil {
		t.Fatalf("client group: %v", err)
	}
}

func (c *streamDrive) escaped(ctx context.Context) error {
	go group (ctx) {
		go { c.tap.read(ctx, c.body)? }
		go c.escapedSteps(ctx)
	}
	return nil
}

func (c *streamDrive) escapedSteps(ctx context.Context) error {
	if err := rejectBadNames(); err != nil {
		return err
	}
	made, err := live.NewEvent("price", view.T("x"))
	if err != nil {
		return fmt.Errorf("NewEvent(price): %w", err)
	}
	if made.Name != "price" {
		return fmt.Errorf("NewEvent(price) = %v", made)
	}
	if err := expectHeartbeatErr(ctx, c.tap); err != nil {
		return err
	}
	quoted, err := live.NewEvent("quote", view.T(`<b>&'"</b>`))
	if err != nil {
		return fmt.Errorf("NewEvent(quote): %w", err)
	}
	if err := c.emit(ctx, quoted); err != nil {
		return err
	}
	want := "event: quote\ndata: &lt;b&gt;&amp;&#39;&#34;&lt;/b&gt;\n\n"
	got, err := tapMessages(ctx, c.tap, 3*time.Second)
	if err != nil {
		return err
	}
	if got != want {
		return fmt.Errorf("escaped message %q, want %q", got, want)
	}
	if err := c.emit(ctx, live.Event{Name: "a\nb", Body: view.T("x")}); err != nil {
		return err
	}
	if err := awaitEndErr(ctx, c.tap, 3*time.Second); err != nil {
		return err
	}
	return c.finishStream(ctx)
}

func (c *streamDrive) finishStream(ctx context.Context) error {
	if err := drainTap(c.tap); err != nil {
		return err
	}
	if err := awaitServeErr(ctx, c.serveDone); err != nil {
		return err
	}
	if cerr := c.body.Close(); cerr != nil {
		return fmt.Errorf("close stream body: %w", cerr)
	}
	return nil
}

type slogTap struct {
	records sync.Locked[[]string]
}

func (h *slogTap) Enabled(_ context.Context, _ slog.Level) bool {
	return true
}

func (h *slogTap) Handle(_ context.Context, r slog.Record) error {
	var b strings.Builder
	r.Attrs(func(a slog.Attr) bool {
		b.WriteString(" ")
		b.WriteString(a.Key)
		b.WriteString("=")
		b.WriteString(a.Value.String())
		return true
	})
	h.records.WithLock(func(rs *[]string) {
		*rs = append(*rs, r.Message+b.String())
	})
	return nil
}

func (h *slogTap) WithAttrs(_ []slog.Attr) slog.Handler {
	return h
}

func (h *slogTap) WithGroup(_ string) slog.Handler {
	return h
}

func TestRenderErrorEndsStreamLoggedOnce(t *testing.T) {
	events := make(chan live.Event, 1)
	ts, serveDone := serveEvents(t, rawHandler(events))
	logs := &slogTap{}
	previous := slog.Default()
	slog.SetDefault(slog.New(logs))
	defer slog.SetDefault(previous)
	resp, err := openStream(t, ts)
	if err != nil {
		t.Fatal(err)
		return
	}
	if resp == nil {
		t.Fatal("no response")
		return
	}
	defer closeBody(t, resp.Body)
	tap := newStreamTap()
	drive := &streamDrive{body: resp.Body, tap: tap, events: events, serveDone: serveDone}
	if err := drive.renderError(t.Context()); err != nil {
		t.Fatalf("client group: %v", err)
	}
	hits := countRecords(logs, "render event")
	if hits != 1 {
		var all []string
		logs.records.WithLock(func(rs *[]string) {
			all = append(all, *rs...)
		})
		t.Fatalf("the render error was logged %d times, want exactly once: %v", hits, all)
	}
}

func (c *streamDrive) renderError(ctx context.Context) error {
	go group (ctx) {
		go { c.tap.read(ctx, c.body)? }
		go c.renderErrorSteps(ctx)
	}
	return nil
}

func (c *streamDrive) renderErrorSteps(ctx context.Context) error {
	if err := expectHeartbeatErr(ctx, c.tap); err != nil {
		return err
	}
	if err := c.emit(ctx, live.Event{Name: "boom", Body: &view.Island{Entry: "e.js", When: "hover"}}); err != nil {
		return err
	}
	if err := awaitEndErr(ctx, c.tap, 3*time.Second); err != nil {
		return err
	}
	if err := awaitServeErr(ctx, c.serveDone); err != nil {
		return err
	}
	if cerr := c.body.Close(); cerr != nil {
		return fmt.Errorf("close stream body: %w", cerr)
	}
	return nil
}

func countRecords(logs *slogTap, part string) int {
	hits := 0
	logs.records.WithLock(func(rs *[]string) {
		for _, r := range *rs {
			if strings.Contains(r, part) {
				hits++
			}
		}
	})
	return hits
}

type brokenPipe struct {
	header http.Header
	writes int
	gone   bool
	cancel context.CancelFunc
}

func (b *brokenPipe) Header() http.Header {
	return b.header
}

func (b *brokenPipe) WriteHeader(status int) {}

func (b *brokenPipe) Write(p []byte) (int, error) {
	b.writes++
	if b.writes == 1 {
		return len(p), nil
	}
	if b.gone {
		b.cancel()
	}
	return 0, io.ErrClosedPipe
}

func writeFailureLogs(t *testing.T, gone bool) int {
	t.Helper()
	logs := &slogTap{}
	previous := slog.Default()
	slog.SetDefault(slog.New(logs))
	defer slog.SetDefault(previous)
	ctx, cancel := context.WithCancel(t.Context())
	defer cancel()
	events := make(chan live.Event, 1)
	events <- live.Event{Name: "tick", Body: view.T("x")}
	r := web.NewRouter()
	r.Handle("GET", "/events", rawHandler(events))
	out := &brokenPipe{header: http.Header{}, gone: gone, cancel: cancel}
	r.ServeHTTP(out, httptest.NewRequest(http.MethodGet, "/events", nil).WithContext(ctx))
	return countRecords(logs, "write event")
}

func TestWriteFailureIsLoggedOnlyWhileTheClientIsPresent(t *testing.T) {
	if hits := writeFailureLogs(t, true); hits != 0 {
		t.Fatalf("a write that failed after the client left was logged %d times, want 0", hits)
	}
	if hits := writeFailureLogs(t, false); hits != 1 {
		t.Fatalf("a write that failed while the client was present was logged %d times, want 1", hits)
	}
}

type beatCounter struct {
	header http.Header
	beats  atomic.Int64
	seen   sync.Locked[[]string]
}

func (b *beatCounter) Header() http.Header {
	return b.header
}

func (b *beatCounter) WriteHeader(status int) {}

func (b *beatCounter) Write(p []byte) (int, error) {
	if string(p) == ": live\n\n" {
		b.beats.Add(1)
		return len(p), nil
	}
	b.seen.WithLock(func(s *[]string) {
		*s = append(*s, string(p))
	})
	return len(p), nil
}

func (b *beatCounter) delivered() []string {
	var out []string
	b.seen.WithLock(func(s *[]string) {
		out = append(out, *s...)
	})
	return out
}

func TestHeartbeatRepeatsEveryFifteenSeconds(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		ctx, cancel := context.WithCancel(t.Context())
		defer cancel()
		r := web.NewRouter()
		r.Handle("GET", "/events", rawHandler(make(chan live.Event)))
		out := &beatCounter{header: http.Header{}}
		if err := driveHeartbeatCount(ctx, cancel, r, out); err != nil {
			t.Fatalf("stream group: %v", err)
		}
	})
}

func driveHeartbeatCount(ctx context.Context, cancel context.CancelFunc, r *web.Router, out *beatCounter) error {
	req := httptest.NewRequest(http.MethodGet, "/events", nil).WithContext(ctx)
	go group (ctx) {
		go {
			r.ServeHTTP(out, req)
		}
		go countBeats(cancel, out)
	}
	return nil
}

func countBeats(cancel context.CancelFunc, out *beatCounter) error {
	for want := int64(1); want <= 3; want++ {
		synctest.Wait()
		if got := out.beats.Load(); got != want {
			return fmt.Errorf("%d heartbeats at the start of period %d, want %d", got, want, want)
		}
		time.Sleep(14 * time.Second)
		synctest.Wait()
		if got := out.beats.Load(); got != want {
			return fmt.Errorf("%d heartbeats 14 seconds into period %d, want %d", got, want, want)
		}
		time.Sleep(time.Second)
	}
	cancel()
	return nil
}

func serveUntilWatched(ctx context.Context, r *web.Router, out *beatCounter, watch func() error) error {
	req := httptest.NewRequest(http.MethodGet, "/events", nil).WithContext(ctx)
	go group (ctx) {
		go {
			r.ServeHTTP(out, req)
		}
		go watch()
	}
	return nil
}

func TestHeartbeatContinuesWhileAnEventRenders(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		ctx, cancel := context.WithCancel(t.Context())
		defer cancel()
		release := make(chan struct{})
		slow := &view.Later{Fallback: view.T("wait"), Resolve: func(ctx context.Context) (view.Node, error) {
			select {
			case <-release:
			case <-ctx.Done():
			}
			return view.T("done"), nil
		}}
		events := make(chan live.Event, 1)
		select {
		case events <- mustEvent(t, "tick", view.Div(slow)):
		case <-ctx.Done():
		}
		r := web.NewRouter()
		r.Handle("GET", "/events", rawHandler(events))
		out := &beatCounter{header: http.Header{}}
		err := serveUntilWatched(ctx, r, out, func() error {
			defer cancel()
			synctest.Wait()
			time.Sleep(31 * time.Second)
			synctest.Wait()
			if got := out.beats.Load(); got != 3 {
				return fmt.Errorf("live_test: %d heartbeats 31 seconds into a blocked render, want 3", got)
			}
			close(release)
			return deliveredEvent(out)
		})
		if err != nil {
			t.Fatal(err)
		}
	})
}

func deliveredEvent(out *beatCounter) error {
	for range 100 {
		synctest.Wait()
		for _, m := range out.delivered() {
			if strings.Contains(m, "event: tick") && strings.Contains(m, "done") {
				return nil
			}
		}
		time.Sleep(time.Second)
	}
	return fmt.Errorf("live_test: event tick not delivered after release: %q", out.delivered())
}
