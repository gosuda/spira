package client

import (
	"bytes"
	"context"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"mime"
	"net/http"
	"strings"

	"github.com/gosuda/spira/resilience"
	"github.com/gosuda/spira/web"
)

type StatusError struct {
	Status      int
	ProblemType string
	BodyLen     int
}

func (e *StatusError) Error() string {
	if e.ProblemType != "" {
		return $"client: upstream status {e.Status} type {e.ProblemType}"
	}
	return $"client: upstream status {e.Status}"
}

type Request[In any] struct {
	Method string
	Path   string
	Body   In?
	Header http.Header
}

type Client struct {
	Base    string
	Policy  resilience.Policy
	MaxBody int64 = 1 << 20
	HTTP    *http.Client
}

func New(base string, policy resilience.Policy) *Client {
	return &Client{Base: base, Policy: policy, HTTP: http.DefaultClient}
}

func Get[Out any](ctx context.Context, c *Client, path string) (Out, error) {
	return Send[empty, Out](ctx, c, Request[empty]{Method: http.MethodGet, Path: path})
}

func Send[In any, Out any](ctx context.Context, c *Client, req Request[In]) (Out, error) {
	p, perr := prepare(req)
	if perr != nil {
		var zero Out
		return zero, perr
	}
	pol := c.Policy
	if !retriable(p.method) {
		pol.Retry = nil
	}
	out, derr := resilience.Do(ctx, pol, func(actx context.Context) (Out, error) {
		return call[Out](actx, c, p)
	})
	if derr != nil {
		var zero Out
		return zero, fmt.Errorf("client: %s %s: %w", p.method, p.path, derr)
	}
	return out, nil
}

func callerFault(status int) bool {
	if status == http.StatusRequestTimeout || status == http.StatusTooManyRequests {
		return false
	}
	return status >= 400 && status < 500
}

type empty struct{}

type prepared struct {
	method  string
	path    string
	header  http.Header
	payload []byte
}

func prepare[In any](req Request[In]) (prepared, error) {
	p := prepared{method: strings.ToUpper(req.Method), path: req.Path, header: req.Header}
	if b := req.Body; b != nil {
		data, merr := json.Marshal(b)
		if merr != nil {
			return p, ErrRequestFailed.Wrap(fmt.Errorf("client: encode body for %s %s: %w", p.method, p.path, merr))
		}
		p.payload = data
	}
	return p, nil
}

func retriable(method string) bool {
	switch method {
	case http.MethodGet, http.MethodHead, http.MethodPut, http.MethodDelete:
		return true
	}
	return false
}

func call[Out any](ctx context.Context, c *Client, p prepared) (Out, error) {
	var none Out
	var body io.Reader
	if p.payload != nil {
		body = bytes.NewReader(p.payload)
	}
	hreq, nerr := http.NewRequestWithContext(ctx, p.method, c.Base+p.path, body)
	if nerr != nil {
		return none, ErrRequestFailed.Wrap(fmt.Errorf("client: new request %s %s: %w", p.method, p.path, nerr))
	}
	applyHeader(hreq, p.header, p.payload != nil)
	resp, derr := c.HTTP.Do(hreq)
	if derr != nil {
		return none, ErrUpstreamFailed.Wrap(fmt.Errorf("client: %s %s: %w", p.method, p.path, derr))
	}
	defer resp.Body.Close()?
	if resp.StatusCode < 200 || resp.StatusCode > 299 {
		data, rerr := io.ReadAll(io.LimitReader(resp.Body, c.MaxBody))
		if rerr != nil {
			return none, ErrUpstreamFailed.Wrap(fmt.Errorf("client: %s %s read error body: %w", p.method, p.path, rerr))
		}
		serr := statusError(resp.StatusCode, resp.Header.Get("Content-Type"), data)
		if callerFault(resp.StatusCode) {
			return none, resilience.Ignored(serr)
		}
		return none, serr
	}
	data, rerr := readLimited(resp.Body, c.MaxBody)
	if rerr != nil {
		if errors.Is(rerr, ErrResponseTooLarge) {
			return none, fmt.Errorf("client: %s %s: %w", p.method, p.path, rerr)
		}
		return none, ErrUpstreamFailed.Wrap(fmt.Errorf("client: %s %s read response: %w", p.method, p.path, rerr))
	}
	var out Out
	if bodyless(p.method, resp.StatusCode) {
		return out, nil
	}
	if uerr := json.Unmarshal(data, &out); uerr != nil {
		return none, ErrUpstreamFailed.Wrap(fmt.Errorf("client: %s %s decode: %w", p.method, p.path, uerr))
	}
	return out, nil
}

func bodyless(method string, status int) bool {
	if method == http.MethodHead {
		return true
	}
	return status == http.StatusNoContent || status == http.StatusResetContent
}

func applyHeader(hreq *http.Request, header http.Header, jsonBody bool) {
	hreq.Header = http.Header{}
	for name, values := range header {
		for _, v := range values {
			hreq.Header.Add(name, v)
		}
	}
	if jsonBody {
		hreq.Header.Set("Content-Type", "application/json")
	}
}

func readLimited(body io.Reader, limit int64) ([]byte, error) {
	data, rerr := io.ReadAll(io.LimitReader(body, limit+1))
	if rerr != nil {
		return nil, rerr
	}
	if int64(len(data)) > limit {
		return nil, ErrResponseTooLarge.Wrap(fmt.Errorf("body exceeds %d bytes", limit))
	}
	return data, nil
}

func statusError(status int, contentType string, data []byte) error {
	problemType := ""
	if mediaType, _, merr := mime.ParseMediaType(contentType); merr == nil && mediaType == "application/problem+json" {
		p := web.Problem{}
		if uerr := json.Unmarshal(data, &p); uerr == nil {
			problemType = p.Type
		}
	}
	se := &StatusError{Status: status, ProblemType: problemType, BodyLen: len(data)}
	if status == http.StatusRequestTimeout {
		return ErrUpstreamTimeout.Wrap(se)
	}
	if status == http.StatusTooManyRequests {
		return ErrUpstreamRateLimited.Wrap(se)
	}
	if callerFault(status) {
		return ErrUpstreamRejected.Wrap(se)
	}
	return ErrUpstreamFailed.Wrap(se)
}
