func TestRequestFailedIsFault(t *testing.T) {
	c := client.New("http://example.invalid", resilience.Policy{Timeout: time.Second})
	_, err := client.Send[func(), probe](t.Context(), c, client.Request[func()]{Method: http.MethodPost, Path: "/x", Body: func() {}})
	if err == nil {
		t.Fatal("err=nil, want the encode failure as an error")
		return
	}
	if !errors.Is(err, client.ErrRequestFailed) {
		t.Fatalf("err=%v, want ErrRequestFailed", err)
		return
	}
	got := fault.Public(err)
	if got.Code != "internal" {
		t.Fatalf("code=%q, want internal for an Internal fault", got.Code)
	}
}

func TestFaultPublicHidesSecret(t *testing.T) {
	secret := "api-key=hunter2-secret"
	hostile := "<script>alert(1)</script>"
	leak := secret + " " + hostile + " /etc/passwd '; DROP TABLE x; --"
	srv := httptest.NewServer(serve(t, http.StatusInternalServerError, "text/plain", leak))
	defer srv.Close()
	c := client.New(srv.URL, resilience.Policy{Timeout: time.Second})
	_, err := client.Get[probe](t.Context(), c, "/secret")
	if err == nil {
		t.Fatal("err=nil, want the 500 as an error")
		return
	}
	got := fault.Public(err)
	if got.Code != "client.upstream_failed" {
		t.Fatalf("code=%q, want client.upstream_failed", got.Code)
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, err), secret, hostile, "/etc/passwd", "DROP TABLE")
	faulttest.RefuseLeak(t, []byte(err.Error()), secret, hostile, "/etc/passwd", "DROP TABLE")
}

func TestFaultsMatchCodeTable(t *testing.T) {
	faulttest.CheckTable(t, "../docs/specs/client.md", client.Faults())
}
