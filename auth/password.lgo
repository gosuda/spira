package auth

import (
	"crypto/rand"
	"crypto/subtle"
	"encoding/base64"
	"fmt"
	"log/slog"
	"strconv"
	"strings"

	"golang.org/x/crypto/argon2"
)

const (
	hashMemoryKiB = 19456
	hashTime      = 2
	hashParallel  = 1
	hashSaltBytes = 16
	hashKeyBytes  = 32
	maxMemoryKiB  = 1 << 20
	maxTime       = 16
	maxParallel   = 16
	maxSaltBytes  = 64
	maxKeyBytes   = 64
	minKeyBytes   = 16
	argon2Version = 19
	argon2idPHC   = "argon2id"
)

type passwordSpec struct {
	time    uint32
	memory  uint32
	threads uint8
	salt    []byte
	key     []byte
}

func HashPassword(password string) (string, error) {
	var salt [hashSaltBytes]byte
	if _, err := rand.Read(salt[:]); err != nil {
		return "", ErrPasswordFailed.Wrap(fmt.Errorf("auth: password hash: %w", err))
	}
	key := argon2.IDKey([]byte(password), salt[:], hashTime, hashMemoryKiB, hashParallel, hashKeyBytes)
	return fmt.Sprintf("$%s$v=%d$m=%d,t=%d,p=%d$%s$%s",
		argon2idPHC, argon2Version, hashMemoryKiB, hashTime, hashParallel,
		base64.RawStdEncoding.EncodeToString(salt[:]),
		base64.RawStdEncoding.EncodeToString(key)), nil
}

func VerifyPassword(encoded string, password string) (bool, error) {
	spec, err := parsePasswordHash(encoded)
	if err != nil {
		return false, ErrPasswordFailed.Wrap(fmt.Errorf("auth: password hash: %w", err))
	}
	derived := argon2.IDKey([]byte(password), spec.salt, spec.time, spec.memory, spec.threads, uint32(len(spec.key)))
	return subtle.ConstantTimeCompare(derived, spec.key) == 1, nil
}

func VerifyAgainstDummy(password string) bool {
	_, err := VerifyPassword(dummyPasswordHash(), password)
	if err != nil {
		slog.Error("auth: dummy password verification failed", "error", err)
	}
	return false
}

func dummyPasswordHash() string {
	salt := base64.RawURLEncoding.EncodeToString(make([]byte, hashSaltBytes))
	key := base64.RawURLEncoding.EncodeToString(make([]byte, hashKeyBytes))
	return fmt.Sprintf("$%s$v=%d$m=%d,t=%d,p=%d$%s$%s",
		argon2idPHC, argon2Version, hashMemoryKiB, hashTime, hashParallel, salt, key)
}

func parsePasswordHash(encoded string) (passwordSpec, error) {
	parts := strings.SplitN(encoded, "$", 6)
	if len(parts) != 6 || parts[0] != "" || parts[1] != argon2idPHC {
		return passwordSpec{}, fmt.Errorf("malformed PHC string")
	}
	if !strings.HasPrefix(parts[2], "v=") || parts[2][2:] != strconv.Itoa(argon2Version) {
		return passwordSpec{}, fmt.Errorf("unsupported argon2 version")
	}
	params := strings.Split(parts[3], ",")
	if len(params) != 3 ||
		!strings.HasPrefix(params[0], "m=") ||
		!strings.HasPrefix(params[1], "t=") ||
		!strings.HasPrefix(params[2], "p=") {
		return passwordSpec{}, fmt.Errorf("malformed parameters")
	}
	nums := make([]uint64, 3)
	for i, p := range params {
		v, err := strconv.ParseUint(p[2:], 10, 32)
		if err != nil {
			return passwordSpec{}, fmt.Errorf("malformed parameter %q", p)
		}
		nums[i] = v
	}
	if nums[0] == 0 || nums[1] == 0 || nums[2] == 0 {
		return passwordSpec{}, fmt.Errorf("parameters must be positive")
	}
	if nums[0] > maxMemoryKiB || nums[1] > maxTime || nums[2] > maxParallel {
		return passwordSpec{}, fmt.Errorf("parameters out of bounds")
	}
	salt, err := decodeBounded("salt", parts[4], base64.RawStdEncoding.EncodedLen(maxSaltBytes))
	if err != nil {
		return passwordSpec{}, err
	}
	key, kerr := decodeBounded("key", parts[5], base64.RawStdEncoding.EncodedLen(maxKeyBytes))
	if kerr != nil {
		return passwordSpec{}, kerr
	}
	if len(salt) > maxSaltBytes {
		return passwordSpec{}, fmt.Errorf("salt length out of bounds")
	}
	if len(key) < minKeyBytes || len(key) > maxKeyBytes {
		return passwordSpec{}, fmt.Errorf("key length out of bounds")
	}
	return passwordSpec{
		time:    uint32(nums[1]),
		memory:  uint32(nums[0]),
		threads: uint8(nums[2]),
		salt:    salt,
		key:     key,
	}, nil
}

func decodeBounded(field string, encoded string, maxEncoded int) ([]byte, error) {
	if len(encoded) == 0 || len(encoded) > maxEncoded {
		return nil, fmt.Errorf("%s length out of bounds", field)
	}
	decoded, derr := base64.RawStdEncoding.DecodeString(encoded)
	if derr != nil {
		return nil, fmt.Errorf("malformed %s: %w", field, derr)
	}
	return decoded, nil
}
