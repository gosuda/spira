package auth_test

import (
	"context"
	"crypto/sha256"
	"encoding/base64"
	"encoding/hex"
	"fmt"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"testing/synctest"
	"time"

	"logos/sync"

	"github.com/gosuda/spira/auth"
	"github.com/gosuda/spira/web"
)

func newTestSessions() (*auth.Sessions, auth.SessionStore) {
	store := auth.NewMemoryStore()
	return &auth.Sessions{Store: store}, store
}

func loginRoute(s *auth.Sessions) *web.Router {
	r := web.NewRouter()
	r.Handle("POST", "/login", func(ctx *web.Context) (web.Reply, error) {
		p := auth.Principal{ID: "u-1", Roles: []string{"user"}}
		cookie, err := s.Login(ctx, p)
		if err != nil {
			return nil, err
		}
		if cookie == nil {
			return nil, fmt.Errorf("auth: login returned no cookie")
		}
		ctx.ResponseHeader().Add("Set-Cookie", cookie.String())
		return web.Empty{}, nil
	})
	return r
}

func logoutHandler(s *auth.Sessions) web.Handler {
	return func(ctx *web.Context) (web.Reply, error) {
		cookie, err := s.Logout(ctx)
		if err != nil {
			return nil, err
		}
		if cookie == nil {
			return nil, fmt.Errorf("auth: logout returned no cookie")
		}
		ctx.ResponseHeader().Add("Set-Cookie", cookie.String())
		return web.Empty{}, nil
	}
}

func guardedRoute(s *auth.Sessions) *web.Router {
	r := web.NewRouter()
	r.Use(auth.Authenticate(s.Authenticator()))
	r.Use(auth.Require(auth.Authenticated()))
	r.Handle("GET", "/who", principalHandler)
	r.Handle("POST", "/logout", logoutHandler(s))
	return r
}

func sessionCookie(t *testing.T, rec *httptest.ResponseRecorder) *http.Cookie? {
	t.Helper()
	cookies := rec.Result().Cookies()
	if len(cookies) != 1 {
		t.Fatalf("want one cookie, got %d (%v)", len(cookies), cookies)
		return nil
	}
	return cookies[0]
}

func hashSessionKey(t *testing.T, id string) string {
	t.Helper()
	sum := sha256.Sum256([]byte(id))
	return hex.EncodeToString(sum[:])
}

func loadSession(t *testing.T, store auth.SessionStore, key string) auth.Principal? {
	t.Helper()
	p, err := store.Load(context.Background(), key)
	if err != nil {
		t.Fatalf("store load %q: %v", key, err)
		return nil
	}
	return p
}

func TestLoginCookieShapeAndStoreSeesSHA256(t *testing.T) {
	s, store := newTestSessions()
	rec := callAuth(t, loginRoute(s), httptest.NewRequest(http.MethodPost, "/login", nil))
	if rec.Code != http.StatusNoContent {
		t.Fatalf("status %d want 204 body %s", rec.Code, rec.Body.String())
	}
	c := sessionCookie(t, rec)
	if c == nil {
		return
	}
	if c.Name != s.Cookie {
		t.Fatalf("cookie name %q want %q", c.Name, s.Cookie)
	}
	raw, err := base64.RawURLEncoding.DecodeString(c.Value)
	if err != nil {
		t.Fatalf("cookie value %q is not base64url: %v", c.Value, err)
		return
	}
	if len(raw) != 32 {
		t.Fatalf("cookie value decodes to %d bytes, want 32", len(raw))
	}
	if !c.Secure || !c.HttpOnly || c.SameSite != http.SameSiteLaxMode || c.Path != "/" {
		t.Fatalf("cookie flags secure=%v httpOnly=%v sameSite=%v path=%q",
			c.Secure, c.HttpOnly, c.SameSite, c.Path)
	}
	if p := loadSession(t, store, c.Value); p != nil {
		t.Fatalf("store holds the raw id as a key")
	}
	p := loadSession(t, store, hashSessionKey(t, c.Value))
	if p == nil {
		t.Fatalf("store has no session under the sha256 key")
		return
	}
	if p.ID != "u-1" {
		t.Fatalf("stored id %q want u-1", p.ID)
	}
}

func TestLoginRotatesIDAndRemovesOldSession(t *testing.T) {
	s, store := newTestSessions()
	r := loginRoute(s)

	c1 := sessionCookie(t, callAuth(t, r, httptest.NewRequest(http.MethodPost, "/login", nil)))
	if c1 == nil {
		return
	}
	again := httptest.NewRequest(http.MethodPost, "/login", nil)
	again.AddCookie(c1)
	c2 := sessionCookie(t, callAuth(t, r, again))
	if c2 == nil {
		return
	}
	if c1.Value == c2.Value {
		t.Fatalf("login reused session id %q", c1.Value)
	}
	if p := loadSession(t, store, hashSessionKey(t, c1.Value)); p != nil {
		t.Fatalf("old session survived re-login")
	}
	if p := loadSession(t, store, hashSessionKey(t, c2.Value)); p == nil {
		t.Fatalf("new session missing after re-login")
	}
}

func TestTamperedOrUnknownSessionIDIsAnonymous(t *testing.T) {
	s, _ := newTestSessions()
	r := guardedRoute(s)

	for _, id := range []string{"not-a-real-id", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"} {
		req := httptest.NewRequest(http.MethodGet, "/who", nil)
		req.AddCookie(&http.Cookie{Name: s.Cookie, Value: id})
		rec := callAuth(t, r, req)
		if rec.Code != http.StatusUnauthorized {
			t.Fatalf("id %q: status %d want 401 body %s", id, rec.Code, rec.Body.String())
		}
	}
}

func TestExpiredSessionIsAnonymous(t *testing.T) {
	s := &auth.Sessions{Store: auth.NewMemoryStore(), TTL: -time.Second}
	rec := callAuth(t, loginRoute(s), httptest.NewRequest(http.MethodPost, "/login", nil))
	cookie := sessionCookie(t, rec)
	if cookie == nil {
		return
	}
	req := httptest.NewRequest(http.MethodGet, "/who", nil)
	req.AddCookie(&http.Cookie{Name: s.Cookie, Value: cookie.Value})
	if got := callAuth(t, guardedRoute(s), req); got.Code != http.StatusUnauthorized {
		t.Fatalf("status %d want 401: a session past its TTL is anonymous", got.Code)
	}
}

func TestLogoutRemovesSessionAndExpiresCookie(t *testing.T) {
	s, store := newTestSessions()
	c1 := sessionCookie(t, callAuth(t, loginRoute(s), httptest.NewRequest(http.MethodPost, "/login", nil)))
	if c1 == nil {
		return
	}
	req := httptest.NewRequest(http.MethodPost, "/logout", nil)
	req.AddCookie(c1)
	rec := callAuth(t, guardedRoute(s), req)
	if rec.Code != http.StatusNoContent {
		t.Fatalf("status %d want 204 body %s", rec.Code, rec.Body.String())
	}
	if p := loadSession(t, store, hashSessionKey(t, c1.Value)); p != nil {
		t.Fatalf("session survived logout")
	}
	expired := sessionCookie(t, rec)
	if expired == nil {
		return
	}
	if !expired.Expires.Before(time.Now()) || expired.MaxAge >= 0 {
		t.Fatalf("cookie not expired: expires=%v maxAge=%d", expired.Expires, expired.MaxAge)
	}
}

func TestMemoryStoreServesSixteenConcurrentChildren(t *testing.T) {
	store := auth.NewMemoryStore()
	if err := driveSixteenSlots(t.Context(), store, t); err != nil {
		t.Fatalf("concurrent drive: %v", err)
	}
	for i := range 16 {
		assertSlot(t, store, i)
	}
}

func driveSixteenSlots(ctx context.Context, store auth.SessionStore, t *testing.T) error {
	go group (ctx, limit = 16) {
		for i := range 16 {
			go exerciseSlot(ctx, store, t, i)
		}
	}
	return nil
}

func exerciseSlot(ctx context.Context, store auth.SessionStore, t *testing.T, i int) error {
	id := fmt.Sprintf("slot-%d", i)
	p := auth.Principal{ID: fmt.Sprintf("user-%d", i), Roles: []string{"user"}}
	if err := store.Save(ctx, id, p, time.Minute); err != nil {
		t.Errorf("slot %d: save: %v", i, err)
		return nil
	}
	got, err := store.Load(ctx, id)
	if err != nil {
		t.Errorf("slot %d: load: %v", i, err)
		return nil
	}
	if got == nil {
		t.Errorf("slot %d: load returned none", i)
		return nil
	}
	if got.ID != p.ID {
		t.Errorf("slot %d: load returned %s want %s", i, got.ID, p.ID)
	}
	if i%2 == 0 {
		if err := store.Delete(ctx, id); err != nil {
			t.Errorf("slot %d: delete: %v", i, err)
		}
	}
	return nil
}

func assertSlot(t *testing.T, store auth.SessionStore, i int) {
	t.Helper()
	p := loadSession(t, store, fmt.Sprintf("slot-%d", i))
	if i%2 == 0 {
		if p != nil {
			t.Fatalf("slot %d: deleted session still present", i)
		}
		return
	}
	if p == nil {
		t.Fatalf("slot %d: session missing", i)
		return
	}
	if p.ID != fmt.Sprintf("user-%d", i) {
		t.Fatalf("slot %d: id %s", i, p.ID)
	}
}

type flakyDeleteStore struct {
	failDelete bool
	sessions   sync.Locked[map[string]auth.Principal]
}

func newFlakyDeleteStore() *flakyDeleteStore {
	s := &flakyDeleteStore{}
	s.sessions.WithLock(func(m *map[string]auth.Principal) {
		*m = map[string]auth.Principal{}
	})
	return s
}

func (s *flakyDeleteStore) Load(ctx context.Context, id string) (auth.Principal?, error) {
	var out auth.Principal?
	s.sessions.WithLock(func(m *map[string]auth.Principal) {
		p, ok := (*m)[id]
		if ok {
			out = p
		}
	})
	return out, nil
}

func (s *flakyDeleteStore) Save(ctx context.Context, id string, p auth.Principal, ttl time.Duration) error {
	s.sessions.WithLock(func(m *map[string]auth.Principal) {
		(*m)[id] = p
	})
	return nil
}

func (s *flakyDeleteStore) Delete(ctx context.Context, id string) error {
	if s.failDelete {
		return fmt.Errorf("store unavailable")
	}
	s.sessions.WithLock(func(m *map[string]auth.Principal) {
		delete(*m, id)
	})
	return nil
}

func (s *flakyDeleteStore) size() int {
	n := 0
	s.sessions.WithLock(func(m *map[string]auth.Principal) {
		n = len(*m)
	})
	return n
}

func captureAuthRoute(s *auth.Sessions, loginErr *string, logoutErr *string) *web.Router {
	r := web.NewRouter()
	r.Handle("POST", "/login", func(ctx *web.Context) (web.Reply, error) {
		cookie, err := s.Login(ctx, auth.Principal{ID: "u-1", Roles: []string{"user"}})
		if err != nil {
			*loginErr = err.Error()
			return nil, err
		}
		if cookie == nil {
			return nil, fmt.Errorf("auth: login returned no cookie")
		}
		ctx.ResponseHeader().Add("Set-Cookie", cookie.String())
		return web.Empty{}, nil
	})
	r.Handle("POST", "/logout", func(ctx *web.Context) (web.Reply, error) {
		cookie, err := s.Logout(ctx)
		if err != nil {
			*logoutErr = err.Error()
			return nil, err
		}
		if cookie == nil {
			return nil, fmt.Errorf("auth: logout returned no cookie")
		}
		ctx.ResponseHeader().Add("Set-Cookie", cookie.String())
		return web.Empty{}, nil
	})
	return r
}

func TestLogoutFailsClosedWhenDeleteFails(t *testing.T) {
	store := newFlakyDeleteStore()
	store.failDelete = true
	s := &auth.Sessions{Store: store}
	var loginErr, logoutErr string
	r := captureAuthRoute(s, &loginErr, &logoutErr)

	rec := callAuth(t, r, httptest.NewRequest(http.MethodPost, "/login", nil))
	if rec.Code != http.StatusNoContent {
		t.Fatalf("login without a cookie: status %d want 204 body %s", rec.Code, rec.Body.String())
	}
	c1 := sessionCookie(t, rec)
	if c1 == nil {
		return
	}
	req := httptest.NewRequest(http.MethodPost, "/logout", nil)
	req.AddCookie(c1)
	out := callAuth(t, r, req)
	if out.Code != http.StatusServiceUnavailable {
		t.Fatalf("logout with a failing delete: status %d want 503 body %s", out.Code, out.Body.String())
	}
	if len(out.Result().Cookies()) != 0 {
		t.Fatalf("logout with a failing delete issued a cookie")
	}
	if !strings.Contains(logoutErr, "auth: session delete:") {
		t.Fatalf("logout error %q lacks the session delete wrap", logoutErr)
	}
	if p := loadSession(t, store, hashSessionKey(t, c1.Value)); p == nil {
		t.Fatalf("session disappeared although its delete failed")
	}
}

func TestLoginFailsClosedWhenDeleteFails(t *testing.T) {
	store := newFlakyDeleteStore()
	store.failDelete = true
	s := &auth.Sessions{Store: store}
	var loginErr, logoutErr string
	r := captureAuthRoute(s, &loginErr, &logoutErr)

	rec := callAuth(t, r, httptest.NewRequest(http.MethodPost, "/login", nil))
	c1 := sessionCookie(t, rec)
	if c1 == nil {
		return
	}
	again := httptest.NewRequest(http.MethodPost, "/login", nil)
	again.AddCookie(c1)
	out := callAuth(t, r, again)
	if out.Code != http.StatusServiceUnavailable {
		t.Fatalf("re-login with a failing delete: status %d want 503 body %s", out.Code, out.Body.String())
	}
	if len(out.Result().Cookies()) != 0 {
		t.Fatalf("re-login with a failing delete issued a cookie")
	}
	if !strings.Contains(loginErr, "auth: session delete:") {
		t.Fatalf("login error %q lacks the session delete wrap", loginErr)
	}
	if store.size() != 1 {
		t.Fatalf("store holds %d sessions after the failed re-login, want only the old one", store.size())
	}
	if p := loadSession(t, store, hashSessionKey(t, c1.Value)); p == nil {
		t.Fatalf("old session disappeared although its delete failed")
	}
}

func TestFailingDeleteNeverBlocksRequestsWithoutCookie(t *testing.T) {
	store := newFlakyDeleteStore()
	store.failDelete = true
	s := &auth.Sessions{Store: store}
	var loginErr, logoutErr string
	r := captureAuthRoute(s, &loginErr, &logoutErr)

	rec := callAuth(t, r, httptest.NewRequest(http.MethodPost, "/login", nil))
	if rec.Code != http.StatusNoContent {
		t.Fatalf("login without a cookie: status %d want 204 body %s", rec.Code, rec.Body.String())
	}
	out := callAuth(t, r, httptest.NewRequest(http.MethodPost, "/logout", nil))
	if out.Code != http.StatusNoContent {
		t.Fatalf("logout without a cookie: status %d want 204 body %s", out.Code, out.Body.String())
	}
	expired := sessionCookie(t, out)
	if expired == nil {
		return
	}
	if expired.MaxAge >= 0 {
		t.Fatalf("logout without a cookie did not expire the cookie: maxAge=%d", expired.MaxAge)
	}
}

func TestMemoryStoreSweepsExpiredEntries(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		store := auth.NewMemoryStore()
		ctx := context.Background()
		p := auth.Principal{ID: "u-1", Roles: []string{"user"}}
		for i := range 100 {
			if err := store.Save(ctx, fmt.Sprintf("s-%d", i), p, time.Second); err != nil {
				t.Fatalf("save %d: %v", i, err)
				return
			}
		}
		time.Sleep(2 * time.Minute)
		if err := store.Save(ctx, "fresh", p, time.Second); err != nil {
			t.Fatalf("save fresh: %v", err)
			return
		}
		n, ok := auth.MemoryStoreSize(store)
		if !ok {
			t.Fatal("MemoryStoreSize did not see a memory store")
			return
		}
		if n != 1 {
			t.Fatalf("store holds %d sessions after the sweep, want 1", n)
		}
	})
}

func TestMemoryStoreSweepKeepsUnexpiredEntries(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		store := auth.NewMemoryStore()
		ctx := context.Background()
		p := auth.Principal{ID: "u-1", Roles: []string{"user"}}
		if err := store.Save(ctx, "short", p, time.Second); err != nil {
			t.Fatalf("save short: %v", err)
			return
		}
		if err := store.Save(ctx, "long", p, 10*time.Minute); err != nil {
			t.Fatalf("save long: %v", err)
			return
		}
		time.Sleep(2 * time.Minute)
		if err := store.Save(ctx, "fresh", p, time.Second); err != nil {
			t.Fatalf("save fresh: %v", err)
			return
		}
		n, ok := auth.MemoryStoreSize(store)
		if !ok {
			t.Fatal("MemoryStoreSize did not see a memory store")
			return
		}
		if n != 2 {
			t.Fatalf("store holds %d sessions after the sweep, want the unexpired one and the fresh one", n)
		}
		if got := loadSession(t, store, "long"); got == nil {
			t.Fatal("the unexpired session was swept away")
		}
	})
}
