package auth_test

import (
	"encoding/base64"
	"strings"
	"testing"

	"github.com/gosuda/spira/auth"
	"golang.org/x/crypto/argon2"
)

const (
	validSalt = "c29tZXNhbHQ"
	validKey  = "NQrDciL0Nsy1wJcvHr079rlYvyBxhBNi"
)

func TestVerifyPasswordAcceptsVector(t *testing.T) {
	encoded := "$argon2id$v=19$m=64,t=2,p=2$" + validSalt + "$" + validKey
	ok, err := auth.VerifyPassword(encoded, "password")
	if err != nil {
		t.Fatalf("VerifyPassword: %v", err)
		return
	}
	if !ok {
		t.Fatal("VerifyPassword rejected the argon2id test vector")
	}
}

func TestVerifyPasswordRejectsWrongPassword(t *testing.T) {
	encoded, err := auth.HashPassword("correct horse battery staple")
	if err != nil {
		t.Fatalf("HashPassword: %v", err)
		return
	}
	ok, verr := auth.VerifyPassword(encoded, "correct horse battery staplf")
	if verr != nil {
		t.Fatalf("VerifyPassword: %v", verr)
		return
	}
	if ok {
		t.Fatal("VerifyPassword accepted a wrong password")
	}
}

func TestVerifyPasswordRejectsOneBitChanges(t *testing.T) {
	encoded, herr := auth.HashPassword("hunter2")
	if herr != nil {
		t.Fatalf("HashPassword: %v", herr)
		return
	}
	fields := strings.Split(encoded, "$")
	if len(fields) != 6 {
		t.Fatalf("unexpected PHC shape %q", encoded)
		return
	}
	cases := map[string]string{
		"salt": fields[0] + "$" + fields[1] + "$" + fields[2] + "$" + fields[3] + "$" + flipChar(fields[4], len(fields[4])/2) + "$" + fields[5],
		"key":  fields[0] + "$" + fields[1] + "$" + fields[2] + "$" + fields[3] + "$" + fields[4] + "$" + flipChar(fields[5], len(fields[5])/2),
	}
	for name, mutated := range cases {
		ok, verr := auth.VerifyPassword(mutated, "hunter2")
		if verr != nil {
			t.Fatalf("%s mutation: VerifyPassword: %v", name, verr)
			return
		}
		if ok {
			t.Fatalf("%s mutation accepted", name)
		}
	}
}

func TestHashPasswordIsRandomized(t *testing.T) {
	a, errA := auth.HashPassword("same password")
	if errA != nil {
		t.Fatalf("HashPassword: %v", errA)
		return
	}
	b, errB := auth.HashPassword("same password")
	if errB != nil {
		t.Fatalf("HashPassword: %v", errB)
		return
	}
	if a == b {
		t.Fatal("two hashes of one password are identical")
	}
	okA, errVA := auth.VerifyPassword(a, "same password")
	if errVA != nil {
		t.Fatalf("VerifyPassword first: %v", errVA)
		return
	}
	if !okA {
		t.Fatal("first hash does not verify")
	}
	okB, errVB := auth.VerifyPassword(b, "same password")
	if errVB != nil {
		t.Fatalf("VerifyPassword second: %v", errVB)
		return
	}
	if !okB {
		t.Fatal("second hash does not verify")
	}
}

func TestHashPasswordUsesRequiredParameters(t *testing.T) {
	encoded, err := auth.HashPassword("parameter check")
	if err != nil {
		t.Fatalf("HashPassword: %v", err)
		return
	}
	fields := strings.Split(encoded, "$")
	if len(fields) != 6 {
		t.Fatalf("unexpected PHC shape %q", encoded)
		return
	}
	if fields[1] != "argon2id" {
		t.Fatalf("algorithm field = %q, want argon2id", fields[1])
	}
	if fields[2] != "v=19" {
		t.Fatalf("version field = %q, want v=19", fields[2])
	}
	if fields[3] != "m=19456,t=2,p=1" {
		t.Fatalf("parameter field = %q, want m=19456,t=2,p=1", fields[3])
	}
	salt, serr := base64.RawStdEncoding.DecodeString(fields[4])
	if serr != nil {
		t.Fatalf("salt decode: %v", serr)
		return
	}
	if len(salt) != 16 {
		t.Fatalf("salt length = %d, want 16", len(salt))
	}
	key, kerr := base64.RawStdEncoding.DecodeString(fields[5])
	if kerr != nil {
		t.Fatalf("key decode: %v", kerr)
		return
	}
	if len(key) != 32 {
		t.Fatalf("key length = %d, want 32", len(key))
	}
}

func TestVerifyPasswordRejectsMalformed(t *testing.T) {
	cases := []struct {
		name    string
		encoded string
		wantSub string
	}{
		{"empty", "", "malformed PHC"},
		{"not phc", "not-a-phc-string", "malformed PHC"},
		{"wrong algorithm", "$argon2i$v=19$m=64,t=1,p=1$" + validSalt + "$" + validKey, "malformed PHC"},
		{"wrong version", "$argon2id$v=16$m=64,t=1,p=1$" + validSalt + "$" + validKey, "unsupported argon2 version"},
		{"version without v prefix", "$argon2id$19$m=64,t=1,p=1$" + validSalt + "$" + validKey, "unsupported argon2 version"},
		{"two params", "$argon2id$v=19$m=64,t=1$" + validSalt + "$" + validKey, "malformed parameters"},
		{"four params", "$argon2id$v=19$m=64,t=1,p=1,x=1$" + validSalt + "$" + validKey, "malformed parameters"},
		{"missing m prefix", "$argon2id$v=19$64,t=1,p=1$" + validSalt + "$" + validKey, "malformed parameters"},
		{"missing p prefix", "$argon2id$v=19$m=64,t=1,1$" + validSalt + "$" + validKey, "malformed parameters"},
		{"memory not a number", "$argon2id$v=19$m=abc,t=1,p=1$" + validSalt + "$" + validKey, "malformed parameter"},
		{"memory signed plus", "$argon2id$v=19$m=+64,t=1,p=1$" + validSalt + "$" + validKey, "malformed parameter"},
		{"memory signed minus", "$argon2id$v=19$m=-1,t=1,p=1$" + validSalt + "$" + validKey, "malformed parameter"},
		{"memory leading space", "$argon2id$v=19$m= 64,t=1,p=1$" + validSalt + "$" + validKey, "malformed parameter"},
		{"zero parameters", "$argon2id$v=19$m=0,t=0,p=0$" + validSalt + "$" + validKey, "parameters must be positive"},
		{"memory over bound", "$argon2id$v=19$m=2000000,t=1,p=1$" + validSalt + "$" + validKey, "parameters out of bounds"},
		{"time over bound", "$argon2id$v=19$m=64,t=17,p=1$" + validSalt + "$" + validKey, "parameters out of bounds"},
		{"parallelism over bound", "$argon2id$v=19$m=64,t=1,p=17$" + validSalt + "$" + validKey, "parameters out of bounds"},
		{"empty salt", "$argon2id$v=19$m=64,t=1,p=1$$" + validKey, "salt length out of bounds"},
		{"oversized salt", "$argon2id$v=19$m=64,t=1,p=1$" + strings.Repeat("QUJD", 22) + "$" + validKey, "salt length out of bounds"},
		{"bad salt base64", "$argon2id$v=19$m=64,t=1,p=1$!!!$" + validKey, "malformed salt"},
		{"empty key", "$argon2id$v=19$m=64,t=1,p=1$" + validSalt + "$", "key length out of bounds"},
		{"short key", "$argon2id$v=19$m=64,t=1,p=1$" + validSalt + "$QUJD", "key length out of bounds"},
		{"long key", "$argon2id$v=19$m=64,t=1,p=1$" + validSalt + "$" + strings.Repeat("QUJD", 22), "key length out of bounds"},
		{"bad key base64", "$argon2id$v=19$m=64,t=1,p=1$" + validSalt + "$!!!", "malformed key"},
		{"trailing garbage", "$argon2id$v=19$m=64,t=1,p=1$" + validSalt + "$" + validKey + "x", "malformed key"},
	}
	for _, c := range cases {
		ok, err := auth.VerifyPassword(c.encoded, "password")
		if err == nil {
			t.Fatalf("%s: VerifyPassword returned ok=%v, want error", c.name, ok)
			continue
		}
		if !strings.Contains(err.Error(), "auth: password hash:") {
			t.Fatalf("%s: error %q lacks auth prefix", c.name, err)
			continue
		}
		if !strings.Contains(err.Error(), c.wantSub) {
			t.Fatalf("%s: error %q lacks %q", c.name, err, c.wantSub)
		}
	}
}

func flipChar(s string, i int) string {
	b := []byte(s)
	if b[i] == 'A' {
		b[i] = 'B'
	} else {
		b[i] = 'A'
	}
	return string(b)
}

func TestVerifyPasswordRejectsHugeEncodedFieldsByLength(t *testing.T) {
	huge := strings.Repeat("!", 1<<20)
	cases := []struct {
		name    string
		encoded string
		wantSub string
	}{
		{"huge salt", "$argon2id$v=19$m=64,t=1,p=1$" + huge + "$" + validKey, "salt length out of bounds"},
		{"huge key", "$argon2id$v=19$m=64,t=1,p=1$" + validSalt + "$" + huge, "key length out of bounds"},
	}
	for _, c := range cases {
		ok, err := auth.VerifyPassword(c.encoded, "password")
		if err == nil {
			t.Fatalf("%s: VerifyPassword returned ok=%v, want error", c.name, ok)
			continue
		}
		if strings.Contains(err.Error(), "malformed") {
			t.Fatalf("%s: error %q decoded the oversized field before bounding its length", c.name, err)
			continue
		}
		if !strings.Contains(err.Error(), c.wantSub) {
			t.Fatalf("%s: error %q lacks %q", c.name, err, c.wantSub)
		}
	}
}

func TestVerifyPasswordAcceptsSaltAtMaximumLength(t *testing.T) {
	salt := make([]byte, 64)
	for i := range salt {
		salt[i] = byte(i)
	}
	key := argon2.IDKey([]byte("password"), salt, 2, 64, 2, 32)
	encoded := "$argon2id$v=19$m=64,t=2,p=2$" +
		base64.RawStdEncoding.EncodeToString(salt) + "$" +
		base64.RawStdEncoding.EncodeToString(key)
	ok, err := auth.VerifyPassword(encoded, "password")
	if err != nil {
		t.Fatalf("VerifyPassword: %v", err)
		return
	}
	if !ok {
		t.Fatal("VerifyPassword rejected a salt of exactly the maximum 64 bytes")
	}
}
