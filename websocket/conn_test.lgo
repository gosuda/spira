package websocket_test

import (
	"bufio"
	"bytes"
	"context"
	"errors"
	"fmt"
	"io"
	"net"
	"net/http"
	"net/http/httptest"
	"strconv"
	"strings"
	"testing"
	"time"

	"github.com/gosuda/spira/websocket"
)

type exchangePlan struct {
	conn *websocket.Conn
	peer net.Conn
	server func(context.Context, *websocket.Conn) error
	client func(net.Conn) error
}

func runExchange(ctx context.Context, plan *exchangePlan) error {
	go group (ctx) {
		go { plan.server(ctx, plan.conn)? }
		go { plan.client(plan.peer)? }
	}
	return nil
}

func exchange(t *testing.T, ctx context.Context, plan *exchangePlan) {
	t.Helper()
	if err := runExchange(ctx, plan); err != nil {
		t.Fatalf("exchange: %v", err)
	}
}

func openPair(t *testing.T, limit int64) (*websocket.Conn, net.Conn) {
	t.Helper()
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("listen: %v", err)
		panic("listen failed")
	}
	client, err := net.DialTimeout("tcp", ln.Addr().String(), 5*time.Second)
	if err != nil {
		t.Fatalf("dial: %v", err)
		panic("dial failed")
	}
	server, err := ln.Accept()
	if err != nil {
		t.Fatalf("accept: %v", err)
		panic("accept failed")
	}
	if err := ln.Close(); err != nil {
		t.Fatalf("listener close: %v", err)
	}
	mustSetDeadline(t, client)
	mustSetDeadline(t, server)
	rw := bufio.NewReadWriter(bufio.NewReader(server), bufio.NewWriter(server))
	return websocket.ServeHijacked(server, rw, "", limit), client
}

func mustSetDeadline(t *testing.T, conn net.Conn) {
	t.Helper()
	if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
		t.Fatalf("set deadline: %v", err)
	}
}

func closePipe(t *testing.T, c *websocket.Conn, peer net.Conn) {
	t.Helper()
	if err := c.Close(); err != nil {
		t.Fatalf("conn close: %v", err)
		return
	}
	if err := peer.Close(); err != nil {
		t.Fatalf("peer close: %v", err)
	}
}

func writeClientBytes(conn net.Conn, b0 uint8, payload []byte) error {
	head := frameHead(b0, len(payload))
	key := [4]byte{0x37, 0xfa, 0x21, 0x3d}
	scrambled := make([]byte, len(payload))
	for i := range payload {
		scrambled[i] = payload[i] ^ key[i%4]
	}
	buf := make([]byte, 0, len(head)+4+len(payload))
	buf = append(buf, head...)
	buf = append(buf, key[0], key[1], key[2], key[3])
	buf = append(buf, scrambled...)
	if _, err := conn.Write(buf); err != nil {
		return fmt.Errorf("write frame: %w", err)
	}
	return nil
}

func frameHead(b0 uint8, length int) []byte {
	if length < 126 {
		return []byte{b0, 0x80 | uint8(length)}
	}
	if length < 65536 {
		return []byte{b0, 0x80 | 126, byte(length >> 8), byte(length)}
	}
	wide := uint64(length)
	return []byte{b0, 0x80 | 127, byte(wide >> 56), byte(wide >> 48), byte(wide >> 40), byte(wide >> 32), byte(wide >> 24), byte(wide >> 16), byte(wide >> 8), byte(wide)}
}

func readServerBytes(r *bufio.Reader) (uint8, []byte, error) {
	b0, err := r.ReadByte()
	if err != nil {
		return 0, nil, err
	}
	b1, err := r.ReadByte()
	if err != nil {
		return 0, nil, err
	}
	if b1&0x80 != 0 {
		return 0, nil, errors.New("server frame is masked")
	}
	length := int64(b1 & 0x7f)
	if length == 126 {
		length, err = readUint16(r)
		if err != nil {
			return 0, nil, err
		}
	} else if length == 127 {
		length, err = readUint64(r)
		if err != nil {
			return 0, nil, err
		}
	}
	payload := make([]byte, length)
	if _, err := io.ReadFull(r, payload); err != nil {
		return 0, nil, err
	}
	return b0 & 0x0f, payload, nil
}

func readUint16(r *bufio.Reader) (int64, error) {
	raw := make([]byte, 2)
	if _, err := io.ReadFull(r, raw); err != nil {
		return 0, err
	}
	return int64(raw[0])<<8 | int64(raw[1]), nil
}

func readUint64(r *bufio.Reader) (int64, error) {
	raw := make([]byte, 8)
	if _, err := io.ReadFull(r, raw); err != nil {
		return 0, err
	}
	var length uint64
	for _, b := range raw {
		length = length<<8 | uint64(b)
	}
	if length>>63 != 0 {
		return 0, errors.New("length top bit set")
	}
	return int64(length), nil
}

func expectCloseCode(peer net.Conn, want uint16, wantReason string) error {
	r := bufio.NewReader(peer)
	opcode, payload, err := readServerBytes(r)
	if err != nil {
		return fmt.Errorf("read close: %w", err)
	}
	if opcode != 0x8 {
		return fmt.Errorf("opcode = %d, want 8", opcode)
	}
	code, reason, err := websocket.ParseClose(payload)
	if err != nil {
		return fmt.Errorf("parse close: %w", err)
	}
	if code != want {
		return fmt.Errorf("close code = %d, want %d", code, want)
	}
	if reason != wantReason {
		return fmt.Errorf("close reason = %q, want %q", reason, wantReason)
	}
	return nil
}

func awaitCloseThenEnd(ctx context.Context, c *websocket.Conn) error {
	k, payload, err := c.Next(ctx)
	if err != nil {
		return fmt.Errorf("first next: %w", err)
	}
	if k != websocket.Close {
		return fmt.Errorf("first kind = %d, want close", uint8(k))
	}
	code, reason, err := websocket.ParseClose(payload)
	if err != nil {
		return fmt.Errorf("parse close: %w", err)
	}
	if code != 1000 || reason != "bye" {
		return fmt.Errorf("close = %d %q, want 1000 bye", code, reason)
	}
	if _, _, err := c.Next(ctx); !errors.Is(err, websocket.ErrClosed) {
		return fmt.Errorf("second next error = %w, want ErrClosed", err)
	}
	return nil
}

func sendCloseExpectEcho(peer net.Conn) error {
	payload := []byte{0x03, 0xe8, 'b', 'y', 'e'}
	if err := writeClientBytes(peer, 0x88, payload); err != nil {
		return err
	}
	r := bufio.NewReader(peer)
	opcode, echo, err := readServerBytes(r)
	if err != nil {
		return fmt.Errorf("read echo: %w", err)
	}
	if opcode != 0x8 {
		return fmt.Errorf("echo opcode = %d, want 8", opcode)
	}
	if !bytes.Equal(echo, payload) {
		return fmt.Errorf("echo = %v, want %v", echo, payload)
	}
	if _, _, err := readServerBytes(r); err == nil {
		return errors.New("second server frame: want connection end, got a frame")
	}
	return nil
}

func TestPeerCloseEchoedOnceThenEnds(t *testing.T) {
	c, peer := openPair(t, 1<<20)
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	exchange(t, ctx, &exchangePlan{conn: c, peer: peer, server: awaitCloseThenEnd, client: sendCloseExpectEcho})
	closePipe(t, c, peer)
}

