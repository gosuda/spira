	if _, _, err := c.Next(ctx); !errors.Is(err, websocket.ErrTooLarge) {
		return fmt.Errorf("next error = %w, want ErrTooLarge", err)
	}
	return nil
}

func sendBigExpectClose(peer net.Conn) error {
	if err := writeClientBytes(peer, 0x82, []byte("Hello")); err != nil {
		return err
	}
	return expectCloseCode(peer, 1009, "")
}

func TestFaultFrameOverLimitSends1009(t *testing.T) {
