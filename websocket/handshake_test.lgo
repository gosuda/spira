func TestCheckUpgradeAcceptsPaddedOuterWhitespaceKey(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Sec-WebSocket-Key", "  dGhlIHNhbXBsZSBub25jZQ==\t")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != nil {
		t.Fatalf("checkUpgrade padded key = %v, want nil", err)
		return
	}
}

func TestCheckUpgradeRefusesInnerWhitespaceKey(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZ Q==")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeKeyError() {
		t.Fatalf("checkUpgrade inner-space key = %v, want key error", err)
	}
}

func TestCheckUpgradeAcceptsMixedCaseTokens(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Connection", "keep-alive")
	req.Header.Add("Connection", "UpGrAdE")
	req.Header.Set("Upgrade", "WebSocket")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != nil {
		t.Fatalf("checkUpgrade mixed case tokens = %v, want nil", err)
		return
	}
}

func TestCheckUpgradeAcceptsSplitUpgradeLines(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Del("Upgrade")
	req.Header.Add("Upgrade", "h2c")
	req.Header.Add("Upgrade", "WebSocket")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != nil {
		t.Fatalf("checkUpgrade split upgrade = %v, want nil", err)
		return
	}
}

func TestCheckUpgradeAcceptsCommaTokens(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Connection", "keep-alive, upgrade")
	req.Header.Set("Upgrade", "websocket")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != nil {
		t.Fatalf("checkUpgrade comma tokens = %v, want nil", err)
		return
	}
}

func TestCheckUpgradeAcceptsSpacedCommaTokens(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Connection", "keep-alive ,  upgrade")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != nil {
		t.Fatalf("checkUpgrade spaced commas = %v, want nil", err)
		return
	}
}

func TestUpgradeStatusCodes(t *testing.T) {
	cases := []struct {
		name string
		err  error
		want int
	}{
		{"nil", nil, http.StatusSwitchingProtocols},
		{"version", websocket.ExposedHandshakeVersionError(), http.StatusUpgradeRequired},
		{"method", websocket.ExposedHandshakeMethodError(), http.StatusMethodNotAllowed},
		{"connection", websocket.ExposedHandshakeConnectionError(), http.StatusBadRequest},
		{"upgrade", websocket.ExposedHandshakeUpgradeError(), http.StatusBadRequest},
		{"key", websocket.ExposedHandshakeKeyError(), http.StatusBadRequest},
		{"protocol", websocket.ExposedHandshakeProtocolError(), http.StatusBadRequest},
		{"subprotocol", websocket.ExposedHandshakeSubprotocolError(), http.StatusBadRequest},
	}
	for _, tc := range cases {
		if got := websocket.ExposedHandshakeUpgradeStatus(tc.err); got != tc.want {
			t.Fatalf("upgradeStatus %s = %d, want %d", tc.name, got, tc.want)
		}
	}
}

func TestFailureHeadersSetsVersionOn426(t *testing.T) {
	h := websocket.ExposedHandshakeFailureHeaders(websocket.ExposedHandshakeVersionError())
	if got := h.Get("Sec-WebSocket-Version"); got != "13" {
		t.Fatalf("failure headers version = %q, want 13", got)
	}
}

func TestFailureHeadersEmptyOtherwise(t *testing.T) {
	h := websocket.ExposedHandshakeFailureHeaders(websocket.ExposedHandshakeKeyError())
	if got := h.Get("Sec-WebSocket-Version"); got != "" {
		t.Fatalf("failure headers version = %q, want empty", got)
	}
}

func TestUpgradeHeadersRoundTrip(t *testing.T) {
	h, herr := websocket.ExposedHandshakeUpgradeHeaders("dGhlIHNhbXBsZSBub25jZQ==", "chat")
	if herr != nil {
		t.Fatalf("upgradeHeaders error = %v, want nil", herr)
		return
	}
	if got := h.Get("Upgrade"); got != "websocket" {
		t.Fatalf("Upgrade = %q, want websocket", got)
	}
	if got := h.Get("Connection"); got != "Upgrade" {
		t.Fatalf("Connection = %q, want Upgrade", got)
	}
	if got := h.Get("Sec-WebSocket-Accept"); got != "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" {
		t.Fatalf("Sec-WebSocket-Accept = %q, want RFC vector", got)
	}
	if got := h.Get("Sec-WebSocket-Protocol"); got != "chat" {
		t.Fatalf("Sec-WebSocket-Protocol = %q, want chat", got)
	}
}

func TestUpgradeHeadersOmitsEmptySubprotocol(t *testing.T) {
	h, herr := websocket.ExposedHandshakeUpgradeHeaders("dGhlIHNhbXBsZSBub25jZQ==", "")
	if herr != nil {
		t.Fatalf("upgradeHeaders error = %v, want nil", herr)
		return
	}
	if got := h.Get("Sec-WebSocket-Protocol"); got != "" {
		t.Fatalf("Sec-WebSocket-Protocol = %q, want empty", got)
	}
}

func TestUpgradeHeadersRefusesCRLFInjection(t *testing.T) {
	_, herr := websocket.ExposedHandshakeUpgradeHeaders("dGhlIHNhbXBsZSBub25jZQ==", "a\r\nB: c")
	if herr != websocket.ExposedHandshakeSubprotocolError() {
		t.Fatalf("upgradeHeaders injection = %v, want subprotocol error", herr)
	}
}

func TestPickSubprotocolPrefersServerOrder(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Add("Sec-WebSocket-Protocol", "chat, super")
	req.Header.Add("Sec-WebSocket-Protocol", "json")
	got, perr := websocket.ExposedHandshakePickSubprotocol(req.Header.Values("Sec-WebSocket-Protocol"), []string{"super", "chat"})
	if perr != nil {
		t.Fatalf("pickSubprotocol error = %v, want nil", perr)
		return
	}
	if got != "super" {
		t.Fatalf("pickSubprotocol = %q, want super", got)
	}
}

func TestPickSubprotocolFallsBackToSecond(t *testing.T) {
	got, perr := websocket.ExposedHandshakePickSubprotocol([]string{"chat"}, []string{"super", "chat"})
	if perr != nil {
		t.Fatalf("pickSubprotocol error = %v, want nil", perr)
		return
	}
	if got != "chat" {
		t.Fatalf("pickSubprotocol = %q, want chat", got)
	}
}

func TestPickSubprotocolReturnsEmptyOnNoMatch(t *testing.T) {
	got, perr := websocket.ExposedHandshakePickSubprotocol([]string{"chat, super"}, []string{"other"})
	if perr != nil {
		t.Fatalf("pickSubprotocol error = %v, want nil", perr)
		return
	}
	if got != "" {
		t.Fatalf("pickSubprotocol = %q, want empty", got)
	}
}

func TestPickSubprotocolNeverPicksUnoffered(t *testing.T) {
	got, perr := websocket.ExposedHandshakePickSubprotocol([]string{"chat"}, []string{"super"})
	if perr != nil {
		t.Fatalf("pickSubprotocol error = %v, want nil", perr)
		return
	}
	if got != "" {
		t.Fatalf("pickSubprotocol = %q, want empty", got)
	}
}

func TestPickSubprotocolTrimsSupportedName(t *testing.T) {
	got, perr := websocket.ExposedHandshakePickSubprotocol([]string{"chat"}, []string{" chat "})
	if perr != nil {
		t.Fatalf("pickSubprotocol error = %v, want nil", perr)
		return
	}
	if got != "chat" {
		t.Fatalf("pickSubprotocol = %q, want chat", got)
	}
}

func TestPickSubprotocolIgnoresBlankNames(t *testing.T) {
	got, perr := websocket.ExposedHandshakePickSubprotocol([]string{""}, []string{""})
	if perr != nil {
		t.Fatalf("pickSubprotocol error = %v, want nil", perr)
		return
	}
	if got != "" {
		t.Fatalf("pickSubprotocol blank = %q, want empty", got)
	}
}

func TestPickSubprotocolRefusesCRLFInjection(t *testing.T) {
	_, perr := websocket.ExposedHandshakePickSubprotocol([]string{"chat"}, []string{"a\r\nB: c"})
	if perr != websocket.ExposedHandshakeSubprotocolError() {
		t.Fatalf("pickSubprotocol injection = %v, want subprotocol error", perr)
	}
}
