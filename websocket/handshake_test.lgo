	req := validHandshakeRequest()
	req.Header.Del("Sec-WebSocket-Key")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeKeyError() {
		t.Fatalf("checkUpgrade missing key = %v, want key error", err)
	}
}

func TestCheckUpgradeRefusesDuplicateKey(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Add("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeKeyError() {
		t.Fatalf("checkUpgrade duplicate key = %v, want key error", err)
	}
