	req := validHandshakeRequest()
	req.Header.Add("Sec-WebSocket-Version", "13")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeVersionError() {
		t.Fatalf("checkUpgrade duplicate version = %v, want version error", err)
