	req := validHandshakeRequest()
	req.Header.Set("Upgrade", "h2c")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeUpgradeError() {
		t.Fatalf("checkUpgrade h2c = %v, want upgrade error", err)
