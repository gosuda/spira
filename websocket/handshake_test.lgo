package websocket_test

import (
	"encoding/base64"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/gosuda/spira/websocket"
)

func validHandshakeRequest() *http.Request {
	req := httptest.NewRequest(http.MethodGet, "/chat", nil)
	req.Header.Set("Connection", "Upgrade")
	req.Header.Set("Upgrade", "websocket")
	req.Header.Set("Sec-WebSocket-Version", "13")
	req.Header.Set("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
	return req
}

func TestAcceptKeyMatchesRFC6455Vector(t *testing.T) {
	got := websocket.ExposedHandshakeAcceptKey("dGhlIHNhbXBsZSBub25jZQ==")
	want := "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
	if got != want {
		t.Fatalf("acceptKey = %q, want %q", got, want)
	}
}

func TestAcceptKeyTrimsOuterWhitespace(t *testing.T) {
	got := websocket.ExposedHandshakeAcceptKey("  dGhlIHNhbXBsZSBub25jZQ==\t")
	want := "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
	if got != want {
		t.Fatalf("acceptKey padded = %q, want %q", got, want)
	}
}

func TestCheckUpgradeAcceptsValidRequest(t *testing.T) {
	if err := websocket.ExposedHandshakeCheckUpgrade(validHandshakeRequest()); err != nil {
		t.Fatalf("checkUpgrade valid request = %v, want nil", err)
	}
}

func TestCheckUpgradeRefusesNonGet(t *testing.T) {
	req := validHandshakeRequest()
	req.Method = http.MethodPost
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeMethodError() {
		t.Fatalf("checkUpgrade POST = %v, want method error", err)
	}
}

func TestCheckUpgradeRefusesOldProtocol(t *testing.T) {
	req := validHandshakeRequest()
	req.ProtoMajor = 1
	req.ProtoMinor = 0
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeProtocolError() {
		t.Fatalf("checkUpgrade HTTP/1.0 = %v, want protocol error", err)
	}
}

func TestCheckUpgradeRefusesMissingConnection(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Connection", "keep-alive")
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeConnectionError() {
		t.Fatalf("checkUpgrade keep-alive = %v, want connection error", err)
	}
}

