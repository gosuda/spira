	req := validHandshakeRequest()
	req.Header.Set("Sec-WebSocket-Key", base64.StdEncoding.EncodeToString(make([]byte, 17)))
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeKeyError() {
		t.Fatalf("checkUpgrade 17-byte key = %v, want key error", err)
	}
}

func TestCheckUpgradeRefusesUnpaddedKey(t *testing.T) {
	req := validHandshakeRequest()
	req.Header.Set("Sec-WebSocket-Key", base64.RawStdEncoding.EncodeToString(make([]byte, 16)))
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeKeyError() {
		t.Fatalf("checkUpgrade unpadded key = %v, want key error", err)
	}
