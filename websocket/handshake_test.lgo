	req := validHandshakeRequest()
	req.Header.Set("Sec-WebSocket-Key", base64.StdEncoding.EncodeToString(make([]byte, 15)))
	if err := websocket.ExposedHandshakeCheckUpgrade(req); err != websocket.ExposedHandshakeKeyError() {
		t.Fatalf("checkUpgrade 15-byte key = %v, want key error", err)
	}
}

