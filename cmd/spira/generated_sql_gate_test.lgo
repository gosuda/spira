package main_test

import (
	"bytes"
	"context"
	"errors"
	"os"
	"os/exec"
	"path/filepath"
	"slices"
	"strings"
	"testing"
	"time"

	spira "github.com/gosuda/spira/cmd/spira"
)

func TestGeneratedSQLCheckRejectsDriftWithoutRewriting(t *testing.T) {
	dir := filepath.Join(t.TempDir(), "app")
	if err := spira.RunNew([]string{"-spira-dir", spiraRoot(t), dir, "example.com/demo"}); err != nil {
		t.Fatalf("RunNew: %v", err)
		return
	}
	for _, recipe := range []string{"sql", "sql-check"} {
		status, out := runGeneratedSQLRecipe(t, dir, recipe)
		if status != 0 {
			t.Fatalf("just %s on clean app: exit %d\n%s", recipe, status, out)
			return
		}
	}

	models := filepath.Join(dir, "db", "store", "models.sql.lgo")
	clean := readSQLGateFile(t, models)
	checkGeneratedSQLStore(t, dir, models, clean)
	t.Run("raw-feature-sql", func(t *testing.T) {
		path := filepath.Join(dir, "features", "home", "raw.lgo")
		writeSQLGateFile(t, path, []byte(rawSQLFeature))
		t.Cleanup(func() { removeSQLGateFile(t, path) })
		requireSQLGateRejection(t, dir, "use generated queries instead of raw db calls")
		assertSQLGateFile(t, path, []byte(rawSQLFeature))
		assertSQLGateFile(t, models, clean)
	})
	t.Run("symlink-sql-input", func(t *testing.T) {
		checkSQLGateSymlink(t, dir)
		assertSQLGateFile(t, models, clean)
	})
}

const rawSQLFeature = `package home

import (
	"context"

	"github.com/gosuda/spira/db"
)

func readRawSQL(ctx context.Context, pool *db.Pool) ([]int, error) {
	return db.` + `Query[int](ctx, pool, "SELECT 1")
}
`

func checkGeneratedSQLStore(t *testing.T, dir string, models string, clean []byte) {
	t.Helper()
	t.Run("modified-generated-file", func(t *testing.T) {
		drift := append(clean, []byte("\nconst sqlGateDriftMarker = true\n")...)
		writeSQLGateFile(t, models, drift)
		t.Cleanup(func() { writeSQLGateFile(t, models, clean) })
		requireSQLGateRejection(t, dir, "models.sql.lgo")
		assertSQLGateFile(t, models, drift)
	})
	t.Run("missing-generated-file", func(t *testing.T) {
		removeSQLGateFile(t, models)
		t.Cleanup(func() { writeSQLGateFile(t, models, clean) })
		requireSQLGateRejection(t, dir, "models.sql.lgo")
		if _, err := os.Lstat(models); !errors.Is(err, os.ErrNotExist) {
			t.Errorf("missing generated file changed during sql-check: lstat %s: %v", models, err)
		}
	})
	t.Run("extra-generated-file", func(t *testing.T) {
		path := filepath.Join(filepath.Dir(models), "extra.sql.lgo")
		extra := []byte("package store\n\nconst extraSQLGateMarker = true\n")
		writeSQLGateFile(t, path, extra)
		t.Cleanup(func() { removeSQLGateFile(t, path) })
		requireSQLGateRejection(t, dir, "extra.sql.lgo")
		assertSQLGateFile(t, path, extra)
		assertSQLGateFile(t, models, clean)
	})
}

func checkSQLGateSymlink(t *testing.T, dir string) {
	t.Helper()
	const query = "db/queries/users.sql"
	path := filepath.Join(dir, filepath.FromSlash(query))
	clean := readSQLGateFile(t, path)
	removeSQLGateFile(t, path)
	t.Cleanup(func() { writeSQLGateFile(t, path, clean) })
	target := filepath.Join(t.TempDir(), "absent.sql")
	if err := os.Symlink(target, path); err != nil {
		t.Fatalf("symlink SQL input: %v", err)
		return
	}
	t.Cleanup(func() { removeSQLGateFile(t, path) })
	requireSQLGateRejection(t, dir, "symlink is not a SQL input: "+query)
	got, err := os.Readlink(path)
	if err != nil || got != target {
		t.Errorf("sql-check changed the SQL input symlink: readlink = %q, %v; want %q", got, err, target)
	}
	if _, err := os.Lstat(target); !errors.Is(err, os.ErrNotExist) {
		t.Errorf("symlink target changed during sql-check: lstat %s: %v", target, err)
	}
}

func requireSQLGateRejection(t *testing.T, dir string, diagnostic string) {
	t.Helper()
	status, out := runGeneratedSQLRecipe(t, dir, "sql-check")
	if status == 0 || !bytes.Contains(out, []byte(diagnostic)) {
		t.Errorf("just sql-check: exit %d; want nonzero exit with %q\n%s", status, diagnostic, out)
	}
}

func readSQLGateFile(t *testing.T, path string) []byte {
	t.Helper()
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatalf("read %s: %v", path, err)
		return nil
	}
	return data
}

func writeSQLGateFile(t *testing.T, path string, data []byte) {
	t.Helper()
	if err := os.WriteFile(path, data, 0o644); err != nil {
		t.Fatalf("write %s: %v", path, err)
	}
}

func removeSQLGateFile(t *testing.T, path string) {
	t.Helper()
	if err := os.Remove(path); err != nil {
		t.Fatalf("remove %s: %v", path, err)
	}
}

func assertSQLGateFile(t *testing.T, path string, want []byte) {
	t.Helper()
	if got := readSQLGateFile(t, path); !bytes.Equal(got, want) {
		t.Errorf("sql-check changed %s", path)
	}
}

func runGeneratedSQLRecipe(t *testing.T, dir string, recipe string) (int, []byte) {
	t.Helper()
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Minute)
	defer cancel()
	cmd := exec.CommandContext(ctx, "just", recipe)
	cmd.Dir = dir
	cmd.WaitDelay = 5 * time.Second
	env := slices.DeleteFunc(cmd.Environ(), func(setting string) bool {
		name, _, _ := strings.Cut(setting, "=")
		return name == "GIT_DIR" || name == "GIT_WORK_TREE" || name == "GIT_COMMON_DIR"
	})
	cmd.Env = append(env, "GIT_CEILING_DIRECTORIES="+filepath.Dir(dir), "GOWORK=off",
		"GOPROXY=off", "GONOPROXY=none", "GOSUMDB=off", "GOTELEMETRY=off")
	out, err := cmd.CombinedOutput()
	if ctx.Err() != nil {
		t.Fatalf("just %s: %v\n%s", recipe, ctx.Err(), out)
		return -1, nil
	}
	if err == nil {
		return 0, out
	}
	if exit, ok := errors.AsType[*exec.ExitError](err); ok && exit.ExitCode() > 0 {
		return exit.ExitCode(), out
	}
	t.Fatalf("just %s did not exit normally: %v\n%s", recipe, err, out)
	return -1, nil
}
