func TestSeedDemoUserFollowsTheEnvironment(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	t.Run("unset", func(t *testing.T) {
		t.Setenv("SPIRA_SEED_DEMO_PASSWORD", "")
		withMigratedPool(t, ctx, "file:seed-unset?mode=memory&cache=shared", func(pool *db.Pool) {
			if err := app.SeedDemoUser(ctx, pool); err != nil {
				t.Fatalf("seed: %v", err)
				return
			}
			found, err := store.GetUserByName(ctx, pool, "demo")
			if err != nil {
				t.Fatalf("lookup: %v", err)
				return
			}
			if found != nil {
				t.Fatalf("seed created user demo while SPIRA_SEED_DEMO_PASSWORD is unset")
			}
		})
	})
	t.Run("set", func(t *testing.T) {
		withMigratedPool(t, ctx, "file:seed-set?mode=memory&cache=shared", func(pool *db.Pool) {
			for _, password := range []string{"first-test-password", "second-test-password"} {
				t.Setenv("SPIRA_SEED_DEMO_PASSWORD", password)
				if err := app.SeedDemoUser(ctx, pool); err != nil {
					t.Fatalf("seed: %v", err)
					return
				}
				assertDemoPassword(t, ctx, pool, password)
			}
		})
	})
}

func assertDemoPassword(t *testing.T, ctx context.Context, pool *db.Pool, password string) {
	t.Helper()
	found, err := store.GetUserByName(ctx, pool, "demo")
	if err != nil {
		t.Fatalf("lookup: %v", err)
		return
	}
	if found == nil {
		t.Fatalf("seed left no user demo while SPIRA_SEED_DEMO_PASSWORD is set")
		return
	}
	user := found ?? store.User{}
	ok, err := auth.VerifyPassword(user.PasswordHash, password)
	if err != nil {
		t.Fatalf("verify: %v", err)
		return
	}
	if !ok {
		t.Fatalf("user demo does not accept the SPIRA_SEED_DEMO_PASSWORD value %q", password)
	}
}

func withMigratedPool(t *testing.T, ctx context.Context, dsn string, run func(pool *db.Pool)) {
	t.Helper()
	pool, err := db.Open("sqlite", dsn)
	if err != nil {
		t.Fatalf("open: %v", err)
		return
	}
	if pool == nil {
		t.Fatalf("open left no pool")
		return
	}
	defer func() {
		stopCtx, stopCancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer stopCancel()
		if serr := pool.Stop(stopCtx); serr != nil {
			t.Errorf("stop: %v", serr)
		}
	}()
	steps, err := migrate.Load(appdb.FS())
	if err != nil {
		t.Fatalf("load: %v", err)
		return
	}
	if err := migrate.Apply(ctx, pool, steps); err != nil {
		t.Fatalf("apply: %v", err)
		return
	}
	run(pool)
}

func TestLoginLookupFailureCarriesAccountFault(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	pool, err := db.Open("sqlite", "file:bare-login-fault?mode=memory&cache=shared")
	if err != nil {
		t.Fatalf("open: %v", err)
		return
	}
	if pool == nil {
		t.Fatalf("open left no pool")
		return
	}
	defer func() {
		stopCtx, stopCancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer stopCancel()
		if serr := pool.Stop(stopCtx); serr != nil {
			t.Errorf("stop: %v", serr)
		}
	}()
	if err := pool.Start(ctx); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	var buf bytes.Buffer
	prev := slog.Default()
	slog.SetDefault(slog.New(slog.NewTextHandler(&buf, &slog.HandlerOptions{})))
	defer slog.SetDefault(prev)
	r := web.NewRouter()
	sessions := &auth.Sessions{Store: &account.DBStore{DB: pool}}
	(&account.Account{DB: pool, Sessions: sessions}).Mount(r)
	form := url.Values{"username": []string{"demo"}, "password": []string{"secret"}}
	req := httptest.NewRequest(http.MethodPost, "/account/login", strings.NewReader(form.Encode()))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	rec := httptest.NewRecorder()
	r.ServeHTTP(rec, req)
	if rec.Code != http.StatusInternalServerError {
		t.Fatalf("status %d want 500 body %s", rec.Code, rec.Body.String())
		return
	}
	if !strings.Contains(buf.String(), "account.failed") {
		t.Fatalf("handler log %q lacks the account fault", buf.String())
		return
	}
	if strings.Contains(rec.Body.String(), "no such table") {
		t.Fatalf("body %q leaks the driver error", rec.Body.String())
		return
	}
}

func TestLoginSurvivesFailedSessionSweep(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	withMigratedPool(t, ctx, "file:sweep-login?mode=memory&cache=shared", func(pool *db.Pool) {
		hash, err := auth.HashPassword("secret")
		if err != nil {
			t.Fatalf("hash: %v", err)
			return
		}
		if _, err := store.CreateUser(ctx, pool, "demo", hash); err != nil {
			t.Fatalf("create user: %v", err)
			return
		}
		if _, err := pool.ExecContext(ctx, `CREATE TRIGGER refuse_sweep BEFORE DELETE ON sessions BEGIN SELECT RAISE(ABORT, 'sweep refused'); END;`); err != nil {
			t.Fatalf("plant sweep failure: %v", err)
			return
		}
		r := web.NewRouter()
		sessions := &auth.Sessions{Store: &account.DBStore{DB: pool}}
		(&account.Account{DB: pool, Sessions: sessions}).Mount(r)
		form := url.Values{"username": []string{"demo"}, "password": []string{"secret"}}
		req := httptest.NewRequest(http.MethodPost, "/account/login", strings.NewReader(form.Encode()))
		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
		rec := httptest.NewRecorder()
		r.ServeHTTP(rec, req)
		if rec.Code != http.StatusSeeOther {
			t.Fatalf("status %d want 303 body %s", rec.Code, rec.Body.String())
			return
		}
	})
}
