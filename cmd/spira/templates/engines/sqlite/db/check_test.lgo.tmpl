package appdb_test

import (
	"context"
	"testing"
	"time"

	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/migrate"

	appdb "{{MODULE}}/db"
	"{{MODULE}}/db/store"

	_ "modernc.org/sqlite"
)

func TestCheckReversibleAndPrepareAll(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	pool, err := db.Open("sqlite", "file:check?mode=memory&cache=shared")
	if err != nil {
		t.Fatalf("open: %v", err)
		return
	}
	if pool == nil {
		t.Fatalf("open left no pool")
		return
	}
	defer func() {
		stopCtx, stopCancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer stopCancel()
		if serr := pool.Stop(stopCtx); serr != nil {
			t.Errorf("stop: %v", serr)
		}
	}()
	steps, err := migrate.Load(appdb.FS())
	if err != nil {
		t.Fatalf("load: %v", err)
		return
	}
	if len(steps) != 2 {
		t.Fatalf("steps = %d, want 2", len(steps))
		return
	}
	if err := migrate.CheckReversible(ctx, pool, steps); err != nil {
		t.Fatalf("reversible: %v", err)
		return
	}
	if err := migrate.Apply(ctx, pool, steps); err != nil {
		t.Fatalf("apply: %v", err)
		return
	}
	if err := store.PrepareAll(ctx, pool); err != nil {
		t.Fatalf("prepare: %v", err)
		return
	}
}
