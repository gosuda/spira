//go:build engines

package appdb_test

import (
	"context"
	"os"
	"testing"
	"time"

	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/migrate"

	appdb "{{MODULE}}/db"
	"{{MODULE}}/db/store"

	_ "{{DRIVER_IMPORT}}"
)

func engineDSN(t *testing.T) string {
	t.Helper()
	dsn := os.Getenv("{{DSN_ENV}}")
	if dsn == "" {
		t.Fatalf("{{DSN_ENV}} is empty; run the engines recipe")
		return ""
	}
	return dsn
}

func TestEngineCheckReversibleAndPrepareAll(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	pool, err := db.Open("{{DRIVER_NAME}}", engineDSN(t))
	if err != nil {
		t.Fatalf("open: %v", err)
		return
	}
	if pool == nil {
		t.Fatalf("open left no pool")
		return
	}
	defer func() {
		stopCtx, stopCancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer stopCancel()
		if serr := pool.Stop(stopCtx); serr != nil {
			t.Errorf("stop: %v", serr)
		}
	}()
	steps, err := migrate.Load(appdb.FS())
	if err != nil {
		t.Fatalf("load: %v", err)
		return
	}
	if err := migrate.CheckReversible(ctx, pool, steps); err != nil {
		t.Fatalf("reversible: %v", err)
		return
	}
	if err := migrate.Apply(ctx, pool, steps); err != nil {
		t.Fatalf("apply: %v", err)
		return
	}
	defer func() {
		rbCtx, rbCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer rbCancel()
		if rerr := migrate.Rollback(rbCtx, pool, steps, len(steps)); rerr != nil {
			t.Errorf("rollback cleanup: %v", rerr)
		}
	}()
	if err := store.PrepareAll(ctx, pool); err != nil {
		t.Fatalf("prepare: %v", err)
		return
	}
}
