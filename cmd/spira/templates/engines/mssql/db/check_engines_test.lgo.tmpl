//go:build engines

package appdb_test

import (
	"context"
	"crypto/rand"
	"os"
	"strings"
	"testing"
	"time"

	"github.com/gosuda/spira/db"
	"github.com/gosuda/spira/migrate"

	appdb "{{MODULE}}/db"
	"{{MODULE}}/db/store"

	_ "{{DRIVER_IMPORT}}"
)

func engineDSN(t *testing.T) string {
	t.Helper()
	dsn := os.Getenv("{{DSN_ENV}}")
	if dsn == "" {
		t.Fatalf("{{DSN_ENV}} is empty; run the engines recipe")
		return ""
	}
	return dsn
}

func openStarted(t *testing.T, ctx context.Context, dsn string) *db.Pool? {
	t.Helper()
	pool, err := db.Open("{{DRIVER_NAME}}", dsn)
	if err != nil {
		t.Fatalf("open: %v", err)
		return nil
	}
	if pool == nil {
		t.Fatalf("open left no pool")
		return nil
	}
	t.Cleanup(func() {
		stopCtx, stopCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer stopCancel()
		if serr := pool.Stop(stopCtx); serr != nil {
			t.Errorf("stop: %v", serr)
		}
	})
	if serr := pool.Start(ctx); serr != nil {
		t.Fatalf("start: %v", serr)
		return nil
	}
	return pool
}

func openScratch(t *testing.T, dsn string) *db.Pool? {
	t.Helper()
	name := "spira_rev_ms_" + strings.ToLower(rand.Text())
	target := strings.Replace(dsn, "spira_test", name, 1)
	if target == dsn {
		t.Fatalf("{{DSN_ENV}} must name the database spira_test")
		return nil
	}
	create := "CREATE DATABASE " + name
	drop := "IF DB_ID('" + name + "') IS NOT NULL DROP DATABASE " + name
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()
	admin := openStarted(t, ctx, dsn)
	if admin == nil {
		return nil
	}
	t.Cleanup(func() {
		dropCtx, dropCancel := context.WithTimeout(context.Background(), 60*time.Second)
		defer dropCancel()
		if _, err := admin.ExecContext(dropCtx, drop); err != nil {
			t.Errorf("drop scratch %s: %v", name, err)
		}
	})
	if _, err := admin.ExecContext(ctx, create); err != nil {
		t.Fatalf("create scratch %s: %v", name, err)
		return nil
	}
	return openStarted(t, ctx, target)
}

func TestEngineCheckReversibleAndPrepareAll(t *testing.T) {
	dsn := engineDSN(t)
	pool := openScratch(t, dsn)
	if pool == nil {
		return
	}
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()
	steps, err := migrate.Load(appdb.FS())
	if err != nil {
		t.Fatalf("load: %v", err)
		return
	}
	if err := migrate.CheckReversible(ctx, pool, steps); err != nil {
		t.Fatalf("reversible: %v", err)
		return
	}
	if err := migrate.Apply(ctx, pool, steps); err != nil {
		t.Fatalf("apply: %v", err)
		return
	}
	if err := store.PrepareAll(ctx, pool); err != nil {
		t.Fatalf("prepare: %v", err)
		return
	}
	if err := migrate.Rollback(ctx, pool, steps, len(steps)); err != nil {
		t.Fatalf("rollback: %v", err)
	}
}
