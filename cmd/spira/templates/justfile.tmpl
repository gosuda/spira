logos_root := env_var_or_default("LOGOS_ROOT", "/home/alpha/repos-devtool/LoGOs/.outline/worktree/spira-toolchain-tip")
upstream_go := env_var_or_default("UPSTREAM_GO", "/home/linuxbrew/.linuxbrew/bin/go")

export GOROOT := logos_root
export GOTOOLCHAIN := "local"
export PATH := justfile_directory() / "bin:" + logos_root / "bin:" + env_var("PATH")

gate: sql-check build lint test web

build:
    logos build ./...

lint:
    logos lint ./...

test:
    logos test -count=1 ./...

sql:
    logos mod download github.com/gosuda/spira
    logos build -o bin/sqlc-gen-spira github.com/gosuda/spira/cmd/sqlc-gen-spira
    GOWORK=off go -C tools tool sqlc generate -f "$PWD/sqlc.yaml"

sql-check:
    #!/usr/bin/env bash
    set -euo pipefail
    status=0
    rg --no-config --no-ignore --hidden -n -U --glob '*.lgo' \
        --glob '!**/.git/**' --glob '!/frontend/node_modules/**' --glob '!/db/store/**' \
        '\bdb\s*\.\s*(Query|One|Exec)\b' . || status=$?
    case "$status" in
        0) printf 'sql-check: use generated queries instead of raw db calls\n' >&2; exit 1 ;;
        1) ;;
        *) printf 'sql-check: rg failed (exit %s)\n' "$status" >&2; exit "$status" ;;
    esac

    if [[ -L db ]]; then
        printf 'sql-check: symlink is not a SQL input: db\n' >&2
        exit 1
    fi
    scratch="$(mktemp -d /tmp/spira-new-sql-check.XXXXXXXX)"
    trap 'rm -rf -- "${scratch:?}"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    printf '%s\0' sqlc.yaml go.mod go.sum tools/go.mod tools/go.sum > "$scratch/sql-inputs"
    find -P db/migrations db/queries \( -type d -o -type l -o -name '*.sql' \) \
        -print0 >> "$scratch/sql-inputs"
    while IFS= read -r -d '' input; do
        if [[ -L "$input" ]]; then
            printf 'sql-check: symlink is not a SQL input: %s\n' "$input" >&2
            exit 1
        fi
        if [[ -d "$input" ]]; then
            mkdir -p -- "$scratch/$input"
            continue
        fi
        if [[ ! -f "$input" ]]; then
            printf 'sql-check: expected a regular input file: %s\n' "$input" >&2
            exit 1
        fi
        cp --parents -- "$input" "$scratch"
    done < "$scratch/sql-inputs"

    export GOWORK=off
    go -C "$scratch/tools" tool sqlc vet -f "$scratch/sqlc.yaml"
    logos build -mod=readonly -modfile="$scratch/go.mod" -o "$scratch/sqlc-gen-spira" github.com/gosuda/spira/cmd/sqlc-gen-spira
    test -x "$scratch/sqlc-gen-spira"
    PATH="$scratch:$PATH" go -C "$scratch/tools" tool sqlc generate -f "$scratch/sqlc.yaml"
    diff -qr --no-dereference -- db/store "$scratch/db/store"

web:
    pnpm --dir frontend install
    pnpm --dir frontend run build

engines:
    logos test -race -tags engines -count=1 ./db/...
