package main_test

import (
	"encoding/json/v2"
	"os"
	"testing"
)

type relationReferenceCase struct {
	Name    string   `json:"name"`
	SQL     string   `json:"sql"`
	Allow   bool     `json:"allow"`
	Columns []string `json:"columns"`
	Option  string   `json:"option"`
}

func TestPostgresRelationReferenceRoles(t *testing.T) {
	data, err := os.ReadFile("testdata/version-relation-roles.json")
	if err != nil {
		t.Fatal(err)
		return
	}
	var cases []relationReferenceCase
	if err := json.Unmarshal(data, &cases); err != nil {
		t.Fatal(err)
		return
	}
	if len(cases) != 32 {
		t.Fatalf("relation reference cases = %d; want 32", len(cases))
		return
	}
	for _, tc := range cases {
		t.Run(tc.Name, func(t *testing.T) {
			diagnostic := ""
			if !tc.Allow {
				diagnostic = "writes versioned table items without " + tc.Option
			}
			checkVersionCatalogCase(t, versionCatalogCase{
				Name: tc.Name, Columns: tc.Columns, Option: tc.Option,
				SQL: tc.SQL, Error: diagnostic,
			})
		})
	}
}
