package main

// SELECT table declarations cannot satisfy the version guard. Expression
// operands in joins, function arguments and nested queries remain visible.
func excludeRelationAliases(tokens []sqlReferenceToken, excluded []bool) {
	for i, token := range tokens {
		if !token.keyword("select") || (i > 0 && tokens[i-1].punctuation(".")) {
			continue
		}
		if start := referenceSelectFrom(tokens, i); start >= 0 {
			excludeRelationList(tokens, start, excluded)
		}
	}
}

func referenceSelectFrom(tokens []sqlReferenceToken, owner int) int {
	for i := referenceOutputStart(tokens, owner); i < len(tokens); i++ {
		if referenceOutputEnd(tokens, i, tokens[owner]) {
			if tokens[i].keyword("from") {
				return i + 1
			}
			return -1
		}
	}
	return -1
}

// Each factor advances past only its relation head and declarations. The
// sibling walk skips balanced arrays so their commas cannot start a factor.
func excludeRelationList(tokens []sqlReferenceToken, start int, excluded []bool) {
	if start >= len(tokens) {
		return
	}
	depth := tokens[start].depth
	for i := referenceRelationFactor(tokens, start, excluded); i < len(tokens); {
		if referenceRelationEnd(tokens, i, depth) {
			return
		}
		if tokens[i].depth != depth {
			i++
			continue
		}
		if tokens[i].punctuation("[") {
			i = referenceBracketEnd(tokens, i)
			continue
		}
		if tokens[i].punctuation(",") || referenceRelationKeyword(tokens, i, "join") {
			i = referenceRelationFactor(tokens, i+1, excluded)
			continue
		}
		i++
	}
}

func referenceRelationFactor(tokens []sqlReferenceToken, start int, excluded []bool) int {
	index := start
	if index < len(tokens) && tokens[index].keyword("lateral") {
		index++
	}
	if index < len(tokens) && tokens[index].keyword("only") {
		index++
	}
	if index == len(tokens) {
		return index
	}
	if tokens[index].punctuation("(") {
		end := referenceParenthesisEnd(tokens, index)
		excludeParenthesizedRelations(tokens, index, end, excluded)
		return referenceRelationAlias(tokens, end, excluded)
	}
	if !tokens[index].isName() {
		return index + 1
	}
	end := referenceNameEnd(tokens, index)
	excludeReferenceRange(excluded, index, end)
	if tokens[index].keyword("rows") && end < len(tokens) && tokens[end].keyword("from") {
		end++
	}
	if end < len(tokens) && tokens[end].punctuation("(") {
		end = referenceParenthesisEnd(tokens, end)
	}
	if end < len(tokens) && tokens[end].punctuation("*") {
		end++
	}
	return referenceRelationAlias(tokens, end, excluded)
}

// Prefix slices retain original indices. Recursion only enters smaller
// parenthesized table lists, never a derived query's expression body.
func excludeParenthesizedRelations(tokens []sqlReferenceToken, open int, end int, excluded []bool) {
	start := open + 1
	if start >= end-1 || !tokens[end-1].punctuation(")") {
		return
	}
	if tokens[start].keyword("select") || tokens[start].keyword("with") || tokens[start].keyword("values") {
		return
	}
	excludeRelationList(tokens[:end-1], start, excluded[:end-1])
}

func referenceRelationAlias(tokens []sqlReferenceToken, start int, excluded []bool) int {
	if start+1 < len(tokens) && tokens[start].keyword("with") && tokens[start+1].keyword("ordinality") {
		start += 2
	}
	if start < len(tokens) && tokens[start].keyword("as") {
		start++
	}
	if start < len(tokens) && tokens[start].isName() && !referenceRelationBoundary(tokens[start]) {
		excluded[start] = true
		start++
	}
	if start < len(tokens) && tokens[start].punctuation("(") {
		end := referenceParenthesisEnd(tokens, start)
		excludeReferenceRange(excluded, start, end)
		return end
	}
	return start
}

func referenceRelationBoundary(token sqlReferenceToken) bool {
	if token.kind != referenceName {
		return false
	}
	switch token.text {
	case "join", "inner", "left", "right", "full", "cross", "natural", "on", "using",
		"where", "group", "having", "window", "order", "limit", "offset", "fetch", "for",
		"union", "intersect", "except", "returning", "into", "tablesample", "with":
		return true
	}
	return false
}

func referenceRelationEnd(tokens []sqlReferenceToken, index int, depth int) bool {
	token := tokens[index]
	if token.depth < depth || token.punctuation(";") {
		return true
	}
	if token.depth != depth || token.kind != referenceName ||
		(index > 0 && tokens[index-1].punctuation(".")) {
		return false
	}
	switch token.text {
	case "group", "order":
		return index+1 < len(tokens) && tokens[index+1].keyword("by")
	case "where", "having", "window", "limit", "offset", "fetch", "for",
		"union", "intersect", "except", "returning", "into":
		return true
	}
	return false
}

func referenceRelationKeyword(tokens []sqlReferenceToken, index int, word string) bool {
	return tokens[index].keyword(word) && (index == 0 || !tokens[index-1].punctuation("."))
}

func referenceBracketEnd(tokens []sqlReferenceToken, start int) int {
	depth := 1
	for i := start + 1; i < len(tokens); i++ {
		if tokens[i].punctuation("[") {
			depth++
		}
		if tokens[i].punctuation("]") {
			depth--
			if depth == 0 {
				return i + 1
			}
		}
	}
	return len(tokens)
}
