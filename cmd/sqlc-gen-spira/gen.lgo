package main

import (
	"fmt"
	"path"
	"strings"
)

func Generate(req *Request) (Model, []File, error) {
	opts, err := decodeOptions(req.PluginOptions)
	if err != nil {
		return Model{}, nil, fmt.Errorf("sqlc-gen-spira: options: %w", err)
	}
	model, err := buildModel(req, &opts)
	if err != nil {
		return Model{}, nil, err
	}
	pkg := packageName(req, &opts)
	files := []File{{Name: "models.sql.lgo", Contents: []byte(emitModels(model, pkg))}}
	for _, group := range groupQueryFiles(model) {
		files = append(files, File{Name: group.name, Contents: []byte(emitQueryFile(pkg, group))})
	}
	return model, files, nil
}

func packageName(req *Request, opts *PluginOptions) string {
	if opts.Package != "" {
		return opts.Package
	}
	if out := req.Settings.Codegen.Out; out != "" {
		if base := path.Base(out); base != "." && base != "/" {
			return base
		}
	}
	return "models"
}

func emitModels(m Model, pkg string) string {
	var b strings.Builder
	b.WriteString("// Code generated by sqlc-gen-spira. DO NOT EDIT.\n\n")
	b.WriteString("package " + pkg + "\n\n")
	emitImportBlock(&b, modelStdImports(m), modelExtImports(m))
	emitEnums(&b, m.Enums)
	emitKeyTypes(&b, m.Entities)
	emitEntities(&b, m.Entities)
	emitTableVars(&b, m.Entities)
	emitPrepareAll(&b, m.Queries)
	return b.String()
}

func usesTime(m Model) bool {
	var types []string
	for _, e := range m.Entities {
		for _, f := range e.Fields {
			types = append(types, f.GoType)
		}
	}
	for _, q := range m.Queries {
		for _, f := range q.Fields {
			types = append(types, f.GoType)
		}
		for _, p := range q.Params {
			types = append(types, p.GoType)
		}
	}
	for _, typ := range types {
		if strings.Contains(typ, "time.Time") {
			return true
		}
	}
	return false
}

func emitEnums(b *strings.Builder, enums []EnumDef) {
	for _, e := range enums {
		fmt.Fprintf(b, "type %s string\n\n", e.GoName)
		for _, v := range e.Vals {
			fmt.Fprintf(b, "const %s %s = %q\n", e.GoName+goName(v), e.GoName, v)
		}
		b.WriteString("\n")
		fmt.Fprintf(b, "func (e %s) Valid() bool {\n", e.GoName)
		b.WriteString("\tswitch e {\n")
		for _, v := range e.Vals {
			fmt.Fprintf(b, "\tcase %s:\n", e.GoName+goName(v))
		}
		b.WriteString("\t\treturn true\n\t}\n\treturn false\n}\n\n")
	}
}

func emitKeyTypes(b *strings.Builder, entities []Entity) {
	seen := map[string]bool{}
	for _, e := range entities {
		if e.KeyType == "" || (seen[e.KeyType] ?? false) {
			continue
		}
		seen[e.KeyType] = true
		fmt.Fprintf(b, "type %s %s\n\n", e.KeyType, e.KeyBase)
	}
}

func emitEntities(b *strings.Builder, entities []Entity) {
	for _, e := range entities {
		fmt.Fprintf(b, "type %s struct {\n", e.Struct)
		for _, f := range e.Fields {
			fmt.Fprintf(b, "\t%s %s `col:\"%s\"`\n", f.GoName, f.GoType, escapeTag(f.Name))
		}
		b.WriteString("}\n\n")
	}
}

func escapeTag(s string) string {
	s = strings.ReplaceAll(s, `\`, `\\`)
	return strings.ReplaceAll(s, `"`, `\"`)
}

type queryGroup struct {
	name    string
	queries []QueryDef
}

func groupQueryFiles(m Model) []queryGroup {
	byFile := map[string][]QueryDef{}
	var files []string
	for i := range m.Queries {
		qd := &m.Queries[i]
		if _, ok := byFile[qd.File]; !ok {
			files = append(files, qd.File)
		}
		byFile[qd.File] = append(byFile[qd.File] ?? []QueryDef{}, *qd)
	}
	sortStrings(files)
	var groups []queryGroup
	for _, file := range files {
		groups = append(groups, queryGroup{name: topicName(file), queries: byFile[file] ?? []QueryDef{}})
	}
	return groups
}

func topicName(file string) string {
	base := path.Base(file)
	if base == "." || base == "/" || base == "" {
		return "queries.sql.lgo"
	}
	name := strings.TrimSuffix(base, ".sql")
	if name == "" {
		return "queries.sql.lgo"
	}
	return name + ".sql.lgo"
}

func modelStdImports(m Model) []string {
	std := []string{"context"}
	if len(m.Queries) > 0 {
		std = append(std, "fmt")
	}
	if usesTime(m) {
		std = append(std, "time")
	}
	return std
}

func modelExtImports(m Model) []string {
	ext := []string{"github.com/gosuda/spira/db"}
	for i := range m.Entities {
		if m.Entities[i].Key != "" {
			ext = append(ext, "github.com/gosuda/spira/orm")
			break
		}
	}
	return ext
}

func queryNeedsTime(qd *QueryDef) bool {
	if strings.Contains(qd.RowGoType, "time.Time") {
		return true
	}
	if qd.RowGoType == goName(qd.Name)+"Row" {
		for j := range qd.Fields {
			if strings.Contains(qd.Fields[j].GoType, "time.Time") {
				return true
			}
		}
	}
	for j := range qd.Params {
		if strings.Contains(qd.Params[j].GoType, "time.Time") {
			return true
		}
	}
	return false
}

func queryStdImports(queries []QueryDef) []string {
	for i := range queries {
		if queryNeedsTime(&queries[i]) {
			return []string{"context", "fmt", "time"}
		}
	}
	return []string{"context", "fmt"}
}

func emitImportBlock(b *strings.Builder, std []string, ext []string) {
	if len(std) == 0 && len(ext) == 0 {
		return
	}
	b.WriteString("import (\n")
	for _, s := range std {
		fmt.Fprintf(b, "\t%q\n", s)
	}
	if len(std) > 0 && len(ext) > 0 {
		b.WriteString("\n")
	}
	for _, s := range ext {
		fmt.Fprintf(b, "\t%q\n", s)
	}
	b.WriteString(")\n\n")
}

func emitTableVars(b *strings.Builder, entities []Entity) {
	for _, e := range entities {
		if e.Key == "" {
			continue
		}
		key := e.KeyType
		if key == "" {
			key = e.KeyBase
		}
		fmt.Fprintf(b, "var %sTable = orm.Table[%s, %s]{Name: %q, Key: %q, Version: %q}\n\n", e.Struct, e.Struct, key, e.Table, e.Key, e.Version)
	}
}

func emitPrepareAll(b *strings.Builder, queries []QueryDef) {
	b.WriteString("func PrepareAll(ctx context.Context, p *db.Pool) error {\n")
	for _, q := range queries {
		fmt.Fprintf(b, "\tif err := p.Prepare(ctx, %sQuery); err != nil {\n", goName(q.Name))
		fmt.Fprintf(b, "\t\treturn fmt.Errorf(%q, err)\n", "PrepareAll: "+q.Name+": %w")
		b.WriteString("\t}\n")
	}
	b.WriteString("\treturn nil\n}\n")
}

func emitQueryFile(pkg string, group queryGroup) string {
	var b strings.Builder
	b.WriteString("// Code generated by sqlc-gen-spira. DO NOT EDIT.\n\n")
	b.WriteString("package " + pkg + "\n\n")
	emitImportBlock(&b, queryStdImports(group.queries), []string{"github.com/gosuda/spira/db"})
	for i := range group.queries {
		qd := &group.queries[i]
		emitQueryConst(&b, qd)
		emitRowDecl(&b, qd)
		emitArgsDecl(&b, qd)
		emitQueryFunc(&b, qd)
	}
	return b.String()
}

func emitQueryConst(b *strings.Builder, qd *QueryDef) {
	fmt.Fprintf(b, "const %sQuery = %s\n\n", goName(qd.Name), goStringLit(qd.Text))
}

func goStringLit(s string) string {
	if !strings.Contains(s, "`") {
		return "`" + s + "`"
	}
	out := strings.ReplaceAll(s, `\`, `\\`)
	out = strings.ReplaceAll(out, `"`, `\"`)
	out = strings.ReplaceAll(out, "\n", `\n`)
	out = strings.ReplaceAll(out, "\t", `\t`)
	out = strings.ReplaceAll(out, "\r", `\r`)
	return `"` + out + `"`
}

func emitRowDecl(b *strings.Builder, qd *QueryDef) {
	if qd.RowGoType != goName(qd.Name)+"Row" {
		return
	}
	fmt.Fprintf(b, "type %s struct {\n", qd.RowGoType)
	emitRowFields(b, qd)
	b.WriteString("}\n\n")
}

func emitRowFields(b *strings.Builder, qd *QueryDef) {
	done := map[string]bool{}
	for i := range qd.Fields {
		f := &qd.Fields[i]
		if f.Embed == "" {
			fmt.Fprintf(b, "\t%s %s `col:\"%s\"`\n", f.GoName, f.GoType, escapeTag(f.Name))
			continue
		}
		key := strings.ToLower(f.Embed)
		if done[key] ?? false {
			continue
		}
		done[key] = true
		fmt.Fprintf(b, "\t%s %s\n", embedFieldFor(qd, key), embedStructFor(qd, key))
	}
}

func embedFieldFor(qd *QueryDef, key string) string {
	for i := range qd.Embeds {
		if strings.ToLower(qd.Embeds[i].Table) == key {
			return qd.Embeds[i].Field
		}
	}
	return goName(key)
}

func embedStructFor(qd *QueryDef, key string) string {
	for i := range qd.Embeds {
		if strings.ToLower(qd.Embeds[i].Table) == key {
			return qd.Embeds[i].Struct
		}
	}
	return goName(key)
}

func emitArgsDecl(b *strings.Builder, qd *QueryDef) {
	if qd.ArgsName == "" {
		return
	}
	fmt.Fprintf(b, "type %s struct {\n", qd.ArgsName)
	for i := range qd.Params {
		p := &qd.Params[i]
		fmt.Fprintf(b, "\t%s %s\n", p.GoName, p.GoType)
	}
	b.WriteString("}\n\n")
}

func emitQueryFunc(b *strings.Builder, qd *QueryDef) {
	name := goName(qd.Name)
	params := emitSigParams(qd)
	switch qd.Cmd {
	case ":one":
		fmt.Fprintf(b, "func %s(%s) (%s?, error) {\n", name, params, qd.RowGoType)
		emitCallLine(b, qd, "row, err := db.One["+qd.RowGoType+"]")
		b.WriteString("\tif err != nil {\n")
		fmt.Fprintf(b, "\t\treturn nil, fmt.Errorf(%q, err)\n", qd.Name+": %w")
		b.WriteString("\t}\n\treturn row, nil\n")
	case ":many":
		fmt.Fprintf(b, "func %s(%s) ([]%s, error) {\n", name, params, qd.RowGoType)
		emitCallLine(b, qd, "rows, err := db.Query["+qd.RowGoType+"]")
		b.WriteString("\tif err != nil {\n")
		fmt.Fprintf(b, "\t\treturn nil, fmt.Errorf(%q, err)\n", qd.Name+": %w")
		b.WriteString("\t}\n\treturn rows, nil\n")
	case ":exec":
		fmt.Fprintf(b, "func %s(%s) error {\n", name, params)
		emitCallLine(b, qd, "_, err := db.Exec")
		b.WriteString("\tif err != nil {\n")
		fmt.Fprintf(b, "\t\treturn fmt.Errorf(%q, err)\n", qd.Name+": %w")
		b.WriteString("\t}\n\treturn nil\n")
	case ":execrows":
		fmt.Fprintf(b, "func %s(%s) (int64, error) {\n", name, params)
		emitExecCount(b, qd, false)
	case ":execlastid":
		fmt.Fprintf(b, "func %s(%s) (int64, error) {\n", name, params)
		emitExecCount(b, qd, true)
	}
	b.WriteString("}\n\n")
}

func emitSigParams(qd *QueryDef) string {
	head := "ctx context.Context, q db.Querier"
	if qd.ArgsName != "" {
		return head + ", args " + qd.ArgsName
	}
	parts := []string{head}
	for i := range qd.Params {
		parts = append(parts, qd.Params[i].GoName+" "+qd.Params[i].GoType)
	}
	return strings.Join(parts, ", ")
}

func argRef(qd *QueryDef, p *ParamDef) string {
	if qd.ArgsName != "" {
		return "args." + p.GoName
	}
	return p.GoName
}

func hasSpread(qd *QueryDef) bool {
	for i := range qd.Slices {
		if qd.Slices[i].Spread {
			return true
		}
	}
	return false
}

func spreadParam(qd *QueryDef, p *ParamDef) bool {
	for i := range qd.Slices {
		if qd.Slices[i].GoName == p.GoName && qd.Slices[i].Spread {
			return true
		}
	}
	return false
}

func callArgs(qd *QueryDef) []string {
	if len(qd.Slices) > 0 {
		return []string{"args..."}
	}
	var out []string
	for i := range qd.Params {
		out = append(out, argRef(qd, &qd.Params[i]))
	}
	return out
}

func callPrelude(qd *QueryDef) []string {
	if len(qd.Slices) == 0 {
		return nil
	}
	pre := []string{"\targs := []any{}\n"}
	for i := range qd.Params {
		p := &qd.Params[i]
		if spreadParam(qd, p) {
			pre = append(pre, "\tfor _, v := range "+argRef(qd, p)+" {\n\t\targs = append(args, v)\n\t}\n")
		} else {
			pre = append(pre, "\targs = append(args, "+argRef(qd, p)+")\n")
		}
	}
	first := true
	for i := range qd.Slices {
		s := &qd.Slices[i]
		if !s.Spread {
			continue
		}
		decl := "query = "
		if first {
			decl = "query := "
			first = false
		}
		ref := s.GoName
		if qd.ArgsName != "" {
			ref = "args." + ref
		}
		pre = append(pre, fmt.Sprintf("\t%sdb.In(%sQuery, %q, len(%s))\n", decl, goName(qd.Name), s.Marker, ref))
	}
	return pre
}

func emitCallLine(b *strings.Builder, qd *QueryDef, head string) {
	for _, line := range callPrelude(qd) {
		b.WriteString(line)
	}
	target := goName(qd.Name) + "Query"
	if hasSpread(qd) {
		target = "query"
	}
	b.WriteString("\t" + head + "(ctx, q, " + target)
	args := callArgs(qd)
	if len(args) > 0 {
		b.WriteString(", " + strings.Join(args, ", "))
	}
	b.WriteString(")\n")
}

func emitExecCount(b *strings.Builder, qd *QueryDef, lastID bool) {
	emitCallLine(b, qd, "res, err := db.Exec")
	b.WriteString("\tif err != nil {\n")
	fmt.Fprintf(b, "\t\treturn 0, fmt.Errorf(%q, err)\n", qd.Name+": %w")
	b.WriteString("\t}\n")
	op := "RowsAffected"
	if lastID {
		op = "LastInsertId"
	}
	fmt.Fprintf(b, "\tn, err := res.%s()\n", op)
	b.WriteString("\tif err != nil {\n")
	fmt.Fprintf(b, "\t\treturn 0, fmt.Errorf(%q, err)\n", qd.Name+": %w")
	b.WriteString("\t}\n\treturn n, nil\n")
}
