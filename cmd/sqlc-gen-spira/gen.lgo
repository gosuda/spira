package main

import (
	"fmt"
	"path"
	"strconv"
	"strings"
)

func Generate(req *Request) (Model, []File, error) {
	opts, err := decodeOptions(req.PluginOptions)
	if err != nil {
		return Model{}, nil, fmt.Errorf("sqlc-gen-spira: options: %w", err)
	}
	pkg, err := packageName(req, &opts)
	if err != nil {
		return Model{}, nil, err
	}
	model, err := buildModel(req, &opts)
	if err != nil {
		return Model{}, nil, err
	}
	files := []File{{Name: "models.sql.lgo", Contents: []byte(emitModels(model, pkg))}}
	for _, group := range groupQueryFiles(model) {
		src, err := emitQueryFile(pkg, model.Engine, group)
		if err != nil {
			return Model{}, nil, err
		}
		files = append(files, File{Name: group.name, Contents: []byte(src)})
	}
	return model, files, nil
}

func packageName(req *Request, opts *PluginOptions) (string, error) {
	name := opts.Package
	if name == "" {
		name = path.Base(req.Settings.Codegen.Out)
		if name == "." || name == "/" {
			return "models", nil
		}
	}
	if name == "_" || !isGoIdent(name) {
		return "", fmt.Errorf("sqlc-gen-spira: package %q is not a Go package name", name)
	}
	return name, nil
}

func emitModels(m Model, pkg string) string {
	var b strings.Builder
	b.WriteString("// Code generated by sqlc-gen-spira. DO NOT EDIT.\n\n")
	b.WriteString("package " + pkg + "\n\n")
	emitImportBlock(&b, modelStdImports(m), modelExtImports(m))
	emitEnums(&b, m.Enums)
	emitKeyTypes(&b, m.Entities)
	emitEntities(&b, m.Entities)
	emitTableVars(&b, m.Entities)
	emitPrepareAll(&b, m.Queries)
	return b.String()
}

func usesTime(m Model) bool {
	var types []string
	for _, e := range m.Entities {
		for _, f := range e.Fields {
			types = append(types, f.GoType)
		}
	}
	for _, q := range m.Queries {
		for _, f := range q.Fields {
			types = append(types, f.GoType)
		}
		for _, p := range q.Params {
			types = append(types, p.GoType)
		}
	}
	for _, typ := range types {
		if strings.Contains(typ, "time.Time") {
			return true
		}
	}
	return false
}

func emitEnums(b *strings.Builder, enums []EnumDef) {
	for _, e := range enums {
		fmt.Fprintf(b, "type %s string\n\n", e.GoName)
		for _, v := range e.Vals {
			fmt.Fprintf(b, "const %s %s = %q\n", e.GoName+goName(v), e.GoName, v)
		}
		b.WriteString("\n")
		fmt.Fprintf(b, "func (e %s) Valid() bool {\n", e.GoName)
		b.WriteString("\tswitch e {\n")
		for _, v := range e.Vals {
			fmt.Fprintf(b, "\tcase %s:\n", e.GoName+goName(v))
		}
		b.WriteString("\t\treturn true\n\t}\n\treturn false\n}\n\n")
	}
}

func emitKeyTypes(b *strings.Builder, entities []Entity) {
	seen := map[string]bool{}
	for _, e := range entities {
		if e.KeyType == "" || (seen[e.KeyType] ?? false) {
			continue
		}
		seen[e.KeyType] = true
		fmt.Fprintf(b, "type %s %s\n\n", e.KeyType, e.KeyBase)
	}
}

func emitEntities(b *strings.Builder, entities []Entity) {
	for _, e := range entities {
		fmt.Fprintf(b, "type %s struct {\n", e.Struct)
		for _, f := range e.Fields {
			fmt.Fprintf(b, "\t%s %s `col:\"%s\"`\n", f.GoName, f.GoType, escapeTag(f.Name))
		}
		b.WriteString("}\n\n")
	}
}

func escapeTag(s string) string {
	s = strings.ReplaceAll(s, `\`, `\\`)
	return strings.ReplaceAll(s, `"`, `\"`)
}

type queryGroup struct {
	name    string
	queries []QueryDef
}

func groupQueryFiles(m Model) []queryGroup {
	byFile := map[string][]QueryDef{}
	var files []string
	for i := range m.Queries {
		qd := &m.Queries[i]
		if _, ok := byFile[qd.File]; !ok {
			files = append(files, qd.File)
		}
		byFile[qd.File] = append(byFile[qd.File] ?? []QueryDef{}, *qd)
	}
	sortStrings(files)
	var groups []queryGroup
	for _, file := range files {
		groups = append(groups, queryGroup{name: topicName(file), queries: byFile[file] ?? []QueryDef{}})
	}
	return groups
}

func topicName(file string) string {
	base := path.Base(file)
	if base == "." || base == "/" || base == "" {
		return "queries.sql.lgo"
	}
	name := strings.TrimSuffix(base, ".sql")
	if name == "" {
		return "queries.sql.lgo"
	}
	return name + ".sql.lgo"
}

func modelStdImports(m Model) []string {
	std := []string{"context"}
	if len(m.Queries) > 0 {
		std = append(std, "fmt")
	}
	if usesTime(m) {
		std = append(std, "time")
	}
	return std
}

func modelExtImports(m Model) []string {
	ext := []string{"github.com/gosuda/spira/db"}
	for i := range m.Entities {
		if m.Entities[i].Key != "" {
			ext = append(ext, "github.com/gosuda/spira/orm")
			break
		}
	}
	return ext
}

func queryNeedsTime(qd *QueryDef) bool {
	if strings.Contains(qd.RowGoType, "time.Time") {
		return true
	}
	if qd.RowGoType == goName(qd.Name)+"Row" {
		for j := range qd.Fields {
			if strings.Contains(qd.Fields[j].GoType, "time.Time") {
				return true
			}
		}
	}
	for j := range qd.Params {
		if strings.Contains(qd.Params[j].GoType, "time.Time") {
			return true
		}
	}
	return false
}

func queryStdImports(queries []QueryDef) []string {
	for i := range queries {
		if queryNeedsTime(&queries[i]) {
			return []string{"context", "fmt", "time"}
		}
	}
	return []string{"context", "fmt"}
}

func emitImportBlock(b *strings.Builder, std []string, ext []string) {
	if len(std) == 0 && len(ext) == 0 {
		return
	}
	b.WriteString("import (\n")
	for _, s := range std {
		fmt.Fprintf(b, "\t%q\n", s)
	}
	if len(std) > 0 && len(ext) > 0 {
		b.WriteString("\n")
	}
	for _, s := range ext {
		fmt.Fprintf(b, "\t%q\n", s)
	}
	b.WriteString(")\n\n")
}

func emitTableVars(b *strings.Builder, entities []Entity) {
	for _, e := range entities {
		if e.Key == "" {
			continue
		}
		key := e.KeyType
		if key == "" {
			key = e.KeyBase
		}
		fmt.Fprintf(b, "var %sTable = orm.Table[%s, %s]{Name: %q, Key: %q, Version: %q}\n\n", e.Struct, e.Struct, key, e.Table, e.Key, e.Version)
	}
}

func emitPrepareAll(b *strings.Builder, queries []QueryDef) {
	const signature = "func PrepareAll(ctx context.Context, p *db.Pool) error {\n"
	if len(queries) == 0 {
		b.WriteString(signature + "\treturn nil\n}\n")
		return
	}
	b.WriteString("//logos:rodata\nvar sqlcSpiraPrepareAllQueries = [...]struct {\n\tname string\n\tsql string\n}{\n")
	for i := range queries {
		name := queries[i].Name
		fmt.Fprintf(b, "\t{%q, %sQuery},\n", name, goName(name))
	}
	b.WriteString("}\n\n" + signature)
	b.WriteString(`	for i := range sqlcSpiraPrepareAllQueries {
		err := p.Prepare(ctx, sqlcSpiraPrepareAllQueries[i].sql)
		if err != nil {
			return fmt.Errorf("PrepareAll: %s: %w", sqlcSpiraPrepareAllQueries[i].name, err)
		}
	}
	return nil
}
`)
}

func emitQueryFile(pkg string, engine string, group queryGroup) (string, error) {
	var b strings.Builder
	b.WriteString("// Code generated by sqlc-gen-spira. DO NOT EDIT.\n\n")
	b.WriteString("package " + pkg + "\n\n")
	emitImportBlock(&b, queryStdImports(group.queries), []string{"github.com/gosuda/spira/db"})
	for i := range group.queries {
		qd := &group.queries[i]
		call := planSliceCall(qd, engine)?
		emitQueryConst(&b, qd)
		emitRowDecl(&b, qd)
		emitArgsDecl(&b, qd)
		emitQueryFunc(&b, qd, call)
	}
	return b.String(), nil
}

func emitQueryConst(b *strings.Builder, qd *QueryDef) {
	fmt.Fprintf(b, "const %sQuery = %s\n\n", goName(qd.Name), goStringLit(qd.Text))
}

func goStringLit(s string) string {
	if !strings.Contains(s, "`") {
		return "`" + s + "`"
	}
	out := strings.ReplaceAll(s, `\`, `\\`)
	out = strings.ReplaceAll(out, `"`, `\"`)
	out = strings.ReplaceAll(out, "\n", `\n`)
	out = strings.ReplaceAll(out, "\t", `\t`)
	out = strings.ReplaceAll(out, "\r", `\r`)
	return `"` + out + `"`
}

func emitRowDecl(b *strings.Builder, qd *QueryDef) {
	if qd.RowGoType != goName(qd.Name)+"Row" {
		return
	}
	fmt.Fprintf(b, "type %s struct {\n", qd.RowGoType)
	emitRowFields(b, qd)
	b.WriteString("}\n\n")
}

func emitRowFields(b *strings.Builder, qd *QueryDef) {
	done := map[string]bool{}
	for i := range qd.Fields {
		f := &qd.Fields[i]
		if f.Embed == "" {
			fmt.Fprintf(b, "\t%s %s `col:\"%s\"`\n", f.GoName, f.GoType, escapeTag(f.Name))
			continue
		}
		key := strings.ToLower(f.Embed)
		if done[key] ?? false {
			continue
		}
		done[key] = true
		fmt.Fprintf(b, "\t%s %s\n", embedFieldFor(qd, key), embedStructFor(qd, key))
	}
}

func embedFieldFor(qd *QueryDef, key string) string {
	for i := range qd.Embeds {
		if strings.ToLower(qd.Embeds[i].Table) == key {
			return qd.Embeds[i].Field
		}
	}
	return goName(key)
}

func embedStructFor(qd *QueryDef, key string) string {
	for i := range qd.Embeds {
		if strings.ToLower(qd.Embeds[i].Table) == key {
			return qd.Embeds[i].Struct
		}
	}
	return goName(key)
}

func emitArgsDecl(b *strings.Builder, qd *QueryDef) {
	if qd.ArgsName == "" {
		return
	}
	fmt.Fprintf(b, "type %s struct {\n", qd.ArgsName)
	for i := range qd.Params {
		p := &qd.Params[i]
		fmt.Fprintf(b, "\t%s %s\n", p.GoName, p.GoType)
	}
	b.WriteString("}\n\n")
}

func emitQueryFunc(b *strings.Builder, qd *QueryDef, call sliceCall) {
	name := goName(qd.Name)
	params := emitSigParams(qd)
	switch qd.Cmd {
	case ":one":
		fmt.Fprintf(b, "func %s(%s) (%s?, error) {\n", name, params, qd.RowGoType)
		emitCallLine(b, qd, call, "row, err := db.One["+qd.RowGoType+"]")
		b.WriteString("\tif err != nil {\n")
		fmt.Fprintf(b, "\t\treturn nil, fmt.Errorf(%q, err)\n", qd.Name+": %w")
		b.WriteString("\t}\n\treturn row, nil\n")
	case ":many":
		fmt.Fprintf(b, "func %s(%s) ([]%s, error) {\n", name, params, qd.RowGoType)
		emitCallLine(b, qd, call, "rows, err := db.Query["+qd.RowGoType+"]")
		b.WriteString("\tif err != nil {\n")
		fmt.Fprintf(b, "\t\treturn nil, fmt.Errorf(%q, err)\n", qd.Name+": %w")
		b.WriteString("\t}\n\treturn rows, nil\n")
	case ":exec":
		fmt.Fprintf(b, "func %s(%s) error {\n", name, params)
		emitCallLine(b, qd, call, "_, err := db.Exec")
		b.WriteString("\tif err != nil {\n")
		fmt.Fprintf(b, "\t\treturn fmt.Errorf(%q, err)\n", qd.Name+": %w")
		b.WriteString("\t}\n\treturn nil\n")
	case ":execrows":
		fmt.Fprintf(b, "func %s(%s) (int64, error) {\n", name, params)
		emitExecCount(b, qd, call, false)
	case ":execlastid":
		fmt.Fprintf(b, "func %s(%s) (int64, error) {\n", name, params)
		emitExecCount(b, qd, call, true)
	}
	b.WriteString("}\n\n")
}

func emitSigParams(qd *QueryDef) string {
	head := "ctx context.Context, q db.Querier"
	if qd.ArgsName != "" {
		return head + ", args " + qd.ArgsName
	}
	parts := []string{head}
	for i := range qd.Params {
		parts = append(parts, qd.Params[i].GoName+" "+qd.Params[i].GoType)
	}
	return strings.Join(parts, ", ")
}

func argRef(qd *QueryDef, name string) string {
	if qd.ArgsName != "" {
		return "args." + name
	}
	return name
}

func hasSpread(qd *QueryDef) bool {
	for i := range qd.Slices {
		if qd.Slices[i].Spread {
			return true
		}
	}
	return false
}

type sliceArgument struct {
	name   string
	marker string
}

type sliceCall struct {
	sql     string
	args    []sliceArgument
	scalars int
}

func planSliceCall(qd *QueryDef, engine string) (sliceCall, error) {
	if (engine != "sqlite" && engine != "mysql") || !hasSpread(qd) {
		return sliceCall{}, nil
	}
	plan := sliceSQL{source: qd.Text, markerEnds: make(map[string]int, len(qd.Slices))}
	numbered := sqliteBindRefs(qd, engine)
	seen := make(map[string]bool, len(qd.Params))
	args := make([]sliceArgument, 0, len(qd.Params))
	positional := 0
	for end := 0; end < len(qd.Text); {
		start := end
		width, bind := sliceBindToken(qd.Text[start:], engine)
		end += width
		if !bind {
			continue
		}
		token := qd.Text[start:end]
		arg, err := sliceBindArgument(qd, numbered, token, positional+1)
		if err != nil {
			return sliceCall{}, fmt.Errorf("sqlc-gen-spira: %s: %w", qd.Name, err)
		}
		if engine != "sqlite" || token == "?" || arg.marker != "" {
			positional++
		}
		plan.rewriteBind(&arg, start, end)
		seen[arg.name] = true
		args = append(args, arg)
	}
	if plan.spreads == 0 {
		return sliceCall{}, nil
	}
	if len(seen) != len(qd.Params) {
		return sliceCall{}, fmt.Errorf("sqlc-gen-spira: %s: slice query does not account for every parameter", qd.Name)
	}
	if plan.copied != 0 {
		plan.rewritten.WriteString(qd.Text[plan.copied:])
	}
	return sliceCall{sql: plan.rewritten.String(), args: args, scalars: len(args) - plan.spreads}, nil
}

type sqliteRefs struct {
	numbers map[int]string
	markers map[string]string
}

func sqliteBindRefs(qd *QueryDef, engine string) sqliteRefs {
	if engine != "sqlite" {
		return sqliteRefs{}
	}
	refs := sqliteRefs{numbers: make(map[int]string, len(qd.Params)), markers: make(map[string]string, len(qd.Slices))}
	for i := range qd.Params {
		p := &qd.Params[i]
		refs.numbers[int(p.Number)] = p.GoName
	}
	for i := range qd.Slices {
		s := &qd.Slices[i]
		if s.Spread {
			refs.markers[s.Marker] = s.GoName
		}
	}
	return refs
}

func sliceBindArgument(qd *QueryDef, sqlite sqliteRefs, token string, position int) (sliceArgument, error) {
	marker := ""
	if name, ok := strings.CutPrefix(token, "/*SLICE:"); ok {
		marker = strings.TrimSuffix(name, "*/?")
	}
	if sqlite.numbers == nil {
		if position > len(qd.Params) {
			return sliceArgument{}, fmt.Errorf("no positional parameter for bind %d (%q)", position, token)
		}
		p := &qd.Params[position-1]
		if marker != "" && (!p.IsSlice || p.Name != marker) {
			return sliceArgument{}, fmt.Errorf("no positional parameter for bind %d (%q)", position, token)
		}
		return sliceArgument{name: p.GoName, marker: marker}, nil
	}
	if marker != "" {
		if param, ok := sqlite.markers[marker]; ok {
			return sliceArgument{name: param, marker: marker}, nil
		}
		return sliceArgument{}, fmt.Errorf("no SQLite parameter for slice %q", marker)
	}
	if token[0] != '?' {
		return sliceArgument{}, fmt.Errorf("SQLite slice queries require sqlc.arg instead of native %q parameters", token[0])
	}
	if len(token) > 1 {
		position = strconv.Atoi(token[1:])?
	}
	if param, ok := sqlite.numbers[position]; ok {
		return sliceArgument{name: param}, nil
	}
	return sliceArgument{}, fmt.Errorf("no SQLite parameter for bind %d", position)
}

type sliceSQL struct {
	source     string
	rewritten  strings.Builder
	markerEnds map[string]int
	copied     int
	aliases    int
	spreads    int
}

func (s *sliceSQL) rewriteBind(arg *sliceArgument, start int, end int) {
	if arg.marker == "" {
		if end-start > 1 {
			s.rewritten.WriteString(s.source[s.copied : start+1])
			s.copied = end
		}
		return
	}
	s.spreads++
	previous := s.markerEnds[arg.marker] ?? 0
	if !strings.Contains(s.source[previous:start], s.source[start:end]) {
		s.markerEnds[arg.marker] = end
		return
	}
	for {
		s.aliases++
		name := "spira_slice_" + strconv.Itoa(s.aliases)
		token := "/*SLICE:" + name + "*/?"
		if strings.Contains(s.source, token) {
			continue
		}
		s.rewritten.WriteString(s.source[s.copied:start])
		s.rewritten.WriteString(token)
		s.copied = end
		arg.marker = name
		return
	}
}

func sliceBindToken(text string, engine string) (int, bool) {
	first := text[0]
	switch {
	case first == '?':
		end := 1
		for engine == "sqlite" && end < len(text) && isASCIIDigit(text[end]) {
			end++
		}
		return end, true
	case first == ':', first == '@', first == '$':
		return 1, engine == "sqlite"
	case first == '\'', first == '"':
		return sqlStringEnd(text, engine), false
	case first == '`':
		return throughSQL(text, "`", 1), false
	case first == '[' && engine == "sqlite":
		return throughSQL(text, "]", 1), false
	case first == '#' && engine == "mysql":
		return throughSQL(text, "\n", 1), false
	case first == '-' && len(text) > 1 && text[1] == '-':
		return throughSQL(text, "\n", 2), false
	case first == '/' && len(text) > 1 && text[1] == '*':
		return sliceBlockToken(text)
	case engine == "sqlite" && sqliteIdentifierByte(first):
		return sqliteIdentifierEnd(text), false
	default:
		return 1, false
	}
}

func sliceBlockToken(text string) (int, bool) {
	end := throughSQL(text, "*/", 2)
	if strings.HasPrefix(text, "/*SLICE:") && end < len(text) && text[end] == '?' &&
		(end+1 == len(text) || !isASCIIDigit(text[end+1])) {
		return end + 1, true
	}
	return end, false
}

func sqliteIdentifierEnd(text string) int {
	i := 1
	for i < len(text) && (sqliteIdentifierByte(text[i]) || text[i] == '$') {
		i++
	}
	return i
}

func sqliteIdentifierByte(c byte) bool {
	return c >= 128 || c == '_' || isASCIILetter(c) || isASCIIDigit(c)
}

func sqlStringEnd(text string, engine string) int {
	quote := text[0]
	for i := 1; i < len(text); i++ {
		if text[i] == quote {
			return i + 1
		}
		if engine == "mysql" && text[i] == '\\' {
			i++
		}
	}
	return len(text)
}

func throughSQL(text string, delim string, start int) int {
	end := strings.Index(text[start:], delim)
	if end < 0 {
		return len(text)
	}
	return start + end + len(delim)
}

func emitSliceArgs(b *strings.Builder, qd *QueryDef, call sliceCall, args string) {
	fmt.Fprintf(b, "\t%s := make([]any, 0, %d", args, call.scalars)
	for _, arg := range call.args {
		if arg.marker != "" {
			fmt.Fprintf(b, " + len(%s)", argRef(qd, arg.name))
		}
	}
	b.WriteString(")\n")
	for _, arg := range call.args {
		ref := argRef(qd, arg.name)
		if arg.marker == "" {
			fmt.Fprintf(b, "\t%s = append(%s, %s)\n", args, args, ref)
			continue
		}
		fmt.Fprintf(b, "\tfor _, v := range %s {\n\t\t%s = append(%s, v)\n\t}\n", ref, args, args)
	}
}

func emitSliceQuery(b *strings.Builder, qd *QueryDef, call sliceCall, target string) {
	if call.sql != "" {
		target = goStringLit(call.sql)
	}
	assign := ":="
	for _, arg := range call.args {
		if arg.marker == "" {
			continue
		}
		fmt.Fprintf(b, "\tquery %s db.In(%s, %q, len(%s))\n", assign, target, arg.marker, argRef(qd, arg.name))
		assign = "="
		target = "query"
	}
}

func emitCallLine(b *strings.Builder, qd *QueryDef, call sliceCall, head string) {
	target := goName(qd.Name) + "Query"
	if len(call.args) != 0 {
		args := "args"
		if qd.ArgsName != "" {
			args = "queryArgs"
		}
		emitSliceArgs(b, qd, call, args)
		emitSliceQuery(b, qd, call, target)
		fmt.Fprintf(b, "\t%s(ctx, q, query, %s...)\n", head, args)
		return
	}
	b.WriteString("\t" + head + "(ctx, q, " + target)
	for i := range qd.Params {
		b.WriteString(", " + argRef(qd, qd.Params[i].GoName))
	}
	b.WriteString(")\n")
}

func emitExecCount(b *strings.Builder, qd *QueryDef, call sliceCall, lastID bool) {
	emitCallLine(b, qd, call, "res, err := db.Exec")
	b.WriteString("\tif err != nil {\n")
	fmt.Fprintf(b, "\t\treturn 0, fmt.Errorf(%q, err)\n", qd.Name+": %w")
	b.WriteString("\t}\n")
	op := "RowsAffected"
	if lastID {
		op = "LastInsertId"
	}
	fmt.Fprintf(b, "\tn, err := res.%s()\n", op)
	b.WriteString("\tif err != nil {\n")
	fmt.Fprintf(b, "\t\treturn 0, fmt.Errorf(%q, err)\n", qd.Name+": %w")
	b.WriteString("\t}\n\treturn n, nil\n")
}
