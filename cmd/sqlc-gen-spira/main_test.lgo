func sliceFixture(t *testing.T) *Request {
	t.Helper()
	req := loadRequest(t, "sqlite")
	req.Catalog.Schemas[0].Tables[0].Columns = []Column{
		{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "kind", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}},
		{Name: "title", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}},
	}
	kindCol := Column{Name: "kind", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}, Table: Identifier{Name: "items"}}
	idsCol := Column{Name: "ids", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}, IsSQLCSlice: true}
	idCol := Column{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}}
	titleCol := Column{Name: "title", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}, Table: Identifier{Name: "items"}}
	req.Queries = []Query{
		{
			Name: "FindDocs", Cmd: ":many", Filename: "docs.sql",
			Text:    "SELECT id, title FROM items WHERE kind = ? AND id IN (/*SLICE:ids*/?) ORDER BY id",
			Columns: []Column{idCol, titleCol},
			Params:  []Parameter{{Number: 1, Column: kindCol}, {Number: 2, Name: "ids", Column: idsCol}},
		},
		{
			Name: "FindAny", Cmd: ":many", Filename: "docs.sql",
			Text:    "SELECT id FROM items WHERE id = ANY(?)",
			Columns: []Column{idCol},
			Params:  []Parameter{{Number: 1, Name: "ids", Column: idsCol}},
		},
	}
	return req
}

func TestSliceQuery(t *testing.T) {
	req := sliceFixture(t)
	model, _, err := Generate(req)
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return
	}
	found := findQuery(t, model, "FindDocs")
	if found.RowGoType != "FindDocsRow" {
		t.Fatalf("FindDocs row = %q, want a FindDocsRow struct", found.RowGoType)
		return
	}
	if len(found.Slices) != 1 {
		t.Fatalf("FindDocs slices = %+v, want one slice parameter", found.Slices)
		return
	}
	slice := found.Slices[0]
	if slice.Marker != "ids" || slice.GoName != "Ids" || slice.Elem != "[]int64" || !slice.Spread {
		t.Fatalf("FindDocs slice = %+v, want the ids marker spread over []int64", slice)
		return
	}
	if found.ArgsName != "" {
		t.Fatalf("FindDocs args = %q, want two positional parameters", found.ArgsName)
		return
	}
	anyFound := findQuery(t, model, "FindAny")
	if len(anyFound.Slices) != 1 || anyFound.Slices[0].Spread {
		t.Fatalf("FindAny slices = %+v, want one unspread slice parameter", anyFound.Slices)
		return
	}
	src := queryFile(t, req, "docs.sql.lgo")
	for _, want := range []string{
		"type FindDocsRow struct",
		"func FindDocs(ctx context.Context, q db.Querier, Kind string, Ids []int64) ([]FindDocsRow, error)",
		`db.In(FindDocsQuery, "ids", len(Ids))`,
		"for _, v := range Ids {",
		"args = append(args, v)",
	} {
		if !strings.Contains(src, want) {
			t.Fatalf("query file holds no %q:\n%s", want, src)
			return
		}
	}
}

func TestQueryFileOmitsTimeImportForEntityRows(t *testing.T) {
	req := patchRequest(t, "sqlite", func(req *Request) {
		req.PluginOptions = pluginOptions(t, map[string]any{
			"tables": map[string]any{
				"items": map[string]any{"type": "Item", "key": "id", "key_type": "ItemID"},
			},
		})
	})
	src := queryFile(t, req, "items.sql.lgo")
	if !strings.Contains(src, "(Item?, error)") {
		t.Fatalf("entity query file holds no Item return:\n%s", src)
		return
	}
	if strings.Contains(src, "\"time\"") {
		t.Fatalf("entity query file imports time:\n%s", src)
		return
	}
	models := generateFile(t, req)
	if !strings.Contains(models, "\"time\"") {
		t.Fatalf("entity models file holds no time import:\n%s", models)
		return
	}
}

func embedFixture(t *testing.T) *Request {
	t.Helper()
	req := loadRequest(t, "sqlite")
	req.PluginOptions = pluginOptions(t, map[string]any{
		"tables": map[string]any{
			"cart_items": map[string]any{"type": "CartItem", "key": "id", "key_type": "CartItemID"},
			"products":   map[string]any{"type": "Product", "key": "id", "key_type": "ProductID"},
		},
		"refs": map[string]any{"cart_items.product_id": "products"},
	})
	items := Table{Rel: Identifier{Name: "cart_items"}, Columns: []Column{
		{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "product_id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "quantity", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
	}}
	products := Table{Rel: Identifier{Name: "products"}, Columns: []Column{
		{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "name", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}},
	}}
	req.Catalog.Schemas[0].Tables = []Table{items, products}
	embed := Identifier{Name: "products"}
	cart := Identifier{Name: "cart_items"}
	req.Queries = []Query{{
		Name: "ListCartItems", Cmd: ":many", Filename: "cart.sql",
		Text: "SELECT cart_items.id, products.id, products.name, cart_items.quantity FROM cart_items JOIN products",
		Columns: []Column{
			{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: cart},
			{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: embed, EmbedTable: embed},
			{Name: "name", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}, Table: embed, EmbedTable: embed},
			{Name: "quantity", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: cart},
		},
		Params: []Parameter{
			{Number: 1, Column: Column{Name: "kind", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}, Table: cart}},
		},
	}}
	return req
}

func TestEmbedQuery(t *testing.T) {
	req := embedFixture(t)
	model, _, err := Generate(req)
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return
	}
	found := findQuery(t, model, "ListCartItems")
	if found.RowGoType != "ListCartItemsRow" {
		t.Fatalf("ListCartItems row = %q, want a ListCartItemsRow struct", found.RowGoType)
		return
	}
	if len(found.Embeds) != 1 {
		t.Fatalf("ListCartItems embeds = %+v, want one products embed", found.Embeds)
		return
	}
	embed := found.Embeds[0]
	if embed.Table != "products" || embed.Field != "Product" || embed.Struct != "Product" {
		t.Fatalf("ListCartItems embed = %+v, want products as Product Product", embed)
		return
	}
	src := queryFile(t, req, "cart.sql.lgo")
	for _, want := range []string{"type ListCartItemsRow struct", "Product Product"} {
		if !strings.Contains(src, want) {
			t.Fatalf("query file holds no %q:\n%s", want, src)
			return
		}
	}
	row := structFields(t, src, "ListCartItemsRow")
	if (row["ID"] ?? "") != "CartItemID" || (row["Quantity"] ?? "") != "int64" {
		t.Fatalf("ListCartItemsRow fields = %v, want the key type on ID", row)
	}
}

func TestDuplicateQuery(t *testing.T) {
	req := patchRequest(t, "sqlite", func(r *Request) {
		dup := r.Queries[0]
		r.Queries = []Query{dup, dup}
	})
	_, _, err := Generate(req)
	if err == nil {
		t.Fatal("Generate succeeded; want the duplicate query error")
		return
	}
	if !strings.Contains(err.Error(), `duplicate query "GetItem"`) {
		t.Fatalf("error = %v, want it to name GetItem", err)
	}
}

func TestDuplicateParamsShareOneName(t *testing.T) {
	req := patchRequest(t, "sqlite", func(r *Request) {
		idCol := Column{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}}
		r.Queries = []Query{{
			Name: "FindTwice", Cmd: ":many", Filename: "items.sql",
			Text: "SELECT id FROM items WHERE id = ? OR id = ?",
			Columns: []Column{
				{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}},
			},
			Params: []Parameter{{Number: 1, Column: idCol}, {Number: 2, Column: idCol}},
		}}
	})
	model, _, err := Generate(req)
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return
	}
	found := findQuery(t, model, "FindTwice")
	if len(found.Params) != 2 || found.Params[0].GoName != "ID" || found.Params[1].GoName != "ID2" {
		t.Fatalf("FindTwice params = %+v, want ID and ID2", found.Params)
	}
}

func TestMarkerWithoutParam(t *testing.T) {
	req := patchRequest(t, "sqlite", func(r *Request) {
