package main

import (
	"encoding/json/v2"
	"os"
	"path/filepath"
	"strings"
	"testing"
)
type wantField struct {
	goName string
	goType string
}

func loadRequest(t *testing.T, fixture string) *Request {
	t.Helper()
	data, err := os.ReadFile(filepath.Join("testdata", fixture, "request.json"))
	if err != nil {
		t.Fatalf("read %s request: %v", fixture, err)
		return &Request{}
	}
	var req Request
	if err := json.Unmarshal(data, &req); err != nil {
		t.Fatalf("decode %s request: %v", fixture, err)
		return &Request{}
	}
	return &req
}

func generateFile(t *testing.T, req *Request) string {
	t.Helper()
	for _, f := range generateFiles(t, req) {
		if f.Name == "models.sql.lgo" {
			return string(f.Contents)
		}
	}
	t.Fatalf("no models.sql.lgo in generated files")
	return ""
}

func queryFile(t *testing.T, req *Request, name string) string {
	t.Helper()
	for _, f := range generateFiles(t, req) {
		if f.Name == name {
			return string(f.Contents)
		}
	}
	t.Fatalf("no %s in generated files", name)
	return ""
}
func generateFiles(t *testing.T, req *Request) []File {
	t.Helper()
	model, files, err := Generate(req)
	_ = model
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return nil
	}
	return files
}

func structFields(t *testing.T, src string, name string) map[string]string {
	t.Helper()
	marker := "type " + name + " struct {"
	start := strings.Index(src, marker)
	if start < 0 {
		t.Fatalf("generated file has no %s", marker)
		return map[string]string{}
	}
	rest := src[start+len(marker):]
	end := strings.Index(rest, "\n}")
	if end < 0 {
		t.Fatalf("struct %s has no closing brace", name)
		return map[string]string{}
	}
	fields := map[string]string{}
	for _, line := range strings.Split(rest[:end], "\n") {
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		parts := strings.Fields(line)
		if len(parts) < 2 {
			t.Fatalf("unparseable field line %q", line)
			return map[string]string{}
		}
		fields[parts[0]] = parts[1]
	}
	return fields
}

func requireFields(t *testing.T, src string, name string, want []wantField) {
	t.Helper()
	got := structFields(t, src, name)
	for _, w := range want {
		typ, ok := got[w.goName]
		if !ok {
			t.Fatalf("%s.%s missing; fields = %v", name, w.goName, got)
			return
		}
		if typ != w.goType {
			t.Fatalf("%s.%s type = %q, want %q", name, w.goName, typ, w.goType)
			return
		}
	}
	for gname := range got {
		found := false
		for _, w := range want {
			if gname == w.goName {
				found = true
			}
		}
		if !found {
			t.Fatalf("%s.%s unexpected; fields = %v", name, gname, got)
			return
		}
	}
}

func itemFields(version string) []wantField {
	return []wantField{
		{"ID", "int64"},
		{"Note", "string?"},
		{"Name", "string"},
		{"CreatedAt", "time.Time"},
		{"Version", version},
	}
}

func TestGenerateItemsFixtures(t *testing.T) {
	cases := []struct {
		fixture string
		version string
	}{
		{"sqlite", "int64"},
		{"postgresql", "int32"},
		{"mysql", "int32"},
		{"mssql", "int32"},
	}
	for _, tc := range cases {
		t.Run(tc.fixture, func(t *testing.T) {
			req := loadRequest(t, tc.fixture)
			src := generateFile(t, req)
			if !strings.Contains(src, "// Code generated by sqlc-gen-spira. DO NOT EDIT.") {
				t.Fatal("missing generated-code marker")
				return
			}
			requireFields(t, src, "Items", itemFields(tc.version))
			if !strings.Contains(src, "func PrepareAll(ctx context.Context, p *db.Pool) error") {
				t.Fatal("models file holds no PrepareAll over *db.Pool")
			}
		})
	}
}

func TestGenerateTypesPostgresql(t *testing.T) {
	req := loadRequest(t, "types-postgresql")
	src := generateFile(t, req)
	want := []wantField{
		{"ID", "int64"},
		{"Mood", "PublicMood"},
		{"MaybeMood", "PublicMood?"},
		{"Flags", "bool"},
		{"Ratio", "float64?"},
		{"Price", "string"},
		{"Uid", "string"},
		{"Payload", "[]byte?"},
		{"Blob", "[]byte"},
		{"Day", "time.Time"},
		{"Stamp", "time.Time"},
		{"Small", "int16"},
		{"Medium", "int32?"},
		{"Big", "int64"},
		{"ShortTxt", "string"},
		{"FixedTxt", "string?"},
		{"RealNum", "float32"},
		{"Dbl", "float64"},
		{"F4", "float32?"},
		{"I8", "int64?"},
		{"I2", "int16?"},
		{"SerialCol", "int32?"},
		{"BigserialCol", "int64?"},
		{"Note", "string?"},
	}
	requireFields(t, src, "Things", want)
	for _, decl := range []string{
		"type PublicMood string",
		`const PublicMoodSad PublicMood = "sad"`,
		`const PublicMoodOk PublicMood = "ok"`,
		`const PublicMoodHappy PublicMood = "happy"`,
		"func (e PublicMood) Valid() bool",
	} {
		if !strings.Contains(src, decl) {
			t.Fatalf("generated file missing %q", decl)
			return
		}
	}
}

func patchRequest(t *testing.T, fixture string, mutate func(*Request)) *Request {
	t.Helper()
	req := loadRequest(t, fixture)
	mutate(req)
	return req
}

func pluginOptions(t *testing.T, opts map[string]any) []byte {
	t.Helper()
	raw, err := json.Marshal(opts)
	if err != nil {
		t.Fatal(err)
		return nil
	}
	return raw
}

func enumFixture(t *testing.T) *Request {
	items := Table{Rel: Identifier{Name: "items"}, Columns: []Column{
		{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "order_id", Length: -1, Type: Identifier{Name: "INTEGER"}},
	}}
	lines := Table{Rel: Identifier{Name: "order_lines"}, Columns: []Column{
		{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "order_id", Length: -1, Type: Identifier{Name: "INTEGER"}},
	}}
	req := loadRequest(t, "sqlite")
	req.Catalog.Schemas[0].Tables = []Table{items, lines}
	req.Queries = nil
	req.PluginOptions = pluginOptions(t, map[string]any{
		"tables": map[string]any{
			"items":       map[string]any{"type": "Item", "key": "id", "key_type": "ItemID"},
			"order_lines": map[string]any{"type": "OrderLine", "key": "id", "key_type": "OrderLineID"},
		},
		"refs": map[string]any{"order_lines.order_id": "items"},
	})
	return req
}

func TestKeyTypesAndRefs(t *testing.T) {
	src := generateFile(t, enumFixture(t))
	for _, decl := range []string{
		"type ItemID int64",
		"type OrderLineID int64",
		"type Item struct",
		"type OrderLine struct",
	} {
		if !strings.Contains(src, decl) {
			t.Fatalf("generated file missing %q\n%s", decl, src)
			return
		}
	}
	item := structFields(t, src, "Item")
	if (item["ID"] ?? "") != "ItemID" || (item["OrderID"] ?? "") != "int64?" {
		t.Fatalf("Item fields = %v", item)
		return
	}
	lines := structFields(t, src, "OrderLine")
	if (lines["ID"] ?? "") != "OrderLineID" || (lines["OrderID"] ?? "") != "int64?" {
		t.Fatalf("OrderLine fields = %v", lines)
	}
}

func TestNullableKeyColumnUsesUnderlyingOption(t *testing.T) {
	req := enumFixture(t)
	lineID := Column{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "order_lines"}}
	lineOwner := Column{Name: "order_id", NotNull: false, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "order_lines"}}
	kindCol := Column{Name: "kind", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}, Table: Identifier{Name: "order_lines"}}
	req.Queries = []Query{{
		Name: "GetLine", Cmd: ":one", Filename: "lines.sql",
		Text: "SELECT id, order_id FROM order_lines WHERE order_id = ? AND kind = ? AND id = ?",
		Columns: []Column{lineID, lineOwner},
		Params: []Parameter{
			{Number: 1, Column: lineOwner},
			{Number: 2, Column: kindCol},
			{Number: 3, Column: lineID},
		},
	}}
	model, _, err := Generate(req)
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return
	}
	found := findQuery(t, model, "GetLine")
	if found.RowGoType != "OrderLine" {
		t.Fatalf("GetLine row = %q, want the OrderLine table struct", found.RowGoType)
		return
	}
	if found.ArgsName != "GetLineArgs" {
		t.Fatalf("GetLine args = %q, want one GetLineArgs struct", found.ArgsName)
		return
	}
	if len(found.Params) != 3 || found.Params[0].GoName != "OrderID" || found.Params[0].GoType != "int64?" {
		t.Fatalf("GetLine params = %+v, want OrderID int64? first", found.Params)
		return
	}
	src := queryFile(t, req, "lines.sql.lgo")
	if !strings.Contains(src, "OrderID int64?") {
		t.Fatalf("Args struct holds no OrderID int64?:\n%s", src)
		return
	}
	if !strings.Contains(src, "func GetLine(ctx context.Context, q db.Querier, args GetLineArgs) (OrderLine?, error)") {
		t.Fatalf("query file holds no GetLine over OrderLine:\n%s", src)
	}
}

func TestKeyTypesAreDistinct(t *testing.T) {
	src := generateFile(t, enumFixture(t))
	for _, decl := range []string{
		"type ItemID int64",
		"type OrderLineID int64",
	} {
		if !strings.Contains(src, decl) {
			t.Fatalf("generated file missing %q", decl)
			return
		}
	}
	if strings.Count(src, "ItemID") < 3 || strings.Count(src, "OrderLineID") < 2 {
		t.Fatalf("key types are declared but never used:\n%s", src)
	}
}

func TestTableVarsPointAtGeneratedEntities(t *testing.T) {
	src := generateFile(t, enumFixture(t))
	for _, decl := range []string{
		`var ItemTable = orm.Table[Item, ItemID]{Name: "items", Key: "id", Version: ""}`,
		`var OrderLineTable = orm.Table[OrderLine, OrderLineID]{Name: "order_lines", Key: "id", Version: ""}`,
		`"github.com/gosuda/spira/orm"`,
	} {
		if !strings.Contains(src, decl) {
			t.Fatalf("generated file missing %q\n%s", decl, src)
			return
		}
	}
}

func TestGenerateErrors(t *testing.T) {
	cases := []struct {
		name    string
		fixture string
		mutate  func(*Request)
		want    string
	}{
		{"unmapped type", "sqlite", func(r *Request) {
			r.Catalog.Schemas[0].Tables[0].Columns[0].Type.Name = "GEOMETRY"
		}, "unmapped type"},
		{"array column", "sqlite", func(r *Request) {
			r.Catalog.Schemas[0].Tables[0].Columns[1].IsArray = true
		}, "is an array"},
		{"unsigned mysql", "mysql", func(r *Request) {
			r.Catalog.Schemas[0].Tables[0].Columns[0].Unsigned = true
		}, "unsigned"},
		{"unknown engine", "sqlite", func(r *Request) {
			r.Settings.Engine = "oracle"
		}, "unknown engine"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			req := patchRequest(t, tc.fixture, tc.mutate)
			_, _, err := Generate(req)
			if err == nil {
				t.Fatalf("Generate succeeded; want error containing %q", tc.want)
				return
			}
			if !strings.Contains(err.Error(), tc.want) {
				t.Fatalf("error = %v, want substring %q", err, tc.want)
			}
		})
	}
}

func TestGenerateJSONRoundTrip(t *testing.T) {
	req := loadRequest(t, "sqlite")
	raw, err := json.Marshal(req)
	if err != nil {
		t.Fatal(err)
		return
	}
	var resp Response
	if out, gerr := GenerateJSON(raw); gerr != nil {
		t.Fatalf("GenerateJSON: %v", gerr)
		return
	} else {
		if uerr := json.Unmarshal(out, &resp); uerr != nil {
			t.Fatalf("decode response: %v", uerr)
			return
		}
	}
	if len(resp.Files) != 2 {
		t.Fatalf("response files = %d, want models plus one query file", len(resp.Files))
		return
	}
	var probe struct {
		Files []struct {
			Contents []byte `json:"contents"`
		} `json:"files"`
	}
	if out, gerr := GenerateJSON(raw); gerr != nil {
		t.Fatalf("GenerateJSON second pass: %v", gerr)
		return
	} else {
		if uerr := json.Unmarshal(out, &probe); uerr != nil {
			t.Fatal(uerr)
			return
		}
	}
	contents := string(probe.Files[0].Contents)
	if !strings.Contains(contents, "type Items struct") {
		t.Fatalf("contents missing Items struct:\n%s", contents)
	}
}

func TestPostgresSkipsSystemSchemas(t *testing.T) {
	req := loadRequest(t, "postgresql")
	src := generateFile(t, req)
	for _, banned := range []string{"PgCatalog", "PgAttribute", "InformationSchema"} {
		if strings.Contains(src, banned) {
			t.Fatalf("generated file contains system schema type %s", banned)
			return
		}
	}
}

var logosKeywords = []string{
	"break", "case", "chan", "const", "continue", "default", "defer",
	"else", "fallthrough", "for", "func", "go", "goto", "if", "import",
	"interface", "map", "package", "range", "return", "select", "struct",
	"switch", "type", "var",
	"errdefer", "group", "scope", "yield",
}

func TestDigitNamesGetXPrefixed(t *testing.T) {
	req := loadRequest(t, "sqlite")
	req.Queries = nil
	table := &req.Catalog.Schemas[0].Tables[0]
	table.Rel.Name = "2_items"
	table.Columns = []Column{
		{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}},
		{Name: "2fa", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}},
	}
	src := generateFile(t, req)
	if !strings.Contains(src, "type X2Items struct") {
		t.Fatalf("table 2_items did not produce struct X2Items:\n%s", src)
		return
	}
	fields := structFields(t, src, "X2Items")
	if (fields["X2Fa"] ?? "") != "string" {
		t.Fatalf("column 2fa produced field %v, want X2Fa string", fields)
		return
	}
	if strings.Contains(src, "_2") {
		t.Fatalf("digit name kept underscore prefix:\n%s", src)
	}
}

func TestKeywordColumnNamesBuild(t *testing.T) {
	req := loadRequest(t, "sqlite")
	req.Queries = nil
	table := &req.Catalog.Schemas[0].Tables[0]
	table.Rel.Name = "kw"
	table.Columns = nil
	for _, kw := range logosKeywords {
		table.Columns = append(table.Columns, Column{Name: kw, NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}})
	}
	src := generateFile(t, req)
	fields := structFields(t, src, "Kw")
	for _, kw := range logosKeywords {
		want := strings.ToUpper(kw[:1]) + kw[1:]
		if _, ok := fields[want]; !ok {
			t.Fatalf("column %q did not produce field %s; fields = %v", kw, want, fields)
			return
		}
	}
}

func TestColumnCollisionNamesBothColumns(t *testing.T) {
	req := loadRequest(t, "sqlite")
	req.Queries = nil
	table := &req.Catalog.Schemas[0].Tables[0]
	table.Columns = []Column{
		{Name: "order_id", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}},
		{Name: "order-id", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}},
	}
	_, _, err := Generate(req)
	if err == nil {
		t.Fatal("Generate succeeded; want column collision error")
		return
	}
	want := `main.items: columns "order_id" and "order-id" both map to field OrderID`
	if !strings.Contains(err.Error(), want) {
		t.Fatalf("error = %v, want substring %q", err, want)
	}
}

func TestTableTypeCollisionNamesBothTables(t *testing.T) {
	req := loadRequest(t, "sqlite")
	req.Queries = nil
	items := req.Catalog.Schemas[0].Tables[0]
	req.Catalog.Schemas = append(req.Catalog.Schemas, Schema{Name: "audit", Tables: []Table{items}})
	_, _, err := Generate(req)
	if err == nil {
		t.Fatal("Generate succeeded; want table type collision error")
		return
	}
	want := `tables "main.items" and "audit.items" both map to type Items`
	if !strings.Contains(err.Error(), want) {
		t.Fatalf("error = %v, want substring %q", err, want)
	}
}

func TestRefsShapeError(t *testing.T) {
	req := enumFixture(t)
	req.PluginOptions = pluginOptions(t, map[string]any{
		"tables": map[string]any{
			"items":       map[string]any{"key": "id", "key_type": "ItemID"},
			"order_lines": map[string]any{"key": "id", "key_type": "OrderLineID"},
		},
		"refs": map[string]any{"order_lines": "items"},
	})
	_, _, err := Generate(req)
	if err == nil {
		t.Fatal("Generate succeeded; want refs shape error")
		return
	}
	want := `refs: "order_lines" is not table.column`
	if !strings.Contains(err.Error(), want) {
		t.Fatalf("error = %v, want substring %q", err, want)
	}
}

func TestRefsMissingNames(t *testing.T) {
	t.Run("missing target table", func(t *testing.T) {
		req := enumFixture(t)
		req.PluginOptions = pluginOptions(t, map[string]any{
			"tables": map[string]any{
				"items":       map[string]any{"key": "id", "key_type": "ItemID"},
				"order_lines": map[string]any{"key": "id", "key_type": "OrderLineID"},
			},
			"refs": map[string]any{"order_lines.order_id": "ghosts"},
		})
		_, _, err := Generate(req)
		if err == nil {
			t.Fatal("Generate succeeded; want missing table error")
			return
		}
		if !strings.Contains(err.Error(), `table "ghosts" is not in the catalog`) {
			t.Fatalf("error = %v, want it to name ghosts", err)
		}
	})
	t.Run("missing source column", func(t *testing.T) {
		req := enumFixture(t)
		req.PluginOptions = pluginOptions(t, map[string]any{
			"tables": map[string]any{
				"items":       map[string]any{"key": "id", "key_type": "ItemID"},
				"order_lines": map[string]any{"key": "id", "key_type": "OrderLineID"},
			},
			"refs": map[string]any{"order_lines.ghost": "items"},
		})
		_, _, err := Generate(req)
		if err == nil {
			t.Fatal("Generate succeeded; want missing column error")
			return
		}
		if !strings.Contains(err.Error(), `"ghost"`) {
			t.Fatalf("error = %v, want it to name ghost", err)
		}
	})
}

func TestAmbiguousTableName(t *testing.T) {
	req := loadRequest(t, "sqlite")
	req.Queries = nil
	items := req.Catalog.Schemas[0].Tables[0]
	req.Catalog.Schemas = append(req.Catalog.Schemas, Schema{Name: "audit", Tables: []Table{items}})
	req.PluginOptions = pluginOptions(t, map[string]any{
		"tables": map[string]any{"items": map[string]any{"key": "id"}},
	})
	_, _, err := Generate(req)
	if err == nil {
		t.Fatal("Generate succeeded; want ambiguity error")
		return
	}
	want := `table "items" is ambiguous: schemas audit, main`
	if !strings.Contains(err.Error(), want) {
		t.Fatalf("error = %v, want substring %q", err, want)
	}
}

func TestUnknownOptionKey(t *testing.T) {
	t.Run("top level", func(t *testing.T) {
		req := loadRequest(t, "sqlite")
		req.PluginOptions = pluginOptions(t, map[string]any{"packages": "x"})
		_, _, err := Generate(req)
		if err == nil {
			t.Fatal("Generate succeeded; want unknown option key error")
			return
		}
		msg := err.Error()
		if !strings.Contains(msg, "packages") {
			t.Fatalf("error = %v, want it to name packages", err)
		}
		if !strings.Contains(msg, "sqlc-gen-spira: options: ") {
			t.Fatalf("error = %v, want sqlc-gen-spira: options: wrap", err)
		}
	})
	t.Run("inside tables entry", func(t *testing.T) {
		req := loadRequest(t, "sqlite")
		req.PluginOptions = pluginOptions(t, map[string]any{
			"tables": map[string]any{"items": map[string]any{"kye": "id"}},
		})
		_, _, err := Generate(req)
		if err == nil {
			t.Fatal("Generate succeeded; want unknown option key error")
			return
		}
		if !strings.Contains(err.Error(), "kye") {
			t.Fatalf("error = %v, want it to name kye", err)
		}
	})
	t.Run("malformed json", func(t *testing.T) {
		req := loadRequest(t, "sqlite")
		req.PluginOptions = []byte("{broken")
		_, _, err := Generate(req)
		if err == nil {
			t.Fatal("Generate succeeded; want decode error")
			return
		}
		if !strings.Contains(err.Error(), "sqlc-gen-spira: options: ") {
			t.Fatalf("error = %v, want sqlc-gen-spira: options: wrap", err)
		}
	})
}

func TestDeterministicModels(t *testing.T) {
	req := enumFixture(t)
	first := generateFile(t, req)
	again := generateFile(t, req)
	if first != again {
		t.Fatal("same request generated different bytes")
		return
	}
	for i := range req.Catalog.Schemas {
		tables := req.Catalog.Schemas[i].Tables
		for l, r := 0, len(tables)-1; l < r; l, r = l+1, r-1 {
			tables[l], tables[r] = tables[r], tables[l]
		}
	}
	permuted := generateFile(t, req)
	if permuted != first {
		t.Fatal("table order changed generated bytes")
	}
}

func TestMethodOK(t *testing.T) {
	if !methodOK("generate") {
		t.Fatal("manual generate argument rejected")
		return
	}
	if !methodOK("/plugin.CodegenService/Generate") {
		t.Fatal("sqlc grpc method path rejected")
		return
	}
	if methodOK("Generate") {
		t.Fatal("bare Generate accepted; only the full method path is valid")
		return
	}
	if methodOK("") {
		t.Fatal("empty argument accepted")
		return
	}
}

func findQuery(t *testing.T, m Model, name string) QueryDef {
	t.Helper()
	for i := range m.Queries {
		if m.Queries[i].Name == name {
			return m.Queries[i]
		}
	}
	t.Fatalf("query %s not in model", name)
	return QueryDef{}
}

func fileNames(files []File) []string {
	var out []string
	for _, f := range files {
		out = append(out, f.Name)
	}
	return out
}

func hasFile(files []File, name string) bool {
	for _, f := range files {
		if f.Name == name {
			return true
		}
	}
	return false
}
type engineCase struct {
	fixture string
	engine  string
	getArg  string
	getType string
	args    []wantField
}

func TestEngineQueryModels(t *testing.T) {
	cases := []engineCase{
		{"sqlite", "sqlite", "ID", "int64", []wantField{{"Name", "string"}, {"ID", "int64"}, {"Version", "int64"}}},
		{"postgresql", "postgresql", "ID", "int64", []wantField{{"Name", "string"}, {"ID", "int64"}, {"Version", "int32"}}},
		{"mysql", "mysql", "ID", "int64", []wantField{{"Name", "string"}, {"ID", "int64"}, {"Version", "int32"}}},
		{"mssql", "mssql", "P1", "int64", []wantField{{"P1", "string"}, {"P2", "int64"}, {"P3", "int32"}}},
	}
	for _, tc := range cases {
		t.Run(tc.fixture, func(t *testing.T) {
			checkEngineCase(t, tc)
		})
	}
}

func checkEngineCase(t *testing.T, tc engineCase) {
	t.Helper()
	req := loadRequest(t, tc.fixture)
	model, files, err := Generate(req)
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return
	}
	if model.Engine != tc.engine {
		t.Fatalf("engine = %q, want %q", model.Engine, tc.engine)
		return
	}
	get := findQuery(t, model, "GetItem")
	if get.Cmd != ":one" {
		t.Fatalf("GetItem cmd = %q, want :one", get.Cmd)
		return
	}
	if get.RowGoType != "Items" {
		t.Fatalf("GetItem row = %q, want the Items table struct", get.RowGoType)
		return
	}
	if len(get.Params) != 1 || get.Params[0].GoName != tc.getArg || get.Params[0].GoType != tc.getType {
		t.Fatalf("GetItem params = %+v, want one %s %s", get.Params, tc.getArg, tc.getType)
		return
	}
	update := findQuery(t, model, "UpdateItem")
	if update.Cmd != ":exec" {
		t.Fatalf("UpdateItem cmd = %q, want :exec", update.Cmd)
		return
	}
	if update.ArgsName != "UpdateItemArgs" {
		t.Fatalf("UpdateItem args = %q, want one UpdateItemArgs struct", update.ArgsName)
		return
	}
	for i, want := range tc.args {
		got := update.Params[i]
		if got.GoName != want.goName || got.GoType != want.goType {
			t.Fatalf("UpdateItem param %d = %s %s, want %s %s", i, got.GoName, got.GoType, want.goName, want.goType)
			return
		}
	}
	checkEngineFiles(t, tc, req, files)
}

func checkEngineFiles(t *testing.T, tc engineCase, req *Request, files []File) {
	t.Helper()
	if !hasFile(files, "models.sql.lgo") || !hasFile(files, "items.sql.lgo") {
		t.Fatalf("files = %v, want models.sql.lgo and items.sql.lgo", fileNames(files))
		return
	}
	queries := queryFile(t, req, "items.sql.lgo")
	sig := "func GetItem(ctx context.Context, q db.Querier, " + tc.getArg + " " + tc.getType + ") (Items?, error)"
	if !strings.Contains(queries, sig) {
		t.Fatalf("query file holds no %q:\n%s", sig, queries)
		return
	}
	if !strings.Contains(queries, "func UpdateItem(ctx context.Context, q db.Querier, args UpdateItemArgs) error") {
		t.Fatalf("query file holds no UpdateItem with UpdateItemArgs:\n%s", queries)
		return
	}
	models := generateFile(t, req)
	for _, want := range []string{"PrepareAll: GetItem", "PrepareAll: UpdateItem", "p.Prepare(ctx, GetItemQuery)"} {
		if !strings.Contains(models, want) {
			t.Fatalf("models file holds no %q:\n%s", want, models)
			return
		}
	}
}

func versionedFixture(t *testing.T) *Request {
	t.Helper()
	req := loadRequest(t, "sqlite")
	req.PluginOptions = pluginOptions(t, map[string]any{
		"tables": map[string]any{
			"items": map[string]any{"type": "Item", "key": "id", "key_type": "ItemID", "version": "version"},
		},
	})
	nameCol := Column{Name: "name", NotNull: true, Length: -1, Type: Identifier{Name: "TEXT"}, Table: Identifier{Name: "items"}}
	idCol := Column{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}}
	req.Queries = []Query{
		{
			Name: "GoodUpdate", Cmd: ":exec", Filename: "items.sql",
			Text:   "UPDATE items SET name = ?, version = version + 1 WHERE id = ?",
			Params: []Parameter{{Number: 1, Column: nameCol}, {Number: 2, Column: idCol}},
		},
		{
			Name: "BadUpdate", Cmd: ":exec", Filename: "items.sql",
			Text:   "UPDATE items SET name = ? WHERE id = ?",
			Params: []Parameter{{Number: 1, Column: nameCol}, {Number: 2, Column: idCol}},
		},
	}
	return req
}

func TestVersionedWriteRefused(t *testing.T) {
	_, _, err := Generate(versionedFixture(t))
	if err == nil {
		t.Fatal("Generate succeeded; want the version refusal for BadUpdate")
		return
	}
	want := "BadUpdate: writes versioned table items without version"
	if !strings.Contains(err.Error(), want) {
		t.Fatalf("error = %v, want substring %q", err, want)
	}
}

func TestUnsupportedCommand(t *testing.T) {
	for _, cmd := range []string{":execresult", ":copyfrom", ":batchmany"} {
		req := patchRequest(t, "sqlite", func(r *Request) {
			r.Queries = []Query{{
				Name: "Bulk", Cmd: cmd, Filename: "items.sql",
				Text: "SELECT id FROM items",
				Columns: []Column{
					{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}},
				},
			}}
		})
		_, _, err := Generate(req)
		if err == nil {
			t.Fatalf("Generate succeeded for %s; want the unsupported command error", cmd)
			return
		}
		want := "Bulk: command " + cmd + " is not supported"
		if !strings.Contains(err.Error(), want) {
			t.Fatalf("error = %v, want substring %q", err, want)
		}
	}
}

func TestUnnamedOutputColumn(t *testing.T) {
	req := patchRequest(t, "sqlite", func(r *Request) {
		r.Queries = []Query{{
			Name: "CountThings", Cmd: ":one", Filename: "items.sql",
			Text: "SELECT id, COUNT(*) FROM items",
			Columns: []Column{
				{Name: "id", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}},
				{Name: "", NotNull: true, Length: -1, Type: Identifier{Name: "INTEGER"}, Table: Identifier{Name: "items"}},
			},
		}}
	})
	_, _, err := Generate(req)
	if err == nil {
		t.Fatal("Generate succeeded; want the missing alias error")
		return
	}
	if !strings.Contains(err.Error(), "CountThings: column 1 needs an alias") {
		t.Fatalf("error = %v, want it to name the query and column 1", err)
	}
}

