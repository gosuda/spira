	}
	if !strings.Contains(err.Error(), `slice marker "ids" has no slice parameter`) {
		t.Fatalf("error = %v, want it to name the ids marker", err)
	}
}

func TestOverridesNormalizeCase(t *testing.T) {
	req := patchRequest(t, "sqlite", func(r *Request) {
		r.Queries = nil
	})
	req.PluginOptions = pluginOptions(t, map[string]any{
		"overrides": map[string]any{"INTEGER": "ItemCode"},
	})
	model, _, err := Generate(req)
	if err != nil {
		t.Fatalf("Generate: %v", err)
		return
	}
	if len(model.Entities) != 1 || len(model.Entities[0].Fields) == 0 {
		t.Fatalf("model holds no entity fields: %+v", model.Entities)
		return
	}
	if got := model.Entities[0].Fields[0].GoType; got != "ItemCode" {
		t.Fatalf("id type = %q, want the ItemCode override to win", got)
	}
}

