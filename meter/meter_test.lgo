func TestEscapesLabelValues(t *testing.T) {
	reg := meter.NewRegistry()
	counter := reg.Counter("c", "help", "path")
	counter.With("a\"b\\c\nd").Add(1)
	text := exposition(t, reg)
	if !strings.Contains(text, `path="a\"b\\c\nd"`) {
		t.Fatalf("label value not escaped as expected, got %q", text)
	}
}

func TestContentType(t *testing.T) {
	reg := meter.NewRegistry()
	req := httptest.NewRequest("GET", "/metrics", nil)
	rec := httptest.NewRecorder()
	reg.Handler().ServeHTTP(rec, req)
	ct := rec.Result().Header.Get("Content-Type")
	if ct != "text/plain; version=0.0.4; charset=utf-8" {
		t.Fatalf("Content-Type = %q", ct)
	}
}

