package resilience_test

import (
	"context"
	"errors"
	"fmt"
	"sync/atomic"
	"testing"
	"time"

	"github.com/gosuda/spira/fault"
	"github.com/gosuda/spira/fault/faulttest"
	"github.com/gosuda/spira/resilience"
)

var boom = errors.New("resilience test: boom")

type testClock struct{ nanos atomic.Int64 }

func (c *testClock) Now() time.Time {
	return time.Unix(0, c.nanos.Load())
}

func (c *testClock) Advance(d time.Duration) {
	c.nanos.Add(int64(d))
}

func failing(context.Context) (int, error) {
	return 0, boom
}

func succeeding(context.Context) (int, error) {
	return 7, nil
}

type step struct {
	advance  time.Duration
	fail     bool
	wantOpen bool
	want     string
}

type runner struct {
	clk   *testClock
	pol   resilience.Policy
	calls atomic.Int64
}

func (r *runner) run(t *testing.T, s step) {
	t.Helper()
	r.clk.Advance(s.advance)
	before := r.calls.Load()
	value, err := resilience.Do(t.Context(), r.pol, func(ctx context.Context) (int, error) {
		r.calls.Add(1)
		if s.fail {
			return 0, boom
		}
		return 7, nil
	})
	took := r.calls.Load() - before
	if err == nil {
		if took != 1 {
			t.Fatalf("%s: %d calls, want 1", s.want, took)
		}
		if s.fail {
			t.Fatalf("%s: err=nil, want boom", s.want)
		}
		if value != 7 {
			t.Fatalf("%s: value=%d, want 7", s.want, value)
		}
		return
	}
	if s.fail {
		if !errors.Is(err, boom) || took != 1 {
			t.Fatalf("%s: err=%v calls=%d, want boom after one call", s.want, err, took)
		}
		return
	}
	if !errors.Is(err, resilience.ErrCircuitOpen) || took != 0 {
		t.Fatalf("%s: err=%v calls=%d, want ErrCircuitOpen with no call", s.want, err, took)
	}
}

func TestBreakerTransitionsFollowTheTable(t *testing.T) {
	clk := &testClock{}
	r := &runner{
		clk: clk,
		pol: resilience.Policy{
			Timeout: time.Second,
			Breaker: &resilience.Breaker{Window: 2, FailureRate: 0.5, OpenFor: time.Second, Now: clk.Now},
		},
	}
	steps := []step{
		{fail: true, want: "closed after fewer than Window failures"},
		{fail: true, want: "the call that fills the window at the rate trips"},
		{wantOpen: true, want: "open rejects without a call"},
		{advance: time.Second, want: "half-open after OpenFor admits a good probe and closes"},
		{fail: true, want: "cleared window keeps one failure closed"},
		{fail: true, want: "a refilled window trips again"},
		{wantOpen: true, want: "open again rejects without a call"},
		{advance: time.Second, fail: true, want: "a failed probe opens again"},
		{wantOpen: true, want: "open after a failed probe rejects without a call"},
		{advance: 999 * time.Millisecond, wantOpen: true, want: "OpenFor not reached still rejects"},
		{advance: time.Millisecond, want: "exactly OpenFor admits a good probe and closes"},
		{fail: true, want: "the window cleared on close keeps one failure closed"},
	}
	for _, s := range steps {
		r.run(t, s)
	}
}

func TestBreakerOpensWhenFullWindowReachesRate(t *testing.T) {
	clk := &testClock{}
	r := &runner{
		clk: clk,
		pol: resilience.Policy{
			Timeout: time.Second,
			Breaker: &resilience.Breaker{Window: 4, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now},
		},
	}
	r.run(t, step{fail: true, want: "one failure in a four-wide window stays closed"})
	r.run(t, step{want: "a success keeps the share below the rate"})
	r.run(t, step{fail: true, want: "two failures out of three stay closed"})
	r.run(t, step{want: "the fourth call fills the window at half failures and trips"})
	r.run(t, step{wantOpen: true, want: "a full window at the rate rejects"})
}

func TestHalfOpenAdmitsExactlyOneProbe(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 2, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	pol := resilience.Policy{Timeout: time.Second, Breaker: brk}
	ctx := t.Context()
	for range 2 {
		if _, err := resilience.Do(ctx, pol, failing); !errors.Is(err, boom) {
			t.Fatalf("warm-up err = %v, want boom", err)
		}
	}
	clk.Advance(time.Hour)
	probeErr, rejected := probeWhileOthersCall(ctx, pol, 16)
	if probeErr != nil {
		t.Fatalf("probe error = %v, want nil", probeErr)
	}
	if rejected != 16 {
		t.Fatalf("rejected = %d, want 16 concurrent ErrCircuitOpen during the probe", rejected)
	}
	if _, err := resilience.Do(t.Context(), pol, succeeding); err != nil {
		t.Fatalf("after a good probe: %v, want the breaker closed", err)
	}
}

func probeWhileOthersCall(ctx context.Context, pol resilience.Policy, callers int) (error, int) {
	admitted := make(chan struct{})
	gate := make(chan struct{})
	release := make(chan struct{})
	drained := make(chan struct{})
	probeResult := make(chan error, 1)
	var rejected atomic.Int64
	var drainedOnce atomic.Bool
	if err := func() error {
		go group (ctx) {
			go {
				_, err := resilience.Do(ctx, pol, func(c context.Context) (int, error) {
					close(admitted)
					<-release
					return 7, nil
				})
				probeResult <- err
			}
			go {
				<-admitted
				close(gate)
			}
			for range callers {
				go {
					<-gate
					_, err := resilience.Do(ctx, pol, failing)
					if errors.Is(err, resilience.ErrCircuitOpen) {
						rejected.Add(1)
					}
					if rejected.Load() == int64(callers) && drainedOnce.CompareAndSwap(false, true) {
						close(drained)
					}
				}
			}
			go {
				<-drained
				close(release)
			}
		}
		return nil
	}(); err != nil {
		return err, 0
	}
	return <-probeResult, int(rejected.Load())
}

func TestBreakerSharedByPointerAcrossPolicies(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	first := resilience.Policy{Timeout: time.Second, Breaker: brk}
	second := resilience.Policy{Timeout: 2 * time.Second, Breaker: brk}
	if _, err := resilience.Do(t.Context(), first, failing); !errors.Is(err, boom) {
		t.Fatalf("first policy err = %v, want boom", err)
	}
	var calls atomic.Int64
	call := func(ctx context.Context) (int, error) {
		calls.Add(1)
		return 7, nil
	}
	if _, err := resilience.Do(t.Context(), second, call); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("second policy err = %v, want ErrCircuitOpen from the shared breaker", err)
	}
	if calls.Load() != 0 {
		t.Fatalf("calls = %d, want 0 while open", calls.Load())
	}
}

func TestDoRetriesUntilAttemptsExhausted(t *testing.T) {
	var calls atomic.Int64
	call := func(ctx context.Context) (int, error) {
		calls.Add(1)
		return 0, boom
	}
	pol := resilience.Policy{
		Timeout: time.Second,
		Retry:   resilience.Retry{Attempts: 4, Base: 5 * time.Millisecond, Max: 10 * time.Millisecond},
	}
	start := time.Now()
	_, err := resilience.Do(t.Context(), pol, call)
	if !errors.Is(err, boom) || errors.Is(err, context.Canceled) {
		t.Fatalf("err = %v, want the last call error alone", err)
	}
	if calls.Load() != 4 {
		t.Fatalf("calls = %d, want 4 attempts", calls.Load())
	}
	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
		t.Fatalf("elapsed = %v, want sleeps bounded by Max", elapsed)
	}
}

func TestDoReturnsTheFirstSuccess(t *testing.T) {
	var calls atomic.Int64
	call := func(ctx context.Context) (int, error) {
		n := calls.Add(1)
		if n < 3 {
			return 0, boom
		}
		return int(n), nil
	}
	pol := resilience.Policy{
		Timeout: time.Second,
		Retry:   resilience.Retry{Attempts: 3, Base: time.Millisecond, Max: 2 * time.Millisecond},
	}
	value, err := resilience.Do(t.Context(), pol, call)
	if err == nil {
		if value != 3 || calls.Load() != 3 {
			t.Fatalf("value = %d calls = %d, want 3 and 3", value, calls.Load())
		}
		return
	}
	t.Fatalf("err = %v, want nil", err)
}

func TestDoStopsRetryingAfterErrCircuitOpen(t *testing.T) {
	var calls atomic.Int64
	call := func(ctx context.Context) (int, error) {
		calls.Add(1)
		return 0, boom
	}
	pol := resilience.Policy{
		Timeout: time.Second,
		Retry:   resilience.Retry{Attempts: 5, Base: time.Millisecond, Max: 2 * time.Millisecond},
		Breaker: &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour},
	}
	_, err := resilience.Do(t.Context(), pol, call)
	if !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("err = %v, want ErrCircuitOpen", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1: one failing attempt trips the breaker and no retry runs", calls.Load())
	}
	pol.Retry = resilience.Retry{Attempts: 5, Base: time.Hour, Max: time.Hour}
	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
	defer cancel()
	_, err = resilience.Do(ctx, pol, call)
	if !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("refused call err = %v, want ErrCircuitOpen", err)
	}
	if errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("refused call err = %v: a backoff started after ErrCircuitOpen", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1: a refused call must not run", calls.Load())
	}
}

func TestBackoffStopsWhenContextEnds(t *testing.T) {
	ctx, cancel := context.WithCancel(t.Context())
	defer cancel()
	var calls atomic.Int64
	call := func(c context.Context) (int, error) {
		calls.Add(1)
		cancel()
		return 0, boom
	}
	pol := resilience.Policy{
		Timeout: time.Second,
		Retry:   resilience.Retry{Attempts: 6, Base: time.Second, Max: time.Second},
	}
	start := time.Now()
	_, err := resilience.Do(ctx, pol, call)
	if !errors.Is(err, boom) || !errors.Is(err, context.Canceled) {
		t.Fatalf("err = %v, want the call error joined with context.Canceled", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1", calls.Load())
	}
	if elapsed := time.Since(start); elapsed > 100*time.Millisecond {
		t.Fatalf("elapsed = %v, want no sleep after the context ended", elapsed)
	}
}

func TestCallerCancellationIsNotCountedAsFailure(t *testing.T) {
	var calls atomic.Int64
	brk := &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour}
	pol := resilience.Policy{Timeout: time.Second, Breaker: brk}
	ctx, cancel := context.WithCancel(t.Context())
	cancel()
	call := func(c context.Context) (int, error) {
		calls.Add(1)
		if c.Err() != nil {
			return 0, c.Err()
		}
		return 0, boom
	}
	if _, err := resilience.Do(ctx, pol, call); !errors.Is(err, context.Canceled) {
		t.Fatalf("canceled call err = %v, want context.Canceled", err)
	}
	if _, err := resilience.Do(t.Context(), pol, call); !errors.Is(err, boom) {
		t.Fatalf("second call err = %v, want boom: the breaker must still admit", err)
	}
	if calls.Load() != 2 {
		t.Fatalf("calls = %d, want 2: cancellation must not trip the breaker", calls.Load())
	}
	if _, err := resilience.Do(t.Context(), pol, call); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("third call err = %v, want ErrCircuitOpen after one real failure", err)
	}
	if calls.Load() != 2 {
		t.Fatalf("calls = %d, want 2", calls.Load())
	}
}

func TestCancelledProbeReleasesTheSlot(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 2, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	pol := resilience.Policy{Timeout: time.Second, Breaker: brk}
	ctx, cancel := context.WithCancel(t.Context())
	defer cancel()
	for range 2 {
		if _, err := resilience.Do(ctx, pol, failing); !errors.Is(err, boom) {
			t.Fatalf("warm-up err = %v, want boom", err)
		}
	}
	clk.Advance(time.Hour)
	var calls atomic.Int64
	probeCtx, stopProbe := context.WithCancel(ctx)
	defer stopProbe()
	probe := func(c context.Context) (int, error) {
		n := calls.Add(1)
		if n == 1 {
			stopProbe()
			<-c.Done()
			return 0, c.Err()
		}
		return 7, nil
	}
	if _, err := resilience.Do(probeCtx, pol, probe); !errors.Is(err, context.Canceled) {
		t.Fatalf("cancelled probe err = %v, want context.Canceled", err)
	}
	if _, err := resilience.Do(ctx, pol, probe); err != nil {
		t.Fatalf("next call err = %v, want the slot released for a new probe", err)
	}
	if calls.Load() != 2 {
		t.Fatalf("calls = %d, want 2: the second call must be admitted as the probe", calls.Load())
	}
	for range 2 {
		if _, err := resilience.Do(ctx, pol, failing); !errors.Is(err, boom) {
			t.Fatalf("post-close failure err = %v, want boom", err)
		}
	}
	if _, err := resilience.Do(ctx, pol, succeeding); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("err = %v, want ErrCircuitOpen: the window refilled after the close", err)
	}
}

func TestIgnoredErrorEndsRetriesAndReturnsItsCause(t *testing.T) {
	var calls atomic.Int64
	pol := resilience.Policy{Timeout: time.Second, Retry: resilience.Retry{Attempts: 3, Base: time.Millisecond, Max: 2 * time.Millisecond}}
	_, err := resilience.Do(t.Context(), pol, func(context.Context) (int, error) {
		calls.Add(1)
		return 0, resilience.Ignored(boom)
	})
	if err != boom {
		t.Fatalf("err = %v, want the wrapped cause itself", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1: an ignored error is final", calls.Load())
	}
}

func TestIgnoredErrorJoinsContextErrorWhenCallerAlreadyEnded(t *testing.T) {
	ctx, cancel := context.WithCancel(t.Context())
	cancel()
	var calls atomic.Int64
	pol := resilience.Policy{Timeout: time.Second, Retry: resilience.Retry{Attempts: 3, Base: time.Millisecond, Max: 2 * time.Millisecond}}
	_, err := resilience.Do(ctx, pol, func(context.Context) (int, error) {
		calls.Add(1)
		return 0, resilience.Ignored(boom)
	})
	if !errors.Is(err, boom) {
		t.Fatalf("err = %v, want boom in the join", err)
		return
	}
	if !errors.Is(err, context.Canceled) {
		t.Fatalf("err = %v, want the join of boom and context.Canceled", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1: an ignored error is final even after cancellation", calls.Load())
	}
}

func ignoring(context.Context) (int, error) {
	return 0, resilience.Ignored(boom)
}

func TestIgnoredErrorIsNoResultInTheWindow(t *testing.T) {
	brk := &resilience.Breaker{Window: 3, FailureRate: 0.5, OpenFor: time.Hour}
	pol := resilience.Policy{Timeout: time.Second, Breaker: brk}
	for _, call := range []func(context.Context) (int, error){failing, failing, ignoring} {
		if _, err := resilience.Do(t.Context(), pol, call); !errors.Is(err, boom) {
			t.Fatalf("err = %v, want boom", err)
		}
	}
	if _, err := resilience.Do(t.Context(), pol, failing); !errors.Is(err, boom) {
		t.Fatalf("err = %v, want boom: two failures and an ignored error must not fill a window of three", err)
	}
	if _, err := resilience.Do(t.Context(), pol, succeeding); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("err = %v, want ErrCircuitOpen after the third failure", err)
	}
}

func TestIgnoredProbeLeavesTheBreakerHalfOpen(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 2, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	pol := resilience.Policy{Timeout: time.Second, Breaker: brk}
	for range 2 {
		if _, err := resilience.Do(t.Context(), pol, failing); !errors.Is(err, boom) {
			t.Fatalf("warm-up err = %v, want boom", err)
		}
	}
	clk.Advance(time.Hour)
	if _, err := resilience.Do(t.Context(), pol, ignoring); !errors.Is(err, boom) {
		t.Fatalf("ignored probe err = %v, want boom", err)
	}
	if _, err := resilience.Do(t.Context(), pol, failing); !errors.Is(err, boom) {
		t.Fatalf("next call err = %v, want boom: the ignored probe must release its slot", err)
	}
	if _, err := resilience.Do(t.Context(), pol, succeeding); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("err = %v, want ErrCircuitOpen: the failed probe opens the breaker, so the ignored probe did not close it", err)
	}
}

func TestAttemptTimeoutCountsAsFailure(t *testing.T) {
	var calls atomic.Int64
	brk := &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour}
	pol := resilience.Policy{Timeout: 5 * time.Millisecond, Breaker: brk}
	call := func(ctx context.Context) (int, error) {
		calls.Add(1)
		<-ctx.Done()
		return 0, ctx.Err()
	}
	if _, err := resilience.Do(t.Context(), pol, call); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("timed attempt err = %v, want context.DeadlineExceeded", err)
	}
	if _, err := resilience.Do(t.Context(), pol, call); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("second call err = %v, want ErrCircuitOpen: an attempt timeout must count", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1", calls.Load())
	}
}

func TestPolicyAndRetryDefaultsHold(t *testing.T) {
	p := resilience.Policy{}
	if p.Timeout != 10*time.Second || p.Breaker != nil {
		t.Fatalf("Policy{} timeout = %v breaker = %v, want 10s and none", p.Timeout, p.Breaker)
	}
	if r := p.Retry; r != nil {
		t.Fatalf("Policy{} retry = %+v, want none", r)
	}
	filled := resilience.Policy{Retry: resilience.Retry{}}
	if r := filled.Retry; r != nil {
		if r.Attempts != 3 || r.Base != 100*time.Millisecond || r.Max != 2*time.Second {
			t.Fatalf("Policy{Retry: Retry{}} retry = %+v, want 3 attempts, 100ms base, 2s max", r)
		}
	} else {
		t.Fatalf("Policy{Retry: Retry{}} retry = nil, want 3 attempts, 100ms base, 2s max")
	}
	var calls atomic.Int64
	call := func(ctx context.Context) (int, error) {
		calls.Add(1)
		return 0, boom
	}
	if _, err := resilience.Do(t.Context(), resilience.Policy{}, call); !errors.Is(err, boom) {
		t.Fatalf("err = %v, want boom", err)
	}
	if calls.Load() != 1 {
		t.Fatalf("calls = %d, want 1 without Retry", calls.Load())
	}
}

func TestStaleFailureCannotStealTheProbe(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	pol := resilience.Policy{Timeout: time.Hour, Breaker: brk}
	scene := staleScene{ctx: t.Context(), pol: pol, clk: clk, aOK: false, bOK: true}
	got := runStaleScene(t, &scene)
	if !errors.Is(got.a, boom) {
		t.Fatalf("stale call err = %v, want boom", got.a)
	}
	if !errors.Is(got.third, resilience.ErrCircuitOpen) {
		t.Fatalf("third call err = %v, want ErrCircuitOpen: B must still be the probe", got.third)
	}
	if got.b != nil {
		t.Fatalf("probe err = %v, want nil", got.b)
	}
	if _, err := resilience.Do(scene.ctx, pol, scene.succeed); err != nil {
		t.Fatalf("after probe close err = %v, want nil", err)
	}
	if got := scene.calls.Load(); got != 4 {
		t.Fatalf("calls = %d, want 4", got)
	}
}

func TestStaleSuccessCannotCloseTheBreaker(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	pol := resilience.Policy{Timeout: time.Hour, Breaker: brk}
	scene := staleScene{ctx: t.Context(), pol: pol, clk: clk, aOK: true, bOK: false}
	got := runStaleScene(t, &scene)
	if got.a != nil {
		t.Fatalf("stale call err = %v, want nil", got.a)
	}
	if !errors.Is(got.third, resilience.ErrCircuitOpen) {
		t.Fatalf("third call err = %v, want ErrCircuitOpen: the stale success must not close", got.third)
	}
	if !errors.Is(got.b, boom) {
		t.Fatalf("probe err = %v, want boom", got.b)
	}
	if _, err := resilience.Do(scene.ctx, pol, scene.succeed); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("fourth call err = %v, want ErrCircuitOpen: the failed probe reopened the breaker", err)
	}
}

type staleScene struct {
	ctx   context.Context
	pol   resilience.Policy
	clk   *testClock
	aOK   bool
	bOK   bool
	calls atomic.Int64
}

func (s *staleScene) fail(context.Context) (int, error) {
	s.calls.Add(1)
	return 0, boom
}

func (s *staleScene) succeed(context.Context) (int, error) {
	s.calls.Add(1)
	return 7, nil
}

type staleResult struct {
	a     error
	third error
	b     error
}

type staleSync struct {
	aAdmitted chan struct{}
	aSettled  chan struct{}
	aGate     chan struct{}
	tripDone  chan struct{}
	bStarted  chan struct{}
	bGate     chan struct{}
	aDone     chan error
	bDone     chan error
	thirdErr  chan error
}

func newStaleSync() staleSync {
	return staleSync{
		aAdmitted: make(chan struct{}),
		aSettled:  make(chan struct{}),
		aGate:     make(chan struct{}),
		tripDone:  make(chan struct{}),
		bStarted:  make(chan struct{}),
		bGate:     make(chan struct{}),
		aDone:     make(chan error, 1),
		bDone:     make(chan error, 1),
		thirdErr:  make(chan error, 1),
	}
}

func runStaleScene(t *testing.T, s *staleScene) staleResult {
	sy := newStaleSync()
	if err := runStaleChildren(t, s, sy); err != nil {
		return staleResult{a: err, third: err, b: err}
	}
	return staleResult{a: recvErr(s.ctx, sy.aDone), third: recvErr(s.ctx, sy.thirdErr), b: recvErr(s.ctx, sy.bDone)}
}

func runStaleChildren(t *testing.T, s *staleScene, sy staleSync) error {
	go group (s.ctx) {
		go {
			_, err := resilience.Do(s.ctx, s.pol, func(c context.Context) (int, error) {
				s.calls.Add(1)
				close(sy.aAdmitted)
				if err := waitGate(c, sy.aGate); err != nil {
					return 0, err
				}
				if s.aOK {
					return 7, nil
				}
				return 0, boom
			})
			sy.aDone <- err
			close(sy.aSettled)
		}
		go {
			<-sy.aAdmitted
			if _, err := resilience.Do(s.ctx, s.pol, s.fail); !errors.Is(err, boom) {
				t.Errorf("trip call err = %v, want boom", err)
			}
			s.clk.Advance(time.Hour)
			close(sy.tripDone)
		}
		go {
			<-sy.tripDone
			_, err := resilience.Do(s.ctx, s.pol, func(c context.Context) (int, error) {
				s.calls.Add(1)
				close(sy.bStarted)
				if err := waitGate(c, sy.bGate); err != nil {
					return 0, err
				}
				if s.bOK {
					return 7, nil
				}
				return 0, boom
			})
			sy.bDone <- err
		}
		go {
			<-sy.bStarted
			close(sy.aGate)
			<-sy.aSettled
			_, e3 := resilience.Do(s.ctx, s.pol, s.succeed)
			sy.thirdErr <- e3
			close(sy.bGate)
		}
	}
	return nil
}

func waitGate(c context.Context, gate <-chan struct{}) error {
	select {
	case <-gate:
		return nil
	case <-c.Done():
		return c.Err()
	}
}

func recvErr(ctx context.Context, ch <-chan error) error {
	select {
	case err := <-ch:
		return err
	case <-ctx.Done():
		return fmt.Errorf("resilience test: scene stalled: %w", ctx.Err())
	}
}

func panicValue(run func()) (got any) {
	defer func() {
		got = recover()
	}()
	run()
	return nil
}

func TestPanickingProbeDoesNotHoldTheSlot(t *testing.T) {
	clk := &testClock{}
	brk := &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour, Now: clk.Now}
	pol := resilience.Policy{Timeout: time.Second, Breaker: brk}
	ctx := t.Context()
	if _, err := resilience.Do(ctx, pol, failing); !errors.Is(err, boom) {
		t.Fatalf("warm-up err = %v, want boom", err)
	}
	clk.Advance(time.Hour)
	exploding := func(context.Context) (int, error) {
		panic("resilience test: probe exploded")
	}
	got := panicValue(func() {
		if _, err := resilience.Do(ctx, pol, exploding); err != nil {
			t.Errorf("exploding probe returned %v, want the panic", err)
		}
	})
	if got != "resilience test: probe exploded" {
		t.Fatalf("panic value = %v, want the probe's panic", got)
	}
	if _, err := resilience.Do(ctx, pol, succeeding); !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("err = %v, want ErrCircuitOpen: a probe that panics is a failed probe", err)
	}
	clk.Advance(time.Hour)
	if _, err := resilience.Do(ctx, pol, succeeding); err != nil {
		t.Fatalf("err = %v, want a new probe admitted after OpenFor", err)
	}
}

func TestCircuitOpenIsFault(t *testing.T) {
	pol := resilience.Policy{Timeout: time.Second, Breaker: &resilience.Breaker{Window: 1, FailureRate: 0.5, OpenFor: time.Hour}}
	if _, err := resilience.Do(t.Context(), pol, failing); !errors.Is(err, boom) {
		t.Fatalf("warm-up err = %v, want boom", err)
		return
	}
	_, err := resilience.Do(t.Context(), pol, succeeding)
	if !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("err = %v, want ErrCircuitOpen", err)
		return
	}
	got := fault.Public(err)
	if got.Code != "resilience.circuit_open" {
		t.Fatalf("code = %q, want resilience.circuit_open", got.Code)
	}
	if got.Message != "The upstream is unavailable." {
		t.Fatalf("message = %q, want the constant", got.Message)
	}
}

func TestTimeoutIsFault(t *testing.T) {
	pol := resilience.Policy{Timeout: 5 * time.Millisecond}
	call := func(ctx context.Context) (int, error) {
		<-ctx.Done()
		return 0, ctx.Err()
	}
	_, err := resilience.Do(t.Context(), pol, call)
	if !errors.Is(err, resilience.ErrTimeout) {
		t.Fatalf("err = %v, want ErrTimeout", err)
		return
	}
	got := fault.Public(err)
	if got.Code != "resilience.timeout" {
		t.Fatalf("code = %q, want resilience.timeout", got.Code)
	}
	if got.Message != "The upstream timed out." {
		t.Fatalf("message = %q, want the constant", got.Message)
	}
}

func TestFaultPublicHidesSecret(t *testing.T) {
	secret := "password=hunter2"
	hostile := "<script>alert(1)</script>"
	inject := secret + " " + hostile + " /etc/passwd '; DROP TABLE x; --"
	call := func(context.Context) (int, error) {
		return 0, errors.New(inject)
	}
	_, err := resilience.Do(t.Context(), resilience.Policy{Timeout: time.Second}, call)
	got := fault.Public(err)
	if got.Code != "internal" {
		t.Fatalf("code = %q, want internal for an undeclared error", got.Code)
	}
	faulttest.RefuseLeak(t, faulttest.PublicJSON(t, err), secret, hostile, "/etc/passwd", "DROP TABLE")
}

func TestFaultsMatchCodeTable(t *testing.T) {
	faulttest.CheckTable(t, "../docs/specs/resilience.md", resilience.Faults())
}
