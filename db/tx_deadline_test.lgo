package db_test

import (
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/gosuda/spira/db"
)

func TestInTxHonorsCallerCancellationBeforeCommit(t *testing.T) {
	pool := openPool(t)
	createThings(t, pool)
	ctx, cancel := context.WithCancel(t.Context())
	_, err := db.InTx[int](ctx, pool, func(tx *db.Tx) (int, error) {
		insertThingRow(t, tx)
		cancel()
		return 7, nil
	})
	if !errors.Is(err, context.Canceled) {
		t.Fatalf("InTx error = %v, want context.Canceled", err)
	}
	if strings.Contains(err.Error(), "db: commit:") {
		t.Fatalf("InTx error = %q, want the context cause without a commit wrap", err)
	}
	if n := countThings(t, pool); n != 0 {
		t.Fatalf("rows after canceled transaction = %d, want 0", n)
	}
}
