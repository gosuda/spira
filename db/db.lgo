package db

import (
	"context"
	"database/sql"
	"database/sql/driver"
	"errors"
	"fmt"
	"log/slog"
	"logos/sync"
	"net/url"
	"strconv"
	"strings"
	"time"
)

type Querier interface {
	QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows?, error)
	ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error)
}

type SQLite struct{}

type Postgres struct{}

type MySQL struct{}

type MSSQL struct{}

type Dialect interface {
	SQLite | Postgres | MySQL | MSSQL
}

const skipCache = "/*db:nocache*/"

func DialectOf(driver string, dsn string) (Dialect, error) {
	switch driver {
	case "sqlite":
		return SQLite{}, nil
	case "pgx", "postgres":
		return Postgres{}, nil
	case "mysql":
		value, found := dsnParam(mysqlQueryPart(dsn), "parseTime")
		if !found || !parseTimeOn(value) {
			return nil, ErrMissingParseTime.Wrap(errors.New("db: mysql DSN needs parseTime=true"))
		}
		return MySQL{}, nil
	case "sqlserver":
		return MSSQL{}, nil
	default:
		return nil, ErrUnknownDriver.Wrap(fmt.Errorf("db: unknown driver %q", driver))
	}
}

func mysqlQueryPart(dsn string) string {
	tail := dsn[strings.LastIndexByte(dsn, '/')+1:]
	if q := strings.IndexByte(tail, '?'); q >= 0 {
		return tail[q+1:]
	}
	return ""
}

func dsnParam(query string, key string) (string, bool) {
	for query != "" {
		var pair string
		pair, query, _ = strings.Cut(query, "&")
		name, value, ok := strings.Cut(pair, "=")
		if ok && name == key {
			return value, true
		}
	}
	return "", false
}

func parseTimeOn(value string) bool {
	return strings.EqualFold(value, "true") || value == "1" || value == "t" || value == "T"
}

type PoolOptions struct {
	MaxOpenConns    int
	MaxIdleConns    int
	ConnMaxLifetime time.Duration
	ConnMaxIdleTime time.Duration
}

func poolDefaults(d Dialect) PoolOptions {
	switch d.(type) {
	case SQLite:
		return PoolOptions{MaxOpenConns: 4, MaxIdleConns: 2, ConnMaxLifetime: 30 * time.Minute, ConnMaxIdleTime: 5 * time.Minute}
	case Postgres, MySQL, MSSQL:
		return PoolOptions{MaxOpenConns: 10, MaxIdleConns: 5, ConnMaxLifetime: 30 * time.Minute, ConnMaxIdleTime: 5 * time.Minute}
	case nil:
	}
	panic("db: unknown dialect for pool defaults")
}

// firstSetPoolOptions merges every option set: each field comes from the
// first set that leaves it nonzero, so later sets fill the gaps of the
// earlier ones instead of being ignored.
func firstSetPoolOptions(opts []PoolOptions) PoolOptions {
	merged := PoolOptions{}
	for _, o := range opts {
		if merged.MaxOpenConns == 0 {
			merged.MaxOpenConns = o.MaxOpenConns
		}
		if merged.MaxIdleConns == 0 {
			merged.MaxIdleConns = o.MaxIdleConns
		}
		if merged.ConnMaxLifetime == 0 {
			merged.ConnMaxLifetime = o.ConnMaxLifetime
		}
		if merged.ConnMaxIdleTime == 0 {
			merged.ConnMaxIdleTime = o.ConnMaxIdleTime
		}
	}
	return merged
}

func resolvePoolOptions(d Dialect, dsn string, opts []PoolOptions) PoolOptions {
	defaults := poolDefaults(d)
	merged := firstSetPoolOptions(opts)
	if merged.MaxOpenConns == 0 {
		merged.MaxOpenConns = defaults.MaxOpenConns
	}
	if merged.MaxIdleConns == 0 {
		merged.MaxIdleConns = defaults.MaxIdleConns
	}
	if merged.ConnMaxLifetime == 0 {
		merged.ConnMaxLifetime = defaults.ConnMaxLifetime
	}
	if merged.ConnMaxIdleTime == 0 {
		merged.ConnMaxIdleTime = defaults.ConnMaxIdleTime
	}
	if isInMemorySQLite(d, dsn) {
		merged.ConnMaxLifetime = 0
		merged.ConnMaxIdleTime = 0
		if merged.MaxIdleConns < 1 {
			merged.MaxIdleConns = 1
		}
	}
	return merged
}

// isInMemorySQLite reports whether the SQLite DSN names an in-memory
// database. Closing the last connection to one deletes it, so the pool
// must never evict its final physical connection.
func isInMemorySQLite(d Dialect, dsn string) bool {
	if _, ok := d.(SQLite); !ok {
		return false
	}
	name, query, _ := strings.Cut(dsn, "?")
	if name == ":memory:" {
		return true
	}
	if rest, ok := strings.CutPrefix(name, "file:"); ok {
		if path, err := url.PathUnescape(rest); err == nil && path == ":memory:" {
			return true
		}
	}
	params, err := url.ParseQuery(query)
	if err != nil {
		return false
	}
	return params.Get("mode") == "memory"
}

func applyPoolLimits(handle *sql.DB, opts PoolOptions) {
	handle.SetMaxOpenConns(opts.MaxOpenConns)
	handle.SetMaxIdleConns(opts.MaxIdleConns)
	handle.SetConnMaxLifetime(opts.ConnMaxLifetime)
	handle.SetConnMaxIdleTime(opts.ConnMaxIdleTime)
}

func Open(driver string, dsn string, opts ...PoolOptions) (*Pool?, error) {
	dialect, err := DialectOf(driver, dsn)
	if err != nil {
		return nil, err
	}
	handle, err := sql.Open(driver, dsn)
	if err != nil {
		return nil, ClassifyDriverError(dialect, fmt.Errorf("db: open %s: %w", driver, err))
	}
	applyPoolLimits(handle, resolvePoolOptions(dialect, dsn, opts))
	return &Pool{handle: handle, dialect: dialect, stmts: &stmtCache{}}, nil
}

// OpenSQLiteImmediate opens a SQLite pool whose writable transactions begin
// with a writer reservation. Use InSQLiteImmediateTx to require that mode.
func OpenSQLiteImmediate(dsn string, opts ...PoolOptions) (*Pool?, error) {
	configured := sqliteImmediateDSN(dsn)?
	pool := Open("sqlite", configured, opts...)?
	if pool == nil {
		return nil, ErrStatementFailed.Wrap(errors.New("db: SQLite open returned no pool"))
	}
	pool.sqliteImmediate = true
	return pool, nil
}

func sqliteImmediateDSN(dsn string) (string, error) {
	name, query, _ := strings.Cut(dsn, "?")
	if name == "" || strings.ContainsRune(dsn, 0) {
		return "", errors.New("db: SQLite immediate transactions require a database name")
	}
	params, err := url.ParseQuery(query)
	if err != nil {
		return "", errors.New("db: invalid SQLite DSN query")
	}
	if params.Has("vfs") || params.Has("nolock") || params.Has("immutable") {
		return "", errors.New("db: SQLite immediate transactions require the default locking VFS")
	}
	mode, _ := params["mode"]
	cache, _ := params["cache"]
	if len(mode) > 1 || len(cache) > 1 {
		return "", errors.New("db: ambiguous SQLite URI mode or cache")
	}
	if err := checkSQLiteDatabaseName(dsn, name, params.Get("mode"), params.Get("cache")); err != nil {
		return "", err
	}
	configured := name + "?_txlock=immediate"
	if query != "" {
		configured += "&" + query
	}
	return configured, nil
}

func checkSQLiteDatabaseName(dsn string, name string, mode string, cache string) error {
	if name == ":memory:" {
		return errors.New("db: SQLite immediate transactions require a shared in-memory database")
	}
	path, uri := strings.CutPrefix(name, "file:")
	if !uri {
		return nil
	}
	if strings.ContainsRune(dsn, '#') || strings.Contains(dsn, "%00") {
		return errors.New("db: SQLite immediate transactions do not accept URI fragments or encoded NULs")
	}
	path, err := url.PathUnescape(path)
	if err != nil {
		return errors.New("db: invalid SQLite URI path")
	}
	if path == "" || path == "//localhost" {
		return errors.New("db: SQLite immediate transactions require a database name")
	}
	if (path == ":memory:" || mode == "memory") && cache != "shared" {
		return errors.New("db: SQLite immediate transactions require a shared in-memory database")
	}
	return nil
}

type Pool struct {
	handle          *sql.DB
	dialect         Dialect
	stmts           *stmtCache
	sqliteImmediate bool
}

func (p *Pool) Dialect() Dialect {
	return p.dialect
}

func (p *Pool) Prepared() int {
	return p.stmts.size()
}

func (p *Pool) Stats() sql.DBStats {
	return p.handle.Stats()
}

func (p *Pool) Prepare(ctx context.Context, query string) error {
	q, skip := unmarked(query)
	if skip {
		return ClassifyDriverError(p.dialect, prepareDirect(ctx, p.handle, q))
	}
	if _, cached := p.stmts.acquire(q); cached {
		p.stmts.release(q)
		return ClassifyDriverError(p.dialect, prepareDirect(ctx, p.handle, q))
	}
	stmt, err := p.stmts.prepare(ctx, p.handle, q)
	if err != nil {
		return ClassifyDriverError(p.dialect, err)
	}
	if stmt == nil {
		return ErrStatementFailed.Wrap(errors.New("db: prepared statement missing"))
	}
	p.stmts.release(q)
	return nil
}

func prepareDirect(ctx context.Context, handle *sql.DB, q string) error {
	stmt, err := handle.PrepareContext(ctx, q)
	if err != nil {
		return fmt.Errorf("db: prepare: %w", err)
	}
	if cerr := stmt.Close(); cerr != nil {
		return fmt.Errorf("db: prepare close: %w", cerr)
	}
	return nil
}

func (p *Pool) Start(ctx context.Context) error {
	if err := p.handle.PingContext(ctx); err != nil {
		return ClassifyDriverError(p.dialect, fmt.Errorf("db: ping: %w", err))
	}
	return nil
}

func (p *Pool) Stop(ctx context.Context) error {
	run := &poolClose{done: make(chan struct{})}
	joinCtx, joinCancel := context.WithCancel(context.Background())
	context.AfterFunc(joinCtx, func() {
		p.closeAll(run)
	})
	joinCancel()
	select {
	case <-run.done:
	case <-ctx.Done():
		return ClassifyDriverError(p.dialect, fmt.Errorf("db: stop: %w", ctx.Err()))
	}
	var err error
	run.err.WithLock(func(e *error) {
		err = *e
	})
	return err
}

type poolClose struct {
	err  sync.Locked[error]
	done chan struct{}
}

func (p *Pool) closeAll(run *poolClose) {
	stmtErr := p.stmts.closeStmts()
	handleErr := p.handle.Close()
	var result error
	if handleErr != nil {
		result = ClassifyDriverError(p.dialect, fmt.Errorf("db: close: %w", errors.Join(stmtErr, handleErr)))
	} else {
		result = ClassifyDriverError(p.dialect, stmtErr)
	}
	run.err.WithLock(func(e *error) {
		*e = result
	})
	close(run.done)
}

func (p *Pool) QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows?, error) {
	q, skip := unmarked(query)
	if skip {
		rows, err := p.handle.QueryContext(ctx, q, args...)
		if err != nil {
			return nil, ClassifyDriverError(p.dialect, fmt.Errorf("db: query: %w", err))
		}
		return rows, nil
	}
	prepared, err := p.stmts.prepare(ctx, p.handle, q)
	if err != nil {
		return nil, ClassifyDriverError(p.dialect, err)
	}
	if prepared == nil {
		return nil, ErrStatementFailed.Wrap(errors.New("db: prepared statement missing"))
	}
	rows, err := prepared.QueryContext(ctx, args...)
	p.stmts.release(q)
	if err != nil {
		return nil, ClassifyDriverError(p.dialect, fmt.Errorf("db: query: %w", err))
	}
	if rows == nil {
		return nil, ErrStatementFailed.Wrap(errors.New("db: query returned no rows"))
	}
	return rows, nil
}

func (p *Pool) ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error) {
	q, skip := unmarked(query)
	if skip {
		res, err := p.handle.ExecContext(ctx, q, args...)
		if err != nil {
			return nil, ClassifyDriverError(p.dialect, fmt.Errorf("db: exec: %w", err))
		}
		return res, nil
	}
	prepared, err := p.stmts.prepare(ctx, p.handle, q)
	if err != nil {
		return nil, ClassifyDriverError(p.dialect, err)
	}
	if prepared == nil {
		return nil, ErrStatementFailed.Wrap(errors.New("db: prepared statement missing"))
	}
	res, err := prepared.ExecContext(ctx, args...)
	p.stmts.release(q)
	if err != nil {
		return nil, ClassifyDriverError(p.dialect, fmt.Errorf("db: exec: %w", err))
	}
	return res, nil
}

type Tx struct {
	tx   *sql.Tx
	pool *Pool
}

func (t *Tx) QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows?, error) {
	q, skip := unmarked(query)
	if skip {
		rows, err := t.tx.QueryContext(ctx, q, args...)
		if err != nil {
			return nil, ClassifyDriverError(t.pool.dialect, fmt.Errorf("db: query: %w", err))
		}
		return rows, nil
	}
	if stmt, cached := t.pool.stmts.acquire(q); cached {
		rows, err := t.tx.StmtContext(ctx, stmt).QueryContext(ctx, args...)
		t.pool.stmts.release(q)
		if err != nil {
			return nil, ClassifyDriverError(t.pool.dialect, fmt.Errorf("db: query: %w", err))
		}
		if rows == nil {
			return nil, ErrStatementFailed.Wrap(errors.New("db: query returned no rows"))
		}
		return rows, nil
	}
	rows, err := t.tx.QueryContext(ctx, q, args...)
	if err != nil {
		return nil, ClassifyDriverError(t.pool.dialect, fmt.Errorf("db: query: %w", err))
	}
	if rows == nil {
		return nil, ErrStatementFailed.Wrap(errors.New("db: query returned no rows"))
	}
	return rows, nil
}

func (t *Tx) ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error) {
	q, skip := unmarked(query)
	if skip {
		res, err := t.tx.ExecContext(ctx, q, args...)
		if err != nil {
			return nil, ClassifyDriverError(t.pool.dialect, fmt.Errorf("db: exec: %w", err))
		}
		return res, nil
	}
	if stmt, cached := t.pool.stmts.acquire(q); cached {
		res, err := t.tx.StmtContext(ctx, stmt).ExecContext(ctx, args...)
		t.pool.stmts.release(q)
		if err != nil {
			return nil, ClassifyDriverError(t.pool.dialect, fmt.Errorf("db: exec: %w", err))
		}
		return res, nil
	}
	res, err := t.tx.ExecContext(ctx, q, args...)
	if err != nil {
		return nil, ClassifyDriverError(t.pool.dialect, fmt.Errorf("db: exec: %w", err))
	}
	return res, nil
}

func InTx[T any](ctx context.Context, p *Pool, work func(tx *Tx) (T, error)) (T, error) {
	var zero T
	tx, err := p.handle.BeginTx(ctx, &sql.TxOptions{})
	if err != nil {
		return zero, ClassifyDriverError(p.dialect, fmt.Errorf("db: begin: %w", err))
	}
	return finishTx(ctx, &Tx{tx: tx, pool: p}, work)
}

// InSQLiteImmediateTx requires a writer reservation before calling work.
func InSQLiteImmediateTx[T any](ctx context.Context, p *Pool, work func(tx *Tx) (T, error)) (value T, err error) {
	var zero T
	if !p.sqliteImmediate {
		return zero, ErrStatementFailed.Wrap(errors.New("db: SQLite immediate transaction requires an immediate SQLite pool"))
	}
	conn, err := p.handle.Conn(ctx)
	if err != nil {
		return zero, ClassifyDriverError(p.dialect, fmt.Errorf("db: lease SQLite connection: %w", err))
	}
	if conn == nil {
		return zero, ErrStatementFailed.Wrap(errors.New("db: SQLite lease returned no connection"))
	}
	defer closeSQLiteConn(conn)?
	var busyMillis int
	if err := conn.QueryRowContext(ctx, "PRAGMA busy_timeout").Scan(&busyMillis); err != nil {
		return zero, ClassifyDriverError(p.dialect, fmt.Errorf("db: read SQLite busy timeout: %w", err))
	}
	const writerBusyMillis = 30000
	if busyMillis != writerBusyMillis {
		defer restoreSQLiteBusyTimeout(ctx, conn, busyMillis, &err)
		if _, err := conn.ExecContext(ctx, "PRAGMA busy_timeout = "+strconv.Itoa(writerBusyMillis)); err != nil {
			return zero, ClassifyDriverError(p.dialect, fmt.Errorf("db: set SQLite busy timeout: %w", err))
		}
	}
	tx, err := conn.BeginTx(ctx, &sql.TxOptions{})
	if err != nil {
		return zero, ClassifyDriverError(p.dialect, fmt.Errorf("db: begin immediate: %w", err))
	}
	return finishTx(ctx, &Tx{tx: tx, pool: p}, func(run *Tx) (T, error) {
		requireSQLiteRollback(ctx, tx)?
		return work(run)
	})
}

func requireSQLiteRollback(ctx context.Context, tx *sql.Tx) error {
	var journalMode string
	row := tx.QueryRowContext(ctx, "PRAGMA main.journal_mode")
	if err := row.Scan(&journalMode); err != nil {
		return ClassifyDriverError(SQLite{}, fmt.Errorf("db: read SQLite journal mode: %w", err))
	}
	if journalMode == "off" {
		return ErrStatementFailed.Wrap(errors.New("db: SQLite immediate transactions require rollback journaling"))
	}
	return nil
}

func restoreSQLiteBusyTimeout(ctx context.Context, conn *sql.Conn, millis int, outcome *error) {
	cleanup, cancel := context.WithTimeout(context.WithoutCancel(ctx), time.Second)
	defer cancel()
	_, err := conn.ExecContext(cleanup, "PRAGMA busy_timeout = "+strconv.Itoa(millis))
	if err == nil || errors.Is(err, sql.ErrConnDone) {
		return
	}
	restoreErr := fmt.Errorf("db: restore SQLite busy timeout: %w", err)
	discardErr := conn.Raw(func(_ any) error { return driver.ErrBadConn })
	if !errors.Is(discardErr, driver.ErrBadConn) && !errors.Is(discardErr, sql.ErrConnDone) {
		restoreErr = errors.Join(restoreErr, fmt.Errorf("db: discard SQLite connection: %w", discardErr))
	}
	if *outcome != nil {
		*outcome = errors.Join(*outcome, restoreErr)
		return
	}
	slog.Error("db: SQLite connection cleanup after immediate transaction", "error", restoreErr)
}

func closeSQLiteConn(conn *sql.Conn) error {
	err := conn.Close()
	if errors.Is(err, sql.ErrConnDone) {
		return nil
	}
	return err
}

func finishTx[T any](ctx context.Context, run *Tx, work func(tx *Tx) (T, error)) (T, error) {
	var zero T
	v, workErr := runTxWork(run, work)
	if workErr != nil {
		return zero, workErr
	}
	if err := ctx.Err(); err != nil {
		// The caller is gone: report the context cause itself. A rollback
		// the driver already performed surfaces as sql.ErrTxDone and must
		// not join the cause; only a genuine rollback failure joins it.
		if rerr := run.tx.Rollback(); rerr != nil && !errors.Is(rerr, sql.ErrTxDone) {
			return zero, errors.Join(err, rerr)
		}
		return zero, err
	}
	if err := run.tx.Commit(); err != nil {
		return zero, ClassifyDriverError(run.pool.dialect, fmt.Errorf("db: commit: %w", err))
	}
	return v, nil
}

func runTxWork[T any](run *Tx, work func(tx *Tx) (T, error)) (T, error) {
	errdefer run.tx.Rollback()?
	return work(run)
}

func Exec(ctx context.Context, q Querier, query string, args ...any) (sql.Result, error) {
	return q.ExecContext(ctx, query, args...)
}

func In(query string, name string, count int) string {
	expanded := strings.Replace(query, marker(name), replacement(count), 1)
	return skipCache + expanded
}

func marker(name string) string {
	return "/*SLICE:" + name + "*/?"
}

func replacement(count int) string {
	if count <= 0 {
		return "NULL"
	}
	var b strings.Builder
	for i := range count {
		if i > 0 {
			b.WriteString(",")
		}
		b.WriteString("?")
	}
	return b.String()
}

func unmarked(query string) (string, bool) {
	if strings.HasPrefix(query, skipCache) {
		return strings.TrimPrefix(query, skipCache), true
	}
	return query, false
}
