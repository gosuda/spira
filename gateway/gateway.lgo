package gateway

import (
	"bytes"
	"context"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"net/http/httputil"
	"net/url"
	"strings"
	"time"

	"logos/rt"
	"logos/sync"

	"github.com/gosuda/spira/resilience"
	"github.com/gosuda/spira/web"
)

type Route struct {
	Host        string?
	PathPrefix  string
	StripPrefix bool
	To          []string
	Stages      []web.Stage
}

func Mount(r *web.Router, routes []Route, policy resilience.Policy) {
	for i := range routes {
		rt := routes[i]
		h := proxyHandler(newProxy(newRelay(rt, policy)))
		r.Group("", func(g *web.Router) {
			g.Use(rt.Stages...)
			for _, pattern := range routePatterns(rt.Host, rt.PathPrefix) {
				g.Handle("", pattern, h)
			}
		})
	}
}

func newRelay(rt Route, policy resilience.Policy) *relay {
	requirePrefix(rt.PathPrefix)
	if len(rt.To) == 0 {
		panic($"gateway: route {rt.PathPrefix}: no upstream")
	}
	hops := make([]upstream, 0, len(rt.To))
	for _, raw := range rt.To {
		hops = append(hops, upstream{base: parseUpstream(raw, rt.PathPrefix), breaker: ownBreaker(policy.Breaker)})
	}
	return &relay{prefix: rt.PathPrefix, strip: rt.StripPrefix, timeout: policy.Timeout, body: badGatewayBody(), hops: hops}
}

func badGatewayBody() []byte {
	body, err := json.Marshal(web.Problem{Title: "Bad Gateway", Status: http.StatusBadGateway})
	if err != nil {
		panic(fmt.Errorf("gateway: encode bad gateway problem: %w", err))
	}
	return body
}

func requirePrefix(prefix string) {
	if !strings.HasPrefix(prefix, "/") {
		panic($"gateway: route {prefix}: path prefix must start with /")
	}
	if strings.ContainsAny(prefix, "{}*") {
		panic($"gateway: route {prefix}: path prefix must not contain wildcards")
	}
}

func parseUpstream(raw string, prefix string) *url.URL {
	u, err := url.Parse(raw)
	if upstreamOK(u, err) {
		return u
	}
	panic($"gateway: route {prefix}: upstream {raw} is not an absolute http or https URL")
}

func upstreamOK(u *url.URL?, err error) bool {
	if err != nil {
		return false
	}
	if u == nil {
		return false
	}
	if u.Scheme != "http" && u.Scheme != "https" {
		return false
	}
	return u.Host != ""
}

func ownBreaker(template *resilience.Breaker?) *resilience.Breaker? {
	if b := template; b != nil {
		return &resilience.Breaker{Window: b.Window, FailureRate: b.FailureRate, OpenFor: b.OpenFor, Now: b.Now}
	}
	return nil
}

func routePatterns(host string?, prefix string) []string {
	name := ""
	if v := host; v != nil {
		name = v
	}
	if prefix == "/" {
		return []string{name + "/"}
	}
	patterns := []string{name + prefix}
	if !strings.HasSuffix(prefix, "/") {
		patterns = append(patterns, name+prefix+"/")
	}
	return patterns
}

func proxyHandler(px *httputil.ReverseProxy) web.Handler {
	return func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: px}, nil
	}
}

func newProxy(rl *relay) *httputil.ReverseProxy {
	return &httputil.ReverseProxy{
		Rewrite:       rewriteForwarded,
		Transport:     rl,
		FlushInterval: -1,
	}
}

func rewriteForwarded(pr *httputil.ProxyRequest) {
	pr.SetXForwarded()
}

type upstream struct {
	base    *url.URL
	breaker *resilience.Breaker?
}

type relay struct {
	prefix  string
	strip   bool
	timeout time.Duration
	body    []byte
	hops    []upstream
	turn    sync.Locked[int]
}

func (rl *relay) RoundTrip(req *http.Request) (*http.Response, error) {
	var start int
	rl.turn.WithLock(func(next *int) {
		start = *next
		*next = (start + 1) % len(rl.hops)
	})
	again, failed := rl.replayable(req)
	var cause error
	if failed != nil {
		cause = failed
		slog.Error("gateway: no upstream served the route", "prefix", rl.prefix, "error", cause)
		return rl.refusal(), nil
	}
	for i := range rl.hops {
		resp, err := rl.send(req, &rl.hops[(start+i)%len(rl.hops)])
		if err != nil {
			cause = err
		} else {
			if r := resp; r != nil {
				return r, nil
			}
		}
		if !again {
			break
		}
	}
	slog.Error("gateway: no upstream served the route", "prefix", rl.prefix, "error", cause)
	return rl.refusal(), nil
}

// replayable decides whether a failed first upstream may be followed by a
// second. A body of unknown length is never assumed empty: the first byte is
// read under the relay timeout, and only an immediate end of stream proves
// the body empty. A proved byte is pushed back so the stream, and the
// trailers after it, stay intact.

func (rl *relay) replayable(req *http.Request) (bool, error?) {
	if req.Body == nil || req.Body == http.NoBody {
		return true, nil
	}
	if req.ContentLength >= 0 {
		return false, nil
	}
	empty, body, expired := peekEmpty(req, rl.timeout)
	if expired != nil {
		return false, expired
	}
	req.Body = body
	if empty {
		req.ContentLength = 0
		return true, nil
	}
	return false, nil
}

type pushedBody struct {
	io.Reader
	closer io.Closer
}

func (b *pushedBody) Close() error {
	return b.closer.Close()
}

type peekOutcome struct {
	first [1]byte
	n     int
	err   error
}

// peekEmpty reads the first byte of an unknown-length body. It returns the
// body with that byte pushed back, so the attempt that follows sees the whole
// stream. A timeout or a cancelled request ends the wait: the body may hold a
// late byte that no one owns afterward, so the caller must not reuse the body
// and answers without trying an upstream.
func peekEmpty(req *http.Request, wait time.Duration) (bool, io.ReadCloser, error?) {
	seen := make(chan peekOutcome, 1)
	g, _ := rt.NewGroup(req.Context(), 0)
	g.Go(func(gctx context.Context) error {
		var first [1]byte
		for {
			n, err := req.Body.Read(first[:])
			if n > 0 || err != nil {
				select {
				case seen <- peekOutcome{first: first, n: n, err: err}:
				case <-gctx.Done():
				}
				return nil
			}
		}
	})
	timer := time.NewTimer(wait)
	defer timer.Stop()
	select {
	case got := <-seen:
		if got.n > 0 {
			kept := bytes.NewReader(got.first[:got.n])
			return false, &pushedBody{Reader: io.MultiReader(kept, req.Body), closer: req.Body}, nil
		}
		if errors.Is(got.err, io.EOF) {
			return true, http.NoBody, nil
		}
		return false, req.Body, nil
	case <-timer.C:
		return false, nil, ErrBadGateway.Wrap(fmt.Errorf("gateway: body of unknown length yielded nothing in %s", wait))
	case <-req.Context().Done():
		return false, nil, ErrBadGateway.Wrap(fmt.Errorf("gateway: body of unknown length wait ended: %w", req.Context().Err()))
	}
}

func (rl *relay) send(req *http.Request, u *upstream) (*http.Response?, error) {
	p := resilience.Policy{Timeout: rl.timeout, Breaker: u.breaker}
	return resilience.Do(req.Context(), p, func(_ context.Context) (*http.Response?, error) {
		return rl.deliver(req, u.base)
	})
}

type delivery struct {
	upstream *relay
	demand   *http.Request
	target   *url.URL
	slot     context.Context
	settled  chan struct{}
	deadline time.Time
	state    sync.Locked[deliveryState]
	fired    sync.Locked[bool]
}

type deliveryState struct {
	resp  *http.Response?
	fault error
	done  time.Time
}

func (rl *relay) deliver(req *http.Request, base *url.URL) (*http.Response?, error) {
	outctx, cancel := context.WithCancel(req.Context())
	deadline := time.Now().Add(rl.timeout)
	d := &delivery{upstream: rl, demand: req, target: base, slot: outctx, settled: make(chan struct{}), deadline: deadline}
	go group (req.Context()) {
		go d.fetchUpstream()
		go d.watchTimeout(req.Context(), cancel)
	}
	var got deliveryState
	d.state.WithLock(func(slot *deliveryState) { got = *slot })
	exceeded := false
	if req.Context().Err() == nil {
		d.fired.WithLock(func(mark *bool) { exceeded = *mark })
	}
	if got.fault != nil {
		cancel()
		if exceeded {
			return nil, ErrBadGateway.Wrap(fmt.Errorf("gateway: upstream headers exceeded %s", rl.timeout))
		}
		return nil, ErrBadGateway.Wrap(got.fault)
	}
	upstream := got.resp
	if upstream == nil {
		cancel()
		return nil, ErrBadGateway.Wrap(fmt.Errorf("gateway: upstream answered without a response"))
	}
	if exceeded || headersLate(got.done, deadline) {
		cancel()
		upstream.Body.Close()?
		return nil, ErrBadGateway.Wrap(fmt.Errorf("gateway: upstream headers exceeded %s", rl.timeout))
	}
	if upstreamFailed(upstream.StatusCode) {
		cancel()
		upstream.Body.Close()?
		return nil, ErrBadGateway.Wrap(fmt.Errorf("gateway: upstream answered %d", upstream.StatusCode))
	}
	upstream.Body = &releasingBody{inner: upstream.Body, cancel: cancel}
	return upstream, nil
}

func headersLate(done time.Time, deadline time.Time) bool {
	return done.After(deadline)
}

func (d *delivery) fetchUpstream() error {
	defer close(d.settled)
	resp, err := http.DefaultTransport.RoundTrip(d.upstream.outbound(d.demand, d.target, d.slot))
	d.state.WithLock(func(slot *deliveryState) {
		slot.resp = resp
		slot.fault = err
		slot.done = time.Now()
	})
	return nil
}

func (d *delivery) watchTimeout(ctx context.Context, cancel context.CancelFunc) error {
	timer := time.NewTimer(d.upstream.timeout)
	defer timer.Stop()
	select {
	case <-timer.C:
		select {
		case <-d.settled:
		default:
			d.fired.WithLock(func(mark *bool) { *mark = true })
			cancel()
		}
	case <-d.settled:
	case <-ctx.Done():
	}
	return nil
}

type releasingBody struct {
	inner  io.ReadCloser
	cancel context.CancelFunc
}

func (b *releasingBody) Read(p []byte) (int, error) {
	return b.inner.Read(p)
}

func (b *releasingBody) Close() error {
	err := b.inner.Close()
	b.cancel()
	return err
}

func (rl *relay) outbound(req *http.Request, base *url.URL, actx context.Context) *http.Request {
	target := *req.URL
	target.Scheme = base.Scheme
	target.Host = base.Host
	joined := targetPath(base.EscapedPath(), rl.escapedTail(req.URL.EscapedPath(), req.Pattern))
	target.Path = unescaped(joined)
	target.RawPath = joined
	target.RawQuery = joinedQuery(base.RawQuery, req.URL.RawQuery)
	out := req.WithContext(actx)
	out.URL = &target
	out.Host = ""
	return out
}

func (rl *relay) escapedTail(path string, pattern string) string {
	if !rl.strip {
		return path
	}
	return cutEscapedSuffix(path, rl.mounted(pattern))
}

func cutEscapedSuffix(path string, mounted string) string {
	segs := strings.Split(path, "/")
	want := strings.Split(mounted, "/")
	end := len(want)
	if strings.HasSuffix(mounted, "/") {
		end = end - 1
	}
	for i := 1; i < end; i++ {
		if i >= len(segs) {
			return path
		}
		if !segmentMatches(segs[i], want[i]) {
			return path
		}
	}
	rest := segs[end:]
	joined := strings.Join(rest, "/")
	if strings.HasPrefix(joined, "/") {
		return joined
	}
	return "/" + joined
}

func segmentMatches(raw string, want string) bool {
	dec, err := url.PathUnescape(raw)
	if err != nil {
		return raw == want
	}
	return dec == want
}

func unescaped(joined string) string {
	dec, err := url.PathUnescape(joined)
	if err != nil {
		panic($"gateway: escaped join {joined} is not a valid escaped path")
	}
	return dec
}

func (rl *relay) mounted(pattern string) string {
	path := pattern[max(strings.IndexByte(pattern, '/'), 0):]
	if strings.HasSuffix(rl.prefix, "/") {
		return path
	}
	return strings.TrimSuffix(path, "/")
}

func targetPath(base string, tail string) string {
	if base == "" || base == "/" {
		return tail
	}
	if strings.HasSuffix(base, "/") {
		return base + tail[1:]
	}
	return base + tail
}

func upstreamFailed(status int) bool {
	switch status {
	case http.StatusBadGateway, http.StatusServiceUnavailable, http.StatusGatewayTimeout:
		return true
	}
	return false
}

func (rl *relay) refusal() *http.Response {
	return &http.Response{
		StatusCode:    http.StatusBadGateway,
		Status:        "502 Bad Gateway",
		Header:        http.Header{"Content-Type": []string{"application/problem+json"}},
		Body:          io.NopCloser(bytes.NewReader(rl.body)),
		ContentLength: int64(len(rl.body)),
	}
}

func joinedQuery(fixed string, own string) string {
	if fixed == "" || own == "" {
		return fixed + own
	}
	return fixed + "&" + own
}
