package web_test

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/gosuda/spira/schema"
	"github.com/gosuda/spira/validate"
	"github.com/gosuda/spira/web"
)

type BindRegion string

type BindFullIn struct {
	ID      int64  `path:"id"`
	Limit   int64  `query:"limit"`
	Mode    string `header:"X-Mode"`
	Session string `cookie:"session"`
	Term    string `form:"term"`
}
type BindSearchIn struct {
	Limit  int64  `query:"limit" json:"limit"`
	Page   int32  `query:"page" json:"page"`
	Active bool   `query:"active" json:"active"`
	Note   string
}

type BindLoginIn struct {
	Username string `form:"username"`
	Password string `form:"password"`
}

func (in BindLoginIn) Check() validate.Errors {
	var errs validate.Errors
	errs.Require(in.Username != "", "username", "present", "username is required")
	errs.Require(len(in.Password) >= 8, "password", "length", "password is too short")
	return errs
}

type BindOptIn struct {
	Q string? `query:"q"`
}

type BindTuneIn struct {
	Timeout time.Duration `query:"timeout"`
	Region  BindRegion    `query:"region"`
}

type BindDoc struct {
	Term string `json:"term"`
}

type BindDocIn struct {
	Doc BindDoc `body:"json"`
}

func TestRouteBindsTypedFields(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/users/{id}", func(ctx *web.Context, in BindFullIn) (web.Reply, error) {
		return web.Data{Value: $"{in.ID}:{in.Limit}:{in.Mode}:{in.Session}:{in.Term}"}, nil
	})
	req := httptest.NewRequest(http.MethodPost, "/users/7?limit=25", strings.NewReader("term=go"))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.Header.Set("X-Mode", "fast")
	req.AddCookie(&http.Cookie{Name: "session", Value: "abc"})
	rec := call(t, r, req)
	if rec.Code != http.StatusOK {
		t.Fatalf("bind status %d want 200 body %s", rec.Code, rec.Body.String())
		return
	}
	if !strings.Contains(rec.Body.String(), "7:25:fast:abc:go") {
		t.Fatalf("bound echo %q lacks every field value", rec.Body.String())
	}
}

func TestBindCollectsEveryFieldError(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/search", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	rec := call(t, r, httptest.NewRequest(http.MethodGet, "/search?limit=abc&page=xyz&active=maybe", nil))
	doc := assertProblemJSON(t, rec, http.StatusBadRequest)
	if len(doc.Errors) != 3 {
		t.Fatalf("bind errors hold %d entries, want 3", len(doc.Errors))
		return
	}
	seen := map[string]bool{}
	for _, e := range doc.Errors {
		seen[e.Field] = true
		if e.Rule != "format" {
			t.Fatalf("field %s rule %q want format", e.Field, e.Rule)
			return
		}
	}
	for _, want := range []string{"Limit", "Page", "Active"} {
		present := seen[want] ?? false
		if !present {
			t.Fatalf("bind errors lack field %s", want)
			return
		}
	}
}

func TestBindRequiredFieldMissing(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/search", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	rec := call(t, r, httptest.NewRequest(http.MethodGet, "/search?page=2", nil))
	doc := assertProblemJSON(t, rec, http.StatusBadRequest)
	found := false
	for _, e := range doc.Errors {
		if e.Field == "Limit" && e.Rule == "required" {
			found = true
		}
	}
	if !found {
		t.Fatalf("bind errors lack the required Limit entry")
	}
}

func TestBindCheckerFailureAnswers422(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/login", func(ctx *web.Context, in BindLoginIn) (web.Reply, error) {
		return web.Data{Value: in.Username}, nil
	})
	bad := httptest.NewRequest(http.MethodPost, "/login", strings.NewReader("username=&password=short"))
	bad.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	doc := assertProblemJSON(t, call(t, r, bad), http.StatusUnprocessableEntity)
	if len(doc.Errors) != 2 {
		t.Fatalf("checker errors hold %d entries, want 2", len(doc.Errors))
		return
	}
	if !strings.Contains(doc.Errors[0].Message, "username is required") {
		t.Fatalf("checker error %q lacks the field message", doc.Errors[0].Message)
	}
	good := httptest.NewRequest(http.MethodPost, "/login", strings.NewReader("username=ada&password=secret123"))
	good.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	rec := call(t, r, good)
	if rec.Code != http.StatusOK {
		t.Fatalf("valid login status %d want 200 body %s", rec.Code, rec.Body.String())
		return
	}
	if !strings.Contains(rec.Body.String(), "ada") {
		t.Fatalf("valid login echo %q lacks the username", rec.Body.String())
	}
}

func TestBindOptionQueryAbsentAndPresent(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/opt", func(ctx *web.Context, in BindOptIn) (web.Reply, error) {
		if in.Q != nil {
			rest := in.Q ?? ""
			return web.Data{Value: $"has:{rest}"}, nil
		}
		return web.Data{Value: "none"}, nil
	})
	absent := call(t, r, httptest.NewRequest(http.MethodGet, "/opt", nil))
	if absent.Code != http.StatusOK || !strings.Contains(absent.Body.String(), "none") {
		t.Fatalf("absent option status %d body %q want none", absent.Code, absent.Body.String())
		return
	}
	set := call(t, r, httptest.NewRequest(http.MethodGet, "/opt?q=hi", nil))
	if set.Code != http.StatusOK || !strings.Contains(set.Body.String(), "has:hi") {
		t.Fatalf("present option status %d body %q want has:hi", set.Code, set.Body.String())
	}
}

func TestBindDurationAndNamedString(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/tune", func(ctx *web.Context, in BindTuneIn) (web.Reply, error) {
		return web.Data{Value: $"{in.Timeout}:{string(in.Region)}"}, nil
	})
	rec := call(t, r, httptest.NewRequest(http.MethodGet, "/tune?timeout=1m30s&region=eu", nil))
	if rec.Code != http.StatusOK {
		t.Fatalf("tune status %d want 200 body %s", rec.Code, rec.Body.String())
		return
	}
	if !strings.Contains(rec.Body.String(), "1m30s:eu") {
		t.Fatalf("tune echo %q lacks the duration and the region", rec.Body.String())
	}
}

