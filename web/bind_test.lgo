	req := httptest.NewRequest(http.MethodPost, "/login?note=a;b", strings.NewReader("username=ada&password=secret123"))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	rec := call(t, r, req)
	if rec.Code != http.StatusOK {
		t.Fatalf("semicolon query status %d want 200 body %s", rec.Code, rec.Body.String())
	}
}

func TestFormFieldMissingFromBodyIsRequired(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/login", func(ctx *web.Context, in BindLoginIn) (web.Reply, error) {
		return web.Data{Value: in.Username}, nil
	})
	req := httptest.NewRequest(http.MethodPost, "/login?password=secret123", strings.NewReader("username=ada"))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	doc := assertProblemJSON(t, call(t, r, req), http.StatusBadRequest)
	found := false
	for _, e := range doc.Errors {
		if e.Field == "Password" && e.Rule == "required" {
			found = true
