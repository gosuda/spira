func TestBindUnknownJSONMemberRejected(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/doc", func(ctx *web.Context, in BindDocIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	req := httptest.NewRequest(http.MethodPost, "/doc", strings.NewReader(`{"term":"go","mystery":1}`))
	req.Header.Set("Content-Type", "application/json")
	doc := assertProblemJSON(t, call(t, r, req), http.StatusBadRequest)
	if len(doc.Errors) != 1 {
		t.Fatalf("unknown member errors hold %d entries, want 1", len(doc.Errors))
		return
	}
	if doc.Errors[0].Field != "mystery" || doc.Errors[0].Rule != "unknown" {
		t.Fatalf("unknown member error is %s %s, want mystery unknown", doc.Errors[0].Field, doc.Errors[0].Rule)
		return
	}
	if !strings.Contains(doc.Errors[0].Message, "is not a known field") {
		t.Fatalf("unknown member message %q lacks the required text", doc.Errors[0].Message)
	}
}

func TestBindHostileValueNeverEchoed(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/search", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	rec := call(t, r, httptest.NewRequest(http.MethodGet, "/search?limit=%3Cscript%3Ealert(1)%3C/script%3E&page=';DROP/**/x;--", nil))
	doc := assertProblemJSON(t, rec, http.StatusBadRequest)
	if len(doc.Errors) != 3 {
		t.Fatalf("hostile errors hold %d entries, want 3", len(doc.Errors))
		return
	}
	body := rec.Body.String()
	for _, hostile := range []string{"<script>", "DROP"} {
		if strings.Contains(body, hostile) {
			t.Fatalf("response body echoes submitted value %q", hostile)
			return
		}
	}
	seen := map[string]string{}
	for _, e := range doc.Errors {
		seen[e.Field] = e.Rule
	}
	limit := seen["Limit"] ?? ""
	page := seen["Page"] ?? ""
	if limit != "format" || page != "format" {
		t.Fatalf("hostile fields carry rules %q and %q, want format", limit, page)
	}
}

func TestBindBodyOverMaxBody(t *testing.T) {
	r := web.NewRouter()
	r.MaxBody = 16
	web.Route(r, "POST", "/doc", func(ctx *web.Context, in BindDocIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	req := httptest.NewRequest(http.MethodPost, "/doc", strings.NewReader(`{"term":"this is way too long"}`))
	req.Header.Set("Content-Type", "application/json")
	assertProblemJSON(t, call(t, r, req), http.StatusRequestEntityTooLarge)
}

func bindField(obj schema.Object, name string) (string, string, bool) {
	for _, fld := range obj.Fields {
		if fld.Name == name {
			return fld.Wire, fld.Source, true
		}
	}
	return "", "", false
}

func TestRouteInfoCarriesSchemaAndDoc(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/search", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	r.Describe("GET", "/search", web.Doc{Summary: "Search catalog", Returns: []web.Response{{Status: 200}}})
	infos := r.Routes()
	if len(infos) != 1 {
		t.Fatalf("routes hold %d entries, want 1", len(infos))
		return
	}
	obj, ok := infos[0].In.(schema.Object)
	if !ok {
		t.Fatalf("route In is not a schema object")
		return
	}
	wire, source, ok := bindField(obj, "Limit")
	if !ok || wire != "limit" || source != "query" {
		t.Fatalf("route In lacks the limit field")
		return
	}
	_, source, ok = bindField(obj, "Note")
	if !ok || source != "" {
		t.Fatalf("route In lacks the untagged field")
		return
	}
	given := infos[0].Doc
	if given == nil {
		t.Fatalf("route Doc is absent")
		return
	}
	if given.Summary != "Search catalog" {
		t.Fatalf("route Doc summary is not the described summary")
	}
	if len(given.Returns) != 1 || given.Returns[0].Status != 200 {
		t.Fatalf("route Doc lacks the described response")
	}
}

func TestRoutesReturnsACopy(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/a", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	first := r.Routes()
	if len(first) != 1 {
		t.Fatalf("routes hold %d entries, want 1", len(first))
		return
	}
	first[0] = web.RouteInfo{}
	second := r.Routes()
	if len(second) != 1 || second[0].Pattern != "/a" {
		t.Fatalf("second Routes call is affected by the first slice")
	}
}

func TestDescribeUnknownRoutePanics(t *testing.T) {
	r := web.NewRouter()
	defer func() {
		if recover() == nil {
			t.Fatal("Describe of an unknown route did not panic")
		}
	}()
	r.Describe("GET", "/missing", web.Doc{Summary: "Absent"})
}

func TestMalformedFormWithSemicolonQueryIsRejected(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/login", func(ctx *web.Context, in BindLoginIn) (web.Reply, error) {
		return web.Data{Value: in.Username}, nil
	})
	bad := httptest.NewRequest(http.MethodPost, "/login?note=a;b", strings.NewReader("username=ada&password=secret123&%zz"))
	bad.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	doc := assertProblemJSON(t, call(t, r, bad), http.StatusBadRequest)
	if len(doc.Errors) != 1 || doc.Errors[0].Field != "form" {
		t.Fatalf("malformed form errors %+v want one form entry", doc.Errors)
	}
}

func TestSemicolonQueryAloneKeepsTheForm(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/login", func(ctx *web.Context, in BindLoginIn) (web.Reply, error) {
		return web.Data{Value: in.Username}, nil
