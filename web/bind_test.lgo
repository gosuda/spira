func TestMalformedOptionQueryValueIsAFieldError(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/opt", func(ctx *web.Context, in BindOptIn) (web.Reply, error) {
		if in.Q != nil {
			rest := in.Q ?? ""
			return web.Data{Value: $"has:{rest}"}, nil
		}
		return web.Data{Value: "none"}, nil
	})
	doc := assertProblemJSON(t, call(t, r, httptest.NewRequest(http.MethodGet, "/opt?q=%ZZ", nil)), http.StatusBadRequest)
	found := false
	for _, e := range doc.Errors {
		if e.Field == "Q" && e.Rule == "format" {
			found = true
		}
	}
	if !found {
		t.Fatalf("bind errors %+v lack the format Q entry", doc.Errors)
	}
}

func TestBindUnknownJSONMemberNamesAreExact(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "POST", "/doc", func(ctx *web.Context, in BindDocIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	cases := []struct {
		body  string
		field string
	}{
		{`{"term":"go","":1}`, ""},
		{`{"term":"go","a\"b":1}`, `a"b`},
	}
	for _, c := range cases {
		req := httptest.NewRequest(http.MethodPost, "/doc", strings.NewReader(c.body))
		req.Header.Set("Content-Type", "application/json")
		doc := assertProblemJSON(t, call(t, r, req), http.StatusBadRequest)
		if len(doc.Errors) != 1 || doc.Errors[0].Field != c.field || doc.Errors[0].Rule != "unknown" {
			t.Fatalf("unknown member errors %+v want one unknown entry for field %q", doc.Errors, c.field)
		}
	}
}
