func TestDescribeInsideAGroupAttachesTheDoc(t *testing.T) {
	r := web.NewRouter()
	r.Group("/api", func(g *web.Router) {
		web.Route(g, "GET", "/items", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
			return web.Empty{}, nil
		})
		g.Describe("GET", "/items", web.Doc{Summary: "List items"})
	})
	infos := r.Routes()
	if len(infos) != 1 {
		t.Fatalf("routes hold %d entries, want 1", len(infos))
		return
	}
	if infos[0].Pattern != "/api/items" {
		t.Fatalf("route pattern %q want /api/items", infos[0].Pattern)
		return
	}
	given := infos[0].Doc ?? web.Doc{}
	if given.Summary != "List items" {
		t.Fatalf("route Doc summary %q want List items", given.Summary)
	}
}

func TestRoutesDeepCopiesDocReturns(t *testing.T) {
	r := web.NewRouter()
	web.Route(r, "GET", "/search", func(ctx *web.Context, in BindSearchIn) (web.Reply, error) {
		return web.Empty{}, nil
	})
	r.Describe("GET", "/search", web.Doc{Summary: "Search catalog", Returns: []web.Response{{Status: 200}}})
	first := r.Routes()
	held := first[0].Doc ?? web.Doc{}
	held.Returns[0].Status = 999
	second := r.Routes()
	given := second[0].Doc ?? web.Doc{}
	if len(given.Returns) != 1 || given.Returns[0].Status != 200 {
		t.Fatalf("second Routes call sees %+v, want one 200 response", given.Returns)
	}
}

