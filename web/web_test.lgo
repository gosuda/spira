func TestBannedSlotAnswersProblemBeforeAnyPageByte(t *testing.T) {
	later := &view.Later{Fallback: view.T("loading"), Resolve: func(ctx context.Context) (view.Node, error) {
		return view.Tr(view.Td(view.T("row"))), nil
	}}
	body := view.Div(view.T("before-table"), view.Table(view.Tbody(later)))
	r := web.NewRouter()
	r.Layout = func(ctx *web.Context, p web.Page) view.Node {
		return view.Html(view.Body(p.Body, view.P(view.T("footer"))))
	}
	r.Handle("GET", "/page", func(ctx *web.Context) (web.Reply, error) {
		return web.Page{Body: body}, nil
	})
	r.Handle("GET", "/fragment", func(ctx *web.Context) (web.Reply, error) {
		return web.Fragment{Body: body}, nil
	})
	for name, req := range map[string]*http.Request{
		"page layout": httptest.NewRequest(http.MethodGet, "/page", nil),
		"page body":   reqWithHeaders("/page", http.Header{"HX-Request": []string{"true"}}),
		"fragment":    httptest.NewRequest(http.MethodGet, "/fragment", nil),
	} {
		rec := call(t, r, req)
		if rec.Code != http.StatusInternalServerError {
			t.Errorf("%s: status %d want 500", name, rec.Code)
		}
		if strings.Contains(rec.Body.String(), "before-table") {
			t.Errorf("%s: page bytes %q came before the problem", name, rec.Body.String())
		}
	}
}

func TestProblemVaryAcceptOnlyWithView(t *testing.T) {
	withView := web.NewRouter()
	withView.ProblemView = func(p web.Problem) view.Node? {
		var node view.Node = view.P(view.T("problem-view"))
		return node
	}
	withView.Handle("GET", "/thing", goneReply)
	for _, accept := range []string{"application/json", "text/html"} {
		rec := call(t, withView, reqWithHeaders("/thing", http.Header{"Accept": []string{accept}}))
		if got := rec.Header().Get("Vary"); got != "Accept" {
			t.Fatalf("accept %q Vary %q want Accept", accept, got)
		}
	}
	plain := web.NewRouter()
	plain.Handle("GET", "/thing", goneReply)
	rec := call(t, plain, httptest.NewRequest(http.MethodGet, "/thing", nil))
	if got := rec.Header().Get("Vary"); got != "" {
		t.Fatalf("Vary %q set without a problem view", got)
	}
}

func TestProblemNegotiationTable(t *testing.T) {
	r := web.NewRouter()
	r.ProblemView = func(p web.Problem) view.Node? {
		var node view.Node = view.P(view.T("problem-view"))
		return node
	}
	r.Handle("GET", "/thing", goneReply)
	cases := []struct {
		accept string
		html   bool
	}{
		{"application/problem+json, text/html;q=0", false},
		{"text/html;q=0", false},
		{"text/html", true},
		{"application/problem+json;q=0.5, text/html;q=0.9", true},
		{"text/html;q=0.5, application/problem+json;q=0.9", false},
		{"application/json, text/html", false},
		{"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", true},
		{"", false},
	}
	for _, tc := range cases {
		headers := http.Header{}
		if tc.accept != "" {
			headers.Set("Accept", tc.accept)
		}
		rec := call(t, r, reqWithHeaders("/thing", headers))
		ct := rec.Header().Get("Content-Type")
		if tc.html && !strings.HasPrefix(ct, "text/html") {
			t.Fatalf("accept %q chose %q, want html", tc.accept, ct)
		}
		if !tc.html && ct != "application/problem+json" {
			t.Fatalf("accept %q chose %q, want problem json", tc.accept, ct)
		}
	}
}

func TestDelegateHijackUpgrade(t *testing.T) {
	upgrader := http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		rc := http.NewResponseController(w)
		conn, buf, err := rc.Hijack()
		if err != nil {
			http.Error(w, "hijack unavailable: "+err.Error(), http.StatusInternalServerError)
			return
		}
		defer func() {
			if cerr := conn.Close(); cerr != nil {
				t.Errorf("hijacked close: %v", cerr)
			}
		}()
		if _, err := buf.WriteString("HTTP/1.1 101 Switching Protocols\r\n\r\nhello-ws"); err != nil {
			return
		}
		if err := buf.Flush(); err != nil {
			return
		}
	})
	r := web.NewRouter()
	r.Handle("GET", "/ws", func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: upgrader}, nil
	})
	srv := httptest.NewServer(r)
	t.Cleanup(srv.Close)
	conn, err := net.Dial("tcp", strings.TrimPrefix(srv.URL, "http://"))
	if err != nil {
		t.Fatalf("dial: %v", err)
	}
	defer func() {
		if cerr := conn.Close(); cerr != nil {
			t.Errorf("client close: %v", cerr)
		}
	}()
	if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
		t.Fatalf("deadline: %v", err)
	}
	if _, err := fmt.Fprintf(conn, "GET /ws HTTP/1.1\r\nHost: %s\r\n\r\n", strings.TrimPrefix(srv.URL, "http://")); err != nil {
		t.Fatalf("write request: %v", err)
	}
	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		t.Fatalf("read status line: %v", err)
	}
	if got := strings.TrimSpace(line); got != "HTTP/1.1 101 Switching Protocols" {
		t.Fatalf("status line %q want the raw 101 upgrade", got)
	}
	rest, err := io.ReadAll(reader)
	if err != nil {
		t.Fatalf("read payload: %v", err)
	}
	if !strings.Contains(string(rest), "hello-ws") {
		t.Fatalf("payload %q lacks the upgraded frame", string(rest))
	}
}

func TestAsteriskTargetIsRejectedWithoutARedirect(t *testing.T) {
	r := web.NewRouter()
	r.Use(func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			ctx.ResponseHeader().Set("X-Root-Stage", "ran")
			return next(ctx)
		}
	})
	r.Handle("GET", "/users", okReply)
	req := httptest.NewRequest(http.MethodGet, "/", nil)
	req.RequestURI = "*"
	req.URL.Path = "*"
	rec := call(t, r, req)
	if rec.Code != http.StatusBadRequest {
		t.Fatalf("asterisk target status %d want 400", rec.Code)
		return
	}
	if loc := rec.Header().Get("Location"); loc != "" {
		t.Fatalf("asterisk target got a redirect to %q", loc)
		return
	}
	if rec.Header().Get("X-Root-Stage") != "ran" {
		t.Fatal("root stage did not run for the asterisk target")
	}
}

func TestUnmatchedRequestKeepsTheHandlerChosenBeforeStages(t *testing.T) {
	r := web.NewRouter()
	r.Use(func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			if ctx.Request.URL.Path == "/missing" {
				ctx.Request.URL.Path = "/users"
			}
			return next(ctx)
		}
	})
	r.Handle("GET", "/users", okReply)
	rec := call(t, r, httptest.NewRequest(http.MethodGet, "/missing", nil))
	if rec.Code != http.StatusNotFound {
		t.Fatalf("rewritten unmatched path status %d want 404", rec.Code)
	}
}

func TestAsteriskRequestURIUsesTheLiveMuxAnswer(t *testing.T) {
	r := web.NewRouter()
	r.Use(func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			ctx.Request.RequestURI = "*"
			return next(ctx)
		}
	})
	r.Handle("GET", "/users", okReply)
	rec := call(t, r, httptest.NewRequest(http.MethodGet, "/missing", nil))
	if rec.Code != http.StatusBadRequest {
		t.Fatalf("mutated asterisk status %d want 400", rec.Code)
	}
}

func TestUnmatchedChainWrapsAStageOnlyAtUse(t *testing.T) {
	wraps := 0
	runs := 0
	r := web.NewRouter()
	r.Use(func(next web.Handler) web.Handler {
		wraps++
		return func(ctx *web.Context) (web.Reply, error) {
			runs++
			return next(ctx)
		}
	})
	registered := wraps
	for range 3 {
		if miss := call(t, r, httptest.NewRequest(http.MethodGet, "/missing", nil)); miss.Code != http.StatusNotFound {
			t.Fatalf("unmatched path status %d want 404", miss.Code)
		}
	}
	if wraps != registered || runs != 3 {
		t.Fatalf("three unmatched requests wrapped the stage %d more times and ran it %d times, want 0 and 3", wraps-registered, runs)
	}
	r.Use(func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			ctx.ResponseHeader().Set("X-Late-Stage", "ran")
			return next(ctx)
		}
	})
	if late := call(t, r, httptest.NewRequest(http.MethodGet, "/missing", nil)); late.Header().Get("X-Late-Stage") != "ran" {
		t.Fatal("a stage added after the first unmatched request did not run")
	}
}

func TestUnmatchedRequestsRunRootStages(t *testing.T) {
	groupRan := false
	r := web.NewRouter()
	r.Use(func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			ctx.ResponseHeader().Set("X-Root-Stage", "ran")
			return next(ctx)
		}
	})
	r.Handle("GET", "/users", okReply)
	r.Group("/api", func(g *web.Router) {
		g.Use(func(next web.Handler) web.Handler {
			return func(ctx *web.Context) (web.Reply, error) {
				groupRan = true
				return next(ctx)
			}
		})
		g.Handle("GET", "/items", okReply)
	})
	miss := call(t, r, httptest.NewRequest(http.MethodGet, "/missing", nil))
	if miss.Code != http.StatusNotFound {
		t.Fatalf("unmatched path status %d want 404", miss.Code)
	}
	if miss.Header().Get("X-Root-Stage") != "ran" {
		t.Fatal("root stage did not run for an unmatched path")
	}
	wrong := call(t, r, httptest.NewRequest(http.MethodPost, "/users", nil))
	if wrong.Code != http.StatusMethodNotAllowed {
		t.Fatalf("wrong method status %d want 405", wrong.Code)
	}
	if !strings.Contains(wrong.Header().Get("Allow"), "GET") {
		t.Fatalf("Allow %q lacks GET", wrong.Header().Get("Allow"))
	}
	if wrong.Header().Get("X-Root-Stage") != "ran" {
		t.Fatal("root stage did not run for a method mismatch")
	}
	if groupRan {
		t.Fatal("group stage ran for a request outside its prefix")
	}
}

func lateStage() web.Stage {
	return func(next web.Handler) web.Handler {
		return func(ctx *web.Context) (web.Reply, error) {
			ctx.ResponseHeader().Set("X-Late-Stage", "ran")
			return next(ctx)
		}
	}
}

func TestLateUseAppliesToEarlierRoutes(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/hello", okReply)
	if early := call(t, r, httptest.NewRequest(http.MethodGet, "/hello", nil)); early.Header().Get("X-Late-Stage") != "" {
		t.Fatal("stage ran before it was registered")
	}
	r.Use(lateStage())
	if late := call(t, r, httptest.NewRequest(http.MethodGet, "/hello", nil)); late.Header().Get("X-Late-Stage") != "ran" {
		t.Fatal("a stage added after route registration did not run")
	}
}

func TestUseWhileServingDoesNotRace(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/hello", okReply)
	if err := driveServeAndUse(t.Context(), r); err != nil {
		t.Fatalf("concurrent use and serve: %v", err)
	}
}

func driveServeAndUse(ctx context.Context, r *web.Router) error {
	go group (ctx) {
		go serveHello(ctx, r)
		go serveHello(ctx, r)
		go addLateStages(ctx, r)
		go addLateStages(ctx, r)
	}
	return nil
}

func serveHello(ctx context.Context, r *web.Router) error {
	for i := 0; i < 200 && ctx.Err() == nil; i++ {
		rec := httptest.NewRecorder()
		r.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/hello", nil))
		if rec.Code != http.StatusNoContent {
			return fmt.Errorf("web test: status %d", rec.Code)
		}
	}
	return nil
}

func addLateStages(ctx context.Context, r *web.Router) error {
	for i := 0; i < 50 && ctx.Err() == nil; i++ {
		r.Use(lateStage())
	}
	return nil
}
