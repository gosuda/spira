}

func TestH2CRefusedWithoutField(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/hello", func(ctx *web.Context) (web.Reply, error) {
		return web.Data{Value: "hi"}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	client := h2cClient()
	resp, err := client.Get("http://" + addr + "/hello")
	if err == nil {
		if cerr := resp.Body.Close(); cerr != nil {
			t.Errorf("close body: %v", cerr)
		}
		t.Fatalf("h2c request succeeded without H2C, want refusal")
		return
	}
}

func TestServerStopReturnsWithinGraceForH2WhenHandlerNeverReturns(t *testing.T) {
	r := web.NewRouter()
	p := &stuckProbe{entered: make(chan struct{}), release: make(chan struct{})}
	r.Handle("GET", "/stuck", stuckHandler(p))
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 500 * time.Millisecond, H2C: true}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	target := h2Target{client: h2cClient(), url: "http://" + addr + "/stuck"}
	if err := driveStuckH2(context.Background(), s, target, p); err != nil {
		t.Fatalf("drive: %v", err)
		return
	}
	select {
	case <-p.entered:
	default:
		t.Fatal("the h2 request never reached the handler")
		return
	}
	var err error
	p.stopErr.WithLock(func(e *error) { err = *e })
	if err == nil {
		t.Fatal("Stop of a never-returning h2 handler reported success")
		return
	}
	if !strings.Contains(err.Error(), "context deadline exceeded") {
		t.Fatalf("Stop error %q does not name the grace deadline", err.Error())
		return
	}
	var dur time.Duration
	p.stopDur.WithLock(func(d *time.Duration) { dur = *d })
	if dur < 400*time.Millisecond {
		t.Fatalf("Stop returned after %v without waiting out the grace period", dur)
		return
	}
	if dur > 5*time.Second {
		t.Fatalf("Stop returned after %v, beyond the grace period", dur)
		return
	}
}

func TestServerStopClosesH2StreamWhenShutdownTimesOut(t *testing.T) {
	r := web.NewRouter()
	p := &closeProbe{entered: make(chan struct{}), ended: make(chan struct{})}
	r.Handle("GET", "/stream", closeWatchingHandler(p))
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 200 * time.Millisecond, H2C: true}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	target := h2Target{client: h2cClient(), url: "http://" + addr + "/stream"}
	if err := driveCloseH2(context.Background(), s, target, p); err != nil {
		t.Fatalf("drive: %v", err)
		return
	}
	select {
	case <-p.entered:
	default:
		t.Fatal("the h2 request never reached the handler")
		return
	}
	var err error
	p.stopErr.WithLock(func(e *error) { err = *e })
	if err == nil {
		t.Fatal("Stop of an open h2 stream reported success")
		return
	}
	var closed bool
	p.closed.WithLock(func(b *bool) { closed = *b })
	if !closed {
		t.Fatal("the request context of an open h2 stream did not end within 3s after Stop timed out")
		return
	}
}

func TestTrackConnWithoutServerReturnsUntracked(t *testing.T) {
	a, b := net.Pipe()
	tracked, err := web.TrackConn(context.Background(), a)
	if err != nil {
		if cerr := a.Close(); cerr != nil {
			t.Errorf("pipe close: %v", cerr)
		}
		if cerr := b.Close(); cerr != nil {
			t.Errorf("pipe close: %v", cerr)
		}
		t.Fatalf("TrackConn: %v", err)
		return
	}

	defer func() {
		if cerr := tracked.Close(); cerr != nil {
			t.Errorf("tracked close: %v", cerr)
		}
	}()
	defer func() {
		if cerr := b.Close(); cerr != nil {
			t.Errorf("pipe close: %v", cerr)
		}
	}()
	if tracked != a {
		if cerr := a.Close(); cerr != nil {
			t.Errorf("pipe close: %v", cerr)
		}
		t.Fatalf("TrackConn wrapped a connection with no server state")
		return
	}
}
func TestServerClosesSlowHeadersWithinReadHeaderTimeout(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/hello", func(ctx *web.Context) (web.Reply, error) {
		return web.Data{Value: "hi"}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ReadHeaderTimeout: 300 * time.Millisecond}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	conn, derr := net.DialTimeout("tcp", addr, 5*time.Second)
	if derr != nil {
		t.Fatalf("dial: %v", derr)
		return
	}
	defer func() {
		if cerr := conn.Close(); cerr != nil {
			return
		}
	}()
	if _, werr := fmt.Fprintf(conn, "GET /hello HTTP/1.1\r\nHost: %s\r\nX-Stall: ", addr); werr != nil {
		t.Fatalf("write partial headers: %v", werr)
		return
	}
	if derr := conn.SetReadDeadline(time.Now().Add(5 * time.Second)); derr != nil {
		t.Fatalf("set read deadline: %v", derr)
		return
	}
	start := time.Now()
	_, rerr := conn.Read(make([]byte, 1))
	elapsed := time.Since(start)
	if rerr == nil {
		t.Fatal("stalled headers got a response byte")
		return
	}
	if elapsed > 2*time.Second {
		t.Fatalf("stalled headers stayed open %v past the 300ms header timeout", elapsed)
		return
	}
}
