)

func stopServer(t *testing.T, s *web.Server) {
	t.Helper()
	t.Cleanup(func() {
		cctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := s.Stop(cctx); err != nil {
			t.Errorf("cleanup stop: %v", err)
		}
	})
}

type slowProbe struct {
	entered  chan struct{}
	release  chan struct{}
	status   sync.Locked[int]
	fetchErr sync.Locked[error]
	stopErr  sync.Locked[error]
	stopDur  sync.Locked[time.Duration]
}

func fetchSlow(ctx context.Context, url string, p *slowProbe) error {
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
	if err != nil {
		p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("server test: build: %w", err) })
		return nil
	}
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("server test: do: %w", err) })
		return nil
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("server test: close body: %w", cerr) })
		}
	}()
	p.status.WithLock(func(s *int) { *s = resp.StatusCode })
	return nil
}

func waitEntered(ctx context.Context, entered chan struct{}) error {
	select {
	case <-entered:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

func stopSlow(ctx context.Context, s *web.Server, p *slowProbe) error {
	if err := waitEntered(ctx, p.entered); err != nil {
		return err
	}
	start := time.Now()
	err := s.Stop(ctx)
	p.stopDur.WithLock(func(d *time.Duration) { *d = time.Since(start) })
	p.stopErr.WithLock(func(e *error) { *e = err })
	return nil
}

func releaseSlow(ctx context.Context, p *slowProbe) error {
	if err := waitEntered(ctx, p.entered); err != nil {
		return err
	}
	time.Sleep(50 * time.Millisecond)
	close(p.release)
	return nil
}

func driveSlow(ctx context.Context, s *web.Server, url string, p *slowProbe) error {
	go group (ctx) {
		go fetchSlow(ctx, url, p)
		go stopSlow(ctx, s, p)
		go releaseSlow(ctx, p)
	}
	return nil
}

func TestServerStopWaitsForInFlightRequest(t *testing.T) {
	r := web.NewRouter()
	p := &slowProbe{entered: make(chan struct{}), release: make(chan struct{})}
	r.Handle("GET", "/slow", slowHandler(p))
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 5 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	if err := driveSlow(context.Background(), s, "http://"+addr+"/slow", p); err != nil {
		t.Fatalf("drive: %v", err)
	}
	var ferr error
	p.fetchErr.WithLock(func(e *error) { ferr = *e })
	if ferr != nil {
		t.Fatalf("in-flight request failed while stopping: %v", ferr)
	}
	var status int
	p.status.WithLock(func(s *int) { status = *s })
	if status != http.StatusNoContent {
		t.Fatalf("in-flight request status %d want 204", status)
	}
	var serr error
	p.stopErr.WithLock(func(e *error) { serr = *e })
	if serr != nil {
		t.Fatalf("Stop: %v", serr)
	}
	var dur time.Duration
	p.stopDur.WithLock(func(d *time.Duration) { dur = *d })
	if dur < 40*time.Millisecond {
		t.Fatalf("Stop returned after %v, before the in-flight request ended", dur)
	}
}

func TestSecondStartOnTakenPortFails(t *testing.T) {
	s1 := &web.Server{Addr: "127.0.0.1:0", Router: web.NewRouter(), ShutdownGrace: 2 * time.Second}
	if err := s1.Start(context.Background()); err != nil {
		t.Fatalf("first start: %v", err)
	}
	stopServer(t, s1)
	addr := s1.BoundAddrForTest()

	s2 := &web.Server{Addr: addr, Router: web.NewRouter()}
	err := s2.Start(context.Background())
	stopServer(t, s2)

	if err == nil {
		if serr := s1.Stop(context.Background()); serr != nil {
			t.Fatalf("stop first server: %v", serr)
		}
		t.Fatal("second start on a taken port succeeded")
	}
	if !strings.Contains(err.Error(), "listen") {
		t.Fatalf("start error %q does not name the listen failure", err.Error())
	}
	if serr := s1.Stop(context.Background()); serr != nil {
		t.Fatalf("stop first server: %v", serr)
	}
}

func TestServeWithoutTLSCertificateFailsAndKeepsTheListener(t *testing.T) {
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("reserve a listener: %v", err)
		return
	}
	t.Cleanup(func() {
		if cerr := ln.Close(); cerr != nil && !errors.Is(cerr, net.ErrClosed) {
			t.Errorf("listener close: %v", cerr)
		}
	})
	r := web.NewRouter()
	r.Handle("GET", "/hello", func(ctx *web.Context) (web.Reply, error) {
		return web.Data{Value: "hi"}, nil
	})
	s := &web.Server{Router: r, ShutdownGrace: time.Second, TLS: &tls.Config{}}
	serr := s.Serve(context.Background(), ln)
	if serr == nil {
		stopServer(t, s)
		t.Fatal("Serve without a certificate reported success")
		return
	}
	if !strings.Contains(serr.Error(), "certificate") {
		t.Fatalf("Serve error %q does not name the missing certificate", serr.Error())
		return
	}
	if got := s.BoundAddrForTest(); got != "" {
		t.Fatalf("the failed Serve bound %s", got)
		return
	}
	good := &web.Server{Router: r, ShutdownGrace: time.Second}
	if gerr := good.Serve(context.Background(), ln); gerr != nil {
		t.Fatalf("Serve on the kept listener: %v", gerr)
		return
	}
	stopServer(t, good)
	resp, gerr := http.Get("http://" + ln.Addr().String() + "/hello")
	if gerr != nil {
		t.Fatalf("get on the kept listener: %v", gerr)
		return
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			t.Errorf("body close: %v", cerr)
		}
	}()
	bs, rerr := io.ReadAll(resp.Body)
	if rerr != nil {
		t.Fatalf("read hello: %v", rerr)
		return
	}
	if !strings.Contains(string(bs), `"hi"`) {
		t.Fatalf("hello body %q lacks the value", string(bs))
		return
	}
}

func TestStartWithoutTLSCertificateFailsBeforeBinding(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/hello", func(ctx *web.Context) (web.Reply, error) {
		return web.Data{Value: "hi"}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: time.Second, TLS: &tls.Config{}}
	serr := s.Start(context.Background())
	if serr == nil {
		stopServer(t, s)
		t.Fatal("Start without a certificate reported success")
		return
	}
	if !strings.Contains(serr.Error(), "certificate") {
		t.Fatalf("Start error %q does not name the missing certificate", serr.Error())
		return
	}
	if got := s.BoundAddrForTest(); got != "" {
		t.Fatalf("the failed Start bound %s", got)
		return
	}
}

func TestStartWithDynamicCertificateConfigServes(t *testing.T) {
	cert, _ := tlsPair(t)
	r := web.NewRouter()
	r.Handle("GET", "/hello", func(ctx *web.Context) (web.Reply, error) {
		return web.Data{Value: "hi"}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second, TLS: &tls.Config{GetCertificate: func(*tls.ClientHelloInfo) (*tls.Certificate, error) {
		return &cert, nil
	}}}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start with a dynamic certificate: %v", err)
		return
	}
	stopServer(t, s)
	if addr := s.BoundAddrForTest(); addr == "" {
		t.Fatal("the started server bound no address")
	}
}

func TestCloneTLSKeepsTheFloorOnDynamicConfigs(t *testing.T) {
	inner := &tls.Config{MinVersion: tls.VersionTLS12}
	s := &web.Server{TLS: &tls.Config{GetConfigForClient: func(*tls.ClientHelloInfo) (*tls.Config, error) {
		return inner, nil
	}}}
	got := web.CloneTLSForTest(s)
	if got == nil {
		t.Fatal("cloneTLS of a TLS server is absent")
		return
	}
	wrapped := got.GetConfigForClient
	if wrapped == nil {
		t.Fatal("cloneTLS dropped GetConfigForClient")
		return
	}
	out, err := wrapped(&tls.ClientHelloInfo{})
	if err != nil {
		t.Fatalf("dynamic config: %v", err)
		return
	}
	if out == nil || out.MinVersion != tls.VersionTLS13 {
		t.Fatal("the dynamic config bypasses the TLS 1.3 floor")
		return
	}
	if inner.MinVersion != tls.VersionTLS12 {
		t.Fatal("cloneTLS mutated the dynamic config")
		return
	}
	denyInner := &tls.Config{MinVersion: tls.VersionTLS12}
	denied := &web.Server{TLS: &tls.Config{GetConfigForClient: func(*tls.ClientHelloInfo) (*tls.Config, error) {
		return denyInner, errors.New("no certificate")
	}}}
	deniedClone := web.CloneTLSForTest(denied)
	if deniedClone == nil {
		t.Fatal("cloneTLS of a denying server is absent")
		return
	}
	if _, err := deniedClone.GetConfigForClient(&tls.ClientHelloInfo{}); err == nil {
		t.Fatal("a failing dynamic config reports success")
		return
	}
}

type ctxProbe struct {
	slowProbe
	cancelled chan struct{}
	url       string
	reqErr    sync.Locked[error]
}

func cancelThenRelease(ctx context.Context, cancel context.CancelFunc, p *ctxProbe) error {
	if err := waitEntered(ctx, p.entered); err != nil {
		return err
	}
	cancel()
	close(p.cancelled)
	time.Sleep(20 * time.Millisecond)
	close(p.release)
	return nil
}

func stopAfterCancel(ctx context.Context, s *web.Server, p *ctxProbe) error {
	select {
	case <-p.cancelled:
	case <-ctx.Done():
		return ctx.Err()
	}
	p.stopErr.WithLock(func(e *error) { *e = s.Stop(ctx) })
	return nil
}

func driveContextCancel(ctx context.Context, s *web.Server, cancel context.CancelFunc, p *ctxProbe) error {
	go group (ctx) {
		go fetchSlow(ctx, p.url, &p.slowProbe)
		go cancelThenRelease(ctx, cancel, p)
		go stopAfterCancel(ctx, s, p)
	}
	return nil
}

func TestServerServesAfterStartContextCancel(t *testing.T) {
	r := web.NewRouter()
	p := &ctxProbe{
		slowProbe: slowProbe{entered: make(chan struct{}), release: make(chan struct{})},
		cancelled: make(chan struct{}),
	}
	r.Handle("GET", "/slow", watchedHandler(p))
	startCtx, cancel := context.WithCancel(context.Background())
	defer cancel()
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 5 * time.Second}
	if err := s.Start(startCtx); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	p.url = "http://" + addr + "/slow"

	if err := driveContextCancel(context.Background(), s, cancel, p); err != nil {
		t.Fatalf("drive: %v", err)
	}
	var status int
	p.status.WithLock(func(v *int) { status = *v })
	if status != http.StatusOK {
		t.Fatalf("in-flight request status %d want 200 after start-context cancel", status)
	}
	var ferr error
	p.fetchErr.WithLock(func(e *error) { ferr = *e })
	if ferr != nil {
		t.Fatalf("in-flight request failed: %v", ferr)
	}
	var rerr error
	p.reqErr.WithLock(func(e *error) { rerr = *e })
	if rerr != nil {
		t.Fatalf("request context did not outlive the start context: %v", rerr)
	}
	var serr error
	p.stopErr.WithLock(func(e *error) { serr = *e })
	if serr != nil {
		t.Fatalf("Stop after start-context cancel: %v", serr)
	}
}

func slowHandler(p *slowProbe) web.Handler {
	return func(ctx *web.Context) (web.Reply, error) {
		close(p.entered)
		select {
		case <-p.release:
		case <-ctx.Ctx().Done():
			return nil, fmt.Errorf("server test: request context ended: %w", ctx.Ctx().Err())
		}
		return web.Empty{}, nil
	}
}

func watchedHandler(p *ctxProbe) web.Handler {
	return func(ctx *web.Context) (web.Reply, error) {
		close(p.entered)
		select {
		case <-p.release:
		case <-ctx.Ctx().Done():
			return nil, fmt.Errorf("server test: request context ended: %w", ctx.Ctx().Err())
		}
		if err := ctx.Request.Context().Err(); err != nil {
			p.reqErr.WithLock(func(e *error) { *e = fmt.Errorf("server test: request context ended with %w", err) })
		}
		return web.Data{Value: "done"}, nil
	}
}

type stuckProbe struct {
	entered    chan struct{}
	release    chan struct{}
	stopWithin time.Duration = time.Minute
	stopErr    sync.Locked[error]
	stopDur    sync.Locked[time.Duration]
	fetchErr   sync.Locked[error]
}

func fetchStuck(url string) error {
	resp, err := http.Get(url)
	if err != nil {
		return nil
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			return
		}
	}()
	return nil
}

func stopStuck(ctx context.Context, s *web.Server, p *stuckProbe) error {
	if err := waitEntered(ctx, p.entered); err != nil {
		p.stopErr.WithLock(func(e *error) { *e = fmt.Errorf("server test: wait entered: %w", err) })
		return nil
	}
	time.Sleep(50 * time.Millisecond)
	stopCtx, cancel := context.WithTimeout(ctx, p.stopWithin)
	defer cancel()
	start := time.Now()
	p.stopErr.WithLock(func(e *error) { *e = s.Stop(stopCtx) })
	p.stopDur.WithLock(func(d *time.Duration) { *d = time.Since(start) })
	close(p.release)
	return nil
}

func driveStuck(ctx context.Context, s *web.Server, url string, p *stuckProbe) error {
	go group (ctx) {
		go fetchStuck(url)
		go stopStuck(ctx, s, p)
	}
	return nil
}

func stuckHandler(p *stuckProbe) web.Handler {
	return func(ctx *web.Context) (web.Reply, error) {
		close(p.entered)
		select {
		case <-p.release:
		case <-ctx.Ctx().Done():
			return nil, fmt.Errorf("server test: request context ended: %w", ctx.Ctx().Err())
		}
		return web.Empty{}, nil
	}
}

func TestServerStopReturnsWithinGraceWhenHandlerNeverReturns(t *testing.T) {
	r := web.NewRouter()
	p := &stuckProbe{entered: make(chan struct{}), release: make(chan struct{})}
	r.Handle("GET", "/stuck", stuckHandler(p))
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 500 * time.Millisecond}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	if err := driveStuck(context.Background(), s, "http://"+addr+"/stuck", p); err != nil {
		t.Fatalf("drive: %v", err)
	}
	var err error
	p.stopErr.WithLock(func(e *error) { err = *e })
	if err == nil {
		t.Fatal("Stop of a never-returning handler reported success")
	}
	if !strings.Contains(err.Error(), "context deadline exceeded") {
		t.Fatalf("Stop error %q does not name the grace deadline", err)
	}
	var dur time.Duration
	p.stopDur.WithLock(func(d *time.Duration) { dur = *d })
	if dur < 400*time.Millisecond {
		t.Fatalf("Stop returned after %v without waiting out the grace period", dur)
	}
	if dur > 5*time.Second {
		t.Fatalf("Stop returned after %v, beyond the grace period", dur)
	}
}

func TestServerStopReturnsByTheCallerDeadline(t *testing.T) {
	r := web.NewRouter()
	p := &stuckProbe{entered: make(chan struct{}), release: make(chan struct{}), stopWithin: 300 * time.Millisecond}
	r.Handle("GET", "/stuck", stuckHandler(p))
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 5 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	if err := driveStuck(context.Background(), s, "http://"+addr+"/stuck", p); err != nil {
		t.Fatalf("drive: %v", err)
	}
	var err error
	p.stopErr.WithLock(func(e *error) { err = *e })
	if err == nil {
		t.Fatal("Stop of a never-returning handler reported success")
	}
	var dur time.Duration
	p.stopDur.WithLock(func(d *time.Duration) { dur = *d })
	if dur < 250*time.Millisecond {
		t.Fatalf("Stop returned after %v, before the caller deadline of 300ms", dur)
	}
	if dur > 2*time.Second {
		t.Fatalf("Stop returned after %v; the caller deadline was 300ms and the grace period 5s", dur)
	}
}

type closeProbe struct {
	entered  chan struct{}
	ended    chan struct{}
	stopErr  sync.Locked[error]
	closed   sync.Locked[bool]
	fetchErr sync.Locked[error]
}

func closeWatchingHandler(p *closeProbe) web.Handler {
	return func(ctx *web.Context) (web.Reply, error) {
		close(p.entered)
		select {
		case <-ctx.Ctx().Done():
			close(p.ended)
		case <-time.After(10 * time.Second):
		}
		return web.Empty{}, nil
	}
}

func stopAndWatch(ctx context.Context, s *web.Server, p *closeProbe) error {
	if err := waitEntered(ctx, p.entered); err != nil {
		p.stopErr.WithLock(func(e *error) { *e = fmt.Errorf("server test: wait entered: %w", err) })
		return nil
	}
	p.stopErr.WithLock(func(e *error) { *e = s.Stop(ctx) })
	select {
	case <-p.ended:
		p.closed.WithLock(func(b *bool) { *b = true })
	case <-time.After(3 * time.Second):
	}
	return nil
}

func driveClose(ctx context.Context, s *web.Server, url string, p *closeProbe) error {
	go group (ctx) {
		go fetchStuck(url)
		go stopAndWatch(ctx, s, p)
	}
	return nil
}

func TestServerStopClosesOpenConnectionsWhenShutdownTimesOut(t *testing.T) {
	r := web.NewRouter()
	p := &closeProbe{entered: make(chan struct{}), ended: make(chan struct{})}
	r.Handle("GET", "/stream", closeWatchingHandler(p))
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 200 * time.Millisecond}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	if err := driveClose(context.Background(), s, "http://"+addr+"/stream", p); err != nil {
		t.Fatalf("drive: %v", err)
	}
	var err error
	p.stopErr.WithLock(func(e *error) { err = *e })
	if err == nil {
		t.Fatal("Stop of an open stream reported success")
	}
	var closed bool
	p.closed.WithLock(func(b *bool) { closed = *b })
	if !closed {
		t.Fatal("the request context of an open stream did not end within 3s after Stop timed out")
	}
}

func holdUpgraded(t *testing.T) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		conn, buf, err := http.NewResponseController(w).Hijack()
		if err != nil {
			http.Error(w, "hijack unavailable: "+err.Error(), http.StatusInternalServerError)
			return
		}
		defer func() {
			if cerr := conn.Close(); cerr != nil && !errors.Is(cerr, net.ErrClosed) {
				t.Errorf("upgraded close: %v", cerr)
			}
		}()
		if _, err := buf.WriteString("HTTP/1.1 101 Switching Protocols\r\n\r\n"); err != nil {
			return
		}
		if err := buf.Flush(); err != nil {
			return
		}
		if _, err := io.Copy(io.Discard, conn); err != nil && !errors.Is(err, net.ErrClosed) {
			t.Errorf("upgraded read: %v", err)
		}
	})
}

func dialUpgraded(t *testing.T, addr string) (net.Conn, *bufio.Reader) {
	t.Helper()
	conn, err := net.Dial("tcp", addr)
	if err != nil {
		t.Fatalf("dial: %v", err)
	}
	t.Cleanup(func() {
		if cerr := conn.Close(); cerr != nil && !errors.Is(cerr, net.ErrClosed) {
			t.Errorf("client close: %v", cerr)
		}
	})
	if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
		t.Fatalf("deadline: %v", err)
	}
	if _, err := fmt.Fprintf(conn, "GET /ws HTTP/1.1\r\nHost: %s\r\n\r\n", addr); err != nil {
		t.Fatalf("write request: %v", err)
	}
	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		t.Fatalf("read status line: %v", err)
	}
	if got := strings.TrimSpace(line); got != "HTTP/1.1 101 Switching Protocols" {
		t.Fatalf("status line %q want the raw 101 upgrade", got)
	}
	for {
		head, herr := reader.ReadString('\n')
		if herr != nil {
			t.Fatalf("read upgrade headers: %v", herr)
		}
		if strings.TrimSpace(head) == "" {
			break
		}
	}
	return conn, reader
}

func wantClosedByServer(t *testing.T, conn net.Conn, reader *bufio.Reader) {
	t.Helper()
	if err := conn.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
		t.Fatalf("read deadline: %v", err)
	}
	if _, err := io.ReadAll(reader); err != nil {
		t.Fatalf("the upgraded connection is still open after Stop: %v", err)
	}
}

func TestServerStopClosesAnUpgradedConnection(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/ws", func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: holdUpgraded(t)}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	conn, reader := dialUpgraded(t, addr)
	if err := s.Stop(context.Background()); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	wantClosedByServer(t, conn, reader)
}

func TestServerStopClosesAnUpgradedConnectionAfterTheGrace(t *testing.T) {
	entered := make(chan struct{})
	release := make(chan struct{})
	hijacked := make(chan struct{})
	var late sync.Locked[error]
	lateUpgrade := http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		close(entered)
		<-release
		_, _, err := http.NewResponseController(w).Hijack()
		late.WithLock(func(e *error) { *e = err })
		close(hijacked)
	})
	r := web.NewRouter()
	r.Handle("GET", "/ws", func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: holdUpgraded(t)}, nil
	})
	r.Handle("GET", "/stuck", func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: lateUpgrade}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 200 * time.Millisecond}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	conn, reader := dialUpgraded(t, addr)
	stuck, err := net.Dial("tcp", addr)
	if err != nil {
		t.Fatalf("dial stuck: %v", err)
	}
	t.Cleanup(func() {
		if cerr := stuck.Close(); cerr != nil && !errors.Is(cerr, net.ErrClosed) {
			t.Errorf("stuck close: %v", cerr)
		}
	})
	if _, err := fmt.Fprintf(stuck, "GET /stuck HTTP/1.1\r\nHost: %s\r\n\r\n", addr); err != nil {
		t.Fatalf("write stuck request: %v", err)
	}
	wctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := waitEntered(wctx, entered); err != nil {
		t.Fatalf("the stuck handler did not start: %v", err)
	}
	stopErr := s.Stop(context.Background())
	close(release)
	if stopErr == nil || !strings.Contains(stopErr.Error(), "web: shutdown: ") {
		t.Fatalf("Stop error = %v, want the shutdown timeout", stopErr)
	}
	wantClosedByServer(t, conn, reader)
	if err := waitEntered(wctx, hijacked); err != nil {
		t.Fatalf("the late Hijack did not return: %v", err)
	}
	var lerr error
	late.WithLock(func(e *error) { lerr = *e })
	if lerr == nil || !strings.Contains(lerr.Error(), "web: server is stopping") {
		t.Fatalf("Hijack after Stop = %v, want web: server is stopping", lerr)
	}
	wantClosedByServer(t, stuck, bufio.NewReader(stuck))
}

func TestServerForgetsAnUpgradedConnectionThatItsHandlerCloses(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/ws", func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: holdUpgraded(t)}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	conn, _ := dialUpgraded(t, addr)
	if open := s.UpgradedConnections(); open != 1 {
		t.Fatalf("the server tracks %d upgraded connections, want 1", open)
	}
	if err := conn.Close(); err != nil {
		t.Fatalf("client close: %v", err)
	}
	deadline := time.Now().Add(2 * time.Second)
	for s.UpgradedConnections() != 0 {
		if time.Now().After(deadline) {
			t.Fatalf("the server still tracks %d upgraded connections after the handler closed its own", s.UpgradedConnections())
		}
		time.Sleep(5 * time.Millisecond)
	}
	if err := s.Stop(context.Background()); err != nil {
		t.Fatalf("Stop: %v", err)
	}
}

func TestServerAnswersOptionsAsteriskWith400(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/users", func(ctx *web.Context) (web.Reply, error) {
		return web.Empty{}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	conn, err := net.Dial("tcp", addr)
	if err != nil {
		t.Fatalf("dial: %v", err)
		return
	}
	defer func() {
		if cerr := conn.Close(); cerr != nil && !errors.Is(cerr, net.ErrClosed) {
			t.Errorf("client close: %v", cerr)
		}
	}()
	if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
		t.Fatalf("deadline: %v", err)
		return
	}
	if _, err := fmt.Fprintf(conn, "OPTIONS * HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n", addr); err != nil {
		t.Fatalf("write request: %v", err)
		return
	}
	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		t.Fatalf("read status line: %v", err)
		return
	}
	if got := strings.TrimSpace(line); got != "HTTP/1.1 400 Bad Request" {
		t.Fatalf("OPTIONS * status %q want %q", got, "HTTP/1.1 400 Bad Request")
	}
}

type tunnelProbe struct {
	half    chan bool
	gotPing chan struct{}
}

func readTunnel(t *testing.T, p *tunnelProbe, conn net.Conn) {
	t.Helper()
	cw, cwOk := conn.(interface{ CloseWrite() error })
	_, crOk := conn.(interface{ CloseRead() error })
	ok := cwOk && crOk
	if ok {
		if err := cw.CloseWrite(); err != nil {
			t.Errorf("tunnel CloseWrite: %v", err)
			return
		}
	}
	select {
	case p.half <- ok:
	default:
	}
	if !ok {
		return
	}
	tmp := make([]byte, 4)
	if _, rerr := io.ReadFull(conn, tmp); rerr != nil {
		if !errors.Is(rerr, io.EOF) && !errors.Is(rerr, net.ErrClosed) {
			t.Errorf("tunnel read: %v", rerr)
		}
		return
	}
	close(p.gotPing)
	if _, err := io.Copy(io.Discard, conn); err != nil && !errors.Is(err, net.ErrClosed) {
		t.Errorf("tunnel drain: %v", err)
	}
}

func halfCloseTunnel(t *testing.T, p *tunnelProbe) http.Handler {
	t.Helper()
	return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		conn, buf, err := http.NewResponseController(w).Hijack()
		if err != nil {
			http.Error(w, "hijack unavailable: "+err.Error(), http.StatusInternalServerError)
			return
		}
		defer func() {
			if cerr := conn.Close(); cerr != nil && !errors.Is(cerr, net.ErrClosed) {
				t.Errorf("tunnel close: %v", cerr)
			}
		}()
		if _, err := buf.WriteString("HTTP/1.1 101 Switching Protocols\r\n\r\nready"); err != nil {
			return
		}
		if err := buf.Flush(); err != nil {
			return
		}
		readTunnel(t, p, conn)
	})
}

func TestUpgradedConnectionKeepsTCPHalfClose(t *testing.T) {
	p := &tunnelProbe{half: make(chan bool, 1), gotPing: make(chan struct{})}
	r := web.NewRouter()
	r.Handle("GET", "/ws", func(ctx *web.Context) (web.Reply, error) {
		return web.Delegate{To: halfCloseTunnel(t, p)}, nil
	})
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()

	conn, reader := dialUpgraded(t, addr)
	ready := make([]byte, 5)
	if _, err := io.ReadFull(reader, ready); err != nil || string(ready) != "ready" {
		t.Fatalf("tunnel opened with %q: %v", string(ready), err)
		return
	}
	select {
	case ok := <-p.half:
		if !ok {
			t.Fatal("hijacked connection lacks CloseWrite, want TCP half-close")
			return
		}
	case <-time.After(5 * time.Second):
		t.Fatal("tunnel handler did not reach half-close")
		return
	}
	if n, rerr := reader.Read(make([]byte, 1)); !errors.Is(rerr, io.EOF) {
		t.Fatalf("read after half-close = %d bytes %v, want EOF", n, rerr)
		return
	}
	if _, err := conn.Write([]byte("ping")); err != nil {
		t.Fatalf("write after half-close: %v", err)
		return
	}
	select {
	case <-p.gotPing:
	case <-time.After(5 * time.Second):
		t.Fatal("tunnel handler did not read the ping")
		return
	}
	if open := s.UpgradedConnections(); open != 1 {
		t.Fatalf("the server tracks %d upgraded connections after a half-close, want 1", open)
		return
	}
	if err := conn.Close(); err != nil {
		t.Fatalf("client close: %v", err)
		return
	}
	if err := s.Stop(context.Background()); err != nil {
		t.Fatalf("Stop: %v", err)
	}
}

func TestUpgradedConnectionWithoutHalfCloseReportsNamedError(t *testing.T) {
	a, b := net.Pipe()
	defer func() {
		if cerr := a.Close(); cerr != nil {
			t.Errorf("pipe close: %v", cerr)
		}
	}()
	defer func() {
		if cerr := b.Close(); cerr != nil {
			t.Errorf("pipe close: %v", cerr)
		}
	}()
	w := web.WrapConnForTest(a)
	cw, ok := w.(interface{ CloseWrite() error })
	if !ok {
		t.Fatal("wrapped connection lost CloseWrite")
		return
	}
	if err := cw.CloseWrite(); err == nil || !strings.Contains(err.Error(), "CloseWrite not supported") {
		t.Fatalf("CloseWrite error = %v, want the named error", err)
		return
	}
	cr, ok := w.(interface{ CloseRead() error })
	if !ok {
		t.Fatal("wrapped connection lost CloseRead")
		return
	}
	if err := cr.CloseRead(); err == nil || !strings.Contains(err.Error(), "CloseRead not supported") {
		t.Fatalf("CloseRead error = %v, want the named error", err)
	}
}
func tlsPair(t *testing.T) (tls.Certificate, *x509.CertPool?) {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatalf("generate key: %v", err)
		return tls.Certificate{}, nil
	}
	now := time.Now()
	tmpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "example.com"}, NotBefore: now.Add(-1 * time.Hour), NotAfter: now.Add(24 * time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, BasicConstraintsValid: true, DNSNames: []string{"example.com"}, IPAddresses: []net.IP{net.ParseIP("127.0.0.1")}}
	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
	if err != nil {
		t.Fatalf("create certificate: %v", err)
		return tls.Certificate{}, nil
	}
	leaf, err := x509.ParseCertificate(der)
	if err != nil {
		t.Fatalf("parse certificate: %v", err)
		return tls.Certificate{}, nil
	}
	pool := x509.NewCertPool()
	pool.AddCert(leaf)
	cert := tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
	return cert, pool
}

func h2cClient() *http.Client {
	protos := &http.Protocols{}
	protos.SetUnencryptedHTTP2(true)
	tr := &http.Transport{Protocols: protos}
	return &http.Client{Transport: tr}
}

func h2TLSClient(pool *x509.CertPool) *http.Client {
	tr := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: pool}, ForceAttemptHTTP2: true}
	return &http.Client{Transport: tr}
}

type h2Target struct {
	client *http.Client
	url    string
}

func fetchH2(client *http.Client, url string) error {
	resp, err := client.Get(url)
	if err != nil {
		return err
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			return
		}
	}()
	return nil
}

func fetchStuckH2(client *http.Client, url string) error {
	resp, err := client.Get(url)
	if err != nil {
		return err
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			return
		}
	}()
	return nil
}

func recordFetchH2(target h2Target, p *closeProbe) error {
	if err := fetchH2(target.client, target.url); err != nil {
		p.fetchErr.WithLock(func(e *error) { *e = err })
	}
	return nil
}

func recordFetchStuckH2(target h2Target, p *stuckProbe) error {
	if err := fetchStuckH2(target.client, target.url); err != nil {
		p.fetchErr.WithLock(func(e *error) { *e = err })
	}
	return nil
}

func driveCloseH2(ctx context.Context, s *web.Server, target h2Target, p *closeProbe) error {
	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
	defer cancel()
	go group (ctx) {
		go recordFetchH2(target, p)
		go stopAndWatch(ctx, s, p)
	}
	return nil
}

func driveStuckH2(ctx context.Context, s *web.Server, target h2Target, p *stuckProbe) error {
	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
	defer cancel()
	go group (ctx) {
		go recordFetchStuckH2(target, p)
		go stopStuck(ctx, s, p)
	}
	return nil
}
func TestTLSServesHTTP2(t *testing.T) {
	r := web.NewRouter()
	r.Handle("GET", "/hello", func(ctx *web.Context) (web.Reply, error) {
		return web.Data{Value: "hi"}, nil
	})
	cert, pool := tlsPair(t)
	if pool == nil {
		t.Fatal("cert pool missing")
		return
	}
	s := &web.Server{Addr: "127.0.0.1:0", Router: r, ShutdownGrace: 2 * time.Second, TLS: &tls.Config{Certificates: []tls.Certificate{cert}}}
	if err := s.Start(context.Background()); err != nil {
		t.Fatalf("start: %v", err)
		return
	}
	stopServer(t, s)
	addr := s.BoundAddrForTest()
	client := h2TLSClient(pool)
	resp, err := client.Get("https://" + addr + "/hello")
	if err != nil {
		t.Fatalf("get: %v", err)
		return
	}
	defer func() {
		if cerr := resp.Body.Close(); cerr != nil {
			t.Errorf("close body: %v", cerr)
		}
	}()
	if resp.Proto != "HTTP/2.0" {
		t.Fatalf("proto %q want HTTP/2.0", resp.Proto)
		return
	}
}

