package web

import (
	"bufio"
	"context"
	"encoding/json/v2"
	"errors"
	"log/slog"
	"net"
	"net/http"

	"logos/sync"

	"github.com/gosuda/spira/fault"
	"github.com/gosuda/spira/schema"
	"github.com/gosuda/spira/view"
)

type Handler func(ctx *Context) (Reply, error)

type Stage func(next Handler) Handler
type RouteInfo struct {
	Method  string
	Pattern string
	In      schema.Schema
	Doc     Doc?
}

type routeList struct {
	items sync.Locked[[]RouteInfo]
}

type routeCell struct {
	handler Handler
	current sync.Locked[http.Handler]
}

func (c *routeCell) ServeHTTP(w http.ResponseWriter, req *http.Request) {
	var current http.Handler
	c.current.WithLock(func(h *http.Handler) { current = *h })
	current.ServeHTTP(w, req)
}

type Router struct {
	mux         *http.ServeMux
	prefix      string
	root        *Router?
	stages      sync.Locked[[]Stage]
	install     sync.Locked[struct{}]
	registered  sync.Locked[[]*routeCell]
	routes      *routeList
	unmatched   sync.Locked[func(c *Context)]
	Layout      func(ctx *Context, p Page) view.Node
	ProblemView func(p Problem) view.Node?
	MaxBody     int64 = 1 << 20
}

func NewRouter() *Router {
	r := &Router{mux: http.NewServeMux(), routes: &routeList{}}
	r.unmatched.WithLock(func(u *func(c *Context)) { *u = chain(r, nil, delegateUnrouted) })
	return r
}

func (r *Router) rootRouter() *Router {
	if root := r.root; root != nil {
		return root
	}
	return r
}

func (r *Router) Use(stages ...Stage) {
	r.install.WithLock(func(*struct{}) {
		var now []Stage
		var cells []*routeCell
		r.stages.WithLock(func(list *[]Stage) {
			*list = append(*list, stages...)
			now = append(now, (*list)...)
			r.registered.WithLock(func(registered *[]*routeCell) { cells = append(cells, (*registered)...) })
		})
		if r.root == nil {
			r.unmatched.WithLock(func(u *func(c *Context)) { *u = chain(r, now, delegateUnrouted) })
		}
		for _, cell := range cells {
			fresh := served(r.rootRouter(), now, cell.handler)
			cell.current.WithLock(func(h *http.Handler) { *h = fresh })
		}
	})
}

func (r *Router) Group(prefix string, build func(g *Router)) {
	g := &Router{
		mux:    r.mux,
		prefix: r.prefix + prefix,
		routes: r.routes,
		root:   r.rootRouter(),
	}
	r.stages.WithLock(func(list *[]Stage) {
		g.stages.WithLock(func(glist *[]Stage) { *glist = append(*glist, (*list)...) })
	})
	build(g)
}

func (r *Router) remember(h Handler) *routeCell {
	cell := &routeCell{handler: h}
	r.install.WithLock(func(*struct{}) {
		var now []Stage
		r.stages.WithLock(func(list *[]Stage) {
			now = append(now, (*list)...)
			r.registered.WithLock(func(registered *[]*routeCell) { *registered = append(*registered, cell) })
		})
		cell.current.WithLock(func(cur *http.Handler) { *cur = served(r.rootRouter(), now, h) })
	})
	return cell
}

func (r *Router) Handle(method string, pattern string, h Handler) {
	full := fullPattern(r.prefix, pattern)
	r.record(method, full)
	r.mux.Handle(method+" "+full, r.remember(h))
}
func (r *Router) record(method string, pattern string) {
	r.recordRoute(method, pattern, nil, nil)
}

func (r *Router) recordRoute(method string, pattern string, in schema.Schema, doc Doc?) {
	r.routes.items.WithLock(func(list *[]RouteInfo) {
		*list = append(*list, RouteInfo{Method: method, Pattern: pattern, In: in, Doc: doc})
	})
}

func (r *Router) Routes() []RouteInfo {
	var out []RouteInfo
	r.routes.items.WithLock(func(list *[]RouteInfo) {
		for i := range *list {
			info := (*list)[i]
			if info.Doc != nil {
				held := info.Doc ?? Doc{}
				fresh := make([]Response, len(held.Returns))
				copy(fresh, held.Returns)
				held.Returns = fresh
				info.Doc = held
			}
			out = append(out, info)
		}
	})
	return out
}

func (r *Router) ServeHTTP(w http.ResponseWriter, req *http.Request) {
	_, pattern := r.mux.Handler(req)
	if pattern != "" {
		r.mux.ServeHTTP(w, req)
		return
	}
	root := r.rootRouter()
	c := newContext(w, req, root)
	unrouted, _ := root.mux.Handler(req)
	c.fallback = unrouted
	var unmatched func(c *Context)
	root.unmatched.WithLock(func(u *func(c *Context)) { unmatched = *u })
	unmatched(c)
}

func delegateUnrouted(c *Context) (Reply, error) {
	if c.Request.RequestURI == "*" {
		return Delegate{To: c.root.mux}, nil
	}
	if c.fallback != nil {
		return Delegate{To: c.fallback}, nil
	}
	unrouted, _ := c.root.mux.Handler(c.Request)
	return Delegate{To: unrouted}, nil
}

func served(root *Router, stages []Stage, h Handler) http.HandlerFunc {
	run := chain(root, stages, h)
	return func(w http.ResponseWriter, req *http.Request) {
		run(newContext(w, req, root))
	}
}

func chain(root *Router, stages []Stage, h Handler) func(c *Context) {
	run := settle(root, h)
	for i := len(stages) - 1; i >= 0; i-- {
		inner := run
		run = settle(root, stages[i](func(c *Context) (Reply, error) {
			inner(c)
			return nil, nil
		}))
	}
	return run
}

func settle(root *Router, h Handler) func(c *Context) {
	return func(c *Context) {
		reply, err := h(c)
		if err != nil {
			root.answerError(c, err)
			return
		}
		root.answerReply(c, reply)
	}
}

func (r *Router) answerReply(c *Context, reply Reply) {
	if reply == nil {
		return
	}
	if c.writer.wrote {
		slog.Error("web: reply dropped, the response is already written", "method", c.Request.Method, "path", c.Request.URL.Path)
		return
	}
	if werr := r.writeReply(c, reply); werr != nil {
		slog.Error("web: reply write failed", "error", werr)
		r.answerProblem(c, internalProblem())
	}
}

func (r *Router) answerError(c *Context, err error) {
	if c.writer.wrote {
		slog.Error("web: error after the response was written", "method", c.Request.Method, "path", c.Request.URL.Path, "error", err)
		return
	}
	pe := &ProblemError{}
	if errors.As(err, &pe) {
		r.answerProblem(c, pe.Problem)
		return
	}
	if f := fault.Of(err); f != nil {
		status := statusForKind(f.Kind)
		if status >= http.StatusInternalServerError {
			slog.Error("web: handler failed", "method", c.Request.Method, "path", c.Request.URL.Path, "error", err)
		}
		r.answerFault(c, err, status)
		return
	}
	slog.Error("web: handler failed", "method", c.Request.Method, "path", c.Request.URL.Path, "error", err)
	r.answerFault(c, err, http.StatusInternalServerError)
}

const statusClientClosed = 499

func statusForKind(k fault.Kind) int {
	switch k {
	case fault.Invalid:
		return http.StatusBadRequest
	case fault.Unprocessable:
		return http.StatusUnprocessableEntity
	case fault.Unauthenticated:
		return http.StatusUnauthorized
	case fault.Forbidden:
		return http.StatusForbidden
	case fault.NotFound:
		return http.StatusNotFound
	case fault.Conflict:
		return http.StatusConflict
	case fault.TooLarge:
		return http.StatusRequestEntityTooLarge
	case fault.RateLimited:
		return http.StatusTooManyRequests
	case fault.Canceled:
		return statusClientClosed
	case fault.Timeout:
		return http.StatusGatewayTimeout
	case fault.Unavailable:
		return http.StatusServiceUnavailable
	case fault.Internal:
		return http.StatusInternalServerError
	}
	return http.StatusInternalServerError
}

func (r *Router) answerFault(c *Context, err error, status int) {
	if c.writer.wrote {
		return
	}
	b, merr := json.Marshal(fault.Public(err))
	if merr != nil {
		slog.Error("web: encode fault", "error", merr)
		r.answerProblem(c, internalProblem())
		return
	}
	w := c.writer
	w.Header().Set("Content-Type", "application/problem+json")
	writeHead(c, status)
	if _, werr := w.Write(b); werr != nil {
		slog.Error("web: write fault", "error", werr)
	}
}

func (r *Router) answerProblem(c *Context, p Problem) {
	if c.writer.wrote {
		return
	}
	if perr := r.writeProblem(c, p); perr != nil {
		slog.Error("web: problem write failed", "error", perr)
	}
}

func internalProblem() Problem {
	return Problem{Title: "Internal Server Error", Status: http.StatusInternalServerError}
}

type Key[T any] struct {
	name string
}

func NewKey[T any](name string) *Key[T] {
	return &Key[T]{name: name}
}

func Get[T any](ctx *Context, k *Key[T]) T? {
	var out T?
	ctx.vals.WithLock(func(m *map[any]any) {
		if v, ok := (*m)[any(k)]; ok {
			if tv, tok := v.(T); tok {
				out = tv
			}
		}
	})
	return out
}

func Set[T any](ctx *Context, k *Key[T], v T) {
	ctx.vals.WithLock(func(m *map[any]any) {
		(*m)[any(k)] = v
	})
}

type Context struct {
	Request  *http.Request
	writer   *statusWriter
	root     *Router
	vals     sync.Locked[map[any]any]
	fallback http.Handler
}

func newContext(w http.ResponseWriter, req *http.Request, root *Router) *Context {
	c := &Context{Request: req, writer: newStatusWriter(w, req), root: root}
	c.vals.WithLock(func(m *map[any]any) {
		*m = map[any]any{}
	})
	return c
}

func (c *Context) Ctx() context.Context {
	if c.Request == nil {
		return context.Background()
	}
	return c.Request.Context()
}

func (c *Context) ResponseHeader() http.Header {
	return c.writer.Header()
}

func (c *Context) Htmx() Htmx {
	h := c.Request.Header
	return Htmx{
		Request:        h.Get("HX-Request") != "",
		Boosted:        h.Get("HX-Boosted") != "",
		HistoryRestore: h.Get("HX-History-Restore-Request") != "",
		Target:         h.Get("HX-Target"),
		Trigger:        h.Get("HX-Trigger"),
		CurrentURL:     h.Get("HX-Current-URL"),
	}
}

type Htmx struct {
	Request        bool
	Boosted        bool
	HistoryRestore bool
	Target         string
	Trigger        string
	CurrentURL     string
}

type statusWriter struct {
	inner  http.ResponseWriter
	req    *http.Request
	status int
	wrote  bool
}

func newStatusWriter(inner http.ResponseWriter, req *http.Request) *statusWriter {
	return &statusWriter{inner: inner, req: req, status: http.StatusOK}
}

func (s *statusWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
	conn, buf, err := http.NewResponseController(s.inner).Hijack()
	if err != nil {
		return conn, buf, err
	}
	s.wrote = true
	ups, served := s.req.Context().Value(upgradesKey{}).(*upgrades)
	if !served {
		return conn, buf, nil
	}
	return ups.adopt(conn, buf)
}

func (s *statusWriter) Header() http.Header {
	return s.inner.Header()
}

func (s *statusWriter) WriteHeader(code int) {
	if s.wrote {
		return
	}
	s.inner.WriteHeader(code)
	s.status = code
	s.wrote = true
}

func (s *statusWriter) Unwrap() http.ResponseWriter {
	return s.inner
}

func (s *statusWriter) Write(b []byte) (int, error) {
	if !s.wrote {
		s.status = http.StatusOK
		s.wrote = true
	}
	return s.inner.Write(b)
}

func (s *statusWriter) Flush() {
	if f, ok := s.inner.(http.Flusher); ok {
		if !s.wrote {
			s.status = http.StatusOK
			s.wrote = true
		}
		f.Flush()
	}
}
