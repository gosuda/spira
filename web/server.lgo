package web

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net"
	"net/http"
	"sync/atomic"
	"time"

	"logos/rt"
	"logos/sync"
)

type Server struct {
	Addr              string = ":8080"
	Router            *Router
	ReadHeaderTimeout time.Duration = 5 * time.Second
	ShutdownGrace     time.Duration = 20 * time.Second

	started atomic.Bool
	run     atomic.Pointer[serverRun]
}

type serverRun struct {
	srv        *http.Server
	join       *joinState
	joinCancel context.CancelFunc
}

type joinState struct {
	done chan struct{}
	err  sync.Locked[error]
}

func (s *Server) Start(ctx context.Context) error {
	if s.started.Load() {
		return fmt.Errorf("web: server already started")
	}
	if s.Router == nil {
		return fmt.Errorf("web: server needs a router")
	}
	l, err := net.Listen("tcp", s.Addr)
	if err != nil {
		return fmt.Errorf("web: listen %s: %w", s.Addr, err)
	}
	if !s.started.CompareAndSwap(false, true) {
		if cerr := l.Close(); cerr != nil {
			slog.Error("web: listener close failed", "error", cerr)
		}
		return fmt.Errorf("web: server already started")
	}
	s.serve(ctx, l)
	return nil
}

func (s *Server) serve(startCtx context.Context, l net.Listener) {
	srv := &http.Server{Handler: s.Router, ReadHeaderTimeout: s.ReadHeaderTimeout}
	g, _ := rt.NewGroup(context.WithoutCancel(startCtx), 0)
	g.Go(func(_ context.Context) error {
		if serr := srv.Serve(l); !errors.Is(serr, http.ErrServerClosed) {
			return fmt.Errorf("web: serve: %w", serr)
		}
		return nil
	})
	js := &joinState{done: make(chan struct{})}
	joinCtx, joinCancel := context.WithCancel(context.Background())
	context.AfterFunc(joinCtx, func() {
		js.err.WithLock(func(e *error) {
			*e = g.Wait()
		})
		close(js.done)
	})
	s.run.Store(&serverRun{srv: srv, join: js, joinCancel: joinCancel})
}

func (s *Server) Stop(ctx context.Context) error {
	if !s.started.Swap(false) {
		return nil
	}
	r := s.run.Load()
	if r == nil {
		return nil
	}
	sctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), s.ShutdownGrace)
	defer cancel()
	shutdownErr := r.srv.Shutdown(sctx)
	r.joinCancel()
	select {
	case <-r.join.done:
	case <-ctx.Done():
		return ctx.Err()
	}
	var joinErr error
	r.join.err.WithLock(func(e *error) {
		joinErr = *e
	})
	if shutdownErr != nil {
		return errors.Join(joinErr, fmt.Errorf("web: shutdown: %w", shutdownErr))
	}
	return joinErr
}
